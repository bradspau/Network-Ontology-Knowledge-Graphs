@prefix cab: <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/cable/> .
@prefix cabAEnd: <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/cable/a-end/> .
@prefix cabChAEnd: <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/cable/child-cable/a-end/> .
@prefix cabChZEnd: <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/cable/child-cable/z-end/> .
@prefix cabChild: <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/cable/child-cable/> .
@prefix cabOptical: <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/cable/optical-cable/> .
@prefix cabZEnd: <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/cable/z-end/> .
@prefix ex: <http://www.huawei.com/ontology/> .
@prefix hw: <http://www.huawei.com/ontology/ietf-hardware/hardware/> .
@prefix hwComp: <http://www.huawei.com/ontology/ietf-hardware/hardware/component/> .
@prefix hwId: <http://www.huawei.com/ontology/identity/ietf-hardware/> .
@prefix hwRoot: <http://www.huawei.com/ontology/ietf-hardware/> .
@prefix hwSensorData: <http://www.huawei.com/ontology/ietf-hardware/hardware/component/sensor-data/> .
@prefix hwState: <http://www.huawei.com/ontology/ietf-hardware/hardware/component/state/> .
@prefix hwTypes: <http://www.huawei.com/ontology/types/ietf-hardware/> .
@prefix net: <http://www.huawei.com/ontology/ietf-network/networks/network/> .
@prefix netBrkChan: <http://www.huawei.com/ontology/ietf-network/networks/network/node/termination-point/inventory-mapping-attributes/port-breakout/breakout-channel/> .
@prefix netInvMap: <http://www.huawei.com/ontology/ietf-network/networks/network/node/termination-point/inventory-mapping-attributes/> .
@prefix netLink: <http://www.huawei.com/ontology/ietf-network/networks/network/link/> .
@prefix netNetworks: <http://www.huawei.com/ontology/ietf-network/networks/> .
@prefix netNode: <http://www.huawei.com/ontology/ietf-network/networks/network/node/> .
@prefix netPortBrk: <http://www.huawei.com/ontology/ietf-network/networks/network/node/termination-point/inventory-mapping-attributes/port-breakout/> .
@prefix netRoot: <http://www.huawei.com/ontology/ietf-network/> .
@prefix netSuppLink: <http://www.huawei.com/ontology/ietf-network/networks/network/link/supporting-link/> .
@prefix netSuppNet: <http://www.huawei.com/ontology/ietf-network/networks/network/supporting-network/> .
@prefix netSuppNode: <http://www.huawei.com/ontology/ietf-network/networks/network/node/supporting-node/> .
@prefix netSuppTP: <http://www.huawei.com/ontology/ietf-network/networks/network/node/termination-point/supporting-termination-point/> .
@prefix netTP: <http://www.huawei.com/ontology/ietf-network/networks/network/node/termination-point/> .
@prefix nwi: <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/> .
@prefix nwiChassis: <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/locations/racks/rack/contained-chassis/> .
@prefix nwiComp: <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/network-elements/network-element/components/component/> .
@prefix nwiCompPatch: <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/network-elements/network-element/components/component/software-rev/patch/> .
@prefix nwiCompSwRev: <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/network-elements/network-element/components/component/software-rev/> .
@prefix nwiGeo: <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/locations/location/geo-location/> .
@prefix nwiInvId: <http://www.huawei.com/ontology/identity/ietf-network-inventory/> .
@prefix nwiLoc: <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/locations/location/> .
@prefix nwiLocs: <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/locations/> .
@prefix nwiNE: <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/network-elements/network-element/> .
@prefix nwiNEs: <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/network-elements/> .
@prefix nwiPassId: <http://www.huawei.com/ontology/identity/ietf-nwi-passive-inventory/> .
@prefix nwiRack: <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/locations/racks/rack/> .
@prefix nwiRacks: <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/locations/racks/> .
@prefix nwiRefFrame: <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/locations/location/geo-location/reference-frame/> .
@prefix nwiRoot: <http://www.huawei.com/ontology/ietf-network-inventory/> .
@prefix nwiSwRev: <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/network-elements/network-element/software-rev/> .
@prefix nwiSwRevPatch: <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/network-elements/network-element/software-rev/patch/> .
@prefix pae: <http://www.huawei.com/ontology/ietf-power-and-energy/energy-objects/> .
@prefix paeId: <http://www.huawei.com/ontology/identity/ietf-power-and-energy/> .
@prefix paePwrEntry: <http://www.huawei.com/ontology/ietf-power-and-energy/energy-objects/power-entry/> .
@prefix paeRoot: <http://www.huawei.com/ontology/ietf-power-and-energy/> .
@prefix pdev: <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/passive-device/> .
@prefix pdevPort: <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/passive-device/passive-port/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shapes: <http://www.huawei.com/ontology/shapes/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

hwSensorData:shape a sh:NodeShape ;
    rdfs:label "Shape for sensor-data" ;
    sh:property shapes:oper-status,
        shapes:units-display,
        shapes:value,
        shapes:value-precision,
        shapes:value-scale,
        shapes:value-timestamp,
        shapes:value-type,
        shapes:value-update-rate ;
    sh:targetClass hwComp:sensor-data .

hwComp:shape a sh:NodeShape ;
    rdfs:label "Shape for component" ;
    sh:property [ a sh:PropertyShape ;
            sh:class hw:component ;
            sh:maxCount 1 ;
            sh:message "Leafref contains-child must target an instance of component" ;
            sh:nodeKind sh:IRI ;
            sh:path ex:contains-child ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:message "List key 'name' is required" ;
            sh:minCount 1 ;
            sh:path hwComp:name ],
        [ a sh:PropertyShape ;
            sh:class hwComp:state ;
            sh:nodeKind sh:IRI ;
            sh:path hwComp:hasState ],
        [ a sh:PropertyShape ;
            sh:class hw:component ;
            sh:maxCount 1 ;
            sh:message "Leafref parent must target an instance of component" ;
            sh:nodeKind sh:IRI ;
            sh:path ex:parent ],
        [ a sh:PropertyShape ;
            sh:class hwComp:sensor-data ;
            sh:nodeKind sh:IRI ;
            sh:path hwComp:hasSensorData ],
        shapes:alias,
        shapes:asset-id,
        shapes:class,
        shapes:description,
        shapes:firmware-rev,
        shapes:hardware-rev,
        shapes:is-fru,
        shapes:mfg-date,
        shapes:mfg-name,
        shapes:model-name,
        shapes:name,
        shapes:parent-rel-pos,
        shapes:physical-index,
        shapes:serial-num,
        shapes:software-rev,
        shapes:uri,
        shapes:uuid ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "Duplicate key combination in list component" ;
            sh:select """SELECT $this WHERE {
  $this a <http://www.huawei.com/ontology/ietf-hardware/hardware/component> .
  $this <http://www.huawei.com/ontology/ietf-hardware/hardware/component/name> ?k1 .
  ?other a <http://www.huawei.com/ontology/ietf-hardware/hardware/component> .
  ?other <http://www.huawei.com/ontology/ietf-hardware/hardware/component/name> ?k1 .
  FILTER(?other != $this)
}""" ] ;
    sh:targetClass hw:component .

hwState:shape a sh:NodeShape ;
    rdfs:label "Shape for state" ;
    sh:property shapes:admin-state,
        shapes:alarm-state,
        shapes:oper-state,
        shapes:standby-state,
        shapes:state-last-changed,
        shapes:usage-state ;
    sh:targetClass hwComp:state .

hw:shape a sh:NodeShape ;
    rdfs:label "Shape for hardware" ;
    sh:property [ a sh:PropertyShape ;
            sh:class hw:component ;
            sh:nodeKind sh:IRI ;
            sh:path hw:hasComponent ],
        shapes:last-change ;
    sh:targetClass hwRoot:hardware .

cabAEnd:shape a sh:NodeShape ;
    rdfs:label "Shape for a-end" ;
    sh:property [ a sh:PropertyShape ;
            sh:class <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/network-elements/network-element/components/component> ;
            sh:maxCount 1 ;
            sh:message "Leafref component-ref must target an instance of component" ;
            sh:nodeKind sh:IRI ;
            sh:path ex:component-ref ],
        [ a sh:PropertyShape ;
            sh:class nwiNEs:network-element ;
            sh:maxCount 1 ;
            sh:message "Leafref ne-ref must target an instance of network-element" ;
            sh:nodeKind sh:IRI ;
            sh:path ex:ne-ref ],
        shapes:device-id,
        shapes:device-type ;
    sh:targetClass cab:a-end .

cabChAEnd:shape a sh:NodeShape ;
    rdfs:label "Shape for a-end" ;
    sh:property [ a sh:PropertyShape ;
            sh:class nwiNEs:network-element ;
            sh:maxCount 1 ;
            sh:message "Leafref ne-ref must target an instance of network-element" ;
            sh:nodeKind sh:IRI ;
            sh:path ex:ne-ref ],
        [ a sh:PropertyShape ;
            sh:class <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/network-elements/network-element/components/component> ;
            sh:maxCount 1 ;
            sh:message "Leafref component-ref must target an instance of component" ;
            sh:nodeKind sh:IRI ;
            sh:path ex:component-ref ],
        shapes:device-id,
        shapes:device-type ;
    sh:targetClass cabChild:a-end .

cabChild:shape a sh:NodeShape ;
    rdfs:label "Shape for child-cable" ;
    sh:property [ a sh:PropertyShape ;
            sh:class cabChild:z-end ;
            sh:nodeKind sh:IRI ;
            sh:path cabChild:hasZEnd ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:message "List key 'index' is required" ;
            sh:minCount 1 ;
            sh:path cabChild:index ],
        [ a sh:PropertyShape ;
            sh:class cabChild:a-end ;
            sh:nodeKind sh:IRI ;
            sh:path cabChild:hasAEnd ],
        shapes:id,
        shapes:index,
        shapes:length ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "Duplicate key combination in list child-cable" ;
            sh:select """SELECT $this WHERE {
  $this a <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/cable/child-cable> .
  $this <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/cable/child-cable/index> ?k1 .
  ?other a <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/cable/child-cable> .
  ?other <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/cable/child-cable/index> ?k1 .
  FILTER(?other != $this)
}""" ] ;
    sh:targetClass cab:child-cable .

cabChZEnd:shape a sh:NodeShape ;
    rdfs:label "Shape for z-end" ;
    sh:property [ a sh:PropertyShape ;
            sh:class <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/network-elements/network-element/components/component> ;
            sh:maxCount 1 ;
            sh:message "Leafref component-ref must target an instance of component" ;
            sh:nodeKind sh:IRI ;
            sh:path ex:component-ref ],
        [ a sh:PropertyShape ;
            sh:class nwiNEs:network-element ;
            sh:maxCount 1 ;
            sh:message "Leafref ne-ref must target an instance of network-element" ;
            sh:nodeKind sh:IRI ;
            sh:path ex:ne-ref ],
        shapes:device-id,
        shapes:device-type ;
    sh:targetClass cabChild:z-end .

cabOptical:shape a sh:NodeShape ;
    rdfs:label "Shape for optical-cable" ;
    sh:property shapes:attenuation,
        shapes:fiber-core-num,
        shapes:fiber-type ;
    sh:targetClass cab:optical-cable .

cab:shape a sh:NodeShape ;
    rdfs:label "Shape for cable" ;
    sh:property [ a sh:PropertyShape ;
            sh:class cab:optical-cable ;
            sh:nodeKind sh:IRI ;
            sh:path cab:hasOpticalCable ],
        [ a sh:PropertyShape ;
            sh:class cab:a-end ;
            sh:nodeKind sh:IRI ;
            sh:path cab:hasAEnd ],
        [ a sh:PropertyShape ;
            sh:class cab:z-end ;
            sh:nodeKind sh:IRI ;
            sh:path cab:hasZEnd ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:message "List key 'id' is required" ;
            sh:minCount 1 ;
            sh:path cab:id ],
        [ a sh:PropertyShape ;
            sh:class cab:child-cable ;
            sh:nodeKind sh:IRI ;
            sh:path cab:hasChildCable ],
        shapes:alias,
        shapes:cable-role,
        shapes:cable-type,
        shapes:description,
        shapes:id,
        shapes:length,
        shapes:name,
        shapes:uuid ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "Duplicate key combination in list cable" ;
            sh:select """SELECT $this WHERE {
  $this a <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/cable> .
  $this <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/cable/id> ?k1 .
  ?other a <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/cable> .
  ?other <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/cable/id> ?k1 .
  FILTER(?other != $this)
}""" ] ;
    sh:targetClass nwi:cable .

cabZEnd:shape a sh:NodeShape ;
    rdfs:label "Shape for z-end" ;
    sh:property [ a sh:PropertyShape ;
            sh:class nwiNEs:network-element ;
            sh:maxCount 1 ;
            sh:message "Leafref ne-ref must target an instance of network-element" ;
            sh:nodeKind sh:IRI ;
            sh:path ex:ne-ref ],
        [ a sh:PropertyShape ;
            sh:class <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/network-elements/network-element/components/component> ;
            sh:maxCount 1 ;
            sh:message "Leafref component-ref must target an instance of component" ;
            sh:nodeKind sh:IRI ;
            sh:path ex:component-ref ],
        shapes:device-id,
        shapes:device-type ;
    sh:targetClass cab:z-end .

<http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/locations/location/geo-location/reference-frame/geodetic-system/shape> a sh:NodeShape ;
    rdfs:label "Shape for geodetic-system" ;
    sh:property shapes:coord-accuracy,
        shapes:geodetic-datum,
        shapes:height-accuracy ;
    sh:targetClass nwiRefFrame:geodetic-system .

nwiRefFrame:shape a sh:NodeShape ;
    rdfs:label "Shape for reference-frame" ;
    sh:property [ a sh:PropertyShape ;
            sh:class nwiRefFrame:geodetic-system ;
            sh:nodeKind sh:IRI ;
            sh:path nwiRefFrame:hasGeodeticSystem ],
        shapes:alternate-system,
        shapes:astronomical-body ;
    sh:targetClass nwiGeo:reference-frame .

nwiGeo:shape a sh:NodeShape ;
    rdfs:label "Shape for geo-location" ;
    sh:property [ a sh:PropertyShape ;
            sh:class nwiGeo:velocity ;
            sh:nodeKind sh:IRI ;
            sh:path nwiGeo:hasVelocity ],
        [ a sh:PropertyShape ;
            sh:class nwiGeo:reference-frame ;
            sh:nodeKind sh:IRI ;
            sh:path nwiGeo:hasReferenceFrame ],
        shapes:height,
        shapes:latitude,
        shapes:longitude,
        shapes:timestamp,
        shapes:valid-until,
        shapes:x,
        shapes:y,
        shapes:z ;
    sh:targetClass nwiLoc:geo-location .

<http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/locations/location/geo-location/velocity/shape> a sh:NodeShape ;
    rdfs:label "Shape for velocity" ;
    sh:property shapes:v-east,
        shapes:v-north,
        shapes:v-up ;
    sh:targetClass nwiGeo:velocity .

<http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/locations/location/physical-address/shape> a sh:NodeShape ;
    rdfs:label "Shape for physical-address" ;
    sh:property shapes:address,
        shapes:city,
        shapes:country-code,
        shapes:postal-code,
        shapes:state ;
    sh:targetClass nwiLoc:physical-address .

nwiLoc:shape a sh:NodeShape ;
    rdfs:label "Shape for location" ;
    sh:property [ a sh:PropertyShape ;
            sh:class nwiLocs:location ;
            sh:maxCount 1 ;
            sh:message "Leafref child must target an instance of location" ;
            sh:nodeKind sh:IRI ;
            sh:path ex:child ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:message "List key 'id' is required" ;
            sh:minCount 1 ;
            sh:path nwiLoc:id ],
        [ a sh:PropertyShape ;
            sh:class nwiLoc:physical-address ;
            sh:nodeKind sh:IRI ;
            sh:path nwiLoc:hasPhysicalAddress ],
        [ a sh:PropertyShape ;
            sh:class nwiLocs:location ;
            sh:maxCount 1 ;
            sh:message "Leafref parent must target an instance of location" ;
            sh:nodeKind sh:IRI ;
            sh:path ex:parent ],
        [ a sh:PropertyShape ;
            sh:class nwiLoc:geo-location ;
            sh:nodeKind sh:IRI ;
            sh:path nwiLoc:hasGeoLocation ],
        shapes:alias,
        shapes:description,
        shapes:id,
        shapes:name,
        shapes:timestamp,
        shapes:type,
        shapes:uuid,
        shapes:valid-until ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "Duplicate key combination in list location" ;
            sh:select """SELECT $this WHERE {
  $this a <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/locations/location> .
  $this <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/locations/location/id> ?k1 .
  ?other a <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/locations/location> .
  ?other <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/locations/location/id> ?k1 .
  FILTER(?other != $this)
}""" ] ;
    sh:targetClass nwiLocs:location .

nwiChassis:shape a sh:NodeShape ;
    rdfs:label "Shape for contained-chassis" ;
    sh:property [ a sh:PropertyShape ;
            sh:class nwiNEs:network-element ;
            sh:maxCount 1 ;
            sh:message "Leafref ne-ref must target an instance of network-element" ;
            sh:nodeKind sh:IRI ;
            sh:path ex:ne-ref ],
        [ a sh:PropertyShape ;
            sh:class <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/network-elements/network-element/components/component> ;
            sh:maxCount 1 ;
            sh:message "Leafref component-ref must target an instance of component" ;
            sh:nodeKind sh:IRI ;
            sh:path ex:component-ref ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:message "List key 'relative-position' is required" ;
            sh:minCount 1 ;
            sh:path nwiChassis:relative-position ],
        shapes:relative-position ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "Duplicate key combination in list contained-chassis" ;
            sh:select """SELECT $this WHERE {
  $this a <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/locations/racks/rack/contained-chassis> .
  $this <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/locations/racks/rack/contained-chassis/relative-position> ?k1 .
  ?other a <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/locations/racks/rack/contained-chassis> .
  ?other <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/locations/racks/rack/contained-chassis/relative-position> ?k1 .
  FILTER(?other != $this)
}""" ] ;
    sh:targetClass nwiRack:contained-chassis .

<http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/locations/racks/rack/rack-location/shape> a sh:NodeShape ;
    rdfs:label "Shape for rack-location" ;
    sh:property [ a sh:PropertyShape ;
            sh:class nwiLocs:location ;
            sh:maxCount 1 ;
            sh:message "Leafref location-ref must target an instance of location" ;
            sh:nodeKind sh:IRI ;
            sh:path ex:location-ref ],
        shapes:column-number,
        shapes:row-number ;
    sh:targetClass nwiRack:rack-location .

nwiRack:shape a sh:NodeShape ;
    rdfs:label "Shape for rack" ;
    sh:property [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:message "List key 'id' is required" ;
            sh:minCount 1 ;
            sh:path nwiRack:id ],
        [ a sh:PropertyShape ;
            sh:class nwiRack:rack-location ;
            sh:nodeKind sh:IRI ;
            sh:path nwiRack:hasRackLocation ],
        [ a sh:PropertyShape ;
            sh:class nwiRack:contained-chassis ;
            sh:nodeKind sh:IRI ;
            sh:path nwiRack:hasContainedChassis ],
        shapes:alias,
        shapes:depth,
        shapes:description,
        shapes:height,
        shapes:id,
        shapes:max-allocated-power,
        shapes:max-voltage,
        shapes:name,
        shapes:timestamp,
        shapes:uuid,
        shapes:valid-until,
        shapes:width ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "Duplicate key combination in list rack" ;
            sh:select """SELECT $this WHERE {
  $this a <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/locations/racks/rack> .
  $this <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/locations/racks/rack/id> ?k1 .
  ?other a <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/locations/racks/rack> .
  ?other <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/locations/racks/rack/id> ?k1 .
  FILTER(?other != $this)
}""" ] ;
    sh:targetClass nwiRacks:rack .

nwiRacks:shape a sh:NodeShape ;
    rdfs:label "Shape for racks" ;
    sh:property [ a sh:PropertyShape ;
            sh:class nwiRacks:rack ;
            sh:nodeKind sh:IRI ;
            sh:path nwiRacks:hasRack ] ;
    sh:targetClass nwiLocs:racks .

nwiLocs:shape a sh:NodeShape ;
    rdfs:label "Shape for locations" ;
    sh:property [ a sh:PropertyShape ;
            sh:class nwiLocs:racks ;
            sh:nodeKind sh:IRI ;
            sh:path nwiLocs:hasRacks ],
        [ a sh:PropertyShape ;
            sh:class nwiLocs:location ;
            sh:nodeKind sh:IRI ;
            sh:path nwiLocs:hasLocation ] ;
    sh:targetClass nwi:locations .

nwiComp:shape a sh:NodeShape ;
    rdfs:label "Shape for component" ;
    sh:property [ a sh:PropertyShape ;
            sh:maxCount 1 ;
