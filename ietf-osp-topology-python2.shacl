@prefix ex: <http://www.huawei.com/ontology/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://www.huawei.com/ontology/ietf-hardware/hardware/component/sensor-data/shape> a sh:NodeShape ;
    rdfs:label "Shape for sensor-data" ;
    sh:property <http://www.huawei.com/ontology/shapes/oper-status>,
        <http://www.huawei.com/ontology/shapes/units-display>,
        <http://www.huawei.com/ontology/shapes/value>,
        <http://www.huawei.com/ontology/shapes/value-precision>,
        <http://www.huawei.com/ontology/shapes/value-scale>,
        <http://www.huawei.com/ontology/shapes/value-timestamp>,
        <http://www.huawei.com/ontology/shapes/value-type>,
        <http://www.huawei.com/ontology/shapes/value-update-rate> ;
    sh:targetClass <http://www.huawei.com/ontology/ietf-hardware/hardware/component/sensor-data> .

<http://www.huawei.com/ontology/ietf-hardware/hardware/component/shape> a sh:NodeShape ;
    rdfs:label "Shape for component" ;
    sh:property [ a sh:PropertyShape ;
            sh:class <http://www.huawei.com/ontology/ietf-hardware/hardware/component> ;
            sh:maxCount 1 ;
            sh:message "Leafref contains-child must target an instance of component" ;
            sh:nodeKind sh:IRI ;
            sh:path ex:contains-child ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:message "List key 'name' is required" ;
            sh:minCount 1 ;
            sh:path <http://www.huawei.com/ontology/ietf-hardware/hardware/component/name> ],
        [ a sh:PropertyShape ;
            sh:class <http://www.huawei.com/ontology/ietf-hardware/hardware/component/sensor-data> ;
            sh:nodeKind sh:IRI ;
            sh:path <http://www.huawei.com/ontology/ietf-hardware/hardware/component/hasSensorData> ],
        [ a sh:PropertyShape ;
            sh:class <http://www.huawei.com/ontology/ietf-hardware/hardware/component/state> ;
            sh:nodeKind sh:IRI ;
            sh:path <http://www.huawei.com/ontology/ietf-hardware/hardware/component/hasState> ],
        [ a sh:PropertyShape ;
            sh:class <http://www.huawei.com/ontology/ietf-hardware/hardware/component> ;
            sh:maxCount 1 ;
            sh:message "Leafref parent must target an instance of component" ;
            sh:nodeKind sh:IRI ;
            sh:path ex:parent ],
        <http://www.huawei.com/ontology/shapes/alias>,
        <http://www.huawei.com/ontology/shapes/asset-id>,
        <http://www.huawei.com/ontology/shapes/class>,
        <http://www.huawei.com/ontology/shapes/description>,
        <http://www.huawei.com/ontology/shapes/firmware-rev>,
        <http://www.huawei.com/ontology/shapes/hardware-rev>,
        <http://www.huawei.com/ontology/shapes/is-fru>,
        <http://www.huawei.com/ontology/shapes/mfg-date>,
        <http://www.huawei.com/ontology/shapes/mfg-name>,
        <http://www.huawei.com/ontology/shapes/model-name>,
        <http://www.huawei.com/ontology/shapes/name>,
        <http://www.huawei.com/ontology/shapes/parent-rel-pos>,
        <http://www.huawei.com/ontology/shapes/physical-index>,
        <http://www.huawei.com/ontology/shapes/serial-num>,
        <http://www.huawei.com/ontology/shapes/software-rev>,
        <http://www.huawei.com/ontology/shapes/uri>,
        <http://www.huawei.com/ontology/shapes/uuid> ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "Duplicate key combination in list component" ;
            sh:select """SELECT $this WHERE {
  $this a <http://www.huawei.com/ontology/ietf-hardware/hardware/component> .
  $this <http://www.huawei.com/ontology/ietf-hardware/hardware/component/name> ?k1 .
  ?other a <http://www.huawei.com/ontology/ietf-hardware/hardware/component> .
  ?other <http://www.huawei.com/ontology/ietf-hardware/hardware/component/name> ?k1 .
  FILTER(?other != $this)
}""" ] ;
    sh:targetClass <http://www.huawei.com/ontology/ietf-hardware/hardware/component> .

<http://www.huawei.com/ontology/ietf-hardware/hardware/component/state/shape> a sh:NodeShape ;
    rdfs:label "Shape for state" ;
    sh:property <http://www.huawei.com/ontology/shapes/admin-state>,
        <http://www.huawei.com/ontology/shapes/alarm-state>,
        <http://www.huawei.com/ontology/shapes/oper-state>,
        <http://www.huawei.com/ontology/shapes/standby-state>,
        <http://www.huawei.com/ontology/shapes/state-last-changed>,
        <http://www.huawei.com/ontology/shapes/usage-state> ;
    sh:targetClass <http://www.huawei.com/ontology/ietf-hardware/hardware/component/state> .

<http://www.huawei.com/ontology/ietf-hardware/hardware/shape> a sh:NodeShape ;
    rdfs:label "Shape for hardware" ;
    sh:property [ a sh:PropertyShape ;
            sh:class <http://www.huawei.com/ontology/ietf-hardware/hardware/component> ;
            sh:nodeKind sh:IRI ;
            sh:path <http://www.huawei.com/ontology/ietf-hardware/hardware/hasComponent> ],
        <http://www.huawei.com/ontology/shapes/last-change> ;
    sh:targetClass <http://www.huawei.com/ontology/ietf-hardware/hardware> .

<http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/cable/a-end/shape> a sh:NodeShape ;
    rdfs:label "Shape for a-end" ;
    sh:property [ a sh:PropertyShape ;
            sh:class <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/network-elements/network-element> ;
            sh:maxCount 1 ;
            sh:message "Leafref ne-ref must target an instance of network-element" ;
            sh:nodeKind sh:IRI ;
            sh:path ex:ne-ref ],
        [ a sh:PropertyShape ;
            sh:class <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/network-elements/network-element/components/component> ;
            sh:maxCount 1 ;
            sh:message "Leafref component-ref must target an instance of component" ;
            sh:nodeKind sh:IRI ;
            sh:path ex:component-ref ],
        <http://www.huawei.com/ontology/shapes/device-id>,
        <http://www.huawei.com/ontology/shapes/device-type> ;
    sh:targetClass <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/cable/a-end> .

<http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/cable/child-cable/a-end/shape> a sh:NodeShape ;
    rdfs:label "Shape for a-end" ;
    sh:property [ a sh:PropertyShape ;
            sh:class <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/network-elements/network-element/components/component> ;
            sh:maxCount 1 ;
            sh:message "Leafref component-ref must target an instance of component" ;
            sh:nodeKind sh:IRI ;
            sh:path ex:component-ref ],
        [ a sh:PropertyShape ;
            sh:class <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/network-elements/network-element> ;
            sh:maxCount 1 ;
            sh:message "Leafref ne-ref must target an instance of network-element" ;
            sh:nodeKind sh:IRI ;
            sh:path ex:ne-ref ],
        <http://www.huawei.com/ontology/shapes/device-id>,
        <http://www.huawei.com/ontology/shapes/device-type> ;
    sh:targetClass <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/cable/child-cable/a-end> .

<http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/cable/child-cable/shape> a sh:NodeShape ;
    rdfs:label "Shape for child-cable" ;
    sh:property [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:message "List key 'index' is required" ;
            sh:minCount 1 ;
            sh:path <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/cable/child-cable/index> ],
        [ a sh:PropertyShape ;
            sh:class <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/cable/child-cable/z-end> ;
            sh:nodeKind sh:IRI ;
            sh:path <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/cable/child-cable/hasZEnd> ],
        [ a sh:PropertyShape ;
            sh:class <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/cable/child-cable/a-end> ;
            sh:nodeKind sh:IRI ;
            sh:path <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/cable/child-cable/hasAEnd> ],
        <http://www.huawei.com/ontology/shapes/id>,
        <http://www.huawei.com/ontology/shapes/index>,
        <http://www.huawei.com/ontology/shapes/length> ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "Duplicate key combination in list child-cable" ;
            sh:select """SELECT $this WHERE {
  $this a <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/cable/child-cable> .
  $this <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/cable/child-cable/index> ?k1 .
  ?other a <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/cable/child-cable> .
  ?other <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/cable/child-cable/index> ?k1 .
  FILTER(?other != $this)
}""" ] ;
    sh:targetClass <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/cable/child-cable> .

<http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/cable/child-cable/z-end/shape> a sh:NodeShape ;
    rdfs:label "Shape for z-end" ;
    sh:property [ a sh:PropertyShape ;
            sh:class <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/network-elements/network-element> ;
            sh:maxCount 1 ;
            sh:message "Leafref ne-ref must target an instance of network-element" ;
            sh:nodeKind sh:IRI ;
            sh:path ex:ne-ref ],
        [ a sh:PropertyShape ;
