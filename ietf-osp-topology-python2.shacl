<http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/cable/shape> a sh:NodeShape ;
    rdfs:label "Shape for cable" ;
    sh:property [ a sh:PropertyShape ;
            sh:class <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/cable/optical-cable> ;
            sh:nodeKind sh:IRI ;
            sh:path <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/cable/hasOpticalCable> ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:message "List key 'id' is required" ;
            sh:minCount 1 ;
            sh:path <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/cable/id> ],
        [ a sh:PropertyShape ;
            sh:class <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/cable/child-cable> ;
            sh:nodeKind sh:IRI ;
            sh:path <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/cable/hasChildCable> ],
        [ a sh:PropertyShape ;
            sh:class <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/cable/z-end> ;
            sh:nodeKind sh:IRI ;
            sh:path <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/cable/hasZEnd> ],
        [ a sh:PropertyShape ;
            sh:class <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/cable/a-end> ;
            sh:nodeKind sh:IRI ;
            sh:path <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/cable/hasAEnd> ],
        <http://www.huawei.com/ontology/shapes/alias>,
        <http://www.huawei.com/ontology/shapes/cable-role>,
        <http://www.huawei.com/ontology/shapes/cable-type>,
        <http://www.huawei.com/ontology/shapes/description>,
        <http://www.huawei.com/ontology/shapes/id>,
        <http://www.huawei.com/ontology/shapes/length>,
        <http://www.huawei.com/ontology/shapes/name>,
        <http://www.huawei.com/ontology/shapes/uuid> ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "Duplicate key combination in list cable" ;
            sh:select """SELECT $this WHERE {
  $this a <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/cable> .
  $this <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/cable/id> ?k1 .
  ?other a <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/cable> .
  ?other <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/cable/id> ?k1 .
  FILTER(?other != $this)
}""" ] ;
    sh:targetClass <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/cable> .

<http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/cable/z-end/shape> a sh:NodeShape ;
