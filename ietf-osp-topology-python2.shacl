<http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/locations/racks/rack/contained-chassis/shape> a sh:NodeShape ;
    rdfs:label "Shape for contained-chassis" ;
    sh:property [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:message "List key 'relative-position' is required" ;
            sh:minCount 1 ;
            sh:path <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/locations/racks/rack/contained-chassis/relative-position> ],
        [ a sh:PropertyShape ;
            sh:class <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/network-elements/network-element/components/component> ;
            sh:maxCount 1 ;
            sh:message "Leafref component-ref must target an instance of component" ;
            sh:nodeKind sh:IRI ;
            sh:path ex:component-ref ],
        [ a sh:PropertyShape ;
            sh:class <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/network-elements/network-element> ;
            sh:maxCount 1 ;
            sh:message "Leafref ne-ref must target an instance of network-element" ;
            sh:nodeKind sh:IRI ;
            sh:path ex:ne-ref ],
        <http://www.huawei.com/ontology/shapes/relative-position> ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "Duplicate key combination in list contained-chassis" ;
            sh:select """SELECT $this WHERE {
