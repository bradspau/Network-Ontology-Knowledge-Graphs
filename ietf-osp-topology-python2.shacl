    sh:maxInclusive 1000000000 ;
    sh:minInclusive -1000000000 .

<http://www.huawei.com/ontology/typedef/ietf-hardware/sensor-value-precision> a sh:NodeShape ;
    rdfs:label "sensor-value-precision" ;
    sh:datatype xsd:byte ;
    sh:maxInclusive 9 ;
    sh:minInclusive -8 .

<http://www.huawei.com/ontology/typedef/ietf-inet-types/as-number> a sh:NodeShape ;
    rdfs:label "as-number" ;
    sh:datatype xsd:unsignedInt .

<http://www.huawei.com/ontology/typedef/ietf-inet-types/domain-name> a sh:NodeShape ;
    rdfs:label "domain-name" ;
    sh:datatype xsd:string ;
    sh:maxLength 253 ;
    sh:minLength 1 ;
    sh:pattern "((([a-zA-Z0-9_]([a-zA-Z0-9\\-_]){0,61})?[a-zA-Z0-9]\\.)*([a-zA-Z0-9_]([a-zA-Z0-9\\-_]){0,61})?[a-zA-Z0-9]\\.?)|\\." .

<http://www.huawei.com/ontology/typedef/ietf-inet-types/dscp> a sh:NodeShape ;
    rdfs:label "dscp" ;
    sh:datatype xsd:unsignedByte ;
    sh:maxInclusive 63 ;
    sh:minInclusive 0 .

<http://www.huawei.com/ontology/typedef/ietf-inet-types/ipv4-address> a sh:NodeShape ;
    rdfs:label "ipv4-address" ;
    sh:datatype xsd:string ;
    sh:pattern "(([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])\\.){3}([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])(%[\\p{N}\\p{L}]+)?" .

<http://www.huawei.com/ontology/typedef/ietf-inet-types/ipv4-address-no-zone> a sh:NodeShape ;
    rdfs:label "ipv4-address-no-zone" ;
    sh:datatype xsd:string ;
    sh:pattern "[0-9\\.]*" .

<http://www.huawei.com/ontology/typedef/ietf-inet-types/ipv4-prefix> a sh:NodeShape ;
    rdfs:label "ipv4-prefix" ;
    sh:datatype xsd:string ;
    sh:pattern "(([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])\\.){3}([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])/(([0-9])|([1-2][0-9])|(3[0-2]))" .

<http://www.huawei.com/ontology/typedef/ietf-inet-types/ipv6-address> a sh:NodeShape ;
    rdfs:label "ipv6-address" ;
    sh:datatype xsd:string ;
    sh:pattern "((:|[0-9a-fA-F]{0,4}):)([0-9a-fA-F]{0,4}:){0,5}((([0-9a-fA-F]{0,4}:)?(:|[0-9a-fA-F]{0,4}))|(((25[0-5]|2[0-4][0-9]|[01]?[0-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9]?[0-9])))(%[\\p{N}\\p{L}]+)?",
        "(([^:]+:){6}(([^:]+:[^:]+)|(.*\\..*)))|((([^:]+:)*[^:]+)?::(([^:]+:)*[^:]+)?)(%.+)?" .

<http://www.huawei.com/ontology/typedef/ietf-inet-types/ipv6-address-no-zone> a sh:NodeShape ;
    rdfs:label "ipv6-address-no-zone" ;
    sh:datatype xsd:string ;
    sh:pattern "[0-9a-fA-F:\\.]*" .

<http://www.huawei.com/ontology/typedef/ietf-inet-types/ipv6-flow-label> a sh:NodeShape ;
    rdfs:label "ipv6-flow-label" ;
    sh:datatype xsd:unsignedInt ;
    sh:maxInclusive 1048575 ;
    sh:minInclusive 0 .

<http://www.huawei.com/ontology/typedef/ietf-inet-types/ipv6-prefix> a sh:NodeShape ;
    rdfs:label "ipv6-prefix" ;
    sh:datatype xsd:string ;
    sh:pattern "((:|[0-9a-fA-F]{0,4}):)([0-9a-fA-F]{0,4}:){0,5}((([0-9a-fA-F]{0,4}:)?(:|[0-9a-fA-F]{0,4}))|(((25[0-5]|2[0-4][0-9]|[01]?[0-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9]?[0-9])))(/(([0-9])|([0-9]{2})|(1[0-1][0-9])|(12[0-8])))",
        "(([^:]+:){6}(([^:]+:[^:]+)|(.*\\..*)))|((([^:]+:)*[^:]+)?::(([^:]+:)*[^:]+)?)(/.+)" .

<http://www.huawei.com/ontology/typedef/ietf-inet-types/port-number> a sh:NodeShape ;
    rdfs:label "port-number" ;
    sh:datatype xsd:unsignedShort ;
    sh:maxInclusive 65535 ;
    sh:minInclusive 0 .

<http://www.huawei.com/ontology/typedef/ietf-inet-types/uri> a sh:NodeShape ;
    rdfs:label "uri" ;
    sh:datatype xsd:string .

<http://www.huawei.com/ontology/typedef/ietf-network-inventory/ne-ref> a sh:NodeShape ;
    rdfs:label "ne-ref" ;
    sh:datatype xsd:string .

<http://www.huawei.com/ontology/typedef/ietf-network-topology/link-id> a sh:NodeShape ;
