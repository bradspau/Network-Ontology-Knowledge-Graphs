hwComp:sensor-data rdfs:comment """Conditional: exists when derived-from-or-self(../class,
                                   "ianahw:sensor")""" ;
    sh:deactivated """derived-from-or-self(../class,
                                   "ianahw:sensor")""" .

cab:optical-cable rdfs:comment "Conditional: exists when derived-from-or-self(../cable-type, 'optical-fiber')" ;
    sh:deactivated "derived-from-or-self(../cable-type, 'optical-fiber')" .

