<http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/cable/optical-cable/shape> a sh:NodeShape ;
    rdfs:label "Shape for optical-cable" ;
    sh:property <http://www.huawei.com/ontology/shapes/attenuation>,
        <http://www.huawei.com/ontology/shapes/fiber-core-num>,
        <http://www.huawei.com/ontology/shapes/fiber-type> ;
