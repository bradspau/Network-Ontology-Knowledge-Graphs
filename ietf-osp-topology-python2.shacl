@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://www.huawei.com/ontology/ietf-hardware/hardware/component/sensor-data/shape> a sh:NodeShape ;
    rdfs:label "Shape for sensor-data" ;
    sh:property <http://www.huawei.com/ontology/shapes/ietf-hardware/hardware/component/sensor-data/oper-status>,
        <http://www.huawei.com/ontology/shapes/ietf-hardware/hardware/component/sensor-data/units-display>,
        <http://www.huawei.com/ontology/shapes/ietf-hardware/hardware/component/sensor-data/value>,
        <http://www.huawei.com/ontology/shapes/ietf-hardware/hardware/component/sensor-data/value-precision>,
        <http://www.huawei.com/ontology/shapes/ietf-hardware/hardware/component/sensor-data/value-scale>,
        <http://www.huawei.com/ontology/shapes/ietf-hardware/hardware/component/sensor-data/value-timestamp>,
        <http://www.huawei.com/ontology/shapes/ietf-hardware/hardware/component/sensor-data/value-type>,
        <http://www.huawei.com/ontology/shapes/ietf-hardware/hardware/component/sensor-data/value-update-rate> ;
    sh:targetClass <http://www.huawei.com/ontology/ietf-hardware/hardware/component/sensor-data> .

<http://www.huawei.com/ontology/ietf-hardware/hardware/component/shape> a sh:NodeShape ;
    rdfs:label "Shape for component" ;
    sh:property [ a sh:PropertyShape ;
            sh:class <http://www.huawei.com/ontology/ietf-hardware/hardware/component> ;
            sh:maxCount 1 ;
            sh:message "Leafref contains-child must target an instance of component" ;
            sh:nodeKind sh:IRI ;
            sh:path <http://www.huawei.com/ontology/ietf-hardware/hardware/component/contains-child> ],
        [ a sh:PropertyShape ;
            sh:class <http://www.huawei.com/ontology/ietf-hardware/hardware/component> ;
            sh:maxCount 1 ;
            sh:message "Leafref parent must target an instance of component" ;
            sh:nodeKind sh:IRI ;
            sh:path <http://www.huawei.com/ontology/ietf-hardware/hardware/component/parent> ],
        [ a sh:PropertyShape ;
            sh:class <http://www.huawei.com/ontology/ietf-hardware/hardware/component/state> ;
            sh:nodeKind sh:IRI ;
            sh:path <http://www.huawei.com/ontology/ietf-hardware/hardware/component/hasState> ],
        [ a sh:PropertyShape ;
            sh:class <http://www.huawei.com/ontology/ietf-hardware/hardware/component/sensor-data> ;
            sh:nodeKind sh:IRI ;
            sh:path <http://www.huawei.com/ontology/ietf-hardware/hardware/component/hasSensorData> ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:message "List key 'name' is required" ;
            sh:minCount 1 ;
            sh:path <http://www.huawei.com/ontology/ietf-hardware/hardware/component/name> ],
        <http://www.huawei.com/ontology/shapes/ietf-hardware/hardware/component/alias>,
        <http://www.huawei.com/ontology/shapes/ietf-hardware/hardware/component/asset-id>,
        <http://www.huawei.com/ontology/shapes/ietf-hardware/hardware/component/class>,
        <http://www.huawei.com/ontology/shapes/ietf-hardware/hardware/component/description>,
        <http://www.huawei.com/ontology/shapes/ietf-hardware/hardware/component/firmware-rev>,
        <http://www.huawei.com/ontology/shapes/ietf-hardware/hardware/component/hardware-rev>,
        <http://www.huawei.com/ontology/shapes/ietf-hardware/hardware/component/is-fru>,
        <http://www.huawei.com/ontology/shapes/ietf-hardware/hardware/component/mfg-date>,
        <http://www.huawei.com/ontology/shapes/ietf-hardware/hardware/component/mfg-name>,
        <http://www.huawei.com/ontology/shapes/ietf-hardware/hardware/component/model-name>,
        <http://www.huawei.com/ontology/shapes/ietf-hardware/hardware/component/name>,
        <http://www.huawei.com/ontology/shapes/ietf-hardware/hardware/component/parent-rel-pos>,
        <http://www.huawei.com/ontology/shapes/ietf-hardware/hardware/component/physical-index>,
        <http://www.huawei.com/ontology/shapes/ietf-hardware/hardware/component/serial-num>,
        <http://www.huawei.com/ontology/shapes/ietf-hardware/hardware/component/software-rev>,
        <http://www.huawei.com/ontology/shapes/ietf-hardware/hardware/component/uri>,
        <http://www.huawei.com/ontology/shapes/ietf-hardware/hardware/component/uuid> ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "Duplicate key combination in list component" ;
            sh:select """SELECT $this WHERE {
  $this a <http://www.huawei.com/ontology/ietf-hardware/hardware/component> .
  $this <http://www.huawei.com/ontology/ietf-hardware/hardware/component/name> ?k1 .
  ?other a <http://www.huawei.com/ontology/ietf-hardware/hardware/component> .
  ?other <http://www.huawei.com/ontology/ietf-hardware/hardware/component/name> ?k1 .
  FILTER(?other != $this)
}""" ] ;
    sh:targetClass <http://www.huawei.com/ontology/ietf-hardware/hardware/component> .

<http://www.huawei.com/ontology/ietf-hardware/hardware/component/state/shape> a sh:NodeShape ;
    rdfs:label "Shape for state" ;
    sh:property <http://www.huawei.com/ontology/shapes/ietf-hardware/hardware/component/state/admin-state>,
        <http://www.huawei.com/ontology/shapes/ietf-hardware/hardware/component/state/alarm-state>,
        <http://www.huawei.com/ontology/shapes/ietf-hardware/hardware/component/state/oper-state>,
        <http://www.huawei.com/ontology/shapes/ietf-hardware/hardware/component/state/standby-state>,
        <http://www.huawei.com/ontology/shapes/ietf-hardware/hardware/component/state/state-last-changed>,
        <http://www.huawei.com/ontology/shapes/ietf-hardware/hardware/component/state/usage-state> ;
    sh:targetClass <http://www.huawei.com/ontology/ietf-hardware/hardware/component/state> .

<http://www.huawei.com/ontology/ietf-hardware/hardware/shape> a sh:NodeShape ;
    rdfs:label "Shape for hardware" ;
    sh:property [ a sh:PropertyShape ;
            sh:class <http://www.huawei.com/ontology/ietf-hardware/hardware/component> ;
            sh:nodeKind sh:IRI ;
            sh:path <http://www.huawei.com/ontology/ietf-hardware/hardware/hasComponent> ],
        <http://www.huawei.com/ontology/shapes/ietf-hardware/hardware/last-change> ;
    sh:targetClass <http://www.huawei.com/ontology/ietf-hardware/hardware> .

<http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/cable/a-end/case-active/shape> a sh:NodeShape ;
