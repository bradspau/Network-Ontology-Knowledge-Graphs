    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:path ex:asset-id .

shapes:class a sh:PropertyShape ;
    sh:class hwId:hardware-class ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:or ( [ sh:class nwiInvId:hardware-class ;
                sh:nodeKind sh:IRI ] [ sh:class nwiInvId:non-hardware-component-class ;
                sh:nodeKind sh:IRI ] ) ;
    sh:path ex:class .

