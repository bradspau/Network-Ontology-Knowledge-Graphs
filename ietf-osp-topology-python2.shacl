<http://www.huawei.com/ontology/typedef/ietf-yang-types/timestamp> a sh:NodeShape ;
    rdfs:label "timestamp" ;
    sh:datatype xsd:unsignedInt .

<http://www.huawei.com/ontology/typedef/ietf-yang-types/timeticks> a sh:NodeShape ;
