            sh:minCount 1 ;
            sh:path nwiComp:component-id ],
        [ a sh:PropertyShape ;
            sh:class <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/network-elements/network-element/components/component> ;
            sh:maxCount 1 ;
            sh:message "Leafref parent must target an instance of component" ;
            sh:nodeKind sh:IRI ;
            sh:path ex:parent ],
        [ a sh:PropertyShape ;
            sh:class nwiComp:software-rev ;
            sh:nodeKind sh:IRI ;
            sh:path nwiComp:hasSoftwareRev ],
        shapes:alias,
        shapes:asset-id,
        shapes:class,
        shapes:component-id,
