<http://www.huawei.com/ontology/typedef/ietf-yang-types/object-identifier> a sh:NodeShape ;
    rdfs:label "object-identifier" ;
    sh:datatype xsd:string ;
    sh:pattern "(([0-1](\\.[1-3]?[0-9]))|(2\\.(0|([1-9]\\d*))))(\\.(0|([1-9]\\d*)))*" .

<http://www.huawei.com/ontology/typedef/ietf-yang-types/object-identifier-128> a sh:NodeShape ;
