        shapes:mfg-name,
        shapes:name,
        shapes:parent-rel-pos,
        shapes:part-number,
        shapes:product-name,
        shapes:serial-number,
        shapes:uri,
        shapes:uuid ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "Duplicate key combination in list component" ;
            sh:select """SELECT $this WHERE {
  $this a <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/network-elements/network-element/components/component> .
  $this <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/network-elements/network-element/components/component/component-id> ?k1 .
