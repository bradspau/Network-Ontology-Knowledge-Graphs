    sh:deactivated "not(../pop)" .

ex:tag-2 rdfs:comment "Conditional: exists when (../translate)",
        "Conditional: exists when not(../pop)" ;
    sh:deactivated "(../translate)",
        "not(../pop)" .

ex:vpn-type sh:condition "not(derived-from-or-self(current(), 'vpn-common:l3vpn'))" ;
    sh:message "L3VPN is only applicable in L3NM." .

hwComp:sensor-data rdfs:comment """Conditional: exists when derived-from-or-self(../class,
                                   "ianahw:sensor")""" ;
    sh:deactivated """derived-from-or-self(../class,
                                   "ianahw:sensor")""" .

l2nmNdEvpn:pbb rdfs:comment "Conditional: exists when derived-from-or-self(../../evpn-type, 'pbb-evpn')" ;
    sh:deactivated "derived-from-or-self(../../evpn-type, 'pbb-evpn')" .

l2nmNdLdp:qinq rdfs:comment "Conditional: exists when derived-from-or-self(../t-ldp-pw-type, 'hvpls')" ;
