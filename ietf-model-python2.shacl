            sh:select """SELECT $this WHERE {
  $this a <http://www.huawei.com/ontology/ietf-network/networks/network/node/termination-point/supporting-termination-point> .
  $this <http://www.huawei.com/ontology/ietf-network/networks/network/node/termination-point/supporting-termination-point/network-ref> ?k1 .
  $this <http://www.huawei.com/ontology/ietf-network/networks/network/node/termination-point/supporting-termination-point/node-ref> ?k2 .
  $this <http://www.huawei.com/ontology/ietf-network/networks/network/node/termination-point/supporting-termination-point/tp-ref> ?k3 .
  ?other a <http://www.huawei.com/ontology/ietf-network/networks/network/node/termination-point/supporting-termination-point> .
  ?other <http://www.huawei.com/ontology/ietf-network/networks/network/node/termination-point/supporting-termination-point/network-ref> ?k1 .
  ?other <http://www.huawei.com/ontology/ietf-network/networks/network/node/termination-point/supporting-termination-point/node-ref> ?k2 .
  ?other <http://www.huawei.com/ontology/ietf-network/networks/network/node/termination-point/supporting-termination-point/tp-ref> ?k3 .
  FILTER(?other != $this)
}""" ] ;
