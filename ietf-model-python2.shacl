l2esDf:shape a sh:NodeShape ;
    rdfs:label "Shape for df-election" ;
    sh:property shapes:df-election-method,
        shapes:election-wait-time,
        shapes:revertive ;
    sh:targetClass l2esSegItem:df-election .

l2esAuto:shape a sh:NodeShape ;
    rdfs:label "Shape for esi-auto" ;
    sh:property shapes:auto,
        shapes:auto-ethernet-segment-identifier,
        shapes:esi-pool-name ;
    sh:targetClass l2esSegItem:esi-auto .

memb:shape a sh:NodeShape ;
    rdfs:label "Shape for member" ;
    sh:property [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:message "List key 'ne-id' is required" ;
            sh:minCount 1 ;
            sh:path memb:ne-id ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:message "List key 'interface-id' is required" ;
            sh:minCount 1 ;
            sh:path memb:interface-id ],
        shapes:interface-id,
        shapes:ne-id ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "Duplicate key combination in list member" ;
            sh:select """SELECT $this WHERE {
  $this a <http://www.huawei.com/ontology/ietf-ethernet-segment/ethernet-segments/ethernet-segment/member> .
  $this <http://www.huawei.com/ontology/ietf-ethernet-segment/ethernet-segments/ethernet-segment/member/ne-id> ?k1 .
  $this <http://www.huawei.com/ontology/ietf-ethernet-segment/ethernet-segments/ethernet-segment/member/interface-id> ?k2 .
  ?other a <http://www.huawei.com/ontology/ietf-ethernet-segment/ethernet-segments/ethernet-segment/member> .
  ?other <http://www.huawei.com/ontology/ietf-ethernet-segment/ethernet-segments/ethernet-segment/member/ne-id> ?k1 .
  ?other <http://www.huawei.com/ontology/ietf-ethernet-segment/ethernet-segments/ethernet-segment/member/interface-id> ?k2 .
  FILTER(?other != $this)
}""" ] ;
    sh:targetClass l2esSegItem:member .

pbb2:shape a sh:NodeShape ;
    rdfs:label "Shape for pbb" ;
    sh:property shapes:backbone-src-mac ;
    sh:targetClass l2esSegItem:pbb .

l2esSegItem:shape a sh:NodeShape ;
    rdfs:label "Shape for ethernet-segment" ;
    sh:property [ a sh:PropertyShape ;
            sh:class l2esSegItem:member ;
            sh:nodeKind sh:IRI ;
            sh:path l2esSegItem:hasMember ],
        [ a sh:PropertyShape ;
            sh:class l2esSegItem:pbb ;
            sh:nodeKind sh:IRI ;
            sh:path l2esSegItem:hasPbb ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:message "List key 'name' is required" ;
            sh:minCount 1 ;
            sh:path l2esSegItem:name ],
        [ a sh:PropertyShape ;
            sh:class l2esSegItem:df-election ;
            sh:nodeKind sh:IRI ;
            sh:path l2esSegItem:hasDfElection ],
        [ a sh:PropertyShape ;
            sh:class l2esSegItem:esi-auto ;
            sh:nodeKind sh:IRI ;
            sh:path l2esSegItem:hasEsiAuto ],
        shapes:esi-redundancy-mode,
        shapes:esi-type,
        shapes:ethernet-segment-identifier,
        shapes:name,
        shapes:split-horizon-filtering ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "Duplicate key combination in list ethernet-segment" ;
            sh:select """SELECT $this WHERE {
  $this a <http://www.huawei.com/ontology/ietf-ethernet-segment/ethernet-segments/ethernet-segment> .
  $this <http://www.huawei.com/ontology/ietf-ethernet-segment/ethernet-segments/ethernet-segment/name> ?k1 .
  ?other a <http://www.huawei.com/ontology/ietf-ethernet-segment/ethernet-segments/ethernet-segment> .
  ?other <http://www.huawei.com/ontology/ietf-ethernet-segment/ethernet-segments/ethernet-segment/name> ?k1 .
  FILTER(?other != $this)
}""" ] ;
    sh:targetClass l2esSeg:ethernet-segment .

l2esSeg:shape a sh:NodeShape ;
    rdfs:label "Shape for ethernet-segments" ;
    sh:property [ a sh:PropertyShape ;
            sh:class l2esSeg:ethernet-segment ;
            sh:nodeKind sh:IRI ;
            sh:path l2esSeg:hasEthernetSegment ] ;
    sh:targetClass ietfEtSe2:ethernet-segments .

hwSensorData:shape a sh:NodeShape ;
    rdfs:label "Shape for sensor-data" ;
    sh:property shapes:oper-status,
        shapes:units-display,
        shapes:value,
        shapes:value-precision,
        shapes:value-scale,
        shapes:value-timestamp,
        shapes:value-type,
        shapes:value-update-rate ;
    sh:targetClass hwComp:sensor-data .

hwComp:shape a sh:NodeShape ;
    rdfs:label "Shape for component" ;
    sh:property [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:message "List key 'name' is required" ;
            sh:minCount 1 ;
            sh:path hwComp:name ],
        [ a sh:PropertyShape ;
            sh:class hw:component ;
            sh:maxCount 1 ;
            sh:message "Leafref contains-child must target an instance of component" ;
            sh:nodeKind sh:IRI ;
            sh:path ex:contains-child ],
        [ a sh:PropertyShape ;
            sh:class hw:component ;
            sh:maxCount 1 ;
            sh:message "Leafref parent must target an instance of component" ;
            sh:nodeKind sh:IRI ;
            sh:path ex:parent ],
        [ a sh:PropertyShape ;
            sh:class hwComp:sensor-data ;
            sh:nodeKind sh:IRI ;
            sh:path hwComp:hasSensorData ],
        [ a sh:PropertyShape ;
            sh:class hwComp:state ;
            sh:nodeKind sh:IRI ;
            sh:path hwComp:hasState ],
        shapes:alias,
        shapes:asset-id,
        shapes:class,
        shapes:description,
        shapes:firmware-rev,
        shapes:hardware-rev,
        shapes:is-fru,
        shapes:mfg-date,
        shapes:mfg-name,
        shapes:model-name,
        shapes:name,
        shapes:parent-rel-pos,
        shapes:physical-index,
        shapes:serial-num,
        shapes:software-rev,
        shapes:uri,
        shapes:uuid ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "Duplicate key combination in list component" ;
            sh:select """SELECT $this WHERE {
  $this a <http://www.huawei.com/ontology/ietf-hardware/hardware/component> .
  $this <http://www.huawei.com/ontology/ietf-hardware/hardware/component/name> ?k1 .
  ?other a <http://www.huawei.com/ontology/ietf-hardware/hardware/component> .
  ?other <http://www.huawei.com/ontology/ietf-hardware/hardware/component/name> ?k1 .
  FILTER(?other != $this)
}""" ] ;
    sh:targetClass hw:component .

hwState:shape a sh:NodeShape ;
    rdfs:label "Shape for state" ;
    sh:property shapes:admin-state,
        shapes:alarm-state,
        shapes:oper-state,
        shapes:standby-state,
        shapes:state-last-changed,
        shapes:usage-state ;
    sh:targetClass hwComp:state .

hw:shape a sh:NodeShape ;
