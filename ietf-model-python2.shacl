        [ a sh:PropertyShape ;
            sh:class netLink:destination ;
            sh:nodeKind sh:IRI ;
            sh:path netLink:hasDestination ],
        [ a sh:PropertyShape ;
            sh:class netLink:source ;
            sh:nodeKind sh:IRI ;
            sh:path netLink:hasSource ],
        shapes:link-id ;
    sh:targetClass net:link .

sour:shape a sh:NodeShape ;
    rdfs:label "Shape for source" ;
