  $this a <http://www.huawei.com/ontology/ietf-l2vpn-ntw/l2vpn-ntw/vpn-services/vpn-service/global-parameters-profiles/global-parameters-profile> .
  $this <http://www.huawei.com/ontology/ietf-l2vpn-ntw/l2vpn-ntw/vpn-services/vpn-service/global-parameters-profiles/global-parameters-profile/profile-id> ?k1 .
  ?other a <http://www.huawei.com/ontology/ietf-l2vpn-ntw/l2vpn-ntw/vpn-services/vpn-service/global-parameters-profiles/global-parameters-profile> .
  ?other <http://www.huawei.com/ontology/ietf-l2vpn-ntw/l2vpn-ntw/vpn-services/vpn-service/global-parameters-profiles/global-parameters-profile/profile-id> ?k1 .
  FILTER(?other != $this)
