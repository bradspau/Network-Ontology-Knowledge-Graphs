  ?other <http://www.huawei.com/ontology/ietf-network/networks/network/node/node-id> ?k1 .
  FILTER(?other != $this)
}""" ] ;
    sh:targetClass net:node .

netSuppNode:shape a sh:NodeShape ;
    rdfs:label "Shape for supporting-node" ;
    sh:property [ a sh:PropertyShape ;
            sh:class net:supporting-network ;
