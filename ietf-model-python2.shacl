    sh:datatype xsd:string ;
    sh:pattern "(([0-1](\\.[1-3]?[0-9]))|(2\\.(0|([1-9]\\d*))))(\\.(0|([1-9]\\d*)))*" .

ietfYaTy:object-identifier-128 a sh:NodeShape ;
    rdfs:label "object-identifier-128" ;
    sh:datatype xsd:string ;
    sh:pattern "\\d*(\\.\\d*){1,127}" .

ietfYaTy:phys-address a sh:NodeShape ;
    rdfs:label "phys-address" ;
    sh:datatype xsd:string ;
    sh:pattern "([0-9a-fA-F]{2}(:[0-9a-fA-F]{2})*)?" .

ietfYaTy:timestamp a sh:NodeShape ;
    rdfs:label "timestamp" ;
    sh:datatype xsd:unsignedInt .

ietfYaTy:timeticks a sh:NodeShape ;
    rdfs:label "timeticks" ;
    sh:datatype xsd:unsignedInt .

ietfYaTy:uuid a sh:NodeShape ;
    rdfs:label "uuid" ;
    sh:datatype xsd:string ;
    sh:pattern "[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}" .

ietfYaTy:xpath1.0 a sh:NodeShape ;
    rdfs:label "xpath1.0" ;
    sh:datatype xsd:string .

ietfYaTy:yang-identifier a sh:NodeShape ;
    rdfs:label "yang-identifier" ;
    sh:datatype xsd:string ;
    sh:pattern ".|..|[^xX].*|.[^mM].*|..[^lL].*",
        "[a-zA-Z_][a-zA-Z0-9\\-_.]*" .

ietfYaTy:zero-based-counter32 a sh:NodeShape ;
    rdfs:label "zero-based-counter32" ;
    sh:datatype xsd:unsignedInt .

ietfYaTy:zero-based-counter64 a sh:NodeShape ;
    rdfs:label "zero-based-counter64" ;
    sh:datatype xsd:unsignedLong .

ex:address rdfs:comment "Conditional: exists when (../ transport)" ;
    sh:deactivated "(../ transport)" .

ex:auto-route-target rdfs:comment "Conditional: exists when ../auto-rt-enable = 'true'" ;
    sh:deactivated "../auto-rt-enable = 'true'" .

ex:cos-id rdfs:comment "Conditional: exists when derived-from-or-self(../type, 'l2vpn-svc:bw-per-cos')" ;
    sh:deactivated "derived-from-or-self(../type, 'l2vpn-svc:bw-per-cos')" .

ex:device-id sh:condition """derived-from-or-self(../device-type,
'nwi-passive:passive-device')""" .

l2t-s-attr:vxlan rdfs:comment "Conditional: exists when derived-from-or-self(../encapsulation-type, 'l2t:vxlan')" ;
    sh:deactivated "derived-from-or-self(../encapsulation-type, 'l2t:vxlan')" .

l2t-attr:vxlan rdfs:comment "Conditional: exists when derived-from-or-self(../encapsulation-type, 'l2t:vxlan')" ;
    sh:deactivated "derived-from-or-self(../encapsulation-type, 'l2t:vxlan')" .

ex:is-main rdfs:comment "Conditional: exists when derived-from-or-self(../nwi:class, 'ianahw:chassis')" ;
    sh:deactivated "derived-from-or-self(../nwi:class, 'ianahw:chassis')" .

ex:lan-tag rdfs:comment "Conditional: exists when derived-from-or-self(../type, 'l2vpn-svc:lan')" ;
    sh:deactivated "derived-from-or-self(../type, 'l2vpn-svc:lan')" .

ex:parent-rel-pos rdfs:comment "Conditional: exists when count(../parent) < 2" ;
    sh:deactivated "count(../parent) < 2" .

ex:rate-limit rdfs:comment "Conditional: exists when derived-from-or-self(../action, 'flood')" ;
    sh:deactivated "derived-from-or-self(../action, 'flood')" .

ex:remote-carrier-name rdfs:comment "Conditional: exists when derived-from-or-self(../../../site-vpn-flavor,'l2vpn-svc:site-vpn-flavor-nni')" ;
    sh:deactivated "derived-from-or-self(../../../site-vpn-flavor,'l2vpn-svc:site-vpn-flavor-nni')" .

ex:revertive rdfs:comment "Conditional: exists when derived-from-or-self(../df-election-method, 'preference')" ;
    sh:deactivated "derived-from-or-self(../df-election-method, 'preference')" .

