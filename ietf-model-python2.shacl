            sh:maxCount 1 ;
            sh:message "Leafref network-ref must target an instance of supporting-network" ;
            sh:nodeKind sh:IRI ;
            sh:path ex:network-ref ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "Duplicate key combination in list supporting-link" ;
            sh:select """SELECT $this WHERE {
  $this a <http://www.huawei.com/ontology/ietf-network/networks/network/link/supporting-link> .
  $this <http://www.huawei.com/ontology/ietf-network/networks/network/link/supporting-link/network-ref> ?k1 .
