@prefix cab: <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/cable/> .
@prefix cabChild: <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/cable/child-cable/> .
@prefix ex: <http://www.huawei.com/ontology/> .
@prefix grpGeo: <http://www.huawei.com/ontology/grouping/ietf-geo-location/> .
@prefix grpNet: <http://www.huawei.com/ontology/grouping/ietf-network/> .
@prefix grpNetTop: <http://www.huawei.com/ontology/grouping/ietf-network-topology/> .
@prefix grpNiLoc: <http://www.huawei.com/ontology/grouping/ietf-ni-location/> .
@prefix grpNwi: <http://www.huawei.com/ontology/grouping/ietf-network-inventory/> .
@prefix grpNwiPass: <http://www.huawei.com/ontology/grouping/ietf-nwi-passive-inventory/> .
@prefix grpNwiTop: <http://www.huawei.com/ontology/grouping/ietf-network-inventory-topology/> .
@prefix hw: <http://www.huawei.com/ontology/ietf-hardware/hardware/> .
@prefix hwAdminSt: <http://www.huawei.com/ontology/types/ietf-hardware/admin-state/> .
@prefix hwComp: <http://www.huawei.com/ontology/ietf-hardware/hardware/component/> .
@prefix hwId: <http://www.huawei.com/ontology/identity/ietf-hardware/> .
@prefix hwNotif: <http://www.huawei.com/ontology/notification/ietf-hardware/> .
@prefix hwOperSt: <http://www.huawei.com/ontology/types/ietf-hardware/oper-state/> .
@prefix hwRoot: <http://www.huawei.com/ontology/ietf-hardware/> .
@prefix hwSensorSt: <http://www.huawei.com/ontology/types/ietf-hardware/sensor-status/> .
@prefix hwSensorVSc: <http://www.huawei.com/ontology/types/ietf-hardware/sensor-value-scale/> .
@prefix hwSensorVTy: <http://www.huawei.com/ontology/types/ietf-hardware/sensor-value-type/> .
@prefix hwTypes: <http://www.huawei.com/ontology/types/ietf-hardware/> .
@prefix hwUsageSt: <http://www.huawei.com/ontology/types/ietf-hardware/standby-state/> .
@prefix ianaHw: <http://www.huawei.com/ontology/identity/iana-hardware/> .
@prefix inetIpVer: <http://www.huawei.com/ontology/types/ietf-inet-types/ip-version/> .
@prefix inetTypes: <http://www.huawei.com/ontology/types/ietf-inet-types/> .
@prefix net: <http://www.huawei.com/ontology/ietf-network/networks/network/> .
@prefix netBrkChan: <http://www.huawei.com/ontology/ietf-network/networks/network/node/termination-point/inventory-mapping-attributes/port-breakout/breakout-channel/> .
@prefix netInvMap: <http://www.huawei.com/ontology/ietf-network/networks/network/node/termination-point/inventory-mapping-attributes/> .
@prefix netLink: <http://www.huawei.com/ontology/ietf-network/networks/network/link/> .
@prefix netNetworks: <http://www.huawei.com/ontology/ietf-network/networks/> .
@prefix netNode: <http://www.huawei.com/ontology/ietf-network/networks/network/node/> .
@prefix netPortBrk: <http://www.huawei.com/ontology/ietf-network/networks/network/node/termination-point/inventory-mapping-attributes/port-breakout/> .
@prefix netRoot: <http://www.huawei.com/ontology/ietf-network/> .
@prefix netSuppLink: <http://www.huawei.com/ontology/ietf-network/networks/network/link/supporting-link/> .
@prefix netSuppNet: <http://www.huawei.com/ontology/ietf-network/networks/network/supporting-network/> .
@prefix netSuppNode: <http://www.huawei.com/ontology/ietf-network/networks/network/node/supporting-node/> .
@prefix netSuppTP: <http://www.huawei.com/ontology/ietf-network/networks/network/node/termination-point/supporting-termination-point/> .
@prefix netTP: <http://www.huawei.com/ontology/ietf-network/networks/network/node/termination-point/> .
@prefix nwi: <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/> .
@prefix nwiChassis: <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/locations/racks/rack/contained-chassis/> .
@prefix nwiComp: <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/network-elements/network-element/components/component/> .
@prefix nwiCompPatch: <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/network-elements/network-element/components/component/software-rev/patch/> .
@prefix nwiCompSwRev: <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/network-elements/network-element/components/component/software-rev/> .
@prefix nwiGeo: <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/locations/location/geo-location/> .
@prefix nwiInvId: <http://www.huawei.com/ontology/identity/ietf-network-inventory/> .
@prefix nwiLoc: <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/locations/location/> .
@prefix nwiLocs: <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/locations/> .
@prefix nwiNE: <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/network-elements/network-element/> .
@prefix nwiNEs: <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/network-elements/> .
@prefix nwiPassId: <http://www.huawei.com/ontology/identity/ietf-nwi-passive-inventory/> .
@prefix nwiRack: <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/locations/racks/rack/> .
@prefix nwiRacks: <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/locations/racks/> .
@prefix nwiRefFrame: <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/locations/location/geo-location/reference-frame/> .
@prefix nwiRoot: <http://www.huawei.com/ontology/ietf-network-inventory/> .
@prefix nwiSwRev: <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/network-elements/network-element/software-rev/> .
@prefix nwiSwRevPatch: <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/network-elements/network-element/software-rev/patch/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pae: <http://www.huawei.com/ontology/ietf-power-and-energy/energy-objects/> .
@prefix paeId: <http://www.huawei.com/ontology/identity/ietf-power-and-energy/> .
@prefix paePwrEntry: <http://www.huawei.com/ontology/ietf-power-and-energy/energy-objects/power-entry/> .
@prefix paeRoot: <http://www.huawei.com/ontology/ietf-power-and-energy/> .
@prefix pdev: <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/passive-device/> .
@prefix pdevPort: <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/passive-device/passive-port/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix yangId: <http://www.huawei.com/ontology/identity/ietf-yang-types/> .

ex:address a owl:DatatypeProperty ;
    rdfs:label "address" ;
    rdfs:comment "Specifies an address (number and street)." ;
    rdfs:domain nwiLoc:physical-address ;
    rdfs:range xsd:string ;
    prov:wasDerivedFrom "nil:physical-address?container/nil:address?leaf" .

ex:admin-state a owl:ObjectProperty ;
    rdfs:label "admin-state" ;
    rdfs:comment """The administrative state for this component.

This node refers to a component's administrative
permission to service both other components within its
containment hierarchy as well other users of its
services defined by means outside the scope of this
module.

Some components exhibit only a subset of the remaining
administrative state values.  Some components cannot be
locked; hence, this node exhibits only the 'unlocked'
state.  Other components cannot be shut down gracefully;
hence, this node does not exhibit the 'shutting-down'
state.""" ;
    rdfs:domain hwComp:state ;
    rdfs:range hwTypes:admin-state ;
    prov:wasDerivedFrom "hw:hardware?container/hw:component?list/hw:state?container/hw:admin-state?leaf" .

ex:alarm-state a owl:DatatypeProperty ;
    rdfs:label "alarm-state" ;
    ex:isStateData true ;
    rdfs:comment """The alarm state for this component.  It does not
include the alarms raised on child components within its
containment hierarchy.""" ;
    rdfs:domain hwComp:state ;
    rdfs:range rdfs:Literal ;
    prov:wasDerivedFrom "hw:hardware?container/hw:component?list/hw:state?container/hw:alarm-state?leaf" .

ex:alias a owl:DatatypeProperty ;
    rdfs:label "alias" ;
    rdfs:comment """An 'alias' name for the component, as specified by a
network manager, that provides a non-volatile 'handle' for
the component.

If no configured value exists, the server MAY set the
value of this node to a locally unique value in the
operational state.

A server implementation MAY map this leaf to the
entPhysicalAlias MIB object.  Such an implementation needs
to use some mechanism to handle the differences in size
and characters allowed between this leaf and
entPhysicalAlias.  The definition of such a mechanism is
outside the scope of this document.""",
        """The alias name of the entity (e.g., component). This alias
name can be specified by a network operator.""" ;
    rdfs:domain hw:component,
        nwi:cable,
        nwiLocs:location,
        nwiRacks:rack,
        nwiNEs:network-element,
        <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/network-elements/network-element/components/component>,
        nwi:passive-device,
        pdev:passive-port ;
    rdfs:range xsd:string ;
    prov:wasDerivedFrom "hw:hardware?container/hw:component?list/hw:alias?leaf",
        "nwi:alias?leaf" .

ex:alternate-system a owl:DatatypeProperty ;
    rdfs:label "alternate-system" ;
    rdfs:comment """The system in which the astronomical body and
geodetic-datum is defined.  Normally, this value is not
present and the system is the natural universe; however,
when present, this value allows for specifying alternate
systems (e.g., virtual realities).  An alternate-system
modifies the definition (but not the type) of the other
values in the reference frame.""" ;
    rdfs:domain nwiGeo:reference-frame ;
    rdfs:range xsd:string ;
    prov:wasDerivedFrom "geo:geo-location?container/geo:reference-frame?container/geo:alternate-system?leaf" .

ex:asset-id a owl:DatatypeProperty ;
    rdfs:label "asset-id" ;
    rdfs:comment """This node is a user-assigned asset tracking identifier for
the component.

A server implementation MAY map this leaf to the
entPhysicalAssetID MIB object.  Such an implementation
needs to use some mechanism to handle the differences in
size and characters allowed between this leaf and
entPhysicalAssetID.  The definition of such a mechanism is
outside the scope of this document.""",
        """This node is an asset tracking identifier for the component,
as specified by a network operator.

A server implementation MAY map this leaf to the
entPhysicalAssetID MIB object.  Such an
implementation needs to use some mechanism to handle
the differences in size and characters allowed
between this leaf and entPhysicalAssetID.

The definition of such a mechanism is outside the
scope of this document.""" ;
    rdfs:domain hw:component,
        <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/network-elements/network-element/components/component> ;
    rdfs:range xsd:string ;
    prov:wasDerivedFrom "hw:hardware?container/hw:component?list/hw:asset-id?leaf",
        "nwi:asset-id?leaf" .

ex:astronomical-body a owl:DatatypeProperty ;
    rdfs:label "astronomical-body" ;
    rdfs:comment """An astronomical body as named by the International
Astronomical Union (IAU) or according to the alternate
system if specified.  Examples include 'sun' (our star),
'earth' (our planet), 'moon' (our moon), 'enceladus' (a
moon of Saturn), 'ceres' (an asteroid), and
'67p/churyumov-gerasimenko (a comet).  The ASCII value
SHOULD have uppercase converted to lowercase and not
include control characters (i.e., values 32..64, and
91..126).  Any preceding 'the' in the name SHOULD NOT be
included.""" ;
    rdfs:domain nwiGeo:reference-frame ;
    rdfs:range xsd:string ;
    prov:wasDerivedFrom "geo:geo-location?container/geo:reference-frame?container/geo:astronomical-body?leaf" .

ex:attenuation a owl:DatatypeProperty ;
    rdfs:label "attenuation" ;
    ex:unit "dB" ;
    rdfs:comment "The fiber attenuation in dB." ;
    rdfs:domain cab:optical-cable ;
    rdfs:range xsd:decimal ;
    prov:wasDerivedFrom "nwi-passive:optical-cable?container/nwi-passive:attenuation?leaf" .

ex:cable-role a owl:ObjectProperty ;
    rdfs:label "cable-role" ;
    rdfs:comment "Role of cable." ;
    rdfs:domain nwi:cable ;
    rdfs:range nwiPassId:cable-role ;
    prov:wasDerivedFrom "nwi-passive:cable-role?leaf" .

ex:cable-type a owl:ObjectProperty ;
    rdfs:label "cable-type" ;
    rdfs:comment "Type of cable." ;
    rdfs:domain nwi:cable ;
    rdfs:range nwiPassId:cable-type ;
    prov:wasDerivedFrom "nwi-passive:cable-type?leaf" .

ex:channel-id a owl:DatatypeProperty ;
    rdfs:label "channel-id" ;
    rdfs:comment """Unique identifier for the breakout channel within the
scope of the parent port.""" ;
    rdfs:domain netPortBrk:breakout-channel ;
    rdfs:range xsd:unsignedShort ;
    prov:wasDerivedFrom "nwit:inventory-mapping-attributes?container/nwit:port-breakout?container/nwit:breakout-channel?list/nwit:channel-id?leaf" .

ex:child a owl:ObjectProperty ;
    rdfs:label "child" ;
    ex:xpathPath "../../location/id" ;
    rdfs:comment "The name of the contained child locations." ;
    rdfs:domain nwiLocs:location ;
    rdfs:range nwiLocs:location ;
    prov:wasDerivedFrom "nwi:network-inventory?container/nil:locations?container/nil:location?list/nil:child?leaf-list" .

ex:city a owl:DatatypeProperty ;
    rdfs:label "city" ;
    rdfs:comment "Specifies a city." ;
    rdfs:domain nwiLoc:physical-address ;
    rdfs:range xsd:string ;
    prov:wasDerivedFrom "nil:physical-address?container/nil:city?leaf" .

ex:class a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "class" ;
    rdfs:comment """An indication of the general hardware type of the
component.""",
        "The type of the component." ;
    rdfs:domain hw:component,
        <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/network-elements/network-element/components/component> ;
    rdfs:range hwId:hardware-class ;
    prov:wasDerivedFrom "hw:hardware?container/hw:component?list/hw:class?leaf",
        "nwi:class?leaf" .

ex:column-number a owl:DatatypeProperty ;
    rdfs:label "column-number" ;
    rdfs:comment """Identifies the physical location of the rack within
the column.""" ;
    rdfs:domain nwiRack:rack-location ;
    rdfs:range xsd:unsignedInt ;
    prov:wasDerivedFrom "nwi:network-inventory?container/nil:locations?container/nil:racks?container/nil:rack?list/nil:rack-location?container/nil:column-number?leaf" .

ex:component-id a owl:DatatypeProperty ;
    rdfs:label "component-id" ;
    rdfs:comment """An identifier that uniquely identifies the component
in a node.""" ;
    rdfs:domain <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/network-elements/network-element/components/component> ;
    rdfs:range xsd:string ;
    prov:wasDerivedFrom "nwi:component-id?leaf" .

ex:component-ref a owl:ObjectProperty ;
    rdfs:label "component-ref" ;
    ex:xpathPath "/nwi:network-inventory/nwi:network-elements/nwi:network-element[nwi:ne-id=current()/../ne-ref]/nwi:components/nwi:component/nwi:component-id" ;
    rdfs:comment """Referenced connected active device's component,
e.g. port component.""",
        """The reference to the chassis component within
the network element and contained by the rack.""" ;
    rdfs:domain cab:a-end,
        cabChild:a-end,
        cabChild:z-end,
        cab:z-end,
        nwiRack:contained-chassis ;
    rdfs:range <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/network-elements/network-element/components/component> ;
    prov:wasDerivedFrom "nwi-passive:a-end?container/nwi-passive:component-ref?leaf",
        "nwi-passive:z-end?container/nwi-passive:component-ref?leaf",
        "nwi:network-inventory?container/nil:locations?container/nil:racks?container/nil:rack?list/nil:contained-chassis?list/nil:component-ref?leaf" .

ex:contains-child a owl:ObjectProperty ;
    rdfs:label "contains-child" ;
    ex:isStateData true ;
    ex:xpathPath "../../component/name" ;
    rdfs:comment "The name of the contained component." ;
    rdfs:domain hw:component ;
    rdfs:range hw:component ;
    prov:wasDerivedFrom "hw:hardware?container/hw:component?list/hw:contains-child?leaf-list" .

ex:coord-accuracy a owl:DatatypeProperty ;
    rdfs:label "coord-accuracy" ;
    rdfs:comment """The accuracy of the latitude/longitude pair for
ellipsoidal coordinates, or the X, Y, and Z components
for Cartesian coordinates.  When coord-accuracy is
specified, it indicates how precisely the coordinates
in the associated list of locations have been
determined with respect to the coordinate system
defined by the geodetic-datum.  For example, there
might be uncertainty due to measurement error if an
experimental measurement was made to determine each
location.""" ;
    rdfs:domain nwiRefFrame:geodetic-system ;
    rdfs:range xsd:decimal ;
    prov:wasDerivedFrom "geo:geo-location?container/geo:reference-frame?container/geo:geodetic-system?container/geo:coord-accuracy?leaf" .

ex:country-code a owl:DatatypeProperty ;
    rdfs:label "country-code" ;
    rdfs:comment """Specifies a country.
Expressed as ISO ALPHA-2 code.""" ;
    rdfs:domain nwiLoc:physical-address ;
    rdfs:range xsd:string ;
    prov:wasDerivedFrom "nil:physical-address?container/nil:country-code?leaf" .

ex:custom-tags a owl:DatatypeProperty ;
    rdfs:label "custom-tags" ;
    rdfs:comment """Customized tags, e.g. RFID, QR code that are
attached to the device.""" ;
    rdfs:domain nwi:passive-device ;
    rdfs:range xsd:string ;
    prov:wasDerivedFrom "nwi:network-inventory?container/nwi-passive:passive-device?list/nwi-passive:custom-tags?leaf-list" .

ex:depth a owl:DatatypeProperty ;
    rdfs:label "depth" ;
    ex:unit "millimeter" ;
    rdfs:comment "Rack depth." ;
    rdfs:domain nwiRacks:rack ;
    rdfs:range xsd:unsignedShort ;
    prov:wasDerivedFrom "nwi:network-inventory?container/nil:locations?container/nil:racks?container/nil:rack?list/nil:depth?leaf" .

ex:description a owl:DatatypeProperty ;
    rdfs:label "description" ;
    ex:isStateData true ;
    rdfs:comment """A textual description of the component.  This node should
contain a string that identifies the manufacturer's name
for the component and should be set to a distinct value
for each version or model of the component.""",
        "The textual description of the entity (e.g., component)." ;
    rdfs:domain hw:component,
        nwi:cable,
        nwiLocs:location,
        nwiRacks:rack,
        nwiNEs:network-element,
        <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/network-elements/network-element/components/component>,
        nwi:passive-device,
        pdev:passive-port ;
    rdfs:range xsd:string ;
    prov:wasDerivedFrom "hw:hardware?container/hw:component?list/hw:description?leaf",
        "nwi:description?leaf" .

ex:dest-node a owl:ObjectProperty ;
    rdfs:label "dest-node" ;
    ex:xpathPath "../../../nw:node/nw:node-id" ;
    rdfs:comment """Destination node identifier.  Must be in the same
network.""" ;
    rdfs:domain netLink:destination ;
    rdfs:range net:node ;
    prov:wasDerivedFrom "nt:link?list/nt:destination?container/nt:dest-node?leaf" .

ex:dest-tp a owl:ObjectProperty ;
    rdfs:label "dest-tp" ;
    ex:xpathPath "../../../nw:node[nw:node-id=current()/../dest-node]/termination-point/tp-id" ;
    rdfs:comment """This termination point is located within the
destination node and terminates the link.""" ;
    rdfs:domain netLink:destination ;
    rdfs:range netNode:termination-point ;
    prov:wasDerivedFrom "nt:link?list/nt:destination?container/nt:dest-tp?leaf" .

ex:device-id a owl:DatatypeProperty ;
    rdfs:label "device-id" ;
    rdfs:comment "Connected passive device identifier." ;
    rdfs:domain cab:a-end,
        cabChild:a-end,
        cabChild:z-end,
        cab:z-end ;
    rdfs:range xsd:string ;
    prov:wasDerivedFrom "nwi-passive:a-end?container/nwi-passive:device-id?leaf",
        "nwi-passive:z-end?container/nwi-passive:device-id?leaf" .

ex:device-ref a owl:ObjectProperty ;
    rdfs:label "device-ref" ;
    rdfs:comment "Reference to a passive device (e.g. ATB or Enclosure)." ;
    rdfs:domain cab:a-end,
        cabChild:a-end,
        cabChild:z-end,
        cab:z-end ;
    rdfs:range nwi:passive-device .

ex:device-type a owl:ObjectProperty ;
    rdfs:label "device-type" ;
    rdfs:comment "Type of connected device.",
        "Type of passive device." ;
    rdfs:domain cab:a-end,
        cabChild:a-end,
        cabChild:z-end,
        cab:z-end,
        nwi:passive-device ;
    rdfs:range nwiPassId:connected-device-type,
        nwiPassId:passive-device-type ;
    prov:wasDerivedFrom "nwi-passive:a-end?container/nwi-passive:device-type?leaf",
        "nwi-passive:z-end?container/nwi-passive:device-type?leaf",
        "nwi:network-inventory?container/nwi-passive:passive-device?list/nwi-passive:device-type?leaf" .

ex:eo-power a owl:DatatypeProperty ;
    rdfs:label "eo-power" ;
    ex:isStateData true ;
    ex:unit "Watts" ;
    rdfs:comment """The current power usage measurement for the energy object.
This value represents the instantaneous power consumption
of the component. Positive values indicate power
consumption, while negative values can indicate power
generation (e.g., for devices with battery backup or
renewable energy sources).""" ;
    rdfs:domain pae:power-entry ;
    rdfs:range xsd:int ;
    prov:wasDerivedFrom "eo:energy-objects?container/eo:power-entry?list/eo:eo-power?leaf" .

ex:eo-power-data-source-accuracy a owl:ObjectProperty ;
    rdfs:label "eo-power-data-source-accuracy" ;
    ex:isStateData true ;
    rdfs:comment """The accuracy of the power data source. Indicates whether
the data source is a direct measurement, an estimate, or
unavailable and also the accuracy level of the data source.
This metadata is crucial for network management
applications to assess the reliability and accuracy of the
power data.""" ;
    rdfs:domain pae:power-entry ;
    rdfs:range paeId:data-source-accuracy ;
    prov:wasDerivedFrom "eo:energy-objects?container/eo:power-entry?list/eo:eo-power-data-source-accuracy?leaf" .

ex:eo-power-measurement-local a owl:DatatypeProperty ;
    rdfs:label "eo-power-measurement-local" ;
    ex:isStateData true ;
    rdfs:comment """Indicates whether the power measurement is local (true) or
remote (false). A local measurement is taken directly at
the device, while a remote measurement is collected from
an external source. This information can be useful for
troubleshooting and understanding the data source.""" ;
    rdfs:domain pae:power-entry ;
    rdfs:range xsd:boolean ;
    prov:wasDerivedFrom "eo:energy-objects?container/eo:power-entry?list/eo:eo-power-measurement-local?leaf" .

ex:eo-power-nameplate a owl:DatatypeProperty ;
    rdfs:label "eo-power-nameplate" ;
    ex:isStateData true ;
    ex:unit "Watts" ;
    rdfs:comment """The nameplate power rating of an energy object. This is
the maximum power that the device is designed to consume or
produce, as specified by the manufacturer. Essential for
power budget calculations and capacity planning.""" ;
    rdfs:domain pae:power-entry ;
    rdfs:range xsd:unsignedInt ;
    prov:wasDerivedFrom "eo:energy-objects?container/eo:power-entry?list/eo:eo-power-nameplate?leaf" .

ex:eo-power-power-factor a owl:DatatypeProperty ;
    rdfs:label "eo-power-power-factor" ;
    ex:isStateData true ;
    rdfs:comment """The percent value of the power factor measurement for the
energy object. This information is important for
understanding the electrical characteristics of the device
and for correctly interpreting the power data.""" ;
    rdfs:domain pae:power-entry ;
    rdfs:range xsd:unsignedByte ;
    prov:wasDerivedFrom "eo:energy-objects?container/eo:power-entry?list/eo:eo-power-power-factor?leaf" .

ex:eo-power-unit-multiplier a owl:ObjectProperty ;
    rdfs:label "eo-power-unit-multiplier" ;
    ex:isStateData true ;
    rdfs:comment """The unit multiplier used to measure the power or energy.
This multiplier applies to both eo-power and
eo-power-nameplate values, allowing representation of power
values from milliwatts to gigawatts using integer
arithmetic.""" ;
    rdfs:domain pae:power-entry ;
    rdfs:range paeId:unit-multiplier ;
    prov:wasDerivedFrom "eo:energy-objects?container/eo:power-entry?list/eo:eo-power-unit-multiplier?leaf" .

ex:fiber-core-num a owl:DatatypeProperty ;
    rdfs:label "fiber-core-num" ;
    rdfs:comment "Number of fiber cores within the cable.",
        "Number of fiber cores within the port." ;
    rdfs:domain cab:optical-cable,
        pdev:passive-port ;
    rdfs:range xsd:unsignedInt ;
    prov:wasDerivedFrom "nwi-passive:optical-cable?container/nwi-passive:fiber-core-num?leaf",
        "nwi-passive:passive-port?list/nwi-passive:fiber-core-num?leaf" .

ex:fiber-type a owl:ObjectProperty ;
    rdfs:label "fiber-type" ;
    rdfs:comment "Type of fiber contained in the cable." ;
    rdfs:domain cab:optical-cable ;
    rdfs:range nwiPassId:fiber-type ;
    prov:wasDerivedFrom "nwi-passive:optical-cable?container/nwi-passive:fiber-type?leaf" .

ex:firmware-rev a owl:DatatypeProperty ;
    rdfs:label "firmware-rev" ;
    ex:isStateData true ;
    rdfs:comment """The vendor-specific firmware revision string for the
component.""" ;
    rdfs:domain hw:component ;
    rdfs:range xsd:string ;
    prov:wasDerivedFrom "hw:hardware?container/hw:component?list/hw:firmware-rev?leaf" .

ex:geodetic-datum a owl:DatatypeProperty ;
    rdfs:label "geodetic-datum" ;
    rdfs:comment """A geodetic-datum defining the meaning of latitude,
longitude, and height.  The default when the
astronomical body is 'earth' is 'wgs-84', which is
used by the Global Positioning System (GPS).  The
ASCII value SHOULD have uppercase converted to
lowercase and not include control characters
(i.e., values 32..64, and 91..126).  The IANA registry
further restricts the value by converting all spaces
(' ') to dashes ('-').
The specification for the geodetic-datum indicates
how accurately it models the astronomical body in
question, both for the 'horizontal'
latitude/longitude coordinates and for height
coordinates.""" ;
    rdfs:domain nwiRefFrame:geodetic-system ;
    rdfs:range xsd:string ;
    prov:wasDerivedFrom "geo:geo-location?container/geo:reference-frame?container/geo:geodetic-system?container/geo:geodetic-datum?leaf" .

grpNetTop:link-ref a owl:Class ;
    rdfs:label "link-ref" ;
    rdfs:comment "Grouping definition: link-ref",
        """This grouping can be used to reference a link in a specific
network.  Although it is not used in this module, it is
defined here for the convenience of augmenting modules.""" .

grpNetTop:tp-ref a owl:Class ;
    rdfs:label "tp-ref" ;
    rdfs:comment "Grouping definition: tp-ref",
        """This grouping can be used to reference a termination point
in a specific node.  Although it is not used in this module,
it is defined here for the convenience of augmenting
modules.""" .

grpNet:network-ref a owl:Class ;
    rdfs:label "network-ref" ;
    rdfs:comment """Contains the information necessary to reference a network --
for example, an underlay network.""",
        "Grouping definition: network-ref" .

grpNet:node-ref a owl:Class ;
    rdfs:label "node-ref" ;
    rdfs:comment "Contains the information necessary to reference a node.",
        "Grouping definition: node-ref" .

ex:hardware-rev a owl:DatatypeProperty ;
    rdfs:label "hardware-rev" ;
    ex:isStateData true ;
    rdfs:comment """The vendor-specific hardware revision string for the
component.

The preferred value is the hardware revision identifier
actually printed on the component itself (if present).""",
        """The vendor-specific hardware revision string for the
component.  The preferred value is the hardware revision
identifier actually printed on the component itself (if
present).""" ;
    rdfs:domain hw:component,
        <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/network-elements/network-element/components/component> ;
    rdfs:range xsd:string ;
    prov:wasDerivedFrom "hw:hardware?container/hw:component?list/hw:hardware-rev?leaf",
        "nwi:hardware-rev?leaf" .

ex:has_breakout-channel a owl:ObjectProperty ;
    rdfs:label "has breakout-channel" ;
    rdfs:domain netInvMap:port-breakout ;
    rdfs:range netPortBrk:breakout-channel .

ex:has_cable a owl:ObjectProperty ;
    rdfs:label "has cable" ;
    rdfs:domain nwiRoot:network-inventory ;
    rdfs:range nwi:cable .

ex:has_child-cable a owl:ObjectProperty ;
    rdfs:label "has child-cable" ;
    rdfs:domain nwi:cable ;
    rdfs:range cab:child-cable .

ex:has_component a owl:ObjectProperty ;
    rdfs:label "has component" ;
    rdfs:domain hwRoot:hardware,
        nwiNE:components ;
    rdfs:range hw:component,
        <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/network-elements/network-element/components/component> .

ex:has_contained-chassis a owl:ObjectProperty ;
    rdfs:label "has contained-chassis" ;
    rdfs:domain nwiRacks:rack ;
    rdfs:range nwiRack:contained-chassis .

ex:has_location a owl:ObjectProperty ;
    rdfs:label "has location" ;
    rdfs:domain nwi:locations ;
    rdfs:range nwiLocs:location .

ex:has_network a owl:ObjectProperty ;
    rdfs:label "has network" ;
    rdfs:domain netRoot:networks ;
    rdfs:range netNetworks:network .

ex:has_network-element a owl:ObjectProperty ;
    rdfs:label "has network-element" ;
    rdfs:domain nwi:network-elements ;
    rdfs:range nwiNEs:network-element .

ex:has_node a owl:ObjectProperty ;
    rdfs:label "has node" ;
    rdfs:domain netNetworks:network ;
    rdfs:range net:node .

ex:has_passive-device a owl:ObjectProperty ;
    rdfs:label "has passive-device" ;
    rdfs:domain nwiRoot:network-inventory ;
    rdfs:range nwi:passive-device .

ex:has_passive-port a owl:ObjectProperty ;
    rdfs:label "has passive-port" ;
    rdfs:domain nwi:passive-device ;
    rdfs:range pdev:passive-port .

ex:has_patch a owl:ObjectProperty ;
    rdfs:label "has patch" ;
    rdfs:domain nwiComp:software-rev,
        nwiNE:software-rev ;
    rdfs:range nwiCompSwRev:patch,
        nwiSwRev:patch .

ex:has_power-entry a owl:ObjectProperty ;
    rdfs:label "has power-entry" ;
    rdfs:domain paeRoot:energy-objects ;
    rdfs:range pae:power-entry .

ex:has_rack a owl:ObjectProperty ;
    rdfs:label "has rack" ;
    rdfs:domain nwiLocs:racks ;
    rdfs:range nwiRacks:rack .

ex:has_software-rev a owl:ObjectProperty ;
    rdfs:label "has software-rev" ;
    rdfs:domain nwiNEs:network-element,
        <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/network-elements/network-element/components/component> ;
    rdfs:range nwiComp:software-rev,
        nwiNE:software-rev .

ex:has_supporting-link a owl:ObjectProperty ;
    rdfs:label "has supporting-link" ;
    rdfs:domain net:link ;
    rdfs:range netLink:supporting-link .

ex:has_supporting-network a owl:ObjectProperty ;
    rdfs:label "has supporting-network" ;
    rdfs:domain netNetworks:network ;
    rdfs:range net:supporting-network .

ex:has_supporting-node a owl:ObjectProperty ;
    rdfs:label "has supporting-node" ;
    rdfs:domain net:node ;
    rdfs:range netNode:supporting-node .

ex:has_supporting-termination-point a owl:ObjectProperty ;
    rdfs:label "has supporting-termination-point" ;
    rdfs:domain netNode:termination-point ;
    rdfs:range netTP:supporting-termination-point .

ex:height a owl:DatatypeProperty ;
    rdfs:label "height" ;
    ex:unit "meters",
        "millimeter" ;
    rdfs:comment """Height from a reference 0 value.  The precision and
'0' value is defined by the reference-frame.""",
        "Rack height." ;
    rdfs:domain nwiLoc:geo-location,
        nwiRacks:rack ;
    rdfs:range xsd:decimal,
        xsd:unsignedShort ;
    prov:wasDerivedFrom "geo:geo-location?container/geo:height?leaf",
        "nwi:network-inventory?container/nil:locations?container/nil:racks?container/nil:rack?list/nil:height?leaf" .

ex:height-accuracy a owl:DatatypeProperty ;
    rdfs:label "height-accuracy" ;
    ex:unit "meters" ;
    rdfs:comment """The accuracy of the height value for ellipsoidal
coordinates; this value is not used with Cartesian
coordinates.  When height-accuracy is specified, it
indicates how precisely the heights in the
associated list of locations have been determined
with respect to the coordinate system defined by the
geodetic-datum.  For example, there might be
uncertainty due to measurement error if an
experimental measurement was made to determine each
location.""" ;
    rdfs:domain nwiRefFrame:geodetic-system ;
    rdfs:range xsd:decimal ;
    prov:wasDerivedFrom "geo:geo-location?container/geo:reference-frame?container/geo:geodetic-system?container/geo:height-accuracy?leaf" .

ex:id a owl:DatatypeProperty ;
    rdfs:label "id" ;
    rdfs:comment "An identifier of the location.",
        """An identifier that uniquely identifies the rack
within a location, e.g. equipment room.""",
        "Cable identifier.",
        "Port identifier." ;
    rdfs:domain nwi:cable,
        cab:child-cable,
        nwiLocs:location,
        nwiRacks:rack,
        nwi:passive-device,
        pdev:passive-port ;
    rdfs:range xsd:string ;
    prov:wasDerivedFrom "nwi-passive:id?leaf",
        "nwi-passive:passive-port?list/nwi-passive:id?leaf",
        "nwi:network-inventory?container/nil:locations?container/nil:location?list/nil:id?leaf",
        "nwi:network-inventory?container/nil:locations?container/nil:racks?container/nil:rack?list/nil:id?leaf",
        "nwi:network-inventory?container/nwi-passive:passive-device?list/nwi-passive:id?leaf" .

ianaHw:backplane a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "backplane" ;
    rdfs:comment """This identity is applicable if the hardware class is some sort
of device for aggregating and forwarding networking traffic,
such as a shared backplane in a modular ethernet switch.  Note
that an implementation may model a backplane as a single
physical component, which is actually implemented as multiple
discrete physical components (within a chassis or stack).""" ;
    rdfs:subClassOf yangId:hardware-class ;
    prov:wasDerivedFrom "ianahw:backplane?identity" .

ianaHw:battery a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "battery" ;
    rdfs:comment """This identity is applicable if the hardware class is some sort
of battery.""" ;
    rdfs:subClassOf yangId:hardware-class ;
    prov:wasDerivedFrom "ianahw:battery?identity" .

ianaHw:chassis a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "chassis" ;
    rdfs:comment """This identity is applicable if the hardware class is an
overall container for networking equipment.  Any class of
physical component, except a stack, may be contained within a
chassis; a chassis may only be contained within a stack.""" ;
    rdfs:subClassOf yangId:hardware-class ;
    prov:wasDerivedFrom "ianahw:chassis?identity" .

ianaHw:container a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "container" ;
    rdfs:comment """This identity is applicable if the hardware class is capable
of containing one or more removable physical entities,
possibly of different types.  For example, each (empty or
full) slot in a chassis will be modeled as a container.  Note
that all removable physical components should be modeled
within a container component, such as field-replaceable
modules, fans, or power supplies.  Note that all known
containers should be modeled by the agent, including empty
containers.""" ;
    rdfs:subClassOf yangId:hardware-class ;
    prov:wasDerivedFrom "ianahw:container?identity" .

ianaHw:cpu a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "cpu" ;
    rdfs:comment """This identity is applicable if the hardware class is some sort
of central processing unit.""" ;
    rdfs:subClassOf yangId:hardware-class ;
    prov:wasDerivedFrom "ianahw:cpu?identity" .

ianaHw:energy-object a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "energy-object" ;
    rdfs:comment """This identity is applicable if the hardware class is some sort
of energy object, i.e., it is a piece of equipment that is
part of or attached to a communications network that is
monitored, it is controlled, or it aids in the management of
another device for Energy Management.""" ;
    rdfs:subClassOf yangId:hardware-class ;
    prov:wasDerivedFrom "ianahw:energy-object?identity" .

ianaHw:fan a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "fan" ;
    rdfs:comment """This identity is applicable if the hardware class is a fan or
other heat-reduction component.""" ;
    rdfs:subClassOf yangId:hardware-class ;
    prov:wasDerivedFrom "ianahw:fan?identity" .

ianaHw:hardware-class a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "hardware-class" ;
    rdfs:comment """This identity is the base for all hardware class
identifiers.""" ;
    prov:wasDerivedFrom "ianahw:hardware-class?identity" .

ianaHw:module a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "module" ;
    rdfs:comment """This identity is applicable if the hardware class is some sort
of self-contained sub-system.  If a module component is
removable, then it should be modeled within a container
component; otherwise, it should be modeled directly within
another physical component (e.g., a chassis or another
module).""" ;
    rdfs:subClassOf yangId:hardware-class ;
    prov:wasDerivedFrom "ianahw:module?identity" .

ianaHw:port a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "port" ;
    rdfs:comment """This identity is applicable if the hardware class is some sort
of networking port capable of receiving and/or transmitting
networking traffic.""" ;
    rdfs:subClassOf yangId:hardware-class ;
    prov:wasDerivedFrom "ianahw:port?identity" .

ianaHw:power-supply a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "power-supply" ;
    rdfs:comment """This identity is applicable if the hardware class is a
power-supplying component.""" ;
    rdfs:subClassOf yangId:hardware-class ;
    prov:wasDerivedFrom "ianahw:power-supply?identity" .

ianaHw:sensor a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "sensor" ;
    rdfs:comment """This identity is applicable if the hardware class is some sort
of sensor, such as a temperature sensor within a router
chassis.""" ;
    rdfs:subClassOf yangId:hardware-class ;
    prov:wasDerivedFrom "ianahw:sensor?identity" .

ianaHw:stack a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "stack" ;
    rdfs:comment """This identity is applicable if the hardware class is some sort
of super-container (possibly virtual) intended to group
together multiple chassis entities.  A stack may be realized
by a virtual cable, a real interconnect cable attached to
multiple chassis, or multiple interconnect cables.  A stack
should not be modeled within any other physical components,
but a stack may be contained within another stack.  Only
chassis components should be contained within a stack.""" ;
    rdfs:subClassOf yangId:hardware-class ;
    prov:wasDerivedFrom "ianahw:stack?identity" .

ianaHw:storage-drive a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "storage-drive" ;
    rdfs:comment """This identity is applicable if the hardware class is some sort
of component with data storage capability as its main
functionality, e.g., hard disk drive (HDD), solid-state device
(SSD), solid-state hybrid drive (SSHD), object storage device
(OSD), or other.""" ;
    rdfs:subClassOf yangId:hardware-class ;
    prov:wasDerivedFrom "ianahw:storage-drive?identity" .

ianaHw:unknown a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "unknown" ;
    rdfs:comment """This identity is applicable if the hardware class is unknown
to the server.""" ;
    rdfs:subClassOf yangId:hardware-class ;
    prov:wasDerivedFrom "ianahw:unknown?identity" .

nwiInvId:ne-physical a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "ne-physical" ;
    rdfs:comment "A physical network element (NE). " ;
    rdfs:subClassOf yangId:ne-type ;
    prov:wasDerivedFrom "nwi:ne-physical?identity" .

nwiInvId:non-hardware-component-class a owl:Class,
