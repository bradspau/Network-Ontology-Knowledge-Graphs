    rdfs:label "G654" ;
    rdfs:comment "ITU-T G.654 fiber." ;
    rdfs:subClassOf yangId:fiber-type ;
    prov:wasDerivedFrom "nwi-passive:G654?identity" .

nwiPassId:G655 a owl:Class,
