    rdfs:label "G655" ;
    rdfs:comment "ITU-T G.655 fiber." ;
    rdfs:subClassOf yangId:fiber-type ;
    prov:wasDerivedFrom "nwi-passive:G655?identity" .

nwiPassId:G656 a owl:Class,
