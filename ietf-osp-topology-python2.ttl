    rdfs:label "G656" ;
    rdfs:comment "ITU-T G.656 fiber." ;
    rdfs:subClassOf yangId:fiber-type ;
    prov:wasDerivedFrom "nwi-passive:G656?identity" .

nwiPassId:G657A1 a owl:Class,
