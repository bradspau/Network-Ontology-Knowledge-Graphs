ex:index a owl:DatatypeProperty ;
    rdfs:label "index" ;
    rdfs:comment """An index number used to identify the concatenation
order of the child cables.""" ;
    rdfs:domain cab:child-cable ;
    rdfs:range xsd:unsignedByte ;
    prov:wasDerivedFrom "nwi-passive:child-cable?list/nwi-passive:index?leaf" .

ex:is-fru a owl:DatatypeProperty ;
    rdfs:label "is-fru" ;
    ex:isStateData true ;
    rdfs:comment """This node indicates whether or not this component is
considered a 'field-replaceable unit' by the vendor.
If this node contains the value 'true', then this
component identifies a field-replaceable unit.
For all components that are permanently contained
within a field-replaceable unit, the value 'false'
should be returned for this node.""",
        """This node indicates whether or not this component is
considered a 'field-replaceable unit' by the vendor.  If
this node contains the value 'true', then this component
identifies a field-replaceable unit.  For all components
that are permanently contained within a field-replaceable
unit, the value 'false' should be returned for this
node.""" ;
    rdfs:domain hw:component,
        <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/network-elements/network-element/components/component> ;
    rdfs:range xsd:boolean ;
    prov:wasDerivedFrom "hw:hardware?container/hw:component?list/hw:is-fru?leaf",
        "nwi:is-fru?leaf" .

ex:is-main a owl:DatatypeProperty ;
    rdfs:label "is-main" ;
    rdfs:comment """This node indicates whether the chassis is taking or
not the 'main' role.

This node is applicable only to scenarios where
there are chassis components which can take the
'main' role (e.g., multi-chassis network elements),
otherwise it is omitted.""" ;
    rdfs:domain <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/network-elements/network-element/components/component> ;
    rdfs:range xsd:boolean ;
    prov:wasDerivedFrom "nwi:network-inventory?container/nwi:network-elements?container/nwi:network-element?list/nwi:components?container/nwi:component?list/nwi:is-main?leaf" .

ex:last-change a owl:DatatypeProperty ;
    rdfs:label "last-change" ;
    ex:isStateData true ;
    rdfs:comment """The time the '/hardware/component' list changed in the
operational state.""" ;
    rdfs:domain hwRoot:hardware ;
    rdfs:range xsd:dateTime ;
    prov:wasDerivedFrom "hw:hardware?container/hw:last-change?leaf" .

ex:latitude a owl:DatatypeProperty ;
    rdfs:label "latitude" ;
    ex:unit "decimal degrees" ;
    rdfs:comment """The latitude value on the astronomical body.  The
definition and precision of this measurement is
indicated by the reference-frame.""" ;
    rdfs:domain nwiLoc:geo-location ;
    rdfs:range xsd:decimal ;
    prov:wasDerivedFrom "geo:geo-location?container/geo:latitude?leaf" .

ex:length a owl:DatatypeProperty ;
    rdfs:label "length" ;
    ex:unit "meter" ;
    rdfs:comment "Length of the cable in meter." ;
    rdfs:domain nwi:cable,
        cab:child-cable ;
    rdfs:range xsd:unsignedInt ;
    prov:wasDerivedFrom "nwi-passive:length?leaf" .

ex:link-id a owl:DatatypeProperty ;
    rdfs:label "link-id" ;
    rdfs:comment """The identifier of a link in the topology.
A link is specific to a topology to which it belongs.""" ;
    rdfs:domain net:link ;
    rdfs:range xsd:anyURI ;
    prov:wasDerivedFrom "nt:link?list/nt:link-id?leaf" .

ex:link-ref a owl:ObjectProperty ;
    rdfs:label "link-ref" ;
    ex:xpathPath "/nw:networks/nw:network[nw:network-id=current()/../network-ref]/link/link-id" ;
    rdfs:comment """This leaf identifies a link that is a part
of this link's underlay.  Reference loops in which
a link identifies itself as its underlay, either
directly or transitively, are not allowed.""" ;
    rdfs:domain netLink:supporting-link ;
    rdfs:range net:link ;
    prov:wasDerivedFrom "nt:link?list/nt:supporting-link?list/nt:link-ref?leaf" .

ex:link-type a owl:DatatypeProperty ;
    rdfs:label "link-type" ;
    rdfs:comment """Classification of the link media type at the topology
layer. Example values include 'copper', 'fiber',
'microwave', or 'wifi'.""" ;
    rdfs:domain netLink:inventory-mapping-attributes ;
    rdfs:range xsd:string ;
    prov:wasDerivedFrom "nwit:inventory-mapping-attributes?container/nwit:link-type?leaf" .

ex:location a owl:ObjectProperty ;
    rdfs:label "location" ;
    ex:xpathPath "/nwi:network-inventory/nil:locations/nil:location/nil:id" ;
    rdfs:comment "The reference of the location." ;
    rdfs:domain nwiNE:locations ;
    rdfs:range nwiLocs:location ;
    prov:wasDerivedFrom "nil:locations?container/nil:location?leaf-list" .

ex:location-ref a owl:ObjectProperty ;
    rdfs:label "location-ref" ;
    ex:xpathPath "/nwi:network-inventory/nil:locations/nil:location/nil:id" ;
    rdfs:comment "Name of location where this rack is located.",
        "Referenced location for the passive device." ;
    rdfs:domain nwiRack:rack-location,
        nwi:passive-device ;
    rdfs:range nwiLocs:location ;
    prov:wasDerivedFrom "nwi:network-inventory?container/nil:locations?container/nil:racks?container/nil:rack?list/nil:rack-location?container/nil:location-ref?leaf",
        "nwi:network-inventory?container/nwi-passive:passive-device?list/nwi-passive:location-ref?leaf" .

ex:longitude a owl:DatatypeProperty ;
    rdfs:label "longitude" ;
    ex:unit "decimal degrees" ;
    rdfs:comment """The longitude value on the astronomical body.  The
definition and precision of this measurement is
indicated by the reference-frame.""" ;
    rdfs:domain nwiLoc:geo-location ;
    rdfs:range xsd:decimal ;
    prov:wasDerivedFrom "geo:geo-location?container/geo:longitude?leaf" .

ex:max-allocated-power a owl:DatatypeProperty ;
    rdfs:label "max-allocated-power" ;
    ex:unit "watts" ;
    rdfs:comment "The maximum allocated power to the rack." ;
    rdfs:domain nwiRacks:rack ;
    rdfs:range xsd:unsignedShort ;
    prov:wasDerivedFrom "nwi:network-inventory?container/nil:locations?container/nil:racks?container/nil:rack?list/nil:max-allocated-power?leaf" .

ex:max-voltage a owl:DatatypeProperty ;
    rdfs:label "max-voltage" ;
    ex:unit "volt" ;
    rdfs:comment "The maximum voltage could be supported by the rack." ;
    rdfs:domain nwiRacks:rack ;
    rdfs:range xsd:unsignedShort ;
    prov:wasDerivedFrom "nwi:network-inventory?container/nil:locations?container/nil:racks?container/nil:rack?list/nil:max-voltage?leaf" .

ex:mfg-date a owl:DatatypeProperty ;
    rdfs:label "mfg-date" ;
    ex:isStateData true ;
    rdfs:comment "The date of manufacturing of the component.",
        "The date of manufacturing of the managed component." ;
    rdfs:domain hw:component,
        <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/network-elements/network-element/components/component> ;
    rdfs:range xsd:dateTime ;
    prov:wasDerivedFrom "hw:hardware?container/hw:component?list/hw:mfg-date?leaf",
        "nwi:mfg-date?leaf" .

ex:mfg-name a owl:DatatypeProperty ;
    rdfs:label "mfg-name" ;
    ex:isStateData true ;
    rdfs:comment """The name of the manufacturer of this entity
(e.g., component).""",
        """The name of the manufacturer of this physical component.
The preferred value is the manufacturer name string
actually printed on the component itself (if present).

Note that comparisons between instances of the
'model-name', 'firmware-rev', 'software-rev', and
'serial-num' nodes are only meaningful amongst components
with the same value of 'mfg-name'.

If the manufacturer name string associated with the
physical component is unknown to the server, then this
node is not instantiated.""" ;
    rdfs:domain hw:component,
        nwiNEs:network-element,
        <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/network-elements/network-element/components/component> ;
    rdfs:range xsd:string ;
    prov:wasDerivedFrom "hw:hardware?container/hw:component?list/hw:mfg-name?leaf",
        "nwi:mfg-name?leaf" .

ex:model-name a owl:DatatypeProperty ;
    rdfs:label "model-name" ;
    ex:isStateData true ;
    rdfs:comment """The vendor-specific model name identifier string
associated with this physical component.  The preferred
value is the customer-visible part number, which may be
printed on the component itself.

If the model name string associated with the physical
component is unknown to the server, then this node is not
instantiated.""" ;
    rdfs:domain hw:component ;
    rdfs:range xsd:string ;
    prov:wasDerivedFrom "hw:hardware?container/hw:component?list/hw:model-name?leaf" .

ex:name a owl:DatatypeProperty ;
    rdfs:label "name" ;
    rdfs:comment """The name assigned to this component.

This name is not required to be the same as
entPhysicalName.""",
        """The name of the  entity (e.g., component), as specified by
a network operator, that provides a non-volatile 'handle'
for the entity and that can be modified anytime during the
entity lifetime.

If no value is discovered, the server MAY set the value of
this node to a locally unique value in the operational
state.""",
        "The vendor-specific name of the software module." ;
    rdfs:domain hw:component,
        nwi:cable,
        nwiLocs:location,
        nwiRacks:rack,
        nwiNEs:network-element,
        <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/network-elements/network-element/components/component>,
        nwiComp:software-rev,
        nwiNE:software-rev,
        nwi:passive-device,
        pdev:passive-port ;
    rdfs:range xsd:string ;
    prov:wasDerivedFrom "hw:hardware?container/hw:component?list/hw:name?leaf",
        "nwi:name?leaf",
        "nwi:software-rev?list/nwi:name?leaf" .

ex:ne-id a owl:DatatypeProperty ;
    rdfs:label "ne-id" ;
    rdfs:comment """An identifier that uniquely identifies the NE in
a network.""" ;
    rdfs:domain nwiNEs:network-element ;
    rdfs:range xsd:string ;
    prov:wasDerivedFrom "nwi:network-inventory?container/nwi:network-elements?container/nwi:network-element?list/nwi:ne-id?leaf" .

ex:ne-ref a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "ne-ref" ;
    ex:xpathPath "/nwi:network-inventory/nwi:network-elements/nwi:network-element/nwi:ne-id" ;
    rdfs:comment """Reference to the NE in the inventory that corresponds to
this topology node.

This reference establishes a 1:1 mapping between the
logical node and its physical NE.""",
        "Referenced Network Element (NE).",
        """The reference to the Network Element which contains the
port to be referenced.""",
        """The reference to the network element containing
the chassis component.""" ;
    rdfs:domain cab:a-end,
        cabChild:a-end,
        cabChild:z-end,
        cab:z-end,
        nwiRack:contained-chassis,
        netNode:inventory-mapping-attributes,
        netTP:inventory-mapping-attributes ;
    rdfs:range nwiNEs:network-element,
        xsd:string ;
    prov:wasDerivedFrom "nwi-passive:a-end?container/nwi-passive:ne-ref?leaf",
        "nwi-passive:z-end?container/nwi-passive:ne-ref?leaf",
        "nwi:network-inventory?container/nil:locations?container/nil:racks?container/nil:rack?list/nil:contained-chassis?list/nil:ne-ref?leaf",
        "nwit:inventory-mapping-attributes?container/nwi:ne-ref?leaf",
        "nwit:inventory-mapping-attributes?container/nwit:ne-ref?leaf" .

ex:ne-type a owl:ObjectProperty ;
    rdfs:label "ne-type" ;
    rdfs:comment "The network element type." ;
    rdfs:domain nwiNEs:network-element ;
    rdfs:range nwiInvId:ne-type ;
    prov:wasDerivedFrom "nwi:network-inventory?container/nwi:network-elements?container/nwi:network-element?list/nwi:ne-type?leaf" .

ex:network-id a owl:DatatypeProperty ;
    rdfs:label "network-id" ;
    rdfs:comment "Identifies a network." ;
    rdfs:domain netNetworks:network ;
    rdfs:range xsd:anyURI ;
    prov:wasDerivedFrom "nw:networks?container/nw:network?list/nw:network-id?leaf" .

ex:network-ref a owl:ObjectProperty ;
    rdfs:label "network-ref" ;
    ex:xpathPath "../../../nw:supporting-network/nw:network-ref",
        "../../../nw:supporting-node/nw:network-ref",
        "/nw:networks/nw:network/nw:network-id" ;
    rdfs:comment """References the underlay network of which the
underlay node is a part.""",
        "References the underlay network.",
        """This leaf identifies in which topology the
supporting termination point is present.""",
        """This leaf identifies in which underlay topology
the supporting link is present.""" ;
    rdfs:domain netLink:supporting-link,
        netNode:supporting-node,
        netTP:supporting-termination-point,
        net:supporting-network ;
    rdfs:range netNetworks:network,
        netNode:supporting-node,
        net:supporting-network ;
    prov:wasDerivedFrom "nt:link?list/nt:supporting-link?list/nt:network-ref?leaf",
        "nt:termination-point?list/nt:supporting-termination-point?list/nt:network-ref?leaf",
        "nw:networks?container/nw:network?list/nw:node?list/nw:supporting-node?list/nw:network-ref?leaf",
        "nw:networks?container/nw:network?list/nw:supporting-network?list/nw:network-ref?leaf" .

ex:node-id a owl:DatatypeProperty ;
    rdfs:label "node-id" ;
    rdfs:comment """Uniquely identifies a node within the containing
network.""" ;
    rdfs:domain net:node ;
    rdfs:range xsd:anyURI ;
    prov:wasDerivedFrom "nw:networks?container/nw:network?list/nw:node?list/nw:node-id?leaf" .

ex:node-ref a owl:ObjectProperty ;
    rdfs:label "node-ref" ;
    ex:xpathPath "../../../nw:supporting-node/nw:node-ref",
        "/nw:networks/nw:network/nw:node/nw:node-id" ;
    rdfs:comment "References the underlay node itself.",
        """This leaf identifies in which node the supporting
termination point is present.""" ;
    rdfs:domain netNode:supporting-node,
        netTP:supporting-termination-point ;
    rdfs:range net:node,
        netNode:supporting-node ;
    prov:wasDerivedFrom "nt:termination-point?list/nt:supporting-termination-point?list/nt:node-ref?leaf",
        "nw:networks?container/nw:network?list/nw:node?list/nw:supporting-node?list/nw:node-ref?leaf" .

hwNotif:hardware-state-change a owl:Class ;
    rdfs:label "hardware-state-change" .

hwNotif:hardware-state-oper-disabled a owl:Class ;
    rdfs:label "hardware-state-oper-disabled" .

hwNotif:hardware-state-oper-enabled a owl:Class ;
    rdfs:label "hardware-state-oper-enabled" .

ex:object-id a owl:DatatypeProperty ;
    rdfs:label "object-id" ;
    rdfs:comment """An identifier that uniquely identifies the energy object
in a device.""" ;
    rdfs:domain pae:power-entry ;
    rdfs:range xsd:string ;
    prov:wasDerivedFrom "eo:energy-objects?container/eo:power-entry?list/eo:object-id?leaf" .

ex:oper-state a owl:ObjectProperty ;
    rdfs:label "oper-state" ;
    ex:isStateData true ;
    rdfs:comment """The operational state for this component.

Note that this node does not follow the administrative
state.  An administrative state of 'down' does not
predict an operational state of 'disabled'.

Note that some implementations may not be able to
accurately report oper-state while the admin-state node
has a value other than 'unlocked'.  In these cases, this
node MUST have a value of 'unknown'.""" ;
    rdfs:domain hwComp:state ;
    rdfs:range hwTypes:oper-state ;
    prov:wasDerivedFrom "hw:hardware?container/hw:component?list/hw:state?container/hw:oper-state?leaf" .

ex:oper-status a owl:ObjectProperty ;
    rdfs:label "oper-status" ;
    rdfs:comment "The operational status of the sensor." ;
    rdfs:domain hwComp:sensor-data ;
    rdfs:range hwTypes:sensor-status ;
    prov:wasDerivedFrom "hw:hardware?container/hw:component?list/hw:sensor-data?container/hw:oper-status?leaf" .

ex:parent a owl:ObjectProperty ;
    rdfs:label "parent" ;
    ex:xpathPath "../../component/component-id",
        "../../component/name",
        "../../location/id" ;
    rdfs:comment """The identifiers of all the components that
physically contain this component.

If this list is empty, this component is not
contained in any other component but it is contained
in the network-element.""",
        """The name of the component that physically contains this
component.

If this leaf is not instantiated, it indicates that this
component is not contained in any other component.

In the event that a physical component is contained by
more than one physical component (e.g., double-wide
modules), this node contains the name of one of these
components.  An implementation MUST use the same name
every time this node is instantiated.""",
        """The name of the location that physically contains this
location.""" ;
    rdfs:domain hw:component,
        nwiLocs:location,
        <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/network-elements/network-element/components/component> ;
    rdfs:range hw:component,
        nwiLocs:location,
        <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/network-elements/network-element/components/component> ;
    prov:wasDerivedFrom "hw:hardware?container/hw:component?list/hw:parent?leaf",
        "nwi:network-inventory?container/nil:locations?container/nil:location?list/nil:parent?leaf",
        "nwi:network-inventory?container/nwi:network-elements?container/nwi:network-element?list/nwi:components?container/nwi:component?list/nwi:parent?leaf-list" .

ex:parent-rel-pos a owl:DatatypeProperty ;
    rdfs:label "parent-rel-pos" ;
    rdfs:comment """An indication of the relative position of this child
component among all its sibling components.  Sibling
components are defined as components that:

  o share the same value of the 'parent' node and

  o share a common base identity for the 'class' node.

Note that the last rule gives implementations flexibility
in how components are numbered.  For example, some
implementations might have a single number series for all
components derived from 'ianahw:port', while some others
might have different number series for different
components with identities derived from 'ianahw:port' (for
example, one for registered jack 45 (RJ45) and one for
small form-factor pluggable (SFP)).""",
        """The relative position with respect to the parent
component among all the sibling components.""" ;
    rdfs:domain hw:component,
        <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/network-elements/network-element/components/component> ;
    rdfs:range xsd:int ;
    prov:wasDerivedFrom "hw:hardware?container/hw:component?list/hw:parent-rel-pos?leaf",
        "nwi:network-inventory?container/nwi:network-elements?container/nwi:network-element?list/nwi:components?container/nwi:component?list/nwi:parent-rel-pos?leaf" .

ex:part-number a owl:DatatypeProperty ;
    rdfs:label "part-number" ;
    rdfs:comment """The vendor-specific part number of the component
type. It is expected that vendors assign unique part
numbers to different component types within the
scope of the vendor.""" ;
    rdfs:domain <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/network-elements/network-element/components/component> ;
    rdfs:range xsd:string ;
    prov:wasDerivedFrom "nwi:part-number?leaf" .

ex:physical-index a owl:DatatypeProperty ;
    rdfs:label "physical-index" ;
    ex:isStateData true ;
    rdfs:comment """The entPhysicalIndex for the entPhysicalEntry represented
by this list entry.""" ;
    rdfs:domain hw:component ;
    rdfs:range xsd:int ;
    prov:wasDerivedFrom "hw:hardware?container/hw:component?list/hw:physical-index?leaf" .

ex:port-ref a owl:ObjectProperty ;
    rdfs:label "port-ref" ;
    ex:xpathPath "/nwi:network-inventory/nwi:network-elements/nwi:network-element[nwi:ne-id=current()/../ne-ref]/nwi:components/nwi:component/nwi:component-id" ;
    rdfs:comment "The reference to the port component." ;
    rdfs:domain netTP:inventory-mapping-attributes ;
    rdfs:range <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/network-elements/network-element/components/component> ;
    prov:wasDerivedFrom "nwit:inventory-mapping-attributes?container/nwi:port-ref?leaf" .

ex:port-type a owl:ObjectProperty ;
    rdfs:label "port-type" ;
    rdfs:comment "Type of passive port." ;
    rdfs:domain pdev:passive-port ;
    rdfs:range nwiPassId:passive-port-type ;
    prov:wasDerivedFrom "nwi-passive:passive-port?list/nwi-passive:port-type?leaf" .

ex:postal-code a owl:DatatypeProperty ;
    rdfs:label "postal-code" ;
    rdfs:comment "Specifies a postal code." ;
    rdfs:domain nwiLoc:physical-address ;
    rdfs:range xsd:string ;
    prov:wasDerivedFrom "nil:physical-address?container/nil:postal-code?leaf" .

ex:product-name a owl:DatatypeProperty ;
    rdfs:label "product-name" ;
    rdfs:comment """The vendor-specific and human-interpretable string
describing the entity (e.g., component) type. It is expected
that vendors assign unique product names to different entity
(e.g., component) types within the scope of the vendor.""" ;
    rdfs:domain nwiNEs:network-element,
        <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/network-elements/network-element/components/component> ;
    rdfs:range xsd:string ;
    prov:wasDerivedFrom "nwi:product-name?leaf" .

ex:product-rev a owl:DatatypeProperty ;
    rdfs:label "product-rev" ;
    rdfs:comment """The vendor-specific product revision string for the
network-element.""" ;
    rdfs:domain nwiNEs:network-element ;
    rdfs:range xsd:string ;
    prov:wasDerivedFrom "nwi:network-inventory?container/nwi:network-elements?container/nwi:network-element?list/nwi:product-rev?leaf" .

ex:rack a owl:ObjectProperty ;
    rdfs:label "rack" ;
    ex:xpathPath "/nwi:network-inventory/nil:locations/nil:racks/nil:rack/nil:id" ;
    rdfs:comment "The reference to the rack." ;
    rdfs:domain nwiNE:locations ;
    rdfs:range nwiRacks:rack ;
    prov:wasDerivedFrom "nil:locations?container/nil:rack?leaf" .

ex:relative-position a owl:DatatypeProperty ;
    rdfs:label "relative-position" ;
    rdfs:comment """A relative position of chassis within
the rack""" ;
    rdfs:domain nwiRack:contained-chassis ;
    rdfs:range xsd:unsignedByte ;
    prov:wasDerivedFrom "nwi:network-inventory?container/nil:locations?container/nil:racks?container/nil:rack?list/nil:contained-chassis?list/nil:relative-position?leaf" .

ex:revision a owl:DatatypeProperty ;
    rdfs:label "revision" ;
    rdfs:comment """The vendor-specific revision string of the software
module when not implicitly defined as part of the name of
the software module.""",
        """The vendor-specific revision string of the software
patch when not implicitly defined as part of the name or
revision of the software module.""" ;
    rdfs:domain nwiComp:software-rev,
        nwiCompSwRev:patch,
        nwiNE:software-rev,
        nwiSwRev:patch ;
    rdfs:range xsd:string ;
    prov:wasDerivedFrom "nwi:software-rev?list/nwi:patch?list/nwi:revision?leaf",
        "nwi:software-rev?list/nwi:revision?leaf" .

ex:row-number a owl:DatatypeProperty ;
    rdfs:label "row-number" ;
    rdfs:comment """Identifies the row within the equipment room where
the rack is located.""" ;
    rdfs:domain nwiRack:rack-location ;
    rdfs:range xsd:unsignedInt ;
    prov:wasDerivedFrom "nwi:network-inventory?container/nil:locations?container/nil:racks?container/nil:rack?list/nil:rack-location?container/nil:row-number?leaf" .

ex:serial-num a owl:DatatypeProperty ;
    rdfs:label "serial-num" ;
    ex:isStateData true ;
    rdfs:comment """The vendor-specific serial number string for the
component.  The preferred value is the serial number
string actually printed on the component itself (if
present).""" ;
    rdfs:domain hw:component ;
    rdfs:range xsd:string ;
    prov:wasDerivedFrom "hw:hardware?container/hw:component?list/hw:serial-num?leaf" .

ex:serial-number a owl:DatatypeProperty ;
    rdfs:label "serial-number" ;
    rdfs:comment """The vendor-specific serial number of the component instance.

It is expected that vendors assign unique serial numbers to
different component instances within the scope of the
'part-number'.""" ;
    rdfs:domain <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/network-elements/network-element/components/component> ;
    rdfs:range xsd:string ;
    prov:wasDerivedFrom "nwi:serial-number?leaf" .

ex:software-rev a owl:DatatypeProperty ;
    rdfs:label "software-rev" ;
    ex:isStateData true ;
    rdfs:comment """The vendor-specific software revision string for the
component.""" ;
    rdfs:domain hw:component ;
    rdfs:range xsd:string ;
    prov:wasDerivedFrom "hw:hardware?container/hw:component?list/hw:software-rev?leaf" .

ex:source-component-id a owl:ObjectProperty ;
    rdfs:label "source-component-id" ;
    ex:isStateData true ;
    ex:xpathPath "/hw:hardware/hw:component/hw:name" ;
    rdfs:comment """Reference to the component name in the ietf-hardware
model. This leaf creates a direct semantic link between the
power attributes and the physical component they describe.
""" ;
    rdfs:domain pae:power-entry ;
    rdfs:range hw:component ;
    prov:wasDerivedFrom "eo:energy-objects?container/eo:power-entry?list/eo:source-component-id?leaf" .

ex:source-node a owl:ObjectProperty ;
    rdfs:label "source-node" ;
    ex:xpathPath "../../../nw:node/nw:node-id" ;
    rdfs:comment "Source node identifier.  Must be in the same topology." ;
    rdfs:domain netLink:source ;
    rdfs:range net:node ;
    prov:wasDerivedFrom "nt:link?list/nt:source?container/nt:source-node?leaf" .

ex:source-tp a owl:ObjectProperty ;
    rdfs:label "source-tp" ;
    ex:xpathPath "../../../nw:node[nw:node-id=current()/../source-node]/termination-point/tp-id" ;
    rdfs:comment """This termination point is located within the source node
and terminates the link.""" ;
    rdfs:domain netLink:source ;
    rdfs:range netNode:termination-point ;
    prov:wasDerivedFrom "nt:link?list/nt:source?container/nt:source-tp?leaf" .

ex:standby-state a owl:ObjectProperty ;
    rdfs:label "standby-state" ;
    ex:isStateData true ;
    rdfs:comment """The standby state for this component.

Some components will exhibit only a subset of the
remaining standby state values.  If this component
cannot operate in a standby role, the value of this node
will always be 'providing-service'.""" ;
    rdfs:domain hwComp:state ;
    rdfs:range hwTypes:standby-state ;
    prov:wasDerivedFrom "hw:hardware?container/hw:component?list/hw:state?container/hw:standby-state?leaf" .

ex:state a owl:DatatypeProperty ;
    rdfs:label "state" ;
    rdfs:comment """Specifies a state. This leaf can also be
used to describe a region for a country that
does not have states.""" ;
    rdfs:domain nwiLoc:physical-address ;
    rdfs:range xsd:string ;
    prov:wasDerivedFrom "nil:physical-address?container/nil:state?leaf" .

ex:state-last-changed a owl:DatatypeProperty ;
    rdfs:label "state-last-changed" ;
    ex:isStateData true ;
    rdfs:comment """The date and time when the value of any of the
admin-state, oper-state, usage-state, alarm-state, or
standby-state changed for this component.

If there has been no change since the last
re-initialization of the local system, this node
contains the date and time of local system
initialization.  If there has been no change since the
component was added to the local system, this node
contains the date and time of the insertion.""" ;
    rdfs:domain hwComp:state ;
    rdfs:range xsd:dateTime ;
    prov:wasDerivedFrom "hw:hardware?container/hw:component?list/hw:state?container/hw:state-last-changed?leaf" .

ex:timestamp a owl:DatatypeProperty ;
    rdfs:label "timestamp" ;
    rdfs:comment "Reference time when location was recorded." ;
    rdfs:domain nwiLocs:location,
        nwiLoc:geo-location,
        nwiRacks:rack ;
    rdfs:range xsd:dateTime ;
    prov:wasDerivedFrom "geo:geo-location?container/geo:timestamp?leaf",
        "nwi:network-inventory?container/nil:locations?container/nil:location?list/nil:timestamp?leaf",
        "nwi:network-inventory?container/nil:locations?container/nil:racks?container/nil:rack?list/nil:timestamp?leaf" .

ex:tp-id a owl:DatatypeProperty ;
    rdfs:label "tp-id" ;
    rdfs:comment "Termination point identifier." ;
    rdfs:domain netNode:termination-point ;
    rdfs:range xsd:anyURI ;
    prov:wasDerivedFrom "nt:termination-point?list/nt:tp-id?leaf" .

ex:tp-ref a owl:ObjectProperty ;
    rdfs:label "tp-ref" ;
    ex:xpathPath "/nw:networks/nw:network[nw:network-id=current()/../network-ref]/nw:node[nw:node-id=current()/../node-ref]/termination-point/tp-id" ;
    rdfs:comment """Reference to the underlay node (the underlay node must
be in a different topology).""" ;
    rdfs:domain netTP:supporting-termination-point ;
    rdfs:range netNode:termination-point ;
    prov:wasDerivedFrom "nt:termination-point?list/nt:supporting-termination-point?list/nt:tp-ref?leaf" .

ex:type a owl:DatatypeProperty ;
    rdfs:label "type" ;
    rdfs:comment """The type of network inventory location, e.g.
equipment room, building, or site.

This allows operators to flexibly define custom location
types (e.g., 'pole', 'roof', 'floor') based on their
specific network scenarios without requiring model
extensions. String-based types enable dynamic adaptation
to heterogeneous organizational naming conventions.""" ;
    rdfs:domain nwiLocs:location ;
    rdfs:range xsd:string ;
    prov:wasDerivedFrom "nwi:network-inventory?container/nil:locations?container/nil:location?list/nil:type?leaf" .

hwAdminSt:locked a hwTypes:admin-state,
        owl:NamedIndividual ;
    rdfs:label "locked" ;
    rdfs:comment "The resource is administratively prohibited from use." .

hwAdminSt:shutting-down a hwTypes:admin-state,
        owl:NamedIndividual ;
    rdfs:label "shutting-down" ;
    rdfs:comment """The resource usage is administratively limited to current
instances of use.""" .

hwAdminSt:unknown a hwTypes:admin-state,
        owl:NamedIndividual ;
    rdfs:label "unknown" ;
    rdfs:comment "The resource is unable to report administrative state." .

hwAdminSt:unlocked a hwTypes:admin-state,
        owl:NamedIndividual ;
    rdfs:label "unlocked" ;
    rdfs:comment """The resource is not administratively prohibited from
use.""" .

hwOperSt:disabled a hwTypes:oper-state,
        owl:NamedIndividual ;
    rdfs:label "disabled" ;
    rdfs:comment "The resource is totally inoperable." .

hwOperSt:enabled a hwTypes:oper-state,
        owl:NamedIndividual ;
    rdfs:label "enabled" ;
    rdfs:comment "The resource is partially or fully operable." .

hwOperSt:testing a hwTypes:oper-state,
        owl:NamedIndividual ;
    rdfs:label "testing" ;
    rdfs:comment """The resource is currently being tested and cannot
therefore report whether or not it is operational.""" .

hwOperSt:unknown a hwTypes:oper-state,
        owl:NamedIndividual ;
    rdfs:label "unknown" ;
    rdfs:comment "The resource is unable to report its operational state." .

hwSensorSt:nonoperational a hwTypes:sensor-status,
        owl:NamedIndividual ;
    rdfs:label "nonoperational" ;
    rdfs:comment """Indicates that the server believes the sensor is broken.
The sensor could have a hard failure (disconnected wire)
or a soft failure such as out-of-range, jittery, or wildly
fluctuating readings.""" .

hwSensorSt:ok a hwTypes:sensor-status,
        owl:NamedIndividual ;
    rdfs:label "ok" ;
    rdfs:comment "Indicates that the server can obtain the sensor value." .

hwSensorSt:unavailable a hwTypes:sensor-status,
        owl:NamedIndividual ;
    rdfs:label "unavailable" ;
    rdfs:comment """Indicates that the server presently cannot obtain the
sensor value.""" .

hwSensorVSc:atto a hwTypes:sensor-value-scale,
        owl:NamedIndividual ;
    rdfs:label "atto" ;
    rdfs:comment "Data scaling factor of 10^-18." .

hwSensorVSc:exa a hwTypes:sensor-value-scale,
        owl:NamedIndividual ;
    rdfs:label "exa" ;
    rdfs:comment "Data scaling factor of 10^18." .

hwSensorVSc:femto a hwTypes:sensor-value-scale,
        owl:NamedIndividual ;
    rdfs:label "femto" ;
    rdfs:comment "Data scaling factor of 10^-15." .

hwSensorVSc:giga a hwTypes:sensor-value-scale,
        owl:NamedIndividual ;
    rdfs:label "giga" ;
    rdfs:comment "Data scaling factor of 10^9." .

hwSensorVSc:kilo a hwTypes:sensor-value-scale,
        owl:NamedIndividual ;
    rdfs:label "kilo" ;
    rdfs:comment "Data scaling factor of 10^3." .

hwSensorVSc:mega a hwTypes:sensor-value-scale,
        owl:NamedIndividual ;
    rdfs:label "mega" ;
    rdfs:comment "Data scaling factor of 10^6." .

hwSensorVSc:micro a hwTypes:sensor-value-scale,
        owl:NamedIndividual ;
    rdfs:label "micro" ;
    rdfs:comment "Data scaling factor of 10^-6." .

hwSensorVSc:milli a hwTypes:sensor-value-scale,
        owl:NamedIndividual ;
    rdfs:label "milli" ;
    rdfs:comment "Data scaling factor of 10^-3." .

hwSensorVSc:nano a hwTypes:sensor-value-scale,
        owl:NamedIndividual ;
    rdfs:label "nano" ;
    rdfs:comment "Data scaling factor of 10^-9." .

hwSensorVSc:peta a hwTypes:sensor-value-scale,
        owl:NamedIndividual ;
    rdfs:label "peta" ;
    rdfs:comment "Data scaling factor of 10^15." .

hwSensorVSc:pico a hwTypes:sensor-value-scale,
        owl:NamedIndividual ;
    rdfs:label "pico" ;
    rdfs:comment "Data scaling factor of 10^-12." .

hwSensorVSc:tera a hwTypes:sensor-value-scale,
        owl:NamedIndividual ;
    rdfs:label "tera" ;
    rdfs:comment "Data scaling factor of 10^12." .

hwSensorVSc:units a hwTypes:sensor-value-scale,
        owl:NamedIndividual ;
    rdfs:label "units" ;
    rdfs:comment "Data scaling factor of 10^0." .

hwSensorVSc:yocto a hwTypes:sensor-value-scale,
        owl:NamedIndividual ;
    rdfs:label "yocto" ;
    rdfs:comment "Data scaling factor of 10^-24." .

hwSensorVSc:yotta a hwTypes:sensor-value-scale,
        owl:NamedIndividual ;
    rdfs:label "yotta" ;
    rdfs:comment "Data scaling factor of 10^24." .

hwSensorVSc:zepto a hwTypes:sensor-value-scale,
        owl:NamedIndividual ;
    rdfs:label "zepto" ;
    rdfs:comment "Data scaling factor of 10^-21." .

hwSensorVSc:zetta a hwTypes:sensor-value-scale,
        owl:NamedIndividual ;
    rdfs:label "zetta" ;
    rdfs:comment "Data scaling factor of 10^21." .

hwSensorVTy:amperes a hwTypes:sensor-value-type,
        owl:NamedIndividual ;
    rdfs:label "amperes" ;
    rdfs:comment "A measure of electric current." .

hwSensorVTy:celsius a hwTypes:sensor-value-type,
        owl:NamedIndividual ;
    rdfs:label "celsius" ;
    rdfs:comment "A measure of temperature." .

hwSensorVTy:cmm a hwTypes:sensor-value-type,
        owl:NamedIndividual ;
    rdfs:label "cmm" ;
    rdfs:comment "A measure of cubic meters per minute (airflow)." .

hwSensorVTy:hertz a hwTypes:sensor-value-type,
        owl:NamedIndividual ;
    rdfs:label "hertz" ;
    rdfs:comment "A measure of frequency." .

hwSensorVTy:other a hwTypes:sensor-value-type,
        owl:NamedIndividual ;
    rdfs:label "other" ;
    rdfs:comment "A measure other than those listed below." .

hwSensorVTy:percent-RH a hwTypes:sensor-value-type,
        owl:NamedIndividual ;
    rdfs:label "percent-RH" ;
    rdfs:comment "A measure of percent relative humidity." .

hwSensorVTy:rpm a hwTypes:sensor-value-type,
        owl:NamedIndividual ;
    rdfs:label "rpm" ;
    rdfs:comment "A measure of shaft revolutions per minute." .

hwSensorVTy:truth-value a hwTypes:sensor-value-type,
        owl:NamedIndividual ;
    rdfs:label "truth-value" ;
    rdfs:comment "Value is one of 1 (true) or 2 (false)" .

hwSensorVTy:unknown a hwTypes:sensor-value-type,
        owl:NamedIndividual ;
    rdfs:label "unknown" ;
    rdfs:comment "An unknown measurement or arbitrary, relative numbers" .

hwSensorVTy:volts-AC a hwTypes:sensor-value-type,
        owl:NamedIndividual ;
    rdfs:label "volts-AC" ;
    rdfs:comment "A measure of electric potential (alternating current)." .

hwSensorVTy:volts-DC a hwTypes:sensor-value-type,
        owl:NamedIndividual ;
    rdfs:label "volts-DC" ;
    rdfs:comment "A measure of electric potential (direct current)." .

hwSensorVTy:watts a hwTypes:sensor-value-type,
        owl:NamedIndividual ;
    rdfs:label "watts" ;
    rdfs:comment "A measure of power." .

hwUsageSt:cold-standby a hwTypes:standby-state,
        owl:NamedIndividual ;
    rdfs:label "cold-standby" ;
    rdfs:comment """The resource is to back up another resource, but it will
not be immediately able to take over the role of a
resource to be backed up and will require some
initialization activity.""" .

hwUsageSt:hot-standby a hwTypes:standby-state,
        owl:NamedIndividual ;
    rdfs:label "hot-standby" ;
    rdfs:comment """The resource is not providing service, but it will be
immediately able to take over the role of the resource to
be backed up, without the need for initialization
activity, and will contain the same information as the
resource to be backed up.""" .

hwUsageSt:providing-service a hwTypes:standby-state,
        owl:NamedIndividual ;
    rdfs:label "providing-service" ;
    rdfs:comment "The resource is providing service." .

hwUsageSt:unknown a hwTypes:standby-state,
        owl:NamedIndividual ;
    rdfs:label "unknown" ;
    rdfs:comment "The resource is unable to report standby state." .

<http://www.huawei.com/ontology/types/ietf-hardware/usage-state/active> a hwTypes:usage-state,
        owl:NamedIndividual ;
    rdfs:label "active" ;
    rdfs:comment """The resource is currently in use, and it has sufficient
spare capacity to provide for additional users.""" .

<http://www.huawei.com/ontology/types/ietf-hardware/usage-state/busy> a hwTypes:usage-state,
        owl:NamedIndividual ;
    rdfs:label "busy" ;
    rdfs:comment """The resource is currently in use, but it currently has no
spare capacity to provide for additional users.""" .

<http://www.huawei.com/ontology/types/ietf-hardware/usage-state/idle> a hwTypes:usage-state,
        owl:NamedIndividual ;
    rdfs:label "idle" ;
    rdfs:comment "The resource is servicing no users." .

<http://www.huawei.com/ontology/types/ietf-hardware/usage-state/unknown> a hwTypes:usage-state,
        owl:NamedIndividual ;
    rdfs:label "unknown" ;
    rdfs:comment "The resource is unable to report usage state." .

inetIpVer:ipv4 a inetTypes:ip-version,
        owl:NamedIndividual ;
    rdfs:label "ipv4" ;
    rdfs:comment "The IPv4 protocol as defined in RFC 791." .

inetIpVer:ipv6 a inetTypes:ip-version,
        owl:NamedIndividual ;
    rdfs:label "ipv6" ;
    rdfs:comment "The IPv6 protocol as defined in RFC 2460." .

inetIpVer:unknown a inetTypes:ip-version,
        owl:NamedIndividual ;
    rdfs:label "unknown" ;
    rdfs:comment """An unknown or unspecified version of the Internet
protocol.""" .

ex:units-display a owl:DatatypeProperty ;
    rdfs:label "units-display" ;
    rdfs:comment """A textual description of the data units that should be
used in the display of the sensor value.""" ;
    rdfs:domain hwComp:sensor-data ;
    rdfs:range xsd:string ;
    prov:wasDerivedFrom "hw:hardware?container/hw:component?list/hw:sensor-data?container/hw:units-display?leaf" .

ex:uri a owl:DatatypeProperty ;
    rdfs:label "uri" ;
    rdfs:comment """This node contains identification information about
the component.""",
        """This node contains identification information about the
component.""" ;
    rdfs:domain hw:component,
        <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/network-elements/network-element/components/component> ;
    rdfs:range xsd:anyURI ;
    prov:wasDerivedFrom "hw:hardware?container/hw:component?list/hw:uri?leaf-list",
        "nwi:uri?leaf-list" .

ex:usage-state a owl:ObjectProperty ;
    rdfs:label "usage-state" ;
    ex:isStateData true ;
    rdfs:comment """The usage state for this component.

This node refers to a component's ability to service
more components in a containment hierarchy.

Some components will exhibit only a subset of the usage
state values.  Components that are unable to ever
service any components within a containment hierarchy
will always have a usage state of 'busy'.  In some
cases, a component will be able to support only one
other component within its containment hierarchy and
will therefore only exhibit values of 'idle' and
'busy'.""" ;
    rdfs:domain hwComp:state ;
    rdfs:range hwTypes:usage-state ;
    prov:wasDerivedFrom "hw:hardware?container/hw:component?list/hw:state?container/hw:usage-state?leaf" .

ex:uuid a owl:DatatypeProperty ;
    rdfs:label "uuid" ;
    ex:isStateData true ;
    rdfs:comment "A Universally Unique Identifier of the component.",
        """The Universally Unique Identifier of the entity
(e.g., component).""" ;
    rdfs:domain hw:component,
        nwi:cable,
        nwiLocs:location,
        nwiRacks:rack,
        nwiNEs:network-element,
        <http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/network-elements/network-element/components/component>,
        nwi:passive-device,
        pdev:passive-port ;
    rdfs:range xsd:string ;
    prov:wasDerivedFrom "hw:hardware?container/hw:component?list/hw:uuid?leaf",
        "nwi:uuid?leaf" .

ex:v-east a owl:DatatypeProperty ;
    rdfs:label "v-east" ;
    ex:unit "meters per second" ;
    rdfs:comment """v-east is the rate of change (i.e., speed) perpendicular
to the right of true north as defined by
the geodetic-system.""" ;
    rdfs:domain nwiGeo:velocity ;
    rdfs:range xsd:decimal ;
    prov:wasDerivedFrom "geo:geo-location?container/geo:velocity?container/geo:v-east?leaf" .

ex:v-north a owl:DatatypeProperty ;
    rdfs:label "v-north" ;
    ex:unit "meters per second" ;
    rdfs:comment """v-north is the rate of change (i.e., speed) towards
true north as defined by the geodetic-system.""" ;
    rdfs:domain nwiGeo:velocity ;
    rdfs:range xsd:decimal ;
    prov:wasDerivedFrom "geo:geo-location?container/geo:velocity?container/geo:v-north?leaf" .

ex:v-up a owl:DatatypeProperty ;
    rdfs:label "v-up" ;
    ex:unit "meters per second" ;
    rdfs:comment """v-up is the rate of change (i.e., speed) away from the
center of mass.""" ;
    rdfs:domain nwiGeo:velocity ;
    rdfs:range xsd:decimal ;
    prov:wasDerivedFrom "geo:geo-location?container/geo:velocity?container/geo:v-up?leaf" .

ex:valid-until a owl:DatatypeProperty ;
    rdfs:label "valid-until" ;
    rdfs:comment """The timestamp for which this geo-location is valid until.
If unspecified, the geo-location has no specific
expiration time.""",
        """The timestamp for which this location is valid until.
If unspecified, the location has no specific
expiration time.""" ;
    rdfs:domain nwiLocs:location,
        nwiLoc:geo-location,
        nwiRacks:rack ;
    rdfs:range xsd:dateTime ;
    prov:wasDerivedFrom "geo:geo-location?container/geo:valid-until?leaf",
        "nwi:network-inventory?container/nil:locations?container/nil:location?list/nil:valid-until?leaf",
        "nwi:network-inventory?container/nil:locations?container/nil:racks?container/nil:rack?list/nil:valid-until?leaf" .

ex:value a owl:DatatypeProperty ;
    rdfs:label "value" ;
    rdfs:comment """The most recent measurement obtained by the server
for this sensor.

A client that periodically fetches this node should also
fetch the nodes 'value-type', 'value-scale', and
'value-precision', since they may change when the value
is changed.""" ;
    rdfs:domain hwComp:sensor-data ;
    rdfs:range xsd:int ;
    prov:wasDerivedFrom "hw:hardware?container/hw:component?list/hw:sensor-data?container/hw:value?leaf" .

ex:value-precision a owl:DatatypeProperty ;
    rdfs:label "value-precision" ;
    rdfs:comment """The number of decimal places of precision
associated with the sensor value""" ;
    rdfs:domain hwComp:sensor-data ;
    rdfs:range xsd:byte ;
    prov:wasDerivedFrom "hw:hardware?container/hw:component?list/hw:sensor-data?container/hw:value-precision?leaf" .

ex:value-scale a owl:ObjectProperty ;
    rdfs:label "value-scale" ;
    rdfs:comment """The (power of 10) scaling factor associated
with the sensor value""" ;
    rdfs:domain hwComp:sensor-data ;
    rdfs:range hwTypes:sensor-value-scale ;
    prov:wasDerivedFrom "hw:hardware?container/hw:component?list/hw:sensor-data?container/hw:value-scale?leaf" .

ex:value-timestamp a owl:DatatypeProperty ;
    rdfs:label "value-timestamp" ;
    rdfs:comment """The time the status and/or value of this sensor was last
obtained by the server.""" ;
    rdfs:domain hwComp:sensor-data ;
    rdfs:range xsd:dateTime ;
    prov:wasDerivedFrom "hw:hardware?container/hw:component?list/hw:sensor-data?container/hw:value-timestamp?leaf" .

ex:value-type a owl:ObjectProperty ;
    rdfs:label "value-type" ;
    rdfs:comment """The type of data units associated with the
sensor value""" ;
    rdfs:domain hwComp:sensor-data ;
    rdfs:range hwTypes:sensor-value-type ;
    prov:wasDerivedFrom "hw:hardware?container/hw:component?list/hw:sensor-data?container/hw:value-type?leaf" .

ex:value-update-rate a owl:DatatypeProperty ;
    rdfs:label "value-update-rate" ;
    ex:unit "milliseconds" ;
    rdfs:comment """An indication of the frequency that the server updates
the associated 'value' node, represented in
milliseconds.  The value zero indicates:

 - the sensor value is updated on demand (e.g.,
   when polled by the server for a get-request),

 - the sensor value is updated when the sensor
   value changes (event-driven), or

 - the server does not know the update rate.""" ;
    rdfs:domain hwComp:sensor-data ;
    rdfs:range xsd:unsignedInt ;
    prov:wasDerivedFrom "hw:hardware?container/hw:component?list/hw:sensor-data?container/hw:value-update-rate?leaf" .

ex:width a owl:DatatypeProperty ;
    rdfs:label "width" ;
    ex:unit "millimeter" ;
    rdfs:comment "Rack width." ;
    rdfs:domain nwiRacks:rack ;
    rdfs:range xsd:unsignedShort ;
    prov:wasDerivedFrom "nwi:network-inventory?container/nil:locations?container/nil:racks?container/nil:rack?list/nil:width?leaf" .

ex:x a owl:DatatypeProperty ;
    rdfs:label "x" ;
    ex:unit "meters" ;
    rdfs:comment "The X value as defined by the reference-frame." ;
    rdfs:domain nwiLoc:geo-location ;
    rdfs:range xsd:decimal ;
    prov:wasDerivedFrom "geo:geo-location?container/geo:x?leaf" .

ex:y a owl:DatatypeProperty ;
    rdfs:label "y" ;
    ex:unit "meters" ;
    rdfs:comment "The Y value as defined by the reference-frame." ;
    rdfs:domain nwiLoc:geo-location ;
    rdfs:range xsd:decimal ;
    prov:wasDerivedFrom "geo:geo-location?container/geo:y?leaf" .

ex:z a owl:DatatypeProperty ;
    rdfs:label "z" ;
    ex:unit "meters" ;
    rdfs:comment "The Z value as defined by the reference-frame." ;
    rdfs:domain nwiLoc:geo-location ;
    rdfs:range xsd:decimal ;
    prov:wasDerivedFrom "geo:geo-location?container/geo:z?leaf" .

grpGeo:geo-location a owl:Class ;
    rdfs:label "geo-location" ;
    rdfs:comment "Grouping definition: geo-location",
        "Grouping to identify a location on an astronomical object." .

grpNwiTop:link-inventory-mapping-attributes a owl:Class ;
    rdfs:label "link-inventory-mapping-attributes" ;
    rdfs:comment """Attributes for classifying link media type.
Detailed inventory reference is intentionally omitted from
this model; implementations should use the appropriate
specialized inventory modules based on the indicated
link-type.""",
        "Grouping definition: link-inventory-mapping-attributes" .

grpNwiTop:node-inventory-mapping-attributes a owl:Class ;
    rdfs:label "node-inventory-mapping-attributes" ;
    rdfs:comment """Attributes for mapping a topology node to a Network Element
(NE) in the physical inventory.""",
        "Grouping definition: node-inventory-mapping-attributes" .

grpNwiTop:tp-inventory-mapping-attributes a owl:Class ;
    rdfs:label "tp-inventory-mapping-attributes" ;
    rdfs:comment """Attributes for mapping a topology termination point (TP)
to a physical port in the network inventory.""",
        "Grouping definition: tp-inventory-mapping-attributes" .

grpNwi:component-attributes a owl:Class ;
    rdfs:label "component-attributes" ;
    rdfs:comment "Grouping definition: component-attributes",
        """The set of common attributes of a component.

This grouping is intended also to be re-used by data models
that need to report the common attributes of a component.""" .

grpNwi:port-ref a owl:Class ;
    rdfs:label "port-ref" ;
    rdfs:comment "Grouping definition: port-ref",
        """This grouping is intended to be used by data models that need
to reference a port component within a Network Element.""" .

grpNiLoc:locations a owl:Class ;
    rdfs:label "locations" ;
    rdfs:comment "Grouping definition: locations",
        "The grouping of the locations." .

grpNiLoc:locations-ref a owl:Class ;
    rdfs:label "locations-ref" ;
    rdfs:comment "Grouping definition: locations-ref",
        "The attributes of the locations." .

grpNiLoc:physical-address a owl:Class ;
    rdfs:label "physical-address" ;
    rdfs:comment "Grouping definition: physical-address",
        "The grouping of the physical address." .

grpNiLoc:racks a owl:Class ;
    rdfs:label "racks" ;
    rdfs:comment "Grouping definition: racks",
        "The attributes of the rack." .

grpNwiPass:cable-attributes a owl:Class ;
    rdfs:label "cable-attributes" ;
    rdfs:comment "Attributes of cables.",
        "Grouping definition: cable-attributes" .

grpNwiPass:cables a owl:Class ;
    rdfs:label "cables" ;
    rdfs:comment "Attributes applicable to cables.",
        "Grouping definition: cables" .

grpNwiPass:child-cables a owl:Class ;
    rdfs:label "child-cables" ;
    rdfs:comment """Attributes applicable to child cables that are concatnated
to form the cable.""",
        "Grouping definition: child-cables" .

grpNwiPass:optical-cable-attributes a owl:Class ;
    rdfs:label "optical-cable-attributes" ;
    rdfs:comment "Attributes applicable to fiber optic cables.",
        "Grouping definition: optical-cable-attributes" .

grpNwiPass:passive-device-ports a owl:Class ;
    rdfs:label "passive-device-ports" ;
    rdfs:comment "Attributes applicable to passive device ports.",
        "Grouping definition: passive-device-ports" .

grpNwiPass:passive-devices a owl:Class ;
    rdfs:label "passive-devices" ;
    rdfs:comment "Attributes applicable to passive devices.",
        "Grouping definition: passive-devices" .

nwiInvId:ne-type a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "ne-type" ;
    rdfs:comment "Base identity for network element (NE) types." ;
    prov:wasDerivedFrom "nwi:ne-type?identity" .

nwiPassId:cable-role a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "cable-role" ;
    rdfs:comment "Base identity for cable roles." ;
    prov:wasDerivedFrom "nwi-passive:cable-role?identity" .

nwiPassId:cable-type a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "cable-type" ;
    rdfs:comment "Base identity for cable types." ;
    prov:wasDerivedFrom "nwi-passive:cable-type?identity" .

nwiPassId:connected-device-type a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "connected-device-type" ;
    rdfs:comment "Base identity for connected device types." ;
    prov:wasDerivedFrom "nwi-passive:connected-device-type?identity" .

nwiPassId:fiber-type a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "fiber-type" ;
    rdfs:comment "Base identity for fiber types." ;
    prov:wasDerivedFrom "nwi-passive:fiber-type?identity" .

nwiPassId:passive-device-type a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "passive-device-type" ;
    rdfs:comment "Base identity for passive device types." ;
    prov:wasDerivedFrom "nwi-passive:passive-device-type?identity" .

nwiPassId:passive-port-type a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "passive-port-type" ;
    rdfs:comment "Base identity for passive port types." ;
    prov:wasDerivedFrom "nwi-passive:passive-port-type?identity" .

paeId:data-source-accuracy a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "data-source-accuracy" ;
    rdfs:comment """Base identity for all possible data accuracy types.
This identity serves as the root for a hierarchy of accuracy
types, allowing for extensibility while maintaining alignment
with current and future industry standards.

The hierarchy, as defined in this YANG module, is as follows.
Other modules may extend this hierarchy with additional
accuracy base- and sub-types as needed.

data-source-accuracy
 ├── accuracy-unknown
 │    └── accuracy-unavailable
 ├── accuracy-estimated
 │    ├── accuracy-static
 │    ├── accuracy-historic
 │    └── accuracy-learned
 └── accuracy-measured
      ├── accuracy-measured-bronze
      ├── accuracy-measured-silver
      ├── accuracy-measured-gold
      ├── accuracy-measured-red
      └── accuracy-measured-ones
""" ;
    prov:wasDerivedFrom "eo:data-source-accuracy?identity" .

paeId:unit-multiplier a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "unit-multiplier" ;
    rdfs:comment """Base identity for unit multipliers as defined in IEC 61850-7-3
Annex A. These represent exponents of 10 for scaling units
associated with the integer units used to measure the power or
energy.""" ;
    prov:wasDerivedFrom "eo:unit-multiplier?identity" .

net:network-types a owl:Class ;
    rdfs:label "network-types" ;
    rdfs:comment """Serves as an augmentation target.
The network type is indicated through corresponding
presence containers augmented into this container.""" ;
    prov:wasDerivedFrom "nw:networks?container/nw:network?list/nw:network-types?container" .

grpNwi:ne-component-common-entity-attributes a owl:Class ;
    rdfs:label "ne-component-common-entity-attributes" ;
    rdfs:comment "Grouping definition: ne-component-common-entity-attributes",
        """The set of attributes which are common to all the entities
(e.g., component, network elements) defined in this module.""" .

grpNwiPass:common-cable-attributes a owl:Class ;
    rdfs:label "common-cable-attributes" ;
    rdfs:comment """Common attributes of cables applicable to the cable
and its child cables.""",
        "Grouping definition: common-cable-attributes" .

grpNwiPass:connected-device-ref a owl:Class ;
    rdfs:label "connected-device-ref" ;
    rdfs:comment "Attributes applicable to connected devices.",
        "Grouping definition: connected-device-ref" .

netRoot:networks a owl:Class ;
    rdfs:label "networks" ;
    rdfs:comment "Serves as a top-level container for a list of networks." ;
    prov:wasDerivedFrom "nw:networks?container" .

netLink:inventory-mapping-attributes a owl:Class ;
    rdfs:label "inventory-mapping-attributes" ;
    rdfs:comment """Container for inventory-related attributes of a link.

This container provides lightweight media classification.
The link-type indicates which specialized inventory model
contains detailed resource information:

- Wired media (fiber, copper): passive network inventory
- Wireless media (microwave, Wi-Fi): wireless-specific
  inventory

  Detailed inventory references may be added in future
  modules.""" ;
    prov:wasDerivedFrom "nwit:inventory-mapping-attributes?container" .

netNode:inventory-mapping-attributes a owl:Class ;
    rdfs:label "inventory-mapping-attributes" ;
    rdfs:comment "Container for inventory mapping attributes of a node." ;
    prov:wasDerivedFrom "nwit:inventory-mapping-attributes?container" .

paeRoot:energy-objects a owl:Class ;
    rdfs:label "energy-objects" ;
    rdfs:comment "Energy objects container for power attributes." ;
    prov:wasDerivedFrom "eo:energy-objects?container" .

hwRoot:hardware a owl:Class ;
    rdfs:label "hardware" ;
    rdfs:comment """Data nodes representing components.

If the server supports configuration of hardware components,
then this data model is instantiated in the configuration
datastores supported by the server.  The leaf-list 'datastore'
for the module 'ietf-hardware' in the YANG library provides
this information.""" ;
    prov:wasDerivedFrom "hw:hardware?container" .

nwiLocs:racks a owl:Class ;
    rdfs:label "racks" ;
    rdfs:comment "Top level container for the list of racks." ;
    prov:wasDerivedFrom "nwi:network-inventory?container/nil:locations?container/nil:racks?container" .

nwi:network-elements a owl:Class ;
    rdfs:label "network-elements" ;
    rdfs:comment """The top-level container for the list of network elements
within the network.""" ;
    prov:wasDerivedFrom "nwi:network-inventory?container/nwi:network-elements?container" .

nwiNE:components a owl:Class ;
    rdfs:label "components" ;
    rdfs:comment """The top-level container for the list of components
within a network element.""" ;
    prov:wasDerivedFrom "nwi:network-inventory?container/nwi:network-elements?container/nwi:network-element?list/nwi:components?container" .

nwiCompSwRev:patch a owl:Class ;
    rdfs:label "patch" ;
    rdfs:comment """The list of software patches configured to be active for
the software module.""" ;
    owl:hasKey ( nwiCompPatch:revision ) ;
    prov:wasDerivedFrom "nwi:software-rev?list/nwi:patch?list" .

nwiNE:locations a owl:Class ;
    rdfs:label "locations" ;
    rdfs:comment "The container for the location." ;
    prov:wasDerivedFrom "nil:locations?container" .

nwiSwRev:patch a owl:Class ;
    rdfs:label "patch" ;
    rdfs:comment """The list of software patches configured to be active for
the software module.""" ;
    owl:hasKey ( nwiSwRevPatch:revision ) ;
    prov:wasDerivedFrom "nwi:software-rev?list/nwi:patch?list" .

netLink:destination a owl:Class ;
    rdfs:label "destination" ;
    rdfs:comment """This container holds the logical destination of a
particular link.""" ;
    prov:wasDerivedFrom "nt:link?list/nt:destination?container" .

netLink:source a owl:Class ;
    rdfs:label "source" ;
    rdfs:comment """This container holds the logical source of a particular
link.""" ;
    prov:wasDerivedFrom "nt:link?list/nt:source?container" .

netInvMap:port-breakout a owl:Class ;
    rdfs:label "port-breakout" ;
    ex:isStateData true ;
    rdfs:comment """Breakout capability of the physical port represented by
this TP. One TP maps to one physical port; channels are
listed here. This container is present only when the
underlying hardware supports partitioning the port into
multiple independent channels (e.g., 400G to 4x100G).""" ;
    prov:wasDerivedFrom "nwit:inventory-mapping-attributes?container/nwit:port-breakout?container" .

netPortBrk:breakout-channel a owl:Class ;
    rdfs:label "breakout-channel" ;
    rdfs:comment """List of breakout channels available on this port.
Each entry represents an independent lane or sub-port
that can be used for channelized interfaces.""" ;
    owl:hasKey ( netBrkChan:channel-id ) ;
    prov:wasDerivedFrom "nwit:inventory-mapping-attributes?container/nwit:port-breakout?container/nwit:breakout-channel?list" .

inetTypes:ip-version a owl:Class ;
    rdfs:label "ip-version" .

grpNwiPass:connected-device-end a owl:Class ;
    rdfs:label "connected-device-end" ;
    rdfs:comment "Attributes applicable to connected device end.",
        "Grouping definition: connected-device-end" .

cab:optical-cable a owl:Class ;
    rdfs:label "optical-cable" ;
    rdfs:comment """Container for attributes associated with fiber
optic cables.""" ;
    prov:wasDerivedFrom "nwi-passive:optical-cable?container" .

nwi:locations a owl:Class ;
    rdfs:label "locations" ;
    rdfs:comment "The container for the NE location information." ;
    rdfs:subClassOf grpNiLoc:racks ;
    prov:wasDerivedFrom "nwi:network-inventory?container/nil:locations?container" .

nwiGeo:reference-frame a owl:Class ;
    rdfs:label "reference-frame" ;
    rdfs:comment "The Frame of Reference for the location values." ;
    prov:wasDerivedFrom "geo:geo-location?container/geo:reference-frame?container" .

nwiRefFrame:geodetic-system a owl:Class ;
    rdfs:label "geodetic-system" ;
    rdfs:comment "The geodetic system of the location data." ;
    prov:wasDerivedFrom "geo:geo-location?container/geo:reference-frame?container/geo:geodetic-system?container" .

nwiGeo:velocity a owl:Class ;
    rdfs:label "velocity" ;
    rdfs:comment """If the object is in motion, the velocity vector describes
this motion at the time given by the timestamp.  For a
formula to convert these values to speed and heading, see
RFC 9179.""" ;
    prov:wasDerivedFrom "geo:geo-location?container/geo:velocity?container" .

nwiRack:rack-location a owl:Class ;
    rdfs:label "rack-location" ;
    rdfs:comment """The location information of the rack, which
comprises the name of the location, row number, and
column number.""" ;
    prov:wasDerivedFrom "nwi:network-inventory?container/nil:locations?container/nil:racks?container/nil:rack?list/nil:rack-location?container" .

netLink:supporting-link a owl:Class ;
    rdfs:label "supporting-link" ;
    rdfs:comment "Identifies the link or links on which this link depends." ;
    owl:hasKey ( netSuppLink:network-ref netSuppLink:link-ref ) ;
    prov:wasDerivedFrom "nt:link?list/nt:supporting-link?list" .

netTP:inventory-mapping-attributes a owl:Class ;
    rdfs:label "inventory-mapping-attributes" ;
    rdfs:comment "Container for inventory mapping attributes of a TP." ;
    rdfs:subClassOf grpNwi:port-ref ;
    prov:wasDerivedFrom "nwit:inventory-mapping-attributes?container" .

net:supporting-network a owl:Class ;
    rdfs:label "supporting-network" ;
    rdfs:comment """An underlay network, used to represent layered network
topologies.""" ;
    owl:hasKey ( netSuppNet:network-ref ) ;
    prov:wasDerivedFrom "nw:networks?container/nw:network?list/nw:supporting-network?list" .

hwTypes:sensor-status a owl:Class ;
    rdfs:label "sensor-status" .

nwiRack:contained-chassis a owl:Class ;
    rdfs:label "contained-chassis" ;
    rdfs:comment "The list of chassis within a rack." ;
    owl:hasKey ( nwiChassis:relative-position ) ;
    prov:wasDerivedFrom "nwi:network-inventory?container/nil:locations?container/nil:racks?container/nil:rack?list/nil:contained-chassis?list" .

netTP:supporting-termination-point a owl:Class ;
    rdfs:label "supporting-termination-point" ;
    rdfs:comment """This list identifies any termination points on which a
given termination point depends or onto which it maps.
Those termination points will themselves be contained
in a supporting node.  This dependency information can be
inferred from the dependencies between links.  Therefore,
this item is not separately configurable.  Hence, no
corresponding constraint needs to be articulated.
The corresponding information is simply provided by the
implementing system.""" ;
    owl:hasKey ( netSuppTP:network-ref netSuppTP:node-ref netSuppTP:tp-ref ) ;
    prov:wasDerivedFrom "nt:termination-point?list/nt:supporting-termination-point?list" .

hwTypes:admin-state a owl:Class ;
    rdfs:label "admin-state" .

hwTypes:oper-state a owl:Class ;
    rdfs:label "oper-state" .

hwTypes:standby-state a owl:Class ;
    rdfs:label "standby-state" .

hwTypes:usage-state a owl:Class ;
    rdfs:label "usage-state" .

nwiRoot:network-inventory a owl:Class ;
    rdfs:label "network-inventory" ;
    ex:isStateData true ;
    rdfs:comment "Top-level container for network inventory." ;
    rdfs:subClassOf grpNiLoc:locations,
        grpNwiPass:cables,
        grpNwiPass:passive-devices ;
    prov:wasDerivedFrom "nwi:network-inventory?container" .

cab:a-end a owl:Class ;
    rdfs:label "a-end" ;
    rdfs:comment "A-end device reference" ;
    rdfs:subClassOf grpNwiPass:connected-device-end ;
    prov:wasDerivedFrom "nwi-passive:a-end?container" .

cabChild:a-end a owl:Class ;
    rdfs:label "a-end" ;
    rdfs:comment "A-end device reference" ;
    rdfs:subClassOf grpNwiPass:connected-device-end ;
    prov:wasDerivedFrom "nwi-passive:a-end?container" .

cabChild:z-end a owl:Class ;
    rdfs:label "z-end" ;
    rdfs:comment "Z-end device reference" ;
    rdfs:subClassOf grpNwiPass:connected-device-end ;
    prov:wasDerivedFrom "nwi-passive:z-end?container" .

cab:z-end a owl:Class ;
    rdfs:label "z-end" ;
    rdfs:comment "Z-end device reference" ;
    rdfs:subClassOf grpNwiPass:connected-device-end ;
    prov:wasDerivedFrom "nwi-passive:z-end?container" .

nwiLoc:physical-address a owl:Class ;
    rdfs:label "physical-address" ;
    rdfs:comment "Top level container for the physical address." ;
    prov:wasDerivedFrom "nil:physical-address?container" .

nwiComp:software-rev a owl:Class ;
    rdfs:label "software-rev" ;
    rdfs:comment """The list of the software modules configured to be active
within the entity (e.g., component).""" ;
    owl:hasKey ( nwiCompSwRev:name ) ;
    prov:wasDerivedFrom "nwi:software-rev?list" .

nwiNE:software-rev a owl:Class ;
    rdfs:label "software-rev" ;
    rdfs:comment """The list of the software modules configured to be active
within the entity (e.g., component).""" ;
    owl:hasKey ( nwiSwRev:name ) ;
    prov:wasDerivedFrom "nwi:software-rev?list" .

netNode:supporting-node a owl:Class ;
    rdfs:label "supporting-node" ;
    rdfs:comment """Represents another node that is in an underlay network
and that supports this node.  Used to represent layering
structure.""" ;
    owl:hasKey ( netSuppNode:network-ref netSuppNode:node-ref ) ;
    prov:wasDerivedFrom "nw:networks?container/nw:network?list/nw:node?list/nw:supporting-node?list" .

grpNwi:basic-common-entity-attributes a owl:Class ;
    rdfs:label "basic-common-entity-attributes" ;
    rdfs:comment "Grouping definition: basic-common-entity-attributes",
        """The set of basic attributes which are common to all the
entities (e.g., component, network elements, location, passive
entities) defined in this module and in other inventory
modules.""" .

hwComp:state a owl:Class ;
    rdfs:label "state" ;
    rdfs:comment "State-related nodes" ;
    prov:wasDerivedFrom "hw:hardware?container/hw:component?list/hw:state?container" .

cab:child-cable a owl:Class ;
    rdfs:label "child-cable" ;
    rdfs:comment "Ordered list of concatenated child cables." ;
    rdfs:subClassOf grpNwiPass:common-cable-attributes,
        grpNwiPass:connected-device-ref ;
    owl:hasKey ( cabChild:index ) ;
    prov:wasDerivedFrom "nwi-passive:child-cable?list" .

net:link a owl:Class ;
    rdfs:label "link" ;
    rdfs:comment """A network link connects a local (source) node and
a remote (destination) node via a set of the respective
node's termination points.  It is possible to have several
links between the same source and destination nodes.
Likewise, a link could potentially be re-homed between
termination points.  Therefore, in order to ensure that we
would always know to distinguish between links, every link
is identified by a dedicated link identifier.  Note that a
link models a point-to-point link, not a multipoint link.""" ;
    rdfs:subClassOf grpNwiTop:link-inventory-mapping-attributes ;
    prov:wasDerivedFrom "nt:link?list" .

netNode:termination-point a owl:Class ;
    rdfs:label "termination-point" ;
    rdfs:comment """A termination point can terminate a link.
Depending on the type of topology, a termination point
could, for example, refer to a port or an interface.""" ;
    rdfs:subClassOf grpNwiTop:tp-inventory-mapping-attributes ;
    prov:wasDerivedFrom "nt:termination-point?list" .

hwComp:sensor-data a owl:Class ;
    rdfs:label "sensor-data" ;
    ex:isStateData true ;
    rdfs:comment "Sensor-related nodes." ;
    prov:wasDerivedFrom "hw:hardware?container/hw:component?list/hw:sensor-data?container" .

pdev:passive-port a owl:Class ;
    rdfs:label "passive-port" ;
    rdfs:comment "List of ports on a passive device." ;
    rdfs:subClassOf grpNwi:basic-common-entity-attributes ;
    owl:hasKey ( pdevPort:id ) ;
    prov:wasDerivedFrom "nwi-passive:passive-port?list" .

netNetworks:network a owl:Class ;
    rdfs:label "network" ;
    rdfs:comment """Describes a network.
A network typically contains an inventory of nodes,
topological information (augmented through the
network-topology data model), and layering information.""" ;
    owl:hasKey ( net:network-id ) ;
    prov:wasDerivedFrom "nw:networks?container/nw:network?list" .

net:node a owl:Class ;
    rdfs:label "node" ;
    rdfs:comment "The inventory of nodes of this network." ;
    rdfs:subClassOf grpNwiTop:node-inventory-mapping-attributes ;
    owl:hasKey ( netNode:node-id ) ;
    prov:wasDerivedFrom "nw:networks?container/nw:network?list/nw:node?list" .

pae:power-entry a owl:Class ;
    rdfs:label "power-entry" ;
    rdfs:comment """Power entry for an energy object, indexed by object id.
Each entry contains the complete set of power attributes
for a specific physical component.""" ;
    owl:hasKey ( paePwrEntry:object-id ) ;
    prov:wasDerivedFrom "eo:energy-objects?container/eo:power-entry?list" .

nwiLoc:geo-location a owl:Class ;
    rdfs:label "geo-location" ;
    rdfs:comment """A location on an astronomical body (e.g., 'earth')
somewhere in a universe.""" ;
    prov:wasDerivedFrom "geo:geo-location?container" .

nwi:passive-device a owl:Class ;
    rdfs:label "passive-device" ;
    rdfs:comment "List of passive devices." ;
    rdfs:subClassOf grpNwi:basic-common-entity-attributes,
        grpNwiPass:passive-device-ports ;
    owl:hasKey ( pdev:id ) ;
    prov:wasDerivedFrom "nwi:network-inventory?container/nwi-passive:passive-device?list" .

hwTypes:sensor-value-type a owl:Class ;
    rdfs:label "sensor-value-type" .

nwi:cable a owl:Class ;
    rdfs:label "cable" ;
    rdfs:comment "List of cables." ;
    rdfs:subClassOf grpNwi:basic-common-entity-attributes,
        grpNwiPass:cable-attributes,
        grpNwiPass:child-cables,
        grpNwiPass:common-cable-attributes,
        grpNwiPass:connected-device-ref,
        grpNwiPass:optical-cable-attributes ;
    owl:hasKey ( cab:id ) ;
    prov:wasDerivedFrom "nwi:network-inventory?container/nwi-passive:cable?list" .

nwiNEs:network-element a owl:Class ;
    rdfs:label "network-element" ;
    rdfs:comment "The list of network elements within the network." ;
    rdfs:subClassOf grpNwi:basic-common-entity-attributes,
        grpNwi:ne-component-common-entity-attributes,
        grpNiLoc:locations-ref ;
    owl:hasKey ( nwiNE:ne-id ) ;
    prov:wasDerivedFrom "nwi:network-inventory?container/nwi:network-elements?container/nwi:network-element?list" .

nwiLocs:location a owl:Class ;
    rdfs:label "location" ;
    rdfs:comment "The list of locations within the network." ;
    rdfs:subClassOf grpGeo:geo-location,
        grpNwi:basic-common-entity-attributes,
        grpNiLoc:physical-address ;
    owl:hasKey ( nwiLoc:id ) ;
    prov:wasDerivedFrom "nwi:network-inventory?container/nil:locations?container/nil:location?list" .

nwiRacks:rack a owl:Class ;
    rdfs:label "rack" ;
    rdfs:comment """The list of racks within a location,
e.g. equipment room.""" ;
    rdfs:subClassOf grpNwi:basic-common-entity-attributes ;
    owl:hasKey ( nwiRack:id ) ;
    prov:wasDerivedFrom "nwi:network-inventory?container/nil:locations?container/nil:racks?container/nil:rack?list" .

hwTypes:sensor-value-scale a owl:Class ;
    rdfs:label "sensor-value-scale" .

<http://www.huawei.com/ontology/ietf-network-inventory/network-inventory/network-elements/network-element/components/component> a owl:Class ;
    rdfs:label "component" ;
    rdfs:comment "The list of components within a network element." ;
    rdfs:subClassOf grpNwi:basic-common-entity-attributes,
        grpNwi:component-attributes,
        grpNwi:ne-component-common-entity-attributes ;
    owl:hasKey ( nwiComp:component-id ) ;
    prov:wasDerivedFrom "nwi:network-inventory?container/nwi:network-elements?container/nwi:network-element?list/nwi:components?container/nwi:component?list" .

hw:component a owl:Class ;
    rdfs:label "component" ;
    rdfs:comment """List of components.

When the server detects a new hardware component, it
initializes a list entry in the operational state.

If the server does not support configuration of hardware
components, list entries in the operational state are
initialized with values for all nodes as detected by the
implementation.

Otherwise, this procedure is followed:

  1. If there is an entry in the '/hardware/component' list
     in the intended configuration with values for the nodes
     'class', 'parent', and 'parent-rel-pos' that are equal
     to the detected values, then the list entry in the
     operational state is initialized with the configured
     values, including the 'name'.

  2. Otherwise (i.e., there is no matching configuration
     entry), the list entry in the operational state is
     initialized with values for all nodes as detected by
     the implementation.

If the '/hardware/component' list in the intended
configuration is modified, then the system MUST behave as if
it re-initializes itself and follow the procedure in (1).""" ;
    owl:hasKey ( hwComp:name ) ;
    prov:wasDerivedFrom "hw:hardware?container/hw:component?list" .

