hwStandbySt:hot-standby a hwTypes:standby-state,
        owl:NamedIndividual ;
    rdfs:label "hot-standby" ;
    rdfs:comment """The resource is not providing service, but it will be
immediately able to take over the role of the resource to
be backed up, without the need for initialization
activity, and will contain the same information as the
resource to be backed up.""" .

hwStandbySt:providing-service a hwTypes:standby-state,
        owl:NamedIndividual ;
    rdfs:label "providing-service" ;
    rdfs:comment "The resource is providing service." .

hwStandbySt:unknown a hwTypes:standby-state,
        owl:NamedIndividual ;
    rdfs:label "unknown" ;
    rdfs:comment "The resource is unable to report standby state." .

hwUsageSt:active a hwTypes:usage-state,
        owl:NamedIndividual ;
    rdfs:label "active" ;
    rdfs:comment """The resource is currently in use, and it has sufficient
spare capacity to provide for additional users.""" .

hwUsageSt:busy a hwTypes:usage-state,
        owl:NamedIndividual ;
    rdfs:label "busy" ;
    rdfs:comment """The resource is currently in use, but it currently has no
spare capacity to provide for additional users.""" .

hwUsageSt:idle a hwTypes:usage-state,
        owl:NamedIndividual ;
    rdfs:label "idle" ;
    rdfs:comment "The resource is servicing no users." .

hwUsageSt:unknown a hwTypes:usage-state,
        owl:NamedIndividual ;
    rdfs:label "unknown" ;
    rdfs:comment "The resource is unable to report usage state." .

inetIpVer:ipv4 a inetTypes:ip-version,
        owl:NamedIndividual ;
    rdfs:label "ipv4" ;
    rdfs:comment "The IPv4 protocol as defined in RFC 791." .

inetIpVer:ipv6 a inetTypes:ip-version,
        owl:NamedIndividual ;
    rdfs:label "ipv6" ;
    rdfs:comment "The IPv6 protocol as defined in RFC 2460." .

inetIpVer:unknown a inetTypes:ip-version,
        owl:NamedIndividual ;
    rdfs:label "unknown" ;
    rdfs:comment """An unknown or unspecified version of the Internet
protocol.""" .

l2tDuplex:full-duplex a l2tTypes:duplex-mode,
        owl:NamedIndividual ;
    rdfs:label "full-duplex" ;
    rdfs:comment "Indicates full-duplex mode." .

l2tDuplex:half-duplex a l2tTypes:duplex-mode,
        owl:NamedIndividual ;
    rdfs:label "half-duplex" ;
    rdfs:comment "Indicates half-duplex mode." .

l2tEvent:addition a l2tTypes:l2-network-event-type,
        owl:NamedIndividual ;
    rdfs:label "addition" ;
    rdfs:comment """A Layer 2 node or link or termination-point
has been added.""" .

l2tEvent:removal a l2tTypes:l2-network-event-type,
        owl:NamedIndividual ;
    rdfs:label "removal" ;
    rdfs:comment """A Layer 2 node or link or termination-point
has been removed.""" .

l2tEvent:update a l2tTypes:l2-network-event-type,
        owl:NamedIndividual ;
    rdfs:label "update" ;
    rdfs:comment """A Layer 2 node or link or termination-point
has been updated.""" .

contMo:discard a l2svcTypes:control-mode,
        owl:NamedIndividual ;
    rdfs:label "discard" ;
    rdfs:comment "'discard' mode, i.e., discard the frame." .

contMo:peer a l2svcTypes:control-mode,
        owl:NamedIndividual ;
    rdfs:label "peer" ;
    rdfs:comment """'peer' mode, i.e., participate in the protocol towards
the CE.  Peering is common for LACP and the Ethernet
Local Management Interface (E-LMI) and, occasionally,
for LLDP.  For VPLSs and VPWSs, the subscriber can also
request that the SP peer enable spanning tree.""" .

contMo:tunnel a l2svcTypes:control-mode,
        owl:NamedIndividual ;
    rdfs:label "tunnel" ;
    rdfs:comment """'tunnel' mode, i.e., pass to the egress or destination
site.  For EPLs, the expectation is that L2CP frames are
tunneled.""" .

negMo:auto-neg a l2svcTypes:neg-mode,
        owl:NamedIndividual ;
    rdfs:label "auto-neg" ;
    rdfs:comment "Defines auto-negotiation mode." .

negMo:full-duplex a l2svcTypes:neg-mode,
        owl:NamedIndividual ;
    rdfs:label "full-duplex" ;
    rdfs:comment "Defines full-duplex mode." .

ex:underlay-multicast a owl:DatatypeProperty ;
    rdfs:label "underlay-multicast" ;
    rdfs:comment """Enables (when set to 'true') or disables
(when set to 'false') underlay
multicast.""" ;
    rdfs:domain l2nmNdSig:evpn-policies ;
    rdfs:range xsd:boolean ;
    prov:wasDerivedFrom "l2vpn-ntw:l2vpn-ntw?container/l2vpn-ntw:vpn-services?container/l2vpn-ntw:vpn-service?list/l2vpn-ntw:vpn-nodes?container/l2vpn-ntw:vpn-node?list/l2vpn-ntw:signaling-option?container/l2vpn-ntw:evpn-policies?container/l2vpn-ntw:underlay-multicast?leaf" .

ex:uni-loop-prevention a owl:DatatypeProperty ;
    rdfs:label "uni-loop-prevention" ;
    rdfs:comment """If this leaf is set to 'true', then the port
automatically goes down when a physical
loopback is detected.""" ;
    rdfs:domain l2svcTpConn:untagged-interface ;
    rdfs:range xsd:boolean ;
    prov:wasDerivedFrom "l2vpn-svc:l2vpn-svc?container/l2vpn-svc:sites?container/l2vpn-svc:site?list/l2vpn-svc:site-network-accesses?container/l2vpn-svc:site-network-access?list/l2vpn-svc:connection?container/l2vpn-svc:untagged-interface?container/l2vpn-svc:uni-loop-prevention?leaf" .

ex:units-display a owl:DatatypeProperty ;
    rdfs:label "units-display" ;
    rdfs:comment """A textual description of the data units that should be
used in the display of the sensor value.""" ;
    rdfs:domain hwComp:sensor-data ;
    rdfs:range xsd:string ;
    prov:wasDerivedFrom "hw:hardware?container/hw:component?list/hw:sensor-data?container/hw:units-display?leaf" .

ex:unnumbered-id a owl:DatatypeProperty ;
    rdfs:label "unnumbered-id" ;
    rdfs:comment """List of unnumbered interface identifiers.
The unnumbered interface identifier will correspond to
the ifIndex value of the interface, i.e., the ifIndex
value of the ifEntry that represents the interface in
implementations where the Interfaces Group MIB
(RFC 2863) is supported.""" ;
    rdfs:domain nw-s-tp:l2-termination-point-attributes ;
    rdfs:isDefinedBy modu:ietf-l2-topology-state ;
    rdfs:range xsd:unsignedInt ;
    prov:wasAttributedTo modu:ietf-l2-topology-state ;
    prov:wasDerivedFrom "l2t:l2-termination-point-attributes?container/l2t:unnumbered-id?leaf-list" .

ex:uri a owl:DatatypeProperty ;
    rdfs:label "uri" ;
    rdfs:comment """This node contains identification information about
the component.""",
        """This node contains identification information about the
component.""" ;
    rdfs:domain hw:component,
        nwiComps:component ;
    rdfs:range xsd:anyURI ;
    prov:wasDerivedFrom "hw:hardware?container/hw:component?list/hw:uri?leaf-list",
        "nwi:uri?leaf-list" .

ex:usage-state a owl:ObjectProperty ;
    rdfs:label "usage-state" ;
    ex:isStateData true ;
    rdfs:comment """The usage state for this component.

This node refers to a component's ability to service
more components in a containment hierarchy.

Some components will exhibit only a subset of the usage
state values.  Components that are unable to ever
service any components within a containment hierarchy
will always have a usage state of 'busy'.  In some
cases, a component will be able to support only one
other component within its containment hierarchy and
will therefore only exhibit values of 'idle' and
'busy'.""" ;
    rdfs:domain hwComp:state ;
    rdfs:range hwTypes:usage-state ;
    prov:wasDerivedFrom "hw:hardware?container/hw:component?list/hw:state?container/hw:usage-state?leaf" .

ex:use-lowest-jitter a owl:DatatypeProperty ;
    rdfs:label "use-lowest-jitter" ;
    rdfs:comment """The traffic class should use the path
with the lowest jitter.""" ;
    rdfs:domain l2svcSiteBw:frame-jitter,
        l2svcTpBw:frame-jitter ;
    rdfs:range xsd:boolean ;
    prov:wasDerivedFrom "l2vpn-svc:l2vpn-svc?container/l2vpn-svc:sites?container/l2vpn-svc:site?list/l2vpn-svc:service?container/l2vpn-svc:qos?container/l2vpn-svc:qos-profile?container/l2vpn-svc:classes?container/l2vpn-svc:class?list/l2vpn-svc:frame-jitter?container/l2vpn-svc:use-lowest-jitter?leaf",
        "l2vpn-svc:l2vpn-svc?container/l2vpn-svc:sites?container/l2vpn-svc:site?list/l2vpn-svc:site-network-accesses?container/l2vpn-svc:site-network-access?list/l2vpn-svc:service?container/l2vpn-svc:qos?container/l2vpn-svc:qos-profile?container/l2vpn-svc:classes?container/l2vpn-svc:class?list/l2vpn-svc:frame-jitter?container/l2vpn-svc:use-lowest-jitter?leaf" .

ex:use-lowest-latency a owl:DatatypeProperty ;
    rdfs:label "use-lowest-latency" ;
    rdfs:comment """The traffic class should use the path
with the lowest delay.""" ;
    rdfs:domain l2svcSiteBw:frame-delay,
        l2svcTpBw:frame-delay ;
    rdfs:range xsd:boolean ;
    prov:wasDerivedFrom "l2vpn-svc:l2vpn-svc?container/l2vpn-svc:sites?container/l2vpn-svc:site?list/l2vpn-svc:service?container/l2vpn-svc:qos?container/l2vpn-svc:qos-profile?container/l2vpn-svc:classes?container/l2vpn-svc:class?list/l2vpn-svc:frame-delay?container/l2vpn-svc:use-lowest-latency?leaf",
        "l2vpn-svc:l2vpn-svc?container/l2vpn-svc:sites?container/l2vpn-svc:site?list/l2vpn-svc:site-network-accesses?container/l2vpn-svc:site-network-access?list/l2vpn-svc:service?container/l2vpn-svc:qos?container/l2vpn-svc:qos-profile?container/l2vpn-svc:classes?container/l2vpn-svc:class?list/l2vpn-svc:frame-delay?container/l2vpn-svc:use-lowest-latency?leaf" .

ex:uuid a owl:DatatypeProperty ;
    rdfs:label "uuid" ;
    ex:isStateData true ;
    rdfs:comment "A Universally Unique Identifier of the component.",
        """The Universally Unique Identifier of the entity
(e.g., component).""" ;
    rdfs:domain hw:component,
        nwi:cable,
        nwiLocs:location,
        niLocRacks:rack,
        nwiNEs:network-element,
        nwiComps:component,
        nwi:passive-device,
        pdev:passive-port ;
    rdfs:range xsd:string ;
    prov:wasDerivedFrom "hw:hardware?container/hw:component?list/hw:uuid?leaf",
        "nwi:uuid?leaf" .

ex:v-east a owl:DatatypeProperty ;
    rdfs:label "v-east" ;
    ex:unit "meters per second" ;
    rdfs:comment """v-east is the rate of change (i.e., speed) perpendicular
to the right of true north as defined by
the geodetic-system.""" ;
    rdfs:domain nwiGeo:velocity ;
    rdfs:isDefinedBy modu:ietf-ni-location ;
    rdfs:range xsd:decimal ;
    prov:wasAttributedTo modu:ietf-ni-location ;
    prov:wasDerivedFrom "geo:geo-location?container/geo:velocity?container/geo:v-east?leaf" .

ex:v-north a owl:DatatypeProperty ;
    rdfs:label "v-north" ;
    ex:unit "meters per second" ;
    rdfs:comment """v-north is the rate of change (i.e., speed) towards
true north as defined by the geodetic-system.""" ;
    rdfs:domain nwiGeo:velocity ;
    rdfs:isDefinedBy modu:ietf-ni-location ;
    rdfs:range xsd:decimal ;
    prov:wasAttributedTo modu:ietf-ni-location ;
    prov:wasDerivedFrom "geo:geo-location?container/geo:velocity?container/geo:v-north?leaf" .

ex:v-up a owl:DatatypeProperty ;
    rdfs:label "v-up" ;
    ex:unit "meters per second" ;
    rdfs:comment """v-up is the rate of change (i.e., speed) away from the
center of mass.""" ;
    rdfs:domain nwiGeo:velocity ;
    rdfs:isDefinedBy modu:ietf-ni-location ;
    rdfs:range xsd:decimal ;
    prov:wasAttributedTo modu:ietf-ni-location ;
    prov:wasDerivedFrom "geo:geo-location?container/geo:velocity?container/geo:v-up?leaf" .

ex:valid-until a owl:DatatypeProperty ;
    rdfs:label "valid-until" ;
    rdfs:comment """The timestamp for which this geo-location is valid until.
If unspecified, the geo-location has no specific
expiration time.""",
        """The timestamp for which this location is valid until.
If unspecified, the location has no specific
expiration time.""" ;
    rdfs:domain nwiLocs:location,
        niLocLoc:geo-location,
        niLocRacks:rack ;
    rdfs:isDefinedBy modu:ietf-ni-location ;
    rdfs:range xsd:dateTime ;
    prov:wasAttributedTo modu:ietf-ni-location ;
    prov:wasDerivedFrom "geo:geo-location?container/geo:valid-until?leaf",
        "nwi:network-inventory?container/nil:locations?container/nil:location?list/nil:valid-until?leaf",
        "nwi:network-inventory?container/nil:locations?container/nil:racks?container/nil:rack?list/nil:valid-until?leaf" .

ex:value a owl:DatatypeProperty ;
    rdfs:label "value" ;
    rdfs:comment """The most recent measurement obtained by the server
for this sensor.

A client that periodically fetches this node should also
fetch the nodes 'value-type', 'value-scale', and
'value-precision', since they may change when the value
is changed.""" ;
    rdfs:domain hwComp:sensor-data ;
    rdfs:range xsd:int ;
    prov:wasDerivedFrom "hw:hardware?container/hw:component?list/hw:sensor-data?container/hw:value?leaf" .

ex:value-precision a owl:DatatypeProperty ;
    rdfs:label "value-precision" ;
    rdfs:comment """The number of decimal places of precision
associated with the sensor value""" ;
    rdfs:domain hwComp:sensor-data ;
    rdfs:range xsd:byte ;
    prov:wasDerivedFrom "hw:hardware?container/hw:component?list/hw:sensor-data?container/hw:value-precision?leaf" .

ex:value-scale a owl:ObjectProperty ;
    rdfs:label "value-scale" ;
    rdfs:comment """The (power of 10) scaling factor associated
with the sensor value""" ;
    rdfs:domain hwComp:sensor-data ;
    rdfs:range hwTypes:sensor-value-scale ;
    prov:wasDerivedFrom "hw:hardware?container/hw:component?list/hw:sensor-data?container/hw:value-scale?leaf" .

ex:value-timestamp a owl:DatatypeProperty ;
    rdfs:label "value-timestamp" ;
    rdfs:comment """The time the status and/or value of this sensor was last
obtained by the server.""" ;
    rdfs:domain hwComp:sensor-data ;
    rdfs:range xsd:dateTime ;
    prov:wasDerivedFrom "hw:hardware?container/hw:component?list/hw:sensor-data?container/hw:value-timestamp?leaf" .

ex:value-type a owl:ObjectProperty ;
    rdfs:label "value-type" ;
    rdfs:comment """The type of data units associated with the
sensor value""" ;
    rdfs:domain hwComp:sensor-data ;
    rdfs:range hwTypes:sensor-value-type ;
    prov:wasDerivedFrom "hw:hardware?container/hw:component?list/hw:sensor-data?container/hw:value-type?leaf" .

ex:value-update-rate a owl:DatatypeProperty ;
    rdfs:label "value-update-rate" ;
    ex:unit "milliseconds" ;
    rdfs:comment """An indication of the frequency that the server updates
the associated 'value' node, represented in
milliseconds.  The value zero indicates:

 - the sensor value is updated on demand (e.g.,
   when polled by the server for a get-request),

 - the sensor value is updated when the sensor
   value changes (event-driven), or

 - the server does not know the update rate.""" ;
    rdfs:domain hwComp:sensor-data ;
    rdfs:range xsd:unsignedInt ;
    prov:wasDerivedFrom "hw:hardware?container/hw:component?list/hw:sensor-data?container/hw:value-update-rate?leaf" .

ex:vc-id a owl:DatatypeProperty ;
    rdfs:label "vc-id" ;
    rdfs:comment "VC label used to identify a PW." ;
    rdfs:domain l2nmNdLdp:pw-peer-list ;
    rdfs:range xsd:string ;
    prov:wasDerivedFrom "l2vpn-ntw:l2vpn-ntw?container/l2vpn-ntw:vpn-services?container/l2vpn-ntw:vpn-service?list/l2vpn-ntw:vpn-nodes?container/l2vpn-ntw:vpn-node?list/l2vpn-ntw:signaling-option?container/l2vpn-ntw:ldp-or-l2tp?container/l2vpn-ntw:pw-peer-list?list/l2vpn-ntw:vc-id?leaf" .

ex:viaCable a owl:ObjectProperty ;
    rdfs:label "via cable" ;
    rdfs:comment "RDF-star annotation on ex:hasUpstreamDevice: the physical cable realising this hop." .

ex:vid a owl:DatatypeProperty ;
    rdfs:label "vid" ;
    rdfs:comment "CVLAN ID." ;
    rdfs:domain cvlaIdToSvMa:cvlan-id ;
    rdfs:range xsd:unsignedShort ;
    prov:wasDerivedFrom "l2vpn-svc:l2vpn-svc?container/l2vpn-svc:sites?container/l2vpn-svc:site?list/l2vpn-svc:site-network-accesses?container/l2vpn-svc:site-network-access?list/l2vpn-svc:connection?container/l2vpn-svc:cvlan-id-to-svc-map?list/l2vpn-svc:cvlan-id?list/l2vpn-svc:vid?leaf" .

ex:vlan-id a owl:DatatypeProperty ;
    rdfs:label "vlan-id" ;
    rdfs:comment "The VLAN ID of the multicast group.",
        """The VLAN ID of the multicast group.
The range of the 12-bit VLAN ID is 0 to 1024.""" ;
    rdfs:domain broaUnUnMu:multicast-gp-address-mapping,
        l2svcBum:multicast-gp-address-mapping,
        l2svcTpBum:multicast-gp-address-mapping ;
    rdfs:range xsd:unsignedInt,
        xsd:unsignedShort ;
    prov:wasDerivedFrom "l2vpn-ntw:l2vpn-ntw?container/l2vpn-ntw:vpn-services?container/l2vpn-ntw:vpn-service?list/l2vpn-ntw:vpn-nodes?container/l2vpn-ntw:vpn-node?list/l2vpn-ntw:vpn-network-accesses?container/l2vpn-ntw:vpn-network-access?list/l2vpn-ntw:service?container/l2vpn-ntw:broadcast-unknown-unicast-multicast?container/l2vpn-ntw:multicast-gp-address-mapping?list/l2vpn-ntw:vlan-id?leaf",
        "l2vpn-svc:broadcast-unknown-unicast-multicast?container/l2vpn-svc:multicast-gp-address-mapping?list/l2vpn-svc:vlan-id?leaf" .

ex:vni-id a owl:DatatypeProperty ;
    rdfs:label "vni-id" ;
    rdfs:comment "VXLAN Network Identifier (VNI)." ;
    rdfs:domain l2t-s-attr:vxlan,
        l2t-attr:vxlan,
        l2svcTagged:vxlan ;
    rdfs:range xsd:string,
        xsd:unsignedInt ;
    prov:wasDerivedFrom "l2t:l2-termination-point-attributes?container/l2t:vxlan?container/l2t:vni-id?leaf",
        "l2vpn-svc:l2vpn-svc?container/l2vpn-svc:sites?container/l2vpn-svc:site?list/l2vpn-svc:site-network-accesses?container/l2vpn-svc:site-network-access?list/l2vpn-svc:connection?container/l2vpn-svc:tagged-interface?container/l2vpn-svc:vxlan?container/l2vpn-svc:vni-id?leaf" .

ex:vpls-edge-id a owl:DatatypeProperty ;
    rdfs:label "vpls-edge-id" ;
    rdfs:comment "VPLS Edge Identifier (VE ID).",
        """VPLS Edge Identifier (VE ID).  This is
used when the same VE ID is configured
for the PE.""" ;
    rdfs:domain l2nmNdSig:vpls-instance,
        l2nmTp:vpls-instance ;
    rdfs:range xsd:unsignedShort ;
    prov:wasDerivedFrom "l2vpn-ntw:l2vpn-ntw?container/l2vpn-ntw:vpn-services?container/l2vpn-ntw:vpn-service?list/l2vpn-ntw:vpn-nodes?container/l2vpn-ntw:vpn-node?list/l2vpn-ntw:signaling-option?container/l2vpn-ntw:vpls-instance?container/l2vpn-ntw:vpls-edge-id?leaf",
        "l2vpn-ntw:l2vpn-ntw?container/l2vpn-ntw:vpn-services?container/l2vpn-ntw:vpn-service?list/l2vpn-ntw:vpn-nodes?container/l2vpn-ntw:vpn-node?list/l2vpn-ntw:vpn-network-accesses?container/l2vpn-ntw:vpn-network-access?list/l2vpn-ntw:vpls-instance?container/l2vpn-ntw:vpls-edge-id?leaf" .

ex:vpls-edge-id-range a owl:DatatypeProperty ;
    rdfs:label "vpls-edge-id-range" ;
    rdfs:comment """Specifies the size of the range of
VE ID in a VPLS service. The range
controls the size of the label
block advertised in the context of
a VPLS instance.""" ;
    rdfs:domain l2nmNdSig:vpls-instance ;
    rdfs:range xsd:unsignedShort ;
    prov:wasDerivedFrom "l2vpn-ntw:l2vpn-ntw?container/l2vpn-ntw:vpn-services?container/l2vpn-ntw:vpn-service?list/l2vpn-ntw:vpn-nodes?container/l2vpn-ntw:vpn-node?list/l2vpn-ntw:signaling-option?container/l2vpn-ntw:vpls-instance?container/l2vpn-ntw:vpls-edge-id-range?leaf" .

ex:vpn-id a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "vpn-id" ;
    ex:xpathPath "/l2vpn-svc/vpn-services/vpn-service/vpn-id" ;
    rdfs:comment "Defines a service identifier.",
        """Identifies the target VPN that the local VPN wants to
access.""",
        """Identifies the target VPN.  If the bandwidth
type is set as bandwidth per VPN service, the
vpn-id MUST be specified.""",
        "Reference to an L2VPN.",
        """Reference to an L2VPN.  Referencing a vpn-id
provides an easy way to attach a particular
logical access to a VPN.  In this case,
the vpn-id must be configured.""",
        "Reference to the target VPN.",
        """VPN Identifier.  This identifier serves to
unify components of a given VPN for the
sake of auto-discovery.""" ;
    rdfs:domain l2nmNode:bgp-auto-discovery,
        l2svcSiteQosRule:match-flow,
        l2svcTpQosRule:match-flow,
        l2svcSvcBw:bandwidth,
        l2svcTp:vpn-attachment,
        entr:vpn,
        vpnSe:vpn-service,
        extrVp:extranet-vpn ;
    rdfs:range vpnSe:vpn-service,
        xsd:string ;
    prov:wasDerivedFrom "l2vpn-ntw:l2vpn-ntw?container/l2vpn-ntw:vpn-services?container/l2vpn-ntw:vpn-service?list/l2vpn-ntw:vpn-nodes?container/l2vpn-ntw:vpn-node?list/l2vpn-ntw:bgp-auto-discovery?container/l2vpn-ntw:vpn-id?leaf",
        "l2vpn-svc:l2vpn-svc?container/l2vpn-svc:sites?container/l2vpn-svc:site?list/l2vpn-svc:service?container/l2vpn-svc:qos?container/l2vpn-svc:qos-classification-policy?container/l2vpn-svc:rule?list/l2vpn-svc:match-flow?container/l2vpn-svc:vpn-id?leaf",
        "l2vpn-svc:l2vpn-svc?container/l2vpn-svc:sites?container/l2vpn-svc:site?list/l2vpn-svc:site-network-accesses?container/l2vpn-svc:site-network-access?list/l2vpn-svc:service?container/l2vpn-svc:qos?container/l2vpn-svc:qos-classification-policy?container/l2vpn-svc:rule?list/l2vpn-svc:match-flow?container/l2vpn-svc:vpn-id?leaf",
        "l2vpn-svc:l2vpn-svc?container/l2vpn-svc:sites?container/l2vpn-svc:site?list/l2vpn-svc:site-network-accesses?container/l2vpn-svc:site-network-access?list/l2vpn-svc:service?container/l2vpn-svc:svc-bandwidth?container/l2vpn-svc:bandwidth?list/l2vpn-svc:vpn-id?leaf",
        "l2vpn-svc:l2vpn-svc?container/l2vpn-svc:sites?container/l2vpn-svc:site?list/l2vpn-svc:site-network-accesses?container/l2vpn-svc:site-network-access?list/l2vpn-svc:vpn-attachment?container/l2vpn-svc:vpn-id?leaf",
        "l2vpn-svc:l2vpn-svc?container/l2vpn-svc:sites?container/l2vpn-svc:site?list/l2vpn-svc:vpn-policies?container/l2vpn-svc:vpn-policy?list/l2vpn-svc:entries?list/l2vpn-svc:vpn?list/l2vpn-svc:vpn-id?leaf",
        "l2vpn-svc:l2vpn-svc?container/l2vpn-svc:vpn-services?container/l2vpn-svc:vpn-service?list/l2vpn-svc:extranet-vpns?container/l2vpn-svc:extranet-vpn?list/l2vpn-svc:vpn-id?leaf",
        "l2vpn-svc:l2vpn-svc?container/l2vpn-svc:vpn-services?container/l2vpn-svc:vpn-service?list/l2vpn-svc:vpn-id?leaf" .

ex:vpn-node-id a owl:DatatypeProperty ;
    rdfs:label "vpn-node-id" ;
    rdfs:comment "Sets the identifier of the VPN node." ;
    rdfs:domain l2nmNodes:vpn-node ;
    rdfs:range xsd:string ;
    prov:wasDerivedFrom "l2vpn-ntw:l2vpn-ntw?container/l2vpn-ntw:vpn-services?container/l2vpn-ntw:vpn-service?list/l2vpn-ntw:vpn-nodes?container/l2vpn-ntw:vpn-node?list/l2vpn-ntw:vpn-node-id?leaf" .

ex:vpn-policy-id a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "vpn-policy-id" ;
    ex:xpathPath "../../../../vpn-policies/vpn-policy/vpn-policy-id" ;
    rdfs:comment "Reference to a VPN policy.",
        "Unique identifier for the VPN policy." ;
    rdfs:domain l2svcTp:vpn-attachment,
        vpnPo2:vpn-policy ;
    rdfs:range vpnPo2:vpn-policy,
        xsd:string ;
    prov:wasDerivedFrom "l2vpn-svc:l2vpn-svc?container/l2vpn-svc:sites?container/l2vpn-svc:site?list/l2vpn-svc:site-network-accesses?container/l2vpn-svc:site-network-access?list/l2vpn-svc:vpn-attachment?container/l2vpn-svc:vpn-policy-id?leaf",
        "l2vpn-svc:l2vpn-svc?container/l2vpn-svc:sites?container/l2vpn-svc:site?list/l2vpn-svc:vpn-policies?container/l2vpn-svc:vpn-policy?list/l2vpn-svc:vpn-policy-id?leaf" .

ex:vpn-service-topology a owl:ObjectProperty ;
    rdfs:label "vpn-service-topology" ;
    rdfs:comment """Defines service topology such as
any-to-any, hub-spoke, etc.""" ;
    rdfs:domain l2nmVpns:vpn-service ;
    rdfs:range l2nmId:vpn-topology ;
    prov:wasDerivedFrom "l2vpn-ntw:l2vpn-ntw?container/l2vpn-ntw:vpn-services?container/l2vpn-ntw:vpn-service?list/l2vpn-ntw:vpn-service-topology?leaf" .

ex:vpn-svc-type a owl:ObjectProperty ;
    rdfs:label "vpn-svc-type" ;
    rdfs:comment "Service type.  By default, the service type is 'vpws'." ;
    rdfs:domain vpnSe:vpn-service ;
    rdfs:range l2svcId:service-type ;
    prov:wasDerivedFrom "l2vpn-svc:l2vpn-svc?container/l2vpn-svc:vpn-services?container/l2vpn-svc:vpn-service?list/l2vpn-svc:vpn-svc-type?leaf" .

ex:vpn-type a owl:ObjectProperty ;
    rdfs:label "vpn-type" ;
    rdfs:comment "Service type." ;
    rdfs:domain l2nmVpns:vpn-service ;
    rdfs:range l2nmId:service-type ;
    prov:wasDerivedFrom "l2vpn-ntw:l2vpn-ntw?container/l2vpn-ntw:vpn-services?container/l2vpn-ntw:vpn-service?list/l2vpn-ntw:vpn-type?leaf" .

ex:vpws-vlan-aware a owl:DatatypeProperty ;
    rdfs:label "vpws-vlan-aware" ;
    rdfs:comment """Enables (when set to 'true') or disables
(when set to 'false') VPWS VLAN-aware
service for the EVPN instance.""" ;
    rdfs:domain l2nmNdSig:evpn-policies ;
    rdfs:range xsd:boolean ;
    prov:wasDerivedFrom "l2vpn-ntw:l2vpn-ntw?container/l2vpn-ntw:vpn-services?container/l2vpn-ntw:vpn-service?list/l2vpn-ntw:vpn-nodes?container/l2vpn-ntw:vpn-node?list/l2vpn-ntw:signaling-option?container/l2vpn-ntw:evpn-policies?container/l2vpn-ntw:vpws-vlan-aware?leaf" .

ex:vsi-pool-name a owl:DatatypeProperty ;
    rdfs:label "vsi-pool-name" ;
    rdfs:comment """The auto-assignment will be
made from this pool.""" ;
    rdfs:domain l2nmVpws:local-vsi-auto,
        l2nmVpws:remote-vsi-auto ;
    rdfs:range xsd:string ;
    prov:wasDerivedFrom "l2vpn-ntw:l2vpn-ntw?container/l2vpn-ntw:vpn-services?container/l2vpn-ntw:vpn-service?list/l2vpn-ntw:vpn-nodes?container/l2vpn-ntw:vpn-node?list/l2vpn-ntw:vpn-network-accesses?container/l2vpn-ntw:vpn-network-access?list/l2vpn-ntw:vpws-service-instance?container/l2vpn-ntw:local-vsi-auto?container/l2vpn-ntw:vsi-pool-name?leaf",
        "l2vpn-ntw:l2vpn-ntw?container/l2vpn-ntw:vpn-services?container/l2vpn-ntw:vpn-service?list/l2vpn-ntw:vpn-nodes?container/l2vpn-ntw:vpn-node?list/l2vpn-ntw:vpn-network-accesses?container/l2vpn-ntw:vpn-network-access?list/l2vpn-ntw:vpws-service-instance?container/l2vpn-ntw:remote-vsi-auto?container/l2vpn-ntw:vsi-pool-name?leaf" .

ex:width a owl:DatatypeProperty ;
    rdfs:label "width" ;
    ex:unit "millimeter" ;
    rdfs:comment "Rack width." ;
    rdfs:domain niLocRacks:rack ;
    rdfs:isDefinedBy modu:ietf-ni-location ;
    rdfs:range xsd:unsignedShort ;
    prov:wasAttributedTo modu:ietf-ni-location ;
    prov:wasDerivedFrom "nwi:network-inventory?container/nil:locations?container/nil:racks?container/nil:rack?list/nil:width?leaf" .

ex:window a owl:DatatypeProperty ;
    rdfs:label "window" ;
    ex:unit "seconds" ;
    rdfs:comment """The time interval over which a MAC mobility event
is detected and checked.
The default value is '180' when this grouping
is used at the service level.""",
        """The timer when a MAC mobility event is
detected.""" ;
    rdfs:domain l2nmGlbMac:mac-loop-prevention,
        l2nmNdMac:mac-loop-prevention,
        l2nmTpMac:mac-loop-prevention ;
    rdfs:range xsd:unsignedInt ;
    prov:wasDerivedFrom "l2vpn-ntw:l2vpn-ntw?container/l2vpn-ntw:vpn-services?container/l2vpn-ntw:vpn-service?list/l2vpn-ntw:vpn-nodes?container/l2vpn-ntw:vpn-node?list/l2vpn-ntw:vpn-network-accesses?container/l2vpn-ntw:vpn-network-access?list/l2vpn-ntw:service?container/l2vpn-ntw:mac-policies?container/l2vpn-ntw:mac-loop-prevention?container/l2vpn-ntw:window?leaf",
        "l2vpn-ntw:mac-policies?container/l2vpn-ntw:mac-loop-prevention?container/l2vpn-ntw:window?leaf" .

ex:x a owl:DatatypeProperty ;
    rdfs:label "x" ;
    ex:unit "meters" ;
    rdfs:comment "The X value as defined by the reference-frame." ;
    rdfs:domain niLocLoc:geo-location ;
    rdfs:isDefinedBy modu:ietf-ni-location ;
    rdfs:range xsd:decimal ;
    prov:wasAttributedTo modu:ietf-ni-location ;
    prov:wasDerivedFrom "geo:geo-location?container/geo:x?leaf" .

ex:y a owl:DatatypeProperty ;
    rdfs:label "y" ;
    ex:unit "meters" ;
    rdfs:comment "The Y value as defined by the reference-frame." ;
    rdfs:domain niLocLoc:geo-location ;
    rdfs:isDefinedBy modu:ietf-ni-location ;
    rdfs:range xsd:decimal ;
    prov:wasAttributedTo modu:ietf-ni-location ;
    prov:wasDerivedFrom "geo:geo-location?container/geo:y?leaf" .

ex:z a owl:DatatypeProperty ;
    rdfs:label "z" ;
    ex:unit "meters" ;
    rdfs:comment "The Z value as defined by the reference-frame." ;
    rdfs:domain niLocLoc:geo-location ;
    rdfs:isDefinedBy modu:ietf-ni-location ;
    rdfs:range xsd:decimal ;
    prov:wasAttributedTo modu:ietf-ni-location ;
    prov:wasDerivedFrom "geo:geo-location?container/geo:z?leaf" .

grpGeo:geo-location a owl:Class ;
    rdfs:label "geo-location" ;
    rdfs:comment "Grouping definition: geo-location",
        "Grouping to identify a location on an astronomical object." .

grpL2t:l2-link-attributes a owl:Class ;
    rdfs:label "l2-link-attributes" ;
    rdfs:comment "Grouping definition: l2-link-attributes",
        "L2 link attributes." .

grpL2t:l2-network-type a owl:Class ;
    rdfs:label "l2-network-type" ;
    rdfs:comment "Grouping definition: l2-network-type",
        "Indicates the topology type to be L2." .

grpL2t:l2-node-attributes a owl:Class ;
    rdfs:label "l2-node-attributes" ;
    rdfs:comment "Grouping definition: l2-node-attributes",
        "L2 node attributes." .

grpL2t:l2-termination-point-attributes a owl:Class ;
    rdfs:label "l2-termination-point-attributes" ;
    rdfs:comment "Grouping definition: l2-termination-point-attributes",
        "L2 termination point attributes." .

grpL2t:l2-topology-attributes a owl:Class ;
    rdfs:label "l2-topology-attributes" ;
    rdfs:comment "Grouping definition: l2-topology-attributes",
        "L2 topology scope attributes." .

ietfL2Nt:y-1731 a owl:Class ;
    rdfs:label "y-1731" ;
    rdfs:comment "Grouping definition: y-1731",
        "Grouping for Y-1731" .

grpNwiTop:link-inventory-mapping-attributes a owl:Class ;
    rdfs:label "link-inventory-mapping-attributes" ;
    rdfs:comment """Attributes for classifying link media type.
Detailed inventory reference is intentionally omitted from
this model; implementations should use the appropriate
specialized inventory modules based on the indicated
link-type.""",
        "Grouping definition: link-inventory-mapping-attributes" .

grpNwiTop:node-inventory-mapping-attributes a owl:Class ;
    rdfs:label "node-inventory-mapping-attributes" ;
    rdfs:comment """Attributes for mapping a topology node to a Network Element
(NE) in the physical inventory.""",
        "Grouping definition: node-inventory-mapping-attributes" .

grpNwiTop:tp-inventory-mapping-attributes a owl:Class ;
    rdfs:label "tp-inventory-mapping-attributes" ;
    rdfs:comment """Attributes for mapping a topology termination point (TP)
to a physical port in the network inventory.""",
        "Grouping definition: tp-inventory-mapping-attributes" .

grpNwi:component-attributes a owl:Class ;
    rdfs:label "component-attributes" ;
    rdfs:comment "Grouping definition: component-attributes",
        """The set of common attributes of a component.

This grouping is intended also to be re-used by data models
that need to report the common attributes of a component.""" .

grpNwi:port-ref a owl:Class ;
    rdfs:label "port-ref" ;
    rdfs:comment "Grouping definition: port-ref",
        """This grouping is intended to be used by data models that need
to reference a port component within a Network Element.""" .

grpNiLoc:locations a owl:Class ;
    rdfs:label "locations" ;
    rdfs:comment "Grouping definition: locations",
        "The grouping of the locations." .

grpNiLoc:locations-ref a owl:Class ;
    rdfs:label "locations-ref" ;
    rdfs:comment "Grouping definition: locations-ref",
        "The attributes of the locations." .

grpNiLoc:physical-address a owl:Class ;
    rdfs:label "physical-address" ;
    rdfs:comment "Grouping definition: physical-address",
        "The grouping of the physical address." .

grpNiLoc:racks a owl:Class ;
    rdfs:label "racks" ;
    rdfs:comment "Grouping definition: racks",
        "The attributes of the rack." .

grpNwiPass:cable-attributes a owl:Class ;
    rdfs:label "cable-attributes" ;
    rdfs:comment "Attributes of cables.",
        "Grouping definition: cable-attributes" .

grpNwiPass:cables a owl:Class ;
    rdfs:label "cables" ;
    rdfs:comment "Attributes applicable to cables.",
        "Grouping definition: cables" .

grpNwiPass:child-cables a owl:Class ;
    rdfs:label "child-cables" ;
    rdfs:comment """Attributes applicable to child cables that are concatnated
