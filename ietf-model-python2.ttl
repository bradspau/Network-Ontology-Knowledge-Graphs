    rdfs:label "any-to-any-role" ;
    rdfs:comment "Site in an any-to-any L2VPN." ;
    rdfs:subClassOf yangId:site-role ;
    prov:wasDerivedFrom "l2vpn-svc:any-to-any-role?identity" .

l2svcId:asm-tree-type a owl:Class,
