    rdfs:subClassOf yangId:bundling-type ;
    prov:wasDerivedFrom "l2vpn-svc:all2one-bundling?identity" .

l2svcId:any-to-any a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "any-to-any" ;
    rdfs:comment "Identity for the any-to-any VPN topology." ;
    rdfs:subClassOf yangId:vpn-topology ;
    prov:wasDerivedFrom "l2vpn-svc:any-to-any?identity" .

l2svcId:any-to-any-role a owl:Class,
