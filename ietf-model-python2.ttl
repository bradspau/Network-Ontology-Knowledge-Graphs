ex:eo-power a owl:DatatypeProperty ;
    rdfs:label "eo-power" ;
    ex:isStateData true ;
    ex:unit "Watts" ;
    rdfs:comment """The current power usage measurement for the energy object.
This value represents the instantaneous power consumption
of the component. Positive values indicate power
consumption, while negative values can indicate power
generation (e.g., for devices with battery backup or
renewable energy sources).""" ;
    rdfs:domain paeEnergy:power-entry ;
    rdfs:range xsd:int ;
    prov:wasDerivedFrom "eo:energy-objects?container/eo:power-entry?list/eo:eo-power?leaf" .

ex:eo-power-data-source-accuracy a owl:ObjectProperty ;
    rdfs:label "eo-power-data-source-accuracy" ;
    ex:isStateData true ;
    rdfs:comment """The accuracy of the power data source. Indicates whether
the data source is a direct measurement, an estimate, or
unavailable and also the accuracy level of the data source.
This metadata is crucial for network management
applications to assess the reliability and accuracy of the
power data.""" ;
    rdfs:domain paeEnergy:power-entry ;
    rdfs:range paeId:data-source-accuracy ;
    prov:wasDerivedFrom "eo:energy-objects?container/eo:power-entry?list/eo:eo-power-data-source-accuracy?leaf" .

ex:eo-power-measurement-local a owl:DatatypeProperty ;
    rdfs:label "eo-power-measurement-local" ;
    ex:isStateData true ;
    rdfs:comment """Indicates whether the power measurement is local (true) or
remote (false). A local measurement is taken directly at
the device, while a remote measurement is collected from
an external source. This information can be useful for
troubleshooting and understanding the data source.""" ;
    rdfs:domain paeEnergy:power-entry ;
    rdfs:range xsd:boolean ;
    prov:wasDerivedFrom "eo:energy-objects?container/eo:power-entry?list/eo:eo-power-measurement-local?leaf" .

ex:eo-power-nameplate a owl:DatatypeProperty ;
    rdfs:label "eo-power-nameplate" ;
    ex:isStateData true ;
    ex:unit "Watts" ;
    rdfs:comment """The nameplate power rating of an energy object. This is
the maximum power that the device is designed to consume or
produce, as specified by the manufacturer. Essential for
power budget calculations and capacity planning.""" ;
    rdfs:domain paeEnergy:power-entry ;
    rdfs:range xsd:unsignedInt ;
    prov:wasDerivedFrom "eo:energy-objects?container/eo:power-entry?list/eo:eo-power-nameplate?leaf" .

ex:eo-power-power-factor a owl:DatatypeProperty ;
    rdfs:label "eo-power-power-factor" ;
    ex:isStateData true ;
    rdfs:comment """The percent value of the power factor measurement for the
energy object. This information is important for
understanding the electrical characteristics of the device
and for correctly interpreting the power data.""" ;
    rdfs:domain paeEnergy:power-entry ;
    rdfs:range xsd:unsignedByte ;
    prov:wasDerivedFrom "eo:energy-objects?container/eo:power-entry?list/eo:eo-power-power-factor?leaf" .

ex:eo-power-unit-multiplier a owl:ObjectProperty ;
    rdfs:label "eo-power-unit-multiplier" ;
    ex:isStateData true ;
    rdfs:comment """The unit multiplier used to measure the power or energy.
This multiplier applies to both eo-power and
eo-power-nameplate values, allowing representation of power
values from milliwatts to gigawatts using integer
arithmetic.""" ;
    rdfs:domain paeEnergy:power-entry ;
    rdfs:range paeId:unit-multiplier ;
    prov:wasDerivedFrom "eo:energy-objects?container/eo:power-entry?list/eo:eo-power-unit-multiplier?leaf" .

ex:esi-pool-name a owl:DatatypeProperty ;
    rdfs:label "esi-pool-name" ;
    rdfs:comment """The auto-assignment will be made from the
pool identified by the ESI-pool-name.""" ;
    rdfs:domain l2esSegItem:esi-auto ;
    rdfs:range xsd:string ;
    prov:wasDerivedFrom "l2vpn-es:ethernet-segments?container/l2vpn-es:ethernet-segment?list/l2vpn-es:esi-auto?container/l2vpn-es:esi-pool-name?leaf" .

ex:esi-redundancy-mode a owl:ObjectProperty ;
    rdfs:label "esi-redundancy-mode" ;
    rdfs:comment "Indicates the ES redundancy mode." ;
    rdfs:domain l2esSeg:ethernet-segment ;
    rdfs:range ietfEtSe:es-redundancy-mode ;
    prov:wasDerivedFrom "l2vpn-es:ethernet-segments?container/l2vpn-es:ethernet-segment?list/l2vpn-es:esi-redundancy-mode?leaf" .

ex:esi-type a owl:ObjectProperty ;
    rdfs:label "esi-type" ;
    rdfs:comment """T-(ESI Type) is a 1-octet field (most significant
octet) that specifies the format of the remaining
