l2nmId:hvpls a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "hvpls" ;
    rdfs:comment """Identity for Hierarchical Virtual Private LAN Service (H-VPLS)
t-ldp-pw-type.""" ;
    rdfs:subClassOf yangId:t-ldp-pw-type ;
    prov:wasDerivedFrom "l2vpn-ntw:hvpls?identity" .

l2nmId:lacp-active a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "lacp-active" ;
    rdfs:comment """LACP active mode.

This mode refers to the mode where auto-speed negotiation
is initiated followed by an establishment of an
Ethernet channel with the other end.""" ;
    rdfs:subClassOf yangId:lacp-mode ;
    prov:wasDerivedFrom "l2vpn-ntw:lacp-active?identity" .

l2nmId:lacp-passive a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "lacp-passive" ;
    rdfs:comment """LACP passive mode.

This mode refers to the LACP mode where an endpoint does
not initiate the negotiation but only responds to LACP
packets initiated by the other end (e.g., full duplex
or half duplex)""" ;
    rdfs:subClassOf yangId:lacp-mode ;
    prov:wasDerivedFrom "l2vpn-ntw:lacp-passive?identity" .

l2nmId:loss a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "loss" ;
    rdfs:comment "Loss measurement is the performance monitoring type." ;
    rdfs:subClassOf yangId:pm-type ;
    prov:wasDerivedFrom "l2vpn-ntw:loss?identity" .

l2nmId:mapping-type a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "mapping-type" ;
    rdfs:comment "Identity for multicast group mapping type." ;
    rdfs:subClassOf ietfVpCo2:multicast-gp-address-mapping ;
    prov:wasDerivedFrom "l2vpn-ntw:mapping-type?identity" .

l2nmId:primary a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "primary" ;
    rdfs:comment "Identifies the main VPN network access." ;
    rdfs:subClassOf yangId:precedence-type ;
    prov:wasDerivedFrom "l2vpn-ntw:primary?identity" .

l2nmId:red a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "red" ;
    rdfs:comment """'red' color type.  A service frame is 'red' if it is not
conformant with both the committed and excess rates of the
bandwidth profile.""" ;
    rdfs:subClassOf yangId:color-type ;
    prov:wasDerivedFrom "l2vpn-ntw:red?identity" .

l2nmId:secondary a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "secondary" ;
    rdfs:comment "Identifies the secondary VPN network access." ;
    rdfs:subClassOf yangId:precedence-type ;
    prov:wasDerivedFrom "l2vpn-ntw:secondary?identity" .

l2nmId:shut a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "shut" ;
    rdfs:comment "Shut protection type." ;
    rdfs:subClassOf yangId:loop-prevention-type ;
    prov:wasDerivedFrom "l2vpn-ntw:shut?identity" .

l2nmId:trap a owl:Class,
        owl:NamedIndividual ;
