l2svcId:bgp a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "bgp" ;
    rdfs:comment """Use BGP (as per RFC 8277) as the signaling protocol
between the PE and the CE.
In this case, BGP must also be configured as
the routing protocol.""" ;
    rdfs:subClassOf yangId:carrierscarrier-type ;
    prov:wasDerivedFrom "l2vpn-svc:bgp?identity" .

l2svcId:bgp-mode a owl:Class,
