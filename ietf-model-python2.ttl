        "l2vpn-svc:l2vpn-svc?container/l2vpn-svc:sites?container/l2vpn-svc:site?list/l2vpn-svc:site-network-accesses?container/l2vpn-svc:site-network-access?list/l2vpn-svc:connection?container/l2vpn-svc:lag-interfaces?container/l2vpn-svc:lag-interface?list/l2vpn-svc:lacp?container/l2vpn-svc:member-links?container/l2vpn-svc:member-link?list/l2vpn-svc:mode?leaf",
        "l2vpn-svc:l2vpn-svc?container/l2vpn-svc:sites?container/l2vpn-svc:site?list/l2vpn-svc:site-network-accesses?container/l2vpn-svc:site-network-access?list/l2vpn-svc:connection?container/l2vpn-svc:lag-interfaces?container/l2vpn-svc:lag-interface?list/l2vpn-svc:lacp?container/l2vpn-svc:mode?leaf",
