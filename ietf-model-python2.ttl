    rdfs:label "vpws-type" ;
    rdfs:comment "Virtual Private Wire Service (VPWS) t-ldp-pw-type." ;
    rdfs:subClassOf yangId:t-ldp-pw-type ;
    prov:wasDerivedFrom "l2vpn-ntw:vpws-type?identity" .

l2nmId:warning a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "warning" ;
    rdfs:comment "Log a warning message as the MAC action." ;
    rdfs:subClassOf yangId:mac-action ;
    prov:wasDerivedFrom "l2vpn-ntw:warning?identity" .

l2nmId:yellow a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "yellow" ;
    rdfs:comment """'yellow' color type.  A service frame is 'yellow' if it
exceeds the committed rate but is conformant with the excess
rate of the bandwidth profile.""" ;
    rdfs:subClassOf yangId:color-type ;
    prov:wasDerivedFrom "l2vpn-ntw:yellow?identity" .

