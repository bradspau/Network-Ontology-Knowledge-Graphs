ex:access-priority a owl:DatatypeProperty ;
    rdfs:label "access-priority" ;
    rdfs:comment """Access priority.  The higher the access-priority
value, the higher the preference will be for the
access in question.""" ;
    rdfs:domain l2svcTp:availability ;
    rdfs:range xsd:unsignedInt ;
    prov:wasDerivedFrom "l2vpn-svc:l2vpn-svc?container/l2vpn-svc:sites?container/l2vpn-svc:site?list/l2vpn-svc:site-network-accesses?container/l2vpn-svc:site-network-access?list/l2vpn-svc:availability?container/l2vpn-svc:access-priority?leaf" .

ex:action a owl:ObjectProperty ;
    rdfs:label "action" ;
    rdfs:comment """Specifies the action taken when the upper limit is
exceeded: drop the packet, flood the packet, or
simply send a warning log message.  By default,
the action is set to 'warning'.""",
        """Specifies the action when the upper limit
is exceeded: drop the packet, flood the
packet, or log a warning message (without
dropping the packet).""",
        """Specifies the action when the upper limit is
exceeded: drop the packet, flood the packet,
or log a warning message (without dropping
the packet).
The default value is 'warning' when this
grouping is used at the service level.""",
        "Specifies the filtering action." ;
    rdfs:domain l2nmGlbMac:mac-addr-limit,
        l2nmNdMac:mac-addr-limit,
        l2nmTpMac:access-control-list,
        l2nmTpMac:mac-addr-limit,
        l2svcTp:mac-addr-limit ;
    rdfs:range l2nmId:mac-action,
        l2svcId:mac-action ;
    prov:wasDerivedFrom "l2vpn-ntw:l2vpn-ntw?container/l2vpn-ntw:vpn-services?container/l2vpn-ntw:vpn-service?list/l2vpn-ntw:vpn-nodes?container/l2vpn-ntw:vpn-node?list/l2vpn-ntw:vpn-network-accesses?container/l2vpn-ntw:vpn-network-access?list/l2vpn-ntw:service?container/l2vpn-ntw:mac-policies?container/l2vpn-ntw:access-control-list?list/l2vpn-ntw:action?leaf",
        "l2vpn-ntw:l2vpn-ntw?container/l2vpn-ntw:vpn-services?container/l2vpn-ntw:vpn-service?list/l2vpn-ntw:vpn-nodes?container/l2vpn-ntw:vpn-node?list/l2vpn-ntw:vpn-network-accesses?container/l2vpn-ntw:vpn-network-access?list/l2vpn-ntw:service?container/l2vpn-ntw:mac-policies?container/l2vpn-ntw:mac-addr-limit?container/l2vpn-ntw:action?leaf",
        "l2vpn-ntw:mac-policies?container/l2vpn-ntw:mac-addr-limit?container/l2vpn-ntw:action?leaf",
        "l2vpn-svc:l2vpn-svc?container/l2vpn-svc:sites?container/l2vpn-svc:site?list/l2vpn-svc:site-network-accesses?container/l2vpn-svc:site-network-access?list/l2vpn-svc:mac-addr-limit?container/l2vpn-svc:action?leaf" .

ex:active-vpn-node-profile a owl:ObjectProperty ;
    rdfs:label "active-vpn-node-profile" ;
    ex:xpathPath "../../../active-global-parameters-profiles/global-parameters-profile/profile-id" ;
    rdfs:comment """An identifier of an active VPN instance
profile.""" ;
    rdfs:domain l2nmTps:vpn-network-access ;
    rdfs:range l2nmNdProf:global-parameters-profile ;
    prov:wasDerivedFrom "l2vpn-ntw:l2vpn-ntw?container/l2vpn-ntw:vpn-services?container/l2vpn-ntw:vpn-service?list/l2vpn-ntw:vpn-nodes?container/l2vpn-ntw:vpn-node?list/l2vpn-ntw:vpn-network-accesses?container/l2vpn-ntw:vpn-network-access?list/l2vpn-ntw:active-vpn-node-profile?leaf" .

ex:actual-site-start a owl:DatatypeProperty ;
    rdfs:label "actual-site-start" ;
    ex:isStateData true ;
    rdfs:comment """This leaf is optional.  It indicates the date and time
when the service at a particular site actually started.""" ;
    rdfs:domain l2svcSites:site ;
    rdfs:range xsd:dateTime ;
    prov:wasDerivedFrom "l2vpn-svc:l2vpn-svc?container/l2vpn-svc:sites?container/l2vpn-svc:site?list/l2vpn-svc:actual-site-start?leaf" .

ex:actual-site-stop a owl:DatatypeProperty ;
    rdfs:label "actual-site-stop" ;
    ex:isStateData true ;
    rdfs:comment """This leaf is optional.  It indicates the date and time
when the service at a particular site actually stopped.""" ;
    rdfs:domain l2svcSites:site ;
    rdfs:range xsd:dateTime ;
    prov:wasDerivedFrom "l2vpn-svc:l2vpn-svc?container/l2vpn-svc:sites?container/l2vpn-svc:site?list/l2vpn-svc:actual-site-stop?leaf" .

ex:address a owl:DatatypeProperty ;
    rdfs:label "address" ;
    rdfs:comment "Address (number and street) of the site.",
        "Management address.",
        "Specifies an address (number and street)." ;
    rdfs:domain l2svcDev:management,
        l2svcLocs:location,
        niLocLoc:physical-address ;
    rdfs:range xsd:string ;
    prov:wasDerivedFrom "l2vpn-svc:l2vpn-svc?container/l2vpn-svc:sites?container/l2vpn-svc:site?list/l2vpn-svc:devices?container/l2vpn-svc:device?list/l2vpn-svc:management?container/l2vpn-svc:address?leaf",
        "l2vpn-svc:l2vpn-svc?container/l2vpn-svc:sites?container/l2vpn-svc:site?list/l2vpn-svc:locations?container/l2vpn-svc:location?list/l2vpn-svc:address?leaf",
        "nil:physical-address?container/nil:address?leaf" .

ex:admin-key a owl:DatatypeProperty ;
    rdfs:label "admin-key" ;
    rdfs:comment """Indicates the value of the key used for
the aggregate interface.""" ;
    rdfs:domain l2nmTpLag:lacp ;
    rdfs:range xsd:unsignedShort ;
    prov:wasDerivedFrom "l2vpn-ntw:l2vpn-ntw?container/l2vpn-ntw:vpn-services?container/l2vpn-ntw:vpn-service?list/l2vpn-ntw:vpn-nodes?container/l2vpn-ntw:vpn-node?list/l2vpn-ntw:vpn-network-accesses?container/l2vpn-ntw:vpn-network-access?list/l2vpn-ntw:connection?container/l2vpn-ntw:lag-interface?container/l2vpn-ntw:lacp?container/l2vpn-ntw:admin-key?leaf" .

ex:admin-state a owl:ObjectProperty ;
    rdfs:label "admin-state" ;
    rdfs:comment """The administrative state for this component.

This node refers to a component's administrative
permission to service both other components within its
containment hierarchy as well other users of its
services defined by means outside the scope of this
module.

Some components exhibit only a subset of the remaining
administrative state values.  Some components cannot be
locked; hence, this node exhibits only the 'unlocked'
state.  Other components cannot be shut down gracefully;
hence, this node does not exhibit the 'shutting-down'
state.""" ;
    rdfs:domain hwComp:state ;
    rdfs:range hwTypes:admin-state ;
    prov:wasDerivedFrom "hw:hardware?container/hw:component?list/hw:state?container/hw:admin-state?leaf" .

ex:advertise-mtu a owl:DatatypeProperty ;
    rdfs:label "advertise-mtu" ;
    rdfs:comment "Controls whether MTU is advertised." ;
    rdfs:domain l2nmNode:signaling-option ;
    rdfs:range xsd:boolean ;
    prov:wasDerivedFrom "l2vpn-ntw:l2vpn-ntw?container/l2vpn-ntw:vpn-services?container/l2vpn-ntw:vpn-service?list/l2vpn-ntw:vpn-nodes?container/l2vpn-ntw:vpn-node?list/l2vpn-ntw:signaling-option?container/l2vpn-ntw:advertise-mtu?leaf" .

ex:agi a owl:DatatypeProperty ;
    rdfs:label "agi" ;
    rdfs:comment """Attachment Group Identifier.  Also, called
VPLS-Id.""" ;
    rdfs:domain l2nmNdSig:ldp-or-l2tp ;
    rdfs:range xsd:string ;
    prov:wasDerivedFrom "l2vpn-ntw:l2vpn-ntw?container/l2vpn-ntw:vpn-services?container/l2vpn-ntw:vpn-service?list/l2vpn-ntw:vpn-nodes?container/l2vpn-ntw:vpn-node?list/l2vpn-ntw:signaling-option?container/l2vpn-ntw:ldp-or-l2tp?container/l2vpn-ntw:agi?leaf" .

ex:alarm-priority-defect a owl:ObjectProperty ;
    rdfs:label "alarm-priority-defect" ;
    rdfs:comment """The lowest-priority defect that is
allowed to generate a fault alarm.  By default,
'fault-alarm-defect-type' is set to
'remote-invalid-ccm'.  The non-existence of
this leaf means that no defects are
to be reported.""" ;
    rdfs:domain l2svcOam:cfm-8021-ag ;
    rdfs:range l2svcId:fault-alarm-defect-type ;
    prov:wasDerivedFrom "l2vpn-svc:l2vpn-svc?container/l2vpn-svc:sites?container/l2vpn-svc:site?list/l2vpn-svc:site-network-accesses?container/l2vpn-svc:site-network-access?list/l2vpn-svc:connection?container/l2vpn-svc:oam?container/l2vpn-svc:cfm-8021-ag?list/l2vpn-svc:alarm-priority-defect?leaf" .

ex:alarm-state a owl:DatatypeProperty ;
    rdfs:label "alarm-state" ;
    ex:isStateData true ;
    rdfs:comment """The alarm state for this component.  It does not
include the alarms raised on child components within its
containment hierarchy.""" ;
    rdfs:domain hwComp:state ;
    rdfs:range rdfs:Literal ;
    prov:wasDerivedFrom "hw:hardware?container/hw:component?list/hw:state?container/hw:alarm-state?leaf" .

ex:alias a owl:DatatypeProperty ;
    rdfs:label "alias" ;
    rdfs:comment """An 'alias' name for the component, as specified by a
network manager, that provides a non-volatile 'handle' for
the component.

If no configured value exists, the server MAY set the
value of this node to a locally unique value in the
operational state.

A server implementation MAY map this leaf to the
entPhysicalAlias MIB object.  Such an implementation needs
to use some mechanism to handle the differences in size
and characters allowed between this leaf and
entPhysicalAlias.  The definition of such a mechanism is
outside the scope of this document.""",
        """The alias name of the entity (e.g., component). This alias
name can be specified by a network operator.""" ;
    rdfs:domain hw:component,
        nwi:cable,
        nwiLocs:location,
        niLocRacks:rack,
        nwiNEs:network-element,
        nwiComps:component,
        nwi:passive-device,
        pdev:passive-port ;
    rdfs:range xsd:string ;
    prov:wasDerivedFrom "hw:hardware?container/hw:component?list/hw:alias?leaf",
        "nwi:alias?leaf" .

ex:all-active a owl:DatatypeProperty ;
    rdfs:label "all-active" ;
    rdfs:comment "All-active mode." ;
    rdfs:domain l2svcTp:availability ;
    rdfs:range xsd:boolean ;
    prov:wasDerivedFrom "l2vpn-svc:l2vpn-svc?container/l2vpn-svc:sites?container/l2vpn-svc:site?list/l2vpn-svc:site-network-accesses?container/l2vpn-svc:site-network-access?list/l2vpn-svc:availability?container/l2vpn-svc:all-active?leaf" .

ex:all-other-accesses a owl:DatatypeProperty ;
    rdfs:label "all-other-accesses" ;
    rdfs:comment """The constraint will apply against all other
site network accesses of this site.""" ;
    rdfs:domain l2svcCon:target ;
    rdfs:range xsd:boolean ;
    prov:wasDerivedFrom "l2vpn-svc:l2vpn-svc?container/l2vpn-svc:sites?container/l2vpn-svc:site?list/l2vpn-svc:site-network-accesses?container/l2vpn-svc:site-network-access?list/l2vpn-svc:access-diversity?container/l2vpn-svc:constraints?container/l2vpn-svc:constraint?list/l2vpn-svc:target?container/l2vpn-svc:all-other-accesses?leaf" .

ex:all-other-groups a owl:DatatypeProperty ;
    rdfs:label "all-other-groups" ;
    rdfs:comment """The constraint will apply against all other
groups the customer is managing.""" ;
    rdfs:domain l2svcCon:target ;
    rdfs:range xsd:boolean ;
    prov:wasDerivedFrom "l2vpn-svc:l2vpn-svc?container/l2vpn-svc:sites?container/l2vpn-svc:site?list/l2vpn-svc:site-network-accesses?container/l2vpn-svc:site-network-access?list/l2vpn-svc:access-diversity?container/l2vpn-svc:constraints?container/l2vpn-svc:constraint?list/l2vpn-svc:target?container/l2vpn-svc:all-other-groups?leaf" .

ex:alternate-system a owl:DatatypeProperty ;
    rdfs:label "alternate-system" ;
    rdfs:comment """The system in which the astronomical body and
geodetic-datum is defined.  Normally, this value is not
present and the system is the natural universe; however,
when present, this value allows for specifying alternate
systems (e.g., virtual realities).  An alternate-system
modifies the definition (but not the type) of the other
values in the reference frame.""" ;
    rdfs:domain nwiGeo:reference-frame ;
    rdfs:isDefinedBy modu:ietf-ni-location ;
    rdfs:range xsd:string ;
    prov:wasAttributedTo modu:ietf-ni-location ;
    prov:wasDerivedFrom "geo:geo-location?container/geo:reference-frame?container/geo:alternate-system?leaf" .

ex:always-on a owl:DatatypeProperty ;
    rdfs:label "always-on" ;
    rdfs:comment """Request for an 'always-on' access type.
For example, this could mean no dial-in access
type.""" ;
    rdfs:domain l2svcTp:bearer ;
    rdfs:range xsd:boolean ;
    prov:wasDerivedFrom "l2vpn-svc:l2vpn-svc?container/l2vpn-svc:sites?container/l2vpn-svc:site?list/l2vpn-svc:site-network-accesses?container/l2vpn-svc:site-network-access?list/l2vpn-svc:bearer?container/l2vpn-svc:always-on?leaf" .

ex:any a owl:DatatypeProperty ;
    rdfs:label "any" ;
    rdfs:comment "Allow all.",
        "Allows all." ;
    rdfs:domain l2nmTpQosRule:match-flow,
        l2svcSiteQosRule:match-flow,
        l2svcTpQosRule:match-flow ;
    rdfs:range xsd:boolean ;
    prov:wasDerivedFrom "l2vpn-ntw:l2vpn-ntw?container/l2vpn-ntw:vpn-services?container/l2vpn-ntw:vpn-service?list/l2vpn-ntw:vpn-nodes?container/l2vpn-ntw:vpn-node?list/l2vpn-ntw:vpn-network-accesses?container/l2vpn-ntw:vpn-network-access?list/l2vpn-ntw:service?container/l2vpn-ntw:qos?container/l2vpn-ntw:qos-classification-policy?container/l2vpn-ntw:rule?list/l2vpn-ntw:match-flow?container/l2vpn-ntw:any?leaf",
        "l2vpn-svc:l2vpn-svc?container/l2vpn-svc:sites?container/l2vpn-svc:site?list/l2vpn-svc:service?container/l2vpn-svc:qos?container/l2vpn-svc:qos-classification-policy?container/l2vpn-svc:rule?list/l2vpn-svc:match-flow?container/l2vpn-svc:any?leaf",
        "l2vpn-svc:l2vpn-svc?container/l2vpn-svc:sites?container/l2vpn-svc:site?list/l2vpn-svc:site-network-accesses?container/l2vpn-svc:site-network-access?list/l2vpn-svc:service?container/l2vpn-svc:qos?container/l2vpn-svc:qos-classification-policy?container/l2vpn-svc:rule?list/l2vpn-svc:match-flow?container/l2vpn-svc:any?leaf" .

ex:arp-suppression a owl:DatatypeProperty ;
    rdfs:label "arp-suppression" ;
    rdfs:comment """Enables (when set to 'true') or
disables (when set to 'false') ARP
suppression.""" ;
    rdfs:domain l2nmNdEvpn:arp-proxy ;
    rdfs:range xsd:boolean ;
    prov:wasDerivedFrom "l2vpn-ntw:l2vpn-ntw?container/l2vpn-ntw:vpn-services?container/l2vpn-ntw:vpn-service?list/l2vpn-ntw:vpn-nodes?container/l2vpn-ntw:vpn-node?list/l2vpn-ntw:signaling-option?container/l2vpn-ntw:evpn-policies?container/l2vpn-ntw:arp-proxy?container/l2vpn-ntw:arp-suppression?leaf" .

ex:asset-id a owl:DatatypeProperty ;
    rdfs:label "asset-id" ;
    rdfs:comment """This node is a user-assigned asset tracking identifier for
the component.

A server implementation MAY map this leaf to the
entPhysicalAssetID MIB object.  Such an implementation
needs to use some mechanism to handle the differences in
size and characters allowed between this leaf and
entPhysicalAssetID.  The definition of such a mechanism is
outside the scope of this document.""",
        """This node is an asset tracking identifier for the component,
as specified by a network operator.

A server implementation MAY map this leaf to the
entPhysicalAssetID MIB object.  Such an
implementation needs to use some mechanism to handle
the differences in size and characters allowed
between this leaf and entPhysicalAssetID.

The definition of such a mechanism is outside the
scope of this document.""" ;
    rdfs:domain hw:component,
        nwiComps:component ;
    rdfs:range xsd:string ;
    prov:wasDerivedFrom "hw:hardware?container/hw:component?list/hw:asset-id?leaf",
        "nwi:asset-id?leaf" .

ex:astronomical-body a owl:DatatypeProperty ;
    rdfs:label "astronomical-body" ;
    rdfs:comment """An astronomical body as named by the International
Astronomical Union (IAU) or according to the alternate
system if specified.  Examples include 'sun' (our star),
'earth' (our planet), 'moon' (our moon), 'enceladus' (a
moon of Saturn), 'ceres' (an asteroid), and
'67p/churyumov-gerasimenko (a comet).  The ASCII value
SHOULD have uppercase converted to lowercase and not
include control characters (i.e., values 32..64, and
91..126).  Any preceding 'the' in the name SHOULD NOT be
included.""" ;
    rdfs:domain nwiGeo:reference-frame ;
    rdfs:isDefinedBy modu:ietf-ni-location ;
    rdfs:range xsd:string ;
    prov:wasAttributedTo modu:ietf-ni-location ;
    prov:wasDerivedFrom "geo:geo-location?container/geo:reference-frame?container/geo:astronomical-body?leaf" .

ex:attenuation a owl:DatatypeProperty ;
    rdfs:label "attenuation" ;
    ex:unit "dB" ;
    rdfs:comment "The fiber attenuation in dB." ;
    rdfs:domain cab:optical-cable ;
    rdfs:isDefinedBy modu:ietf-nwi-passive-inventory ;
    rdfs:range xsd:decimal ;
    prov:wasAttributedTo modu:ietf-nwi-passive-inventory ;
    prov:wasDerivedFrom "nwi-passive:optical-cable?container/nwi-passive:attenuation?leaf" .

ex:auto a owl:DatatypeProperty ;
    rdfs:label "auto" ;
    rdfs:comment "Indicates an ESI is fully auto-assigned.",
        """Indicates that a local VSI
is fully auto-assigned.""",
        """Indicates that a remote VSI
is fully auto-assigned.""" ;
    rdfs:domain l2esSegItem:esi-auto,
        l2nmVpws:local-vsi-auto,
