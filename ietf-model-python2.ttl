ex:ce-id a owl:DatatypeProperty ;
    rdfs:label "ce-id" ;
    rdfs:comment "Identifies the CE within the VPN." ;
    rdfs:domain l2nmTps:vpn-network-access ;
    rdfs:range xsd:unsignedShort ;
    prov:wasDerivedFrom "l2vpn-ntw:l2vpn-ntw?container/l2vpn-ntw:vpn-services?container/l2vpn-ntw:vpn-service?list/l2vpn-ntw:vpn-nodes?container/l2vpn-ntw:vpn-node?list/l2vpn-ntw:vpn-network-accesses?container/l2vpn-ntw:vpn-network-access?list/l2vpn-ntw:ce-id?leaf" .

ex:ce-range a owl:DatatypeProperty ;
    rdfs:label "ce-range" ;
    rdfs:comment """Determines the number of remote CEs with
which a given CE can communicate in the
 context of a VPN.""" ;
    rdfs:domain l2nmNode:signaling-option ;
    rdfs:range xsd:unsignedShort ;
    prov:wasDerivedFrom "l2vpn-ntw:l2vpn-ntw?container/l2vpn-ntw:vpn-services?container/l2vpn-ntw:vpn-service?list/l2vpn-ntw:vpn-nodes?container/l2vpn-ntw:vpn-node?list/l2vpn-ntw:signaling-option?container/l2vpn-ntw:ce-range?leaf" .

ex:ce-vlan-cos-preservation a owl:DatatypeProperty ;
    rdfs:label "ce-vlan-cos-preservation" ;
    rdfs:comment """CE VLAN CoS preservation.  Priority Code Point (PCP) bits
in the CE VLAN tag of the egress frame are identical to
those of the ingress frame that yielded this egress
service frame.""",
        """CE VLAN CoS preservation.  The PCP bits in the CE-VLAN tag
of the egress frame are identical to those of the
ingress frame that yielded this egress service frame.""" ;
    rdfs:domain l2nmGlbProf:global-parameters-profile,
        l2nmNdProf:global-parameters-profile,
        vpnSe:vpn-service ;
    rdfs:range xsd:boolean ;
    prov:wasDerivedFrom "l2vpn-ntw:ce-vlan-cos-preservation?leaf",
        "l2vpn-svc:l2vpn-svc?container/l2vpn-svc:vpn-services?container/l2vpn-svc:vpn-service?list/l2vpn-svc:ce-vlan-cos-preservation?leaf" .

ex:ce-vlan-preservation a owl:DatatypeProperty ;
    rdfs:label "ce-vlan-preservation" ;
    rdfs:comment """Preserves the CE VLAN ID from ingress to egress, i.e.,
the CE VLAN tag of the egress frame is identical to
that of the ingress frame that yielded this egress
service frame.  If all-to-one bundling within a site
is enabled, then preservation applies to all ingress
service frames.  If all-to-one bundling is disabled,
then preservation applies to tagged ingress service
frames having CE VLAN ID 1 through 4094.""",
        """Preserves the CE-VLAN ID from ingress to egress, i.e.,
the CE-VLAN tag of the egress frame is identical to
that of the ingress frame that yielded this
egress service frame.  If all-to-one bundling within
a site is enabled, then preservation applies to all
ingress service frames.  If all-to-one bundling is
disabled, then preservation applies to tagged
ingress service frames having CE-VLAN IDs 1 through 4094.""" ;
    rdfs:domain l2nmGlbProf:global-parameters-profile,
        l2nmNdProf:global-parameters-profile,
        vpnSe:vpn-service ;
    rdfs:range xsd:boolean ;
    prov:wasDerivedFrom "l2vpn-ntw:ce-vlan-preservation?leaf",
        "l2vpn-svc:l2vpn-svc?container/l2vpn-svc:vpn-services?container/l2vpn-svc:vpn-service?list/l2vpn-svc:ce-vlan-preservation?leaf" .

