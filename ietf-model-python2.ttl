        l2nmId:neg-mode,
        l2svcTypes:neg-mode ;
    prov:wasDerivedFrom "l2vpn-ntw:l2vpn-ntw?container/l2vpn-ntw:vpn-services?container/l2vpn-ntw:vpn-service?list/l2vpn-ntw:vpn-nodes?container/l2vpn-ntw:vpn-node?list/l2vpn-ntw:vpn-network-accesses?container/l2vpn-ntw:vpn-network-access?list/l2vpn-ntw:connection?container/l2vpn-ntw:lag-interface?container/l2vpn-ntw:lacp?container/l2vpn-ntw:member-link-list?container/l2vpn-ntw:member-link?list/l2vpn-ntw:mode?leaf",
