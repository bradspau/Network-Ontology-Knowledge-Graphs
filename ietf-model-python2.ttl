ex:inner-tag a owl:DatatypeProperty ;
    rdfs:label "inner-tag" ;
    rdfs:comment """The inner VLAN tag.  It may include a list of VLAN
Ids or nonoverlapping VLAN ranges.""" ;
    rdfs:domain nw-s-tp:l2-termination-point-attributes ;
    rdfs:isDefinedBy modu:ietf-l2-topology-state ;
    rdfs:range xsd:string ;
    prov:wasAttributedTo modu:ietf-l2-topology-state ;
    prov:wasDerivedFrom "l2t:l2-termination-point-attributes?container/l2t:inner-tag?leaf" .

ex:inner-tpid a owl:DatatypeProperty ;
