ietfEtSe:esi-type a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "esi-type" ;
    rdfs:comment """T (Ethernet Segment Identifier (ESI) Type) is a 1-octet field
(most significant octet) that specifies the format of the
remaining 9 octets (ESI Value).""" ;
    prov:wasDerivedFrom "l2vpn-es:esi-type?identity" .

l2tId:eth-encapsulation-type a owl:Class,
