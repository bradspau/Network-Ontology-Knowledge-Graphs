    rdfs:comment "VLAN bundle service interface." ;
    rdfs:subClassOf yangId:evpn-service-interface-type ;
    prov:wasDerivedFrom "l2vpn-ntw:vlan-bundle-service-interface?identity" .

l2nmId:vpls-type a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "vpls-type" ;
    rdfs:comment "Virtual Private LAN Service (VPLS) t-ldp-pw-type." ;
    rdfs:subClassOf yangId:t-ldp-pw-type ;
    prov:wasDerivedFrom "l2vpn-ntw:vpls-type?identity" .

l2nmId:vpws-type a owl:Class,
