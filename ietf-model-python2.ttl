        "l2vpn-svc:l2vpn-svc?container/l2vpn-svc:sites?container/l2vpn-svc:site?list/l2vpn-svc:site-network-accesses?container/l2vpn-svc:site-network-access?list/l2vpn-svc:service?container/l2vpn-svc:svc-bandwidth?container/l2vpn-svc:bandwidth?list/l2vpn-svc:pir?leaf" .

