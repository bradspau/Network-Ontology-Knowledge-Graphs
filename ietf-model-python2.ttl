        l2nmTpMac:access-control-list,
        membLi3:member-link,
        nwi:cable,
        nwiLocs:location,
        niLocRacks:rack,
        nwiNEs:network-element,
        nwiComps:component,
        nwiComp:software-rev,
        nwiNE:software-rev,
        nwi:passive-device,
        pdev:passive-port,
        nws-link:l2-link-attributes,
        net:l2-topology-attributes,
        nw-node:l2-node-attributes ;
    rdfs:range xsd:string ;
    prov:wasDerivedFrom "hw:hardware?container/hw:component?list/hw:name?leaf",
        "l2t:l2-link-attributes?container/l2t:name?leaf",
        "l2t:l2-node-attributes?container/l2t:name?leaf",
        "l2t:l2-topology-attributes?container/l2t:name?leaf",
        "l2vpn-es:ethernet-segments?container/l2vpn-es:ethernet-segment?list/l2vpn-es:name?leaf",
        "l2vpn-ntw:l2vpn-ntw?container/l2vpn-ntw:vpn-services?container/l2vpn-ntw:vpn-service?list/l2vpn-ntw:vpn-nodes?container/l2vpn-ntw:vpn-node?list/l2vpn-ntw:vpn-network-accesses?container/l2vpn-ntw:vpn-network-access?list/l2vpn-ntw:connection?container/l2vpn-ntw:lag-interface?container/l2vpn-ntw:lacp?container/l2vpn-ntw:member-link-list?container/l2vpn-ntw:member-link?list/l2vpn-ntw:name?leaf",
        "l2vpn-ntw:l2vpn-ntw?container/l2vpn-ntw:vpn-services?container/l2vpn-ntw:vpn-service?list/l2vpn-ntw:vpn-nodes?container/l2vpn-ntw:vpn-node?list/l2vpn-ntw:vpn-network-accesses?container/l2vpn-ntw:vpn-network-access?list/l2vpn-ntw:service?container/l2vpn-ntw:mac-policies?container/l2vpn-ntw:access-control-list?list/l2vpn-ntw:name?leaf",
        "l2vpn-svc:l2vpn-svc?container/l2vpn-svc:sites?container/l2vpn-svc:site?list/l2vpn-svc:site-network-accesses?container/l2vpn-svc:site-network-access?list/l2vpn-svc:connection?container/l2vpn-svc:lag-interfaces?container/l2vpn-svc:lag-interface?list/l2vpn-svc:lacp?container/l2vpn-svc:member-links?container/l2vpn-svc:member-link?list/l2vpn-svc:name?leaf",
        "nwi:name?leaf",
        "nwi:software-rev?list/nwi:name?leaf" .

ex:nd-suppression a owl:DatatypeProperty ;
    rdfs:label "nd-suppression" ;
    rdfs:comment """Enables (when set to 'true') or
disables (when set to 'false')
Neighbor Discovery (ND) message
suppression.
ND suppression is a technique that
is used to reduce the amount of ND
packets flooding within individual
segments between hosts
connected to the same logical
switch.""" ;
    rdfs:domain l2nmNdEvpn:nd-proxy ;
    rdfs:range xsd:boolean ;
    prov:wasDerivedFrom "l2vpn-ntw:l2vpn-ntw?container/l2vpn-ntw:vpn-services?container/l2vpn-ntw:vpn-service?list/l2vpn-ntw:vpn-nodes?container/l2vpn-ntw:vpn-node?list/l2vpn-ntw:signaling-option?container/l2vpn-ntw:evpn-policies?container/l2vpn-ntw:nd-proxy?container/l2vpn-ntw:nd-suppression?leaf" .

ex:ne-id a owl:DatatypeProperty ;
    rdfs:label "ne-id" ;
    rdfs:comment """An identifier of the network element where
the VPN node is deployed.  This identifier
uniquely identifies the network element within
an administrative domain.""",
        """An identifier of the network element where the ES
is configured within a service provider network.""",
        """An identifier that uniquely identifies the NE in
a network.""" ;
    rdfs:domain l2esSegItem:member,
        l2nmNodes:vpn-node,
        nwiNEs:network-element ;
    rdfs:range xsd:string ;
    prov:wasDerivedFrom "l2vpn-es:ethernet-segments?container/l2vpn-es:ethernet-segment?list/l2vpn-es:member?list/l2vpn-es:ne-id?leaf",
        "l2vpn-ntw:l2vpn-ntw?container/l2vpn-ntw:vpn-services?container/l2vpn-ntw:vpn-service?list/l2vpn-ntw:vpn-nodes?container/l2vpn-ntw:vpn-node?list/l2vpn-ntw:ne-id?leaf",
        "nwi:network-inventory?container/nwi:network-elements?container/nwi:network-element?list/nwi:ne-id?leaf" .

ex:ne-ref a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "ne-ref" ;
    ex:xpathPath "/nwi:network-inventory/nwi:network-elements/nwi:network-element/nwi:ne-id" ;
    rdfs:comment """Reference to the NE in the inventory that corresponds to
this topology node.

This reference establishes a 1:1 mapping between the
logical node and its physical NE.""",
        "Referenced Network Element (NE).",
        """The reference to the Network Element which contains the
port to be referenced.""",
        """The reference to the network element containing
the chassis component.""" ;
    rdfs:domain cab:a-end,
        cabChild:a-end,
        cabChild:z-end,
        cab:z-end,
        niLocRack:contained-chassis,
        nw-s-tp:inventory-mapping-attributes,
        nw-node:inventory-mapping-attributes ;
    rdfs:isDefinedBy modu:ietf-network-inventory-topology ;
    rdfs:range nwiNEs:network-element,
        xsd:string ;
    prov:wasAttributedTo modu:ietf-network-inventory-topology ;
    prov:wasDerivedFrom "nwi-passive:a-end?container/nwi-passive:ne-ref?leaf",
        "nwi-passive:z-end?container/nwi-passive:ne-ref?leaf",
        "nwi:network-inventory?container/nil:locations?container/nil:racks?container/nil:rack?list/nil:contained-chassis?list/nil:ne-ref?leaf",
        "nwit:inventory-mapping-attributes?container/nwi:ne-ref?leaf",
        "nwit:inventory-mapping-attributes?container/nwit:ne-ref?leaf" .

ex:ne-type a owl:ObjectProperty ;
    rdfs:label "ne-type" ;
    rdfs:comment "The network element type." ;
    rdfs:domain nwiNEs:network-element ;
    rdfs:range nwiInvId:ne-type ;
    prov:wasDerivedFrom "nwi:network-inventory?container/nwi:network-elements?container/nwi:network-element?list/nwi:ne-type?leaf" .

ex:network-access-id a owl:DatatypeProperty ;
    rdfs:label "network-access-id" ;
    rdfs:comment "Identifier of network access." ;
    rdfs:domain l2svcTps:site-network-access ;
    rdfs:range xsd:string ;
    prov:wasDerivedFrom "l2vpn-svc:l2vpn-svc?container/l2vpn-svc:sites?container/l2vpn-svc:site?list/l2vpn-svc:site-network-accesses?container/l2vpn-svc:site-network-access?list/l2vpn-svc:network-access-id?leaf" .

ex:network-id a owl:DatatypeProperty ;
    rdfs:label "network-id" ;
    rdfs:comment "Identifies a network." ;
    rdfs:domain netNetworks:network ;
    rdfs:range xsd:anyURI ;
    prov:wasDerivedFrom "nw:networks?container/nw:network?list/nw:network-id?leaf" .

ex:network-ref a owl:ObjectProperty ;
    rdfs:label "network-ref" ;
    ex:xpathPath "../../../nw:supporting-network/nw:network-ref",
        "../../../nw:supporting-node/nw:network-ref",
        "/nw:networks/nw:network/nw:network-id" ;
    rdfs:comment """References the underlay network of which the
underlay node is a part.""",
        "References the underlay network.",
        """This leaf identifies in which topology the
supporting termination point is present.""",
        """This leaf identifies in which underlay topology
the supporting link is present.""" ;
    rdfs:domain netLink:supporting-link,
        nw-node:supporting-node,
        nw-tp:supporting-termination-point,
        net:supporting-network ;
    rdfs:range netNetworks:network,
        nw-node:supporting-node,
        net:supporting-network ;
    prov:wasDerivedFrom "nt:link?list/nt:supporting-link?list/nt:network-ref?leaf",
        "nt:termination-point?list/nt:supporting-termination-point?list/nt:network-ref?leaf",
        "nw:networks?container/nw:network?list/nw:node?list/nw:supporting-node?list/nw:network-ref?leaf",
        "nw:networks?container/nw:network?list/nw:supporting-network?list/nw:network-ref?leaf" .

ex:node-id a owl:DatatypeProperty ;
    rdfs:label "node-id" ;
    rdfs:comment """Uniquely identifies a node within the containing
network.""" ;
    rdfs:domain net:node ;
    rdfs:range xsd:anyURI ;
    prov:wasDerivedFrom "nw:networks?container/nw:network?list/nw:node?list/nw:node-id?leaf" .

ex:node-ref a owl:ObjectProperty ;
    rdfs:label "node-ref" ;
    ex:xpathPath "../../../nw:supporting-node/nw:node-ref",
        "/nw:networks/nw:network/nw:node/nw:node-id" ;
    rdfs:comment "References the underlay node itself.",
        """This leaf identifies in which node the supporting
termination point is present.""" ;
    rdfs:domain nw-node:supporting-node,
        nw-tp:supporting-termination-point ;
    rdfs:range net:node,
        nw-node:supporting-node ;
    prov:wasDerivedFrom "nt:termination-point?list/nt:supporting-termination-point?list/nt:node-ref?leaf",
        "nw:networks?container/nw:network?list/nw:node?list/nw:supporting-node?list/nw:node-ref?leaf" .

hwNotif:hardware-state-change a owl:Class ;
    rdfs:label "hardware-state-change" .

hwNotif:hardware-state-oper-disabled a owl:Class ;
    rdfs:label "hardware-state-oper-disabled" .

hwNotif:hardware-state-oper-enabled a owl:Class ;
    rdfs:label "hardware-state-oper-enabled" .

l2tSNotif:l2-link-event a owl:Class ;
    rdfs:label "l2-link-event" .

l2tSNotif:l2-node-event a owl:Class ;
    rdfs:label "l2-node-event" .

l2tSNotif:l2-termination-point-event a owl:Class ;
    rdfs:label "l2-termination-point-event" .

l2tNotif:l2-link-event a owl:Class ;
    rdfs:label "l2-link-event" .

l2tNotif:l2-node-event a owl:Class ;
    rdfs:label "l2-node-event" .

l2tNotif:l2-termination-point-event a owl:Class ;
    rdfs:label "l2-termination-point-event" .

ex:object-id a owl:DatatypeProperty ;
    rdfs:label "object-id" ;
    rdfs:comment """An identifier that uniquely identifies the energy object
in a device.""" ;
    rdfs:domain paeEnergy:power-entry ;
    rdfs:range xsd:string ;
    prov:wasDerivedFrom "eo:energy-objects?container/eo:power-entry?list/eo:object-id?leaf" .

ex:oper-state a owl:ObjectProperty ;
    rdfs:label "oper-state" ;
    ex:isStateData true ;
    rdfs:comment """The operational state for this component.

Note that this node does not follow the administrative
state.  An administrative state of 'down' does not
predict an operational state of 'disabled'.

Note that some implementations may not be able to
accurately report oper-state while the admin-state node
has a value other than 'unlocked'.  In these cases, this
node MUST have a value of 'unknown'.""" ;
    rdfs:domain hwComp:state ;
    rdfs:range hwTypes:oper-state ;
    prov:wasDerivedFrom "hw:hardware?container/hw:component?list/hw:state?container/hw:oper-state?leaf" .

ex:oper-status a owl:ObjectProperty ;
    rdfs:label "oper-status" ;
    rdfs:comment "The operational status of the sensor." ;
    rdfs:domain hwComp:sensor-data ;
    rdfs:range hwTypes:sensor-status ;
    prov:wasDerivedFrom "hw:hardware?container/hw:component?list/hw:sensor-data?container/hw:oper-status?leaf" .

ex:outer-tag a owl:DatatypeProperty ;
    rdfs:label "outer-tag" ;
    rdfs:comment """The outermost VLAN tag.  It may include a list of VLAN
Ids or nonoverlapping VLAN ranges.""" ;
    rdfs:domain nw-s-tp:l2-termination-point-attributes ;
    rdfs:isDefinedBy modu:ietf-l2-topology-state ;
    rdfs:range xsd:string ;
    prov:wasAttributedTo modu:ietf-l2-topology-state ;
    prov:wasDerivedFrom "l2t:l2-termination-point-attributes?container/l2t:outer-tag?leaf" .

ex:outer-tpid a owl:DatatypeProperty ;
    rdfs:label "outer-tpid" ;
    rdfs:comment """Identifies a specific 802.1Q tag type of outermost VLAN
tag.""" ;
    rdfs:domain nw-s-tp:l2-termination-point-attributes ;
    rdfs:isDefinedBy modu:ietf-l2-topology-state ;
    rdfs:range xsd:string ;
    prov:wasAttributedTo modu:ietf-l2-topology-state ;
    prov:wasDerivedFrom "l2t:l2-termination-point-attributes?container/l2t:outer-tpid?leaf" .

ex:p2mp-replication a owl:DatatypeProperty ;
    rdfs:label "p2mp-replication" ;
    rdfs:comment """Controls whether Point-to-Multipoint
(P2MP) replication is enabled ('true')
or disabled ('false')""" ;
    rdfs:domain l2nmNdSig:evpn-policies ;
    rdfs:range xsd:boolean ;
    prov:wasDerivedFrom "l2vpn-ntw:l2vpn-ntw?container/l2vpn-ntw:vpn-services?container/l2vpn-ntw:vpn-service?list/l2vpn-ntw:vpn-nodes?container/l2vpn-ntw:vpn-node?list/l2vpn-ntw:signaling-option?container/l2vpn-ntw:evpn-policies?container/l2vpn-ntw:p2mp-replication?leaf" .

ex:parent a owl:ObjectProperty ;
    rdfs:label "parent" ;
    ex:xpathPath "../../component/component-id",
        "../../component/name",
        "../../location/id" ;
    rdfs:comment """The identifiers of all the components that
physically contain this component.

If this list is empty, this component is not
contained in any other component but it is contained
in the network-element.""",
        """The name of the component that physically contains this
component.

If this leaf is not instantiated, it indicates that this
component is not contained in any other component.

In the event that a physical component is contained by
more than one physical component (e.g., double-wide
modules), this node contains the name of one of these
components.  An implementation MUST use the same name
every time this node is instantiated.""",
        """The name of the location that physically contains this
location.""" ;
    rdfs:domain hw:component,
        nwiLocs:location,
        nwiComps:component ;
    rdfs:range hw:component,
        nwiLocs:location,
        nwiComps:component ;
    prov:wasDerivedFrom "hw:hardware?container/hw:component?list/hw:parent?leaf",
        "nwi:network-inventory?container/nil:locations?container/nil:location?list/nil:parent?leaf",
        "nwi:network-inventory?container/nwi:network-elements?container/nwi:network-element?list/nwi:components?container/nwi:component?list/nwi:parent?leaf-list" .

ex:parent-rel-pos a owl:DatatypeProperty ;
    rdfs:label "parent-rel-pos" ;
    rdfs:comment """An indication of the relative position of this child
component among all its sibling components.  Sibling
components are defined as components that:

  o share the same value of the 'parent' node and

  o share a common base identity for the 'class' node.

Note that the last rule gives implementations flexibility
in how components are numbered.  For example, some
implementations might have a single number series for all
components derived from 'ianahw:port', while some others
might have different number series for different
components with identities derived from 'ianahw:port' (for
example, one for registered jack 45 (RJ45) and one for
small form-factor pluggable (SFP)).""",
        """The relative position with respect to the parent
component among all the sibling components.

The format of this string is
implementation-specific. When mapping from RFC 6933,
the entPhysicalParentRelPos integer value SHOULD be
encoded as an integer string.""" ;
    rdfs:domain hw:component,
        nwiComps:component ;
    rdfs:range xsd:int,
        xsd:string ;
    prov:wasDerivedFrom "hw:hardware?container/hw:component?list/hw:parent-rel-pos?leaf",
        "nwi:network-inventory?container/nwi:network-elements?container/nwi:network-element?list/nwi:components?container/nwi:component?list/nwi:parent-rel-pos?leaf" .

ex:parent-service-id a owl:DatatypeProperty ;
    rdfs:label "parent-service-id" ;
    rdfs:comment """Pointer to the parent service that
triggered the L2NM.""" ;
    rdfs:domain l2nmVpns:vpn-service ;
    rdfs:range xsd:string ;
    prov:wasDerivedFrom "l2vpn-ntw:l2vpn-ntw?container/l2vpn-ntw:vpn-services?container/l2vpn-ntw:vpn-service?list/l2vpn-ntw:parent-service-id?leaf" .

ex:part-number a owl:DatatypeProperty ;
    rdfs:label "part-number" ;
    rdfs:comment """The vendor-specific part number of the component
type. It is expected that vendors assign unique part
numbers to different component types within the
scope of the vendor.""" ;
    rdfs:domain nwiComps:component ;
    rdfs:range xsd:string ;
    prov:wasDerivedFrom "nwi:part-number?leaf" .

ex:pause a owl:ObjectProperty ;
    rdfs:label "pause" ;
    rdfs:comment "Pause protocol type applicable to all sites." ;
    rdfs:domain l2svcTpConn:l2cp-control ;
    rdfs:range l2svcTypes:control-mode ;
    prov:wasDerivedFrom "l2vpn-svc:l2vpn-svc?container/l2vpn-svc:sites?container/l2vpn-svc:site?list/l2vpn-svc:site-network-accesses?container/l2vpn-svc:site-network-access?list/l2vpn-svc:connection?container/l2vpn-svc:l2cp-control?container/l2vpn-svc:pause?leaf" .

ex:pbs a owl:DatatypeProperty ;
    rdfs:label "pbs" ;
    ex:unit "bps",
        "bytes" ;
    rdfs:comment "Peak Burst Size (PBS).",
        """Peak Burst Size.  It is measured in bytes per
second.""" ;
    rdfs:domain l2nmSvcCeBw:ce-to-pe-bandwidth,
        l2nmCePeBw:cos,
        l2nmSvcPeBw:pe-to-ce-bandwidth,
        l2nmPeCeBw:cos,
        l2svcSvcBw:bandwidth ;
    rdfs:range xsd:unsignedLong ;
    prov:wasDerivedFrom "l2vpn-ntw:pbs?leaf",
        "l2vpn-svc:l2vpn-svc?container/l2vpn-svc:sites?container/l2vpn-svc:site?list/l2vpn-svc:site-network-accesses?container/l2vpn-svc:site-network-access?list/l2vpn-svc:service?container/l2vpn-svc:svc-bandwidth?container/l2vpn-svc:bandwidth?list/l2vpn-svc:pbs?leaf" .

ex:pcp a owl:DatatypeProperty ;
    rdfs:label "pcp" ;
    rdfs:comment "PCP value.",
        "Priority Code Point (PCP) value." ;
    rdfs:domain l2nmTpQosRule:match-flow,
        l2svcSiteQosRule:match-flow,
        l2svcTpQosRule:match-flow ;
    rdfs:range xsd:unsignedByte ;
    prov:wasDerivedFrom "l2vpn-ntw:l2vpn-ntw?container/l2vpn-ntw:vpn-services?container/l2vpn-ntw:vpn-service?list/l2vpn-ntw:vpn-nodes?container/l2vpn-ntw:vpn-node?list/l2vpn-ntw:vpn-network-accesses?container/l2vpn-ntw:vpn-network-access?list/l2vpn-ntw:service?container/l2vpn-ntw:qos?container/l2vpn-ntw:qos-classification-policy?container/l2vpn-ntw:rule?list/l2vpn-ntw:match-flow?container/l2vpn-ntw:pcp?leaf",
        "l2vpn-svc:l2vpn-svc?container/l2vpn-svc:sites?container/l2vpn-svc:site?list/l2vpn-svc:service?container/l2vpn-svc:qos?container/l2vpn-svc:qos-classification-policy?container/l2vpn-svc:rule?list/l2vpn-svc:match-flow?container/l2vpn-svc:pcp?leaf",
        "l2vpn-svc:l2vpn-svc?container/l2vpn-svc:sites?container/l2vpn-svc:site?list/l2vpn-svc:site-network-accesses?container/l2vpn-svc:site-network-access?list/l2vpn-svc:service?container/l2vpn-svc:qos?container/l2vpn-svc:qos-classification-policy?container/l2vpn-svc:rule?list/l2vpn-svc:match-flow?container/l2vpn-svc:pcp?leaf" .

ex:peer-addr a owl:DatatypeProperty ;
    rdfs:label "peer-addr" ;
    rdfs:comment "Indicates the peer forwarder's IP address.",
        "Indicates the peer's IP address." ;
    rdfs:domain l2nmNdLdp:pw-peer-list,
        l2nmNdLdp:remote-targets ;
    prov:wasDerivedFrom "l2vpn-ntw:l2vpn-ntw?container/l2vpn-ntw:vpn-services?container/l2vpn-ntw:vpn-service?list/l2vpn-ntw:vpn-nodes?container/l2vpn-ntw:vpn-node?list/l2vpn-ntw:signaling-option?container/l2vpn-ntw:ldp-or-l2tp?container/l2vpn-ntw:pw-peer-list?list/l2vpn-ntw:peer-addr?leaf",
        "l2vpn-ntw:l2vpn-ntw?container/l2vpn-ntw:vpn-services?container/l2vpn-ntw:vpn-service?list/l2vpn-ntw:vpn-nodes?container/l2vpn-ntw:vpn-node?list/l2vpn-ntw:signaling-option?container/l2vpn-ntw:ldp-or-l2tp?container/l2vpn-ntw:remote-targets?list/l2vpn-ntw:peer-addr?leaf" .

ex:peer-ip a owl:DatatypeProperty ;
    rdfs:label "peer-ip" ;
    rdfs:comment "Peer IP." ;
    rdfs:domain l2svcVxlan:peer-list ;
    prov:wasDerivedFrom "l2vpn-svc:l2vpn-svc?container/l2vpn-svc:sites?container/l2vpn-svc:site?list/l2vpn-svc:site-network-accesses?container/l2vpn-svc:site-network-access?list/l2vpn-svc:connection?container/l2vpn-svc:tagged-interface?container/l2vpn-svc:vxlan?container/l2vpn-svc:peer-list?list/l2vpn-svc:peer-ip?leaf" .

ex:peer-mode a owl:ObjectProperty ;
    rdfs:label "peer-mode" ;
    rdfs:comment """Specifies the VXLAN access mode.  By default,
the peer mode is set to 'static-mode'.""" ;
    rdfs:domain l2svcTagged:vxlan ;
    rdfs:range l2svcId:vxlan-peer-mode ;
    prov:wasDerivedFrom "l2vpn-svc:l2vpn-svc?container/l2vpn-svc:sites?container/l2vpn-svc:site?list/l2vpn-svc:site-network-accesses?container/l2vpn-svc:site-network-access?list/l2vpn-svc:connection?container/l2vpn-svc:tagged-interface?container/l2vpn-svc:vxlan?container/l2vpn-svc:peer-mode?leaf" .

ex:permit-any a owl:DatatypeProperty ;
    rdfs:label "permit-any" ;
    rdfs:comment "Allow all sites." ;
    rdfs:domain l2svcCloud:cloud-access ;
    rdfs:range xsd:boolean ;
    prov:wasDerivedFrom "l2vpn-svc:l2vpn-svc?container/l2vpn-svc:vpn-services?container/l2vpn-svc:vpn-service?list/l2vpn-svc:cloud-accesses?container/l2vpn-svc:cloud-access?list/l2vpn-svc:permit-any?leaf" .

ex:permit-site a owl:ObjectProperty ;
    rdfs:label "permit-site" ;
    ex:xpathPath "/l2vpn-svc/sites/site/site-id" ;
    rdfs:comment "Site ID to be authorized." ;
    rdfs:domain l2svcCloud:cloud-access ;
    rdfs:range l2svcSites:site ;
    prov:wasDerivedFrom "l2vpn-svc:l2vpn-svc?container/l2vpn-svc:vpn-services?container/l2vpn-svc:vpn-service?list/l2vpn-svc:cloud-accesses?container/l2vpn-svc:cloud-access?list/l2vpn-svc:permit-site?leaf-list" .

ex:phy-mtu a owl:DatatypeProperty ;
    rdfs:label "phy-mtu" ;
    ex:unit "bytes" ;
    rdfs:comment "PHY MTU." ;
    rdfs:domain l2svcTpConn:untagged-interface ;
    rdfs:range xsd:unsignedInt ;
    prov:wasDerivedFrom "l2vpn-svc:l2vpn-svc?container/l2vpn-svc:sites?container/l2vpn-svc:site?list/l2vpn-svc:site-network-accesses?container/l2vpn-svc:site-network-access?list/l2vpn-svc:connection?container/l2vpn-svc:untagged-interface?container/l2vpn-svc:phy-mtu?leaf" .

ex:physical-index a owl:DatatypeProperty ;
    rdfs:label "physical-index" ;
    ex:isStateData true ;
    rdfs:comment """The entPhysicalIndex for the entPhysicalEntry represented
by this list entry.""" ;
    rdfs:domain hw:component ;
    rdfs:range xsd:int ;
    prov:wasDerivedFrom "hw:hardware?container/hw:component?list/hw:physical-index?leaf" .

ex:pir a owl:DatatypeProperty ;
    rdfs:label "pir" ;
    ex:unit "bps" ;
    rdfs:comment """Peak Information Rate (PIR), i.e., maximum
frame delivery allowed.  It is equal
to or less than sum of CIR and EIR.""",
        """Peak Information Rate, i.e., maximum frame
delivery allowed.  It is equal to or less
than the sum of the CIR and the EIR.""" ;
