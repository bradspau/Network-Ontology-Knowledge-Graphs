ex:translate a owl:DatatypeProperty ;
    rdfs:label "translate" ;
    rdfs:comment """Translates one or two outer tags.  PCP
bits are preserved.

The following operations are
supported:

- translate 1 with tag-1 leaf is
  provided: only the outermost tag is
  translated to the value in tag-1.

- translate 2 with both tag-1 and
  tag-2 leaves are provided: both
  outer and inner tags are translated
  to the values in tag-1 and tag-2,
  respectively.

- translate 2 with tag-1 leaf is
  provided: the outer tag is popped
  while the inner tag is translated
  to the value in tag-1.""",
        """Translates the outer tag to one or two
tags.  PCP bits are preserved.""" ;
    rdfs:domain dot1:tag-operations,
        qinq:tag-operations ;
    rdfs:range xsd:boolean,
        xsd:unsignedByte ;
    prov:wasDerivedFrom "l2vpn-ntw:l2vpn-ntw?container/l2vpn-ntw:vpn-services?container/l2vpn-ntw:vpn-service?list/l2vpn-ntw:vpn-nodes?container/l2vpn-ntw:vpn-node?list/l2vpn-ntw:vpn-network-accesses?container/l2vpn-ntw:vpn-network-access?list/l2vpn-ntw:connection?container/l2vpn-ntw:encapsulation?container/l2vpn-ntw:dot1q?container/l2vpn-ntw:tag-operations?container/l2vpn-ntw:translate?leaf",
        "l2vpn-ntw:l2vpn-ntw?container/l2vpn-ntw:vpn-services?container/l2vpn-ntw:vpn-service?list/l2vpn-ntw:vpn-nodes?container/l2vpn-ntw:vpn-node?list/l2vpn-ntw:vpn-network-accesses?container/l2vpn-ntw:vpn-network-access?list/l2vpn-ntw:connection?container/l2vpn-ntw:encapsulation?container/l2vpn-ntw:qinq?container/l2vpn-ntw:tag-operations?container/l2vpn-ntw:translate?leaf" .

