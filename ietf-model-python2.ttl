l2svcId:cos-id-pcp a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "cos-id-pcp" ;
    rdfs:comment """Identity of the CoS ID based on the
Port Control Protocol (PCP).""" ;
    rdfs:subClassOf yangId:cos-id ;
    prov:wasDerivedFrom "l2vpn-svc:cos-id-pcp?identity" .

l2svcId:cross-connect-ccm a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "cross-connect-ccm" ;
    rdfs:comment """Indicates that one or more cross-connect CCMs have been
received and that 3.5 times the period of at least one of
those CCMs' transmission intervals has not yet expired.""" ;
    rdfs:subClassOf yangId:fault-alarm-defect-type ;
    prov:wasDerivedFrom "l2vpn-svc:cross-connect-ccm?identity" .

l2svcId:customer-managed a owl:Class,
