    rdfs:range xsd:string ;
    prov:wasAttributedTo modu:ietf-l2-topology-state ;
    prov:wasDerivedFrom "l2t:l2-termination-point-attributes?container/l2t:inner-tpid?leaf" .

ex:interface-id a owl:DatatypeProperty ;
    rdfs:label "interface-id" ;
    rdfs:comment "Identifier of a node interface.",
        "Refers to a physical or logical interface." ;
    rdfs:domain l2esSegItem:member,
        l2nmTps:vpn-network-access ;
    rdfs:range xsd:string ;
    prov:wasDerivedFrom "l2vpn-es:ethernet-segments?container/l2vpn-es:ethernet-segment?list/l2vpn-es:member?list/l2vpn-es:interface-id?leaf",
        "l2vpn-ntw:l2vpn-ntw?container/l2vpn-ntw:vpn-services?container/l2vpn-ntw:vpn-service?list/l2vpn-ntw:vpn-nodes?container/l2vpn-ntw:vpn-node?list/l2vpn-ntw:vpn-network-accesses?container/l2vpn-ntw:vpn-network-access?list/l2vpn-ntw:interface-id?leaf" .

ex:interface-name a owl:DatatypeProperty ;
    rdfs:label "interface-name" ;
    rdfs:comment """Name of the interface.  The name can (but does not
have to) correspond to an interface reference of a
containing node's interface, i.e., the path name of a
corresponding interface data node on the containing
node is reminiscent of data type interface-ref defined
in RFC 8343.  It should be noted that data type
interface-ref of RFC 8343 cannot be used directly,
as this data type is used to reference an interface
in a datastore of a single node in the network, not
to uniquely reference interfaces across a network.""" ;
    rdfs:domain nw-s-tp:l2-termination-point-attributes ;
    rdfs:isDefinedBy modu:ietf-l2-topology-state ;
    rdfs:range xsd:string ;
    prov:wasAttributedTo modu:ietf-l2-topology-state ;
    prov:wasDerivedFrom "l2t:l2-termination-point-attributes?container/l2t:interface-name?leaf" .

ex:interval a owl:DatatypeProperty ;
    rdfs:label "interval" ;
    ex:unit "milliseconds" ;
    rdfs:comment "BFD interval." ;
    rdfs:domain l2svcLacp:micro-bfd ;
    rdfs:range xsd:unsignedInt ;
    prov:wasDerivedFrom "l2vpn-svc:l2vpn-svc?container/l2vpn-svc:sites?container/l2vpn-svc:site?list/l2vpn-svc:site-network-accesses?container/l2vpn-svc:site-network-access?list/l2vpn-svc:connection?container/l2vpn-svc:lag-interfaces?container/l2vpn-svc:lag-interface?list/l2vpn-svc:lacp?container/l2vpn-svc:micro-bfd?container/l2vpn-svc:interval?leaf" .

ex:ip-mobility-threshold a owl:DatatypeProperty ;
    rdfs:label "ip-mobility-threshold" ;
    rdfs:comment """It is possible for a given host (as
defined by its IP address) to move
from one ES to another.  The
IP mobility threshold specifies the
number of IP mobility events
that are detected for a given IP
address within the
detection-threshold before it
is identified as a duplicate IP
address.
Once the detection threshold is
reached, updates for the IP address
are suppressed.""",
        """It is possible for a given host (as
defined by its IP address) to move
from one ES to another.  The
IP mobility threshold specifies the
number of IP mobility events
that are detected for a given IP
address within the
detection-threshold before it
is identified as a duplicate IP
address.  Once the detection threshold
is reached, updates for the IP address
are suppressed.""" ;
    rdfs:domain l2nmNdEvpn:arp-proxy,
        l2nmNdEvpn:nd-proxy ;
    rdfs:range xsd:unsignedShort ;
    prov:wasDerivedFrom "l2vpn-ntw:l2vpn-ntw?container/l2vpn-ntw:vpn-services?container/l2vpn-ntw:vpn-service?list/l2vpn-ntw:vpn-nodes?container/l2vpn-ntw:vpn-node?list/l2vpn-ntw:signaling-option?container/l2vpn-ntw:evpn-policies?container/l2vpn-ntw:arp-proxy?container/l2vpn-ntw:ip-mobility-threshold?leaf",
        "l2vpn-ntw:l2vpn-ntw?container/l2vpn-ntw:vpn-services?container/l2vpn-ntw:vpn-service?list/l2vpn-ntw:vpn-nodes?container/l2vpn-ntw:vpn-node?list/l2vpn-ntw:signaling-option?container/l2vpn-ntw:evpn-policies?container/l2vpn-ntw:nd-proxy?container/l2vpn-ntw:ip-mobility-threshold?leaf" .

ex:is-fru a owl:DatatypeProperty ;
    rdfs:label "is-fru" ;
    ex:isStateData true ;
    rdfs:comment """This node indicates whether or not this component is
considered a 'field-replaceable unit' by the vendor.
If this node contains the value 'true', then this
component identifies a field-replaceable unit.
For all components that are permanently contained
within a field-replaceable unit, the value 'false'
should be returned for this node.""",
        """This node indicates whether or not this component is
considered a 'field-replaceable unit' by the vendor.  If
this node contains the value 'true', then this component
identifies a field-replaceable unit.  For all components
that are permanently contained within a field-replaceable
unit, the value 'false' should be returned for this
node.""" ;
    rdfs:domain hw:component,
        nwiComps:component ;
    rdfs:range xsd:boolean ;
    prov:wasDerivedFrom "hw:hardware?container/hw:component?list/hw:is-fru?leaf",
        "nwi:is-fru?leaf" .

ex:is-main a owl:DatatypeProperty ;
    rdfs:label "is-main" ;
    rdfs:comment """This node indicates whether the chassis is taking or
not the 'main' role.

This node is applicable only to scenarios where the
network element contains chassis components which
can take or not the 'main' role (e.g., multi-chassis
network elements).

It is therefore omitted in scenarios where the
network element does not contain chassis components
which can can take or not the 'main' role
(e.g., single-chassis network elements).""" ;
    rdfs:domain nwiComps:component ;
    rdfs:range xsd:boolean ;
    prov:wasDerivedFrom "nwi:network-inventory?container/nwi:network-elements?container/nwi:network-element?list/nwi:components?container/nwi:component?list/nwi:is-main?leaf" .

ex:l2-termination-point a owl:DatatypeProperty ;
    rdfs:label "l2-termination-point" ;
    rdfs:comment """Specifies a reference to a local Layer 2
termination point such as a Layer 2
sub-interface.""" ;
    rdfs:domain l2nmTp:connection ;
    rdfs:range xsd:string ;
    prov:wasDerivedFrom "l2vpn-ntw:l2vpn-ntw?container/l2vpn-ntw:vpn-services?container/l2vpn-ntw:vpn-service?list/l2vpn-ntw:vpn-nodes?container/l2vpn-ntw:vpn-node?list/l2vpn-ntw:vpn-network-accesses?container/l2vpn-ntw:vpn-network-access?list/l2vpn-ntw:connection?container/l2vpn-ntw:l2-termination-point?leaf" .

