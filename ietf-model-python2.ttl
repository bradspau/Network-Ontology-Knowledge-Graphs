dot1:tag-operations a owl:Class ;
    rdfs:label "tag-operations" ;
    rdfs:comment """Sets the tag manipulation policy for this
VPN network access.  It defines a set of
tag manipulations that allow for the
insertion, removal, or rewriting
of 802.1Q VLAN tags.  These operations are
indicated for the CE-PE direction.
By default, tag operations are symmetric.
As such, the reverse tag operation is
assumed on the PE-CE direction.""" ;
    prov:wasDerivedFrom "l2vpn-ntw:l2vpn-ntw?container/l2vpn-ntw:vpn-services?container/l2vpn-ntw:vpn-service?list/l2vpn-ntw:vpn-nodes?container/l2vpn-ntw:vpn-node?list/l2vpn-ntw:vpn-network-accesses?container/l2vpn-ntw:vpn-network-access?list/l2vpn-ntw:connection?container/l2vpn-ntw:encapsulation?container/l2vpn-ntw:dot1q?container/l2vpn-ntw:tag-operations?container" .

