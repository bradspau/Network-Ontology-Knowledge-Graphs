ex:height a owl:DatatypeProperty ;
    rdfs:label "height" ;
    ex:unit "meters",
        "millimeter" ;
    rdfs:comment """Height from a reference 0 value.  The precision and
'0' value is defined by the reference-frame.""",
        "Rack height." ;
    rdfs:domain niLocLoc:geo-location,
        niLocRacks:rack ;
    rdfs:isDefinedBy modu:ietf-ni-location ;
    rdfs:range xsd:decimal,
        xsd:unsignedShort ;
    prov:wasAttributedTo modu:ietf-ni-location ;
    prov:wasDerivedFrom "geo:geo-location?container/geo:height?leaf",
        "nwi:network-inventory?container/nil:locations?container/nil:racks?container/nil:rack?list/nil:height?leaf" .

ex:height-accuracy a owl:DatatypeProperty ;
    rdfs:label "height-accuracy" ;
    ex:unit "meters" ;
    rdfs:comment """The accuracy of the height value for ellipsoidal
coordinates; this value is not used with Cartesian
coordinates.  When height-accuracy is specified, it
indicates how precisely the heights in the
associated list of locations have been determined
with respect to the coordinate system defined by the
geodetic-datum.  For example, there might be
uncertainty due to measurement error if an
experimental measurement was made to determine each
location.""" ;
    rdfs:domain nwiRefFrame:geodetic-system ;
    rdfs:isDefinedBy modu:ietf-ni-location ;
    rdfs:range xsd:decimal ;
    prov:wasAttributedTo modu:ietf-ni-location ;
    prov:wasDerivedFrom "geo:geo-location?container/geo:reference-frame?container/geo:geodetic-system?container/geo:height-accuracy?leaf" .

ex:hold-timer a owl:DatatypeProperty ;
    rdfs:label "hold-timer" ;
    ex:unit "milliseconds" ;
    rdfs:comment "BFD hold timer." ;
    rdfs:domain l2svcLacp:micro-bfd ;
    rdfs:range xsd:unsignedInt ;
    prov:wasDerivedFrom "l2vpn-svc:l2vpn-svc?container/l2vpn-svc:sites?container/l2vpn-svc:site?list/l2vpn-svc:site-network-accesses?container/l2vpn-svc:site-network-access?list/l2vpn-svc:connection?container/l2vpn-svc:lag-interfaces?container/l2vpn-svc:lag-interface?list/l2vpn-svc:lacp?container/l2vpn-svc:micro-bfd?container/l2vpn-svc:hold-timer?leaf" .

ex:id a owl:DatatypeProperty ;
