ex:cable-role a owl:ObjectProperty ;
    rdfs:label "cable-role" ;
    rdfs:comment "Role of cable." ;
    rdfs:domain nwi:cable ;
    rdfs:isDefinedBy modu:ietf-nwi-passive-inventory ;
    rdfs:range nwiPassId:cable-role ;
    prov:wasAttributedTo modu:ietf-nwi-passive-inventory ;
    prov:wasDerivedFrom "nwi-passive:cable-role?leaf" .

ex:cable-type a owl:ObjectProperty ;
    rdfs:label "cable-type" ;
    rdfs:comment "Type of cable." ;
    rdfs:domain nwi:cable ;
    rdfs:isDefinedBy modu:ietf-nwi-passive-inventory ;
    rdfs:range nwiPassId:cable-type ;
    prov:wasAttributedTo modu:ietf-nwi-passive-inventory ;
    prov:wasDerivedFrom "nwi-passive:cable-type?leaf" .

ex:cableRole a owl:ObjectProperty ;
    rdfs:label "cable role" ;
    rdfs:comment "RDF-star annotation on ex:hasUpstreamDevice: role/tier of the cable. Priority ascending: internal=0, drop=1, access=2, branch=3, aggregation=4, distribution=5, trunk=6." .

ex:carrierscarrier a owl:DatatypeProperty ;
    rdfs:label "carrierscarrier" ;
    rdfs:comment "The VPN is using CsC, and so MPLS is required." ;
    rdfs:domain vpnSe:vpn-service ;
    rdfs:range xsd:boolean ;
    prov:wasDerivedFrom "l2vpn-svc:l2vpn-svc?container/l2vpn-svc:vpn-services?container/l2vpn-svc:vpn-service?list/l2vpn-svc:carrierscarrier?leaf" .

ex:cbs a owl:DatatypeProperty ;
    rdfs:label "cbs" ;
    ex:unit "bps",
        "bytes" ;
    rdfs:comment """Committed Burst Size (CBS).  CBS controls the
bursty nature of the traffic.  Traffic
that does not use the configured CIR
accumulates credits until the credits
reach the configured CBS.""",
        """Committed Burst Size (CBS).  Controls the bursty
nature of the traffic.  Traffic that does not
use the configured Committed Information Rate
(CIR) accumulates credits until the credits
reach the configured CBS.""" ;
    rdfs:domain l2nmSvcCeBw:ce-to-pe-bandwidth,
        l2nmCePeBw:cos,
        l2nmSvcPeBw:pe-to-ce-bandwidth,
        l2nmPeCeBw:cos,
        l2svcSvcBw:bandwidth ;
    rdfs:range xsd:unsignedLong ;
    prov:wasDerivedFrom "l2vpn-ntw:cbs?leaf",
        "l2vpn-svc:l2vpn-svc?container/l2vpn-svc:sites?container/l2vpn-svc:site?list/l2vpn-svc:site-network-accesses?container/l2vpn-svc:site-network-access?list/l2vpn-svc:service?container/l2vpn-svc:svc-bandwidth?container/l2vpn-svc:bandwidth?list/l2vpn-svc:cbs?leaf" .

ex:ccm-holdtime a owl:DatatypeProperty ;
    rdfs:label "ccm-holdtime" ;
    ex:unit "milliseconds" ;
    rdfs:comment "CCM hold time.",
        """CCM hold time.  By default, the CCM hold time
is 3.5 times the CCM interval.""" ;
    rdfs:domain l2nmOam1:n2-uni-c,
        l2nmOam1:n2-uni-n,
        l2svcOam:cfm-8021-ag ;
    rdfs:range xsd:unsignedInt ;
    prov:wasDerivedFrom "l2vpn-ntw:ccm-holdtime?leaf",
        "l2vpn-svc:l2vpn-svc?container/l2vpn-svc:sites?container/l2vpn-svc:site?list/l2vpn-svc:site-network-accesses?container/l2vpn-svc:site-network-access?list/l2vpn-svc:connection?container/l2vpn-svc:oam?container/l2vpn-svc:cfm-8021-ag?list/l2vpn-svc:ccm-holdtime?leaf" .

ex:ccm-interval a owl:DatatypeProperty ;
    rdfs:label "ccm-interval" ;
    ex:unit "milliseconds" ;
    rdfs:comment """CCM interval.  By default, the CCM interval is
10,000 milliseconds (10 seconds).""",
        "Continuity Check Message (CCM) interval." ;
    rdfs:domain l2nmOam1:n2-uni-c,
        l2nmOam1:n2-uni-n,
        l2svcOam:cfm-8021-ag ;
    rdfs:range xsd:unsignedInt ;
    prov:wasDerivedFrom "l2vpn-ntw:ccm-interval?leaf",
        "l2vpn-svc:l2vpn-svc?container/l2vpn-svc:sites?container/l2vpn-svc:site?list/l2vpn-svc:site-network-accesses?container/l2vpn-svc:site-network-access?list/l2vpn-svc:connection?container/l2vpn-svc:oam?container/l2vpn-svc:cfm-8021-ag?list/l2vpn-svc:ccm-interval?leaf" .

ex:ccm-p-bits-pri a owl:DatatypeProperty ;
    rdfs:label "ccm-p-bits-pri" ;
    rdfs:comment """The priority parameter for CCMs
transmitted by the MEP.""",
        """The priority parameter for CCMs transmitted by
the MEP.  The non-existence of this leaf means
that no defects are to be reported.""" ;
    rdfs:domain l2nmOam1:n2-uni-c,
