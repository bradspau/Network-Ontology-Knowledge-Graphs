ex:byte-offset a owl:DatatypeProperty ;
    rdfs:label "byte-offset" ;
    rdfs:comment """Number of bytes in the service frame header
that are excluded from the QoS calculation
(e.g., extra VLAN tags).""" ;
    rdfs:domain l2svcQosCls:class,
        l2svcTpQosCls:class ;
