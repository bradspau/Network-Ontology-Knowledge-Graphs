ex:bgp-ad-enabled a owl:DatatypeProperty ;
    rdfs:label "bgp-ad-enabled" ;
    rdfs:comment """Indicates whether BGP auto-discovery is enabled
or disabled.""" ;
    rdfs:domain l2nmVpns:vpn-service ;
    rdfs:range xsd:boolean ;
    prov:wasDerivedFrom "l2vpn-ntw:l2vpn-ntw?container/l2vpn-ntw:vpn-services?container/l2vpn-ntw:vpn-service?list/l2vpn-ntw:bgp-ad-enabled?leaf" .

ex:bridge-id a owl:DatatypeProperty ;
    rdfs:label "bridge-id" ;
    rdfs:comment """This is the bridge identifier represented as a
hexadecimal 8-octet string.  It has 4 bits of
priority, 12 bits of Multiple Spanning Tree
Instance Identifier (MSTI-ID), and the base bridge
identifier.  There may be multiple for each
spanning tree instance.""" ;
    rdfs:domain nw-node:l2-node-attributes ;
    rdfs:isDefinedBy modu:ietf-l2-topology-state ;
    rdfs:range xsd:string ;
    prov:wasAttributedTo modu:ietf-l2-topology-state ;
    prov:wasDerivedFrom "l2t:l2-node-attributes?container/l2t:bridge-id?leaf-list" .

ex:bum-overall-rate a owl:DatatypeProperty ;
    rdfs:label "bum-overall-rate" ;
    ex:unit "bps" ;
    rdfs:comment "Overall rate for BUM." ;
    rdfs:domain l2nmTpSvc:broadcast-unknown-unicast-multicast,
