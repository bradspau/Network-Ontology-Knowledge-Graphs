ex:svc-mtu a owl:DatatypeProperty ;
    rdfs:label "svc-mtu" ;
    ex:unit "bytes" ;
    rdfs:comment """Layer 2 service MTU.  It is also known
as the maximum transmission unit or
maximum frame size.""",
        """SVC MTU.  It is also known as the maximum
transmission unit or maximum frame size.  When
a frame is larger than the MTU, it is broken
down, or fragmented, into smaller pieces by
the network protocol to accommodate the MTU
of the network.  If CsC is enabled,
the requested svc-mtu leaf will refer to the
MPLS MTU and not to the link MTU.""" ;
    rdfs:domain l2nmGlbProf:global-parameters-profile,
        l2nmNdProf:global-parameters-profile,
        l2svcTp:service ;
    rdfs:range xsd:unsignedInt,
        xsd:unsignedShort ;
    prov:wasDerivedFrom "l2vpn-ntw:svc-mtu?leaf",
        "l2vpn-svc:l2vpn-svc?container/l2vpn-svc:sites?container/l2vpn-svc:site?list/l2vpn-svc:site-network-accesses?container/l2vpn-svc:site-network-access?list/l2vpn-svc:service?container/l2vpn-svc:svc-mtu?leaf" .

