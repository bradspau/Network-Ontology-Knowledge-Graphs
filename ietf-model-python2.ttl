paeId:accuracy-estimated a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "accuracy-estimated" ;
    rdfs:comment """The power data is estimated, perhaps based on a model,
history or calculation rather than a direct measurement.""" ;
    rdfs:subClassOf yangId:data-source-accuracy ;
    prov:wasDerivedFrom "eo:accuracy-estimated?identity" .

paeId:accuracy-historic a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "accuracy-historic" ;
    rdfs:comment """The power data is based on an historic measurement data
for this specific system and usage pattern.""" ;
    rdfs:subClassOf yangId:accuracy-estimated ;
    prov:wasDerivedFrom "eo:accuracy-historic?identity" .

paeId:accuracy-learned a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "accuracy-learned" ;
    rdfs:comment """The power data is based on an machine learning
model prediction.""" ;
    rdfs:subClassOf yangId:accuracy-estimated ;
    prov:wasDerivedFrom "eo:accuracy-learned?identity" .

paeId:accuracy-measured a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "accuracy-measured" ;
    rdfs:comment """The power data is a direct, real-time measurement
from a sensor.""" ;
    rdfs:subClassOf yangId:data-source-accuracy ;
    prov:wasDerivedFrom "eo:accuracy-measured?identity" .

paeId:accuracy-measured-bronze a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "accuracy-measured-bronze" ;
    rdfs:comment """The power data is a direct, real-time measurement
from a sensor with +/- 30% accuracy for typical values.""" ;
    rdfs:subClassOf yangId:accuracy-measured ;
    prov:wasDerivedFrom "eo:accuracy-measured-bronze?identity" .

paeId:accuracy-measured-gold a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "accuracy-measured-gold" ;
    rdfs:comment """The power data is a direct, real-time measurement
from a sensor with +/- 5% accuracy for typical values.""" ;
    rdfs:subClassOf yangId:accuracy-measured ;
    prov:wasDerivedFrom "eo:accuracy-measured-gold?identity" .

paeId:accuracy-measured-ones a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "accuracy-measured-ones" ;
    rdfs:comment """The power data is a direct, real-time measurement
from a sensor with all non-zero digits valid.""" ;
    rdfs:subClassOf yangId:accuracy-measured ;
    prov:wasDerivedFrom "eo:accuracy-measured-ones?identity" .

paeId:accuracy-measured-red a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "accuracy-measured-red" ;
    rdfs:comment """The power data is a direct, real-time measurement
from a sensor with +/- 2% accuracy for typical values.""" ;
    rdfs:subClassOf yangId:accuracy-measured ;
    prov:wasDerivedFrom "eo:accuracy-measured-red?identity" .

paeId:accuracy-measured-silver a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "accuracy-measured-silver" ;
    rdfs:comment """The power data is a direct, real-time measurement
from a sensor with +/- 10% accuracy for typical values.""" ;
    rdfs:subClassOf yangId:accuracy-measured ;
    prov:wasDerivedFrom "eo:accuracy-measured-silver?identity" .

paeId:accuracy-static a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "accuracy-static" ;
    rdfs:comment """The power data is based on static data, such as
manufacturer specifications, datasheet of typical power values
or nameplate ratings, rather than real-time measurements.""" ;
    rdfs:subClassOf yangId:accuracy-estimated ;
    prov:wasDerivedFrom "eo:accuracy-static?identity" .

paeId:accuracy-unavailable a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "accuracy-unavailable" ;
    rdfs:comment """A power data is not available for some reason, such
as a sensor failure or a component being powered off.""" ;
    rdfs:subClassOf yangId:accuracy-unknown ;
    prov:wasDerivedFrom "eo:accuracy-unavailable?identity" .

paeId:accuracy-unknown a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "accuracy-unknown" ;
    rdfs:comment "The accuracy of the power data is unknown." ;
    rdfs:subClassOf yangId:data-source-accuracy ;
    prov:wasDerivedFrom "eo:accuracy-unknown?identity" .

paeId:multiplier-giga a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "multiplier-giga" ;
    rdfs:comment """Represents a multiplier of 10^9 (1,000,000,000) associated
with the integer units used to measure the power or energy.""" ;
    prov:wasDerivedFrom "eo:multiplier-giga?identity" .

paeId:multiplier-kilo a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "multiplier-kilo" ;
    rdfs:comment """Represents a multiplier of 10^3 (1,000) associated with the
integer units used to measure the power or energy.""" ;
    prov:wasDerivedFrom "eo:multiplier-kilo?identity" .

paeId:multiplier-mega a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "multiplier-mega" ;
    rdfs:comment """Represents a multiplier of 10^6 (1,000,000) associated with
the integer units used to measure the power or energy.""" ;
    prov:wasDerivedFrom "eo:multiplier-mega?identity" .

paeId:multiplier-milli a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "multiplier-milli" ;
    rdfs:comment """Represents a multiplier of 10^-3 (0.001) associated with the
integer units used to measure the power or energy.""" ;
    prov:wasDerivedFrom "eo:multiplier-milli?identity" .

paeId:multiplier-none a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "multiplier-none" ;
    rdfs:comment """Represents a multiplier of 10^0 (1) associated with
the integer units used to measure the power or energy.""" ;
    prov:wasDerivedFrom "eo:multiplier-none?identity" .

paeId:power-state a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "power-state" ;
    rdfs:comment """Base identity for all possible power states. This identity
serves as the root for a hierarchy of power states, allowing
for extensibility while maintaining alignment with the IANA
Power State Set Registry.""" ;
    prov:wasDerivedFrom "eo:power-state?identity" .

