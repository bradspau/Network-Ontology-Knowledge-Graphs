ex:lacp-lamp a owl:ObjectProperty ;
    rdfs:label "lacp-lamp" ;
    rdfs:comment "LACP / Link Aggregation Marker Protocol (LAMP)." ;
    rdfs:domain l2svcTpConn:l2cp-control ;
