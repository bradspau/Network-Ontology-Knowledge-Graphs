        "Grouping definition: child-cables" .

grpNwiPass:optical-cable-attributes a owl:Class ;
    rdfs:label "optical-cable-attributes" ;
    rdfs:comment "Attributes applicable to fiber optic cables.",
        "Grouping definition: optical-cable-attributes" .

grpNwiPass:passive-device-ports a owl:Class ;
    rdfs:label "passive-device-ports" ;
    rdfs:comment "Attributes applicable to passive device ports.",
