        "l2vpn-ntw:l2vpn-ntw?container/l2vpn-ntw:vpn-services?container/l2vpn-ntw:vpn-service?list/l2vpn-ntw:vpn-nodes?container/l2vpn-ntw:vpn-node?list/l2vpn-ntw:vpn-network-accesses?container/l2vpn-ntw:vpn-network-access?list/l2vpn-ntw:vpws-service-instance?container/l2vpn-ntw:remote-vsi-auto?container/l2vpn-ntw:auto?leaf" .

ex:auto-ethernet-segment-identifier a owl:DatatypeProperty ;
    rdfs:label "auto-ethernet-segment-identifier" ;
