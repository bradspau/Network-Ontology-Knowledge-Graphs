ex:cos-id a owl:DatatypeProperty ;
    rdfs:label "cos-id" ;
    rdfs:comment """Identifier of the CoS, indicated by
DSCP or a CE-CLAN CoS (802.1p) value
in the service frame.""",
        """Identifier of the CoS, indicated by
