ex:relative-position a owl:DatatypeProperty ;
    rdfs:label "relative-position" ;
    rdfs:comment """A relative position of chassis within
the rack""" ;
    rdfs:domain niLocRack:contained-chassis ;
    rdfs:isDefinedBy modu:ietf-ni-location ;
    rdfs:range xsd:unsignedByte ;
    prov:wasAttributedTo modu:ietf-ni-location ;
    prov:wasDerivedFrom "nwi:network-inventory?container/nil:locations?container/nil:racks?container/nil:rack?list/nil:contained-chassis?list/nil:relative-position?leaf" .

ex:remote-carrier-identifier a owl:DatatypeProperty ;
    rdfs:label "remote-carrier-identifier" ;
    rdfs:comment """Identification of the remote carrier name to be used.
It can be an L2VPN partner, data-center SP, or
private CSP.  Local to each administration.""" ;
    rdfs:domain l2svcVpnProfs:valid-provider-identifiers ;
    rdfs:range xsd:string ;
    prov:wasDerivedFrom "l2vpn-svc:l2vpn-svc?container/l2vpn-svc:vpn-profiles?container/l2vpn-svc:valid-provider-identifiers?container/l2vpn-svc:remote-carrier-identifier?leaf-list" .

ex:remote-carrier-name a owl:ObjectProperty ;
    rdfs:label "remote-carrier-name" ;
    ex:xpathPath "/l2vpn-svc/vpn-profiles/valid-provider-identifiers/remote-carrier-identifier" ;
    rdfs:comment """Remote carrier name.  The 'remote-carrier-name'
parameter must be configured only when
'site-vpn-flavor' is set to 'site-vpn-flavor-nni'.
If it is not set, it indicates that the customer
does not know the remote carrier's name
beforehand.""" ;
    rdfs:domain l2svcTps:site-network-access ;
    rdfs:range l2svcVpnProfs:valid-provider-identifiers ;
    prov:wasDerivedFrom "l2vpn-svc:l2vpn-svc?container/l2vpn-svc:sites?container/l2vpn-svc:site?list/l2vpn-svc:site-network-accesses?container/l2vpn-svc:site-network-access?list/l2vpn-svc:remote-carrier-name?leaf" .

ex:remote-ce-id a owl:DatatypeProperty ;
    rdfs:label "remote-ce-id" ;
    rdfs:comment """Indicates the identifier of the remote
CE.""" ;
    rdfs:domain l2nmTps:vpn-network-access ;
    rdfs:range xsd:unsignedShort ;
    prov:wasDerivedFrom "l2vpn-ntw:l2vpn-ntw?container/l2vpn-ntw:vpn-services?container/l2vpn-ntw:vpn-service?list/l2vpn-ntw:vpn-nodes?container/l2vpn-ntw:vpn-node?list/l2vpn-ntw:vpn-network-accesses?container/l2vpn-ntw:vpn-network-access?list/l2vpn-ntw:remote-ce-id?leaf" .

ex:remote-mep-id a owl:DatatypeProperty ;
    rdfs:label "remote-mep-id" ;
    rdfs:comment "Remote MEP ID.",
        """Remote MEP ID.  The non-existence of this
leaf means that no measurements are to be
reported.""",
        """Remote MEP ID.  The non-existence of this leaf
means that no defects are to be reported.""" ;
    rdfs:domain l2nmOam1:n2-uni-c,
        l2nmOam1:n2-uni-n,
        l2nmOam:y-1731,
        l2svcOam:cfm-8021-ag,
        l2svcOam:y-1731 ;
    rdfs:range xsd:unsignedInt ;
    prov:wasDerivedFrom "l2vpn-ntw:l2vpn-ntw?container/l2vpn-ntw:vpn-services?container/l2vpn-ntw:vpn-service?list/l2vpn-ntw:vpn-nodes?container/l2vpn-ntw:vpn-node?list/l2vpn-ntw:vpn-network-accesses?container/l2vpn-ntw:vpn-network-access?list/l2vpn-ntw:ethernet-service-oam?container/l2vpn-ntw:y-1731?list/l2vpn-ntw:remote-mep-id?leaf",
        "l2vpn-ntw:remote-mep-id?leaf",
        "l2vpn-svc:l2vpn-svc?container/l2vpn-svc:sites?container/l2vpn-svc:site?list/l2vpn-svc:site-network-accesses?container/l2vpn-svc:site-network-access?list/l2vpn-svc:connection?container/l2vpn-svc:oam?container/l2vpn-svc:cfm-8021-ag?list/l2vpn-svc:remote-mep-id?leaf",
        "l2vpn-svc:l2vpn-svc?container/l2vpn-svc:sites?container/l2vpn-svc:site?list/l2vpn-svc:site-network-accesses?container/l2vpn-svc:site-network-access?list/l2vpn-svc:connection?container/l2vpn-svc:oam?container/l2vpn-svc:y-1731?list/l2vpn-svc:remote-mep-id?leaf" .

ex:remote-vpws-service-instance a owl:DatatypeProperty ;
    rdfs:label "remote-vpws-service-instance" ;
    rdfs:comment """Indicates the value of the remote
VSI.""" ;
    rdfs:domain l2nmTp:vpws-service-instance ;
    rdfs:range xsd:unsignedInt ;
    prov:wasDerivedFrom "l2vpn-ntw:l2vpn-ntw?container/l2vpn-ntw:vpn-services?container/l2vpn-ntw:vpn-service?list/l2vpn-ntw:vpn-nodes?container/l2vpn-ntw:vpn-node?list/l2vpn-ntw:vpn-network-accesses?container/l2vpn-ntw:vpn-network-access?list/l2vpn-ntw:vpws-service-instance?container/l2vpn-ntw:remote-vpws-service-instance?leaf" .

ex:retry-timer a owl:DatatypeProperty ;
    rdfs:label "retry-timer" ;
    ex:unit "seconds" ;
    rdfs:comment """The retry timer.  When the retry timer
expires, the duplicate MAC address will
be flushed from the MAC-VRF.""",
        """The retry timer.  When the retry timer expires,
the duplicate MAC address will be flushed from
the MAC-VRF.""" ;
    rdfs:domain l2nmGlbMac:mac-loop-prevention,
        l2nmNdMac:mac-loop-prevention,
        l2nmTpMac:mac-loop-prevention,
        l2svcSite:mac-loop-prevention,
        l2svcTp:mac-loop-prevention ;
    rdfs:range xsd:unsignedInt ;
    prov:wasDerivedFrom "l2vpn-ntw:l2vpn-ntw?container/l2vpn-ntw:vpn-services?container/l2vpn-ntw:vpn-service?list/l2vpn-ntw:vpn-nodes?container/l2vpn-ntw:vpn-node?list/l2vpn-ntw:vpn-network-accesses?container/l2vpn-ntw:vpn-network-access?list/l2vpn-ntw:service?container/l2vpn-ntw:mac-policies?container/l2vpn-ntw:mac-loop-prevention?container/l2vpn-ntw:retry-timer?leaf",
        "l2vpn-ntw:mac-policies?container/l2vpn-ntw:mac-loop-prevention?container/l2vpn-ntw:retry-timer?leaf",
        "l2vpn-svc:mac-loop-prevention?container/l2vpn-svc:retry-timer?leaf" .

ex:revertive a owl:DatatypeProperty ;
    rdfs:label "revertive" ;
    rdfs:comment """The default behavior is that the DF election
procedure is triggered upon PE failures following
configured preference values.  Such a mode is called
the 'revertive' mode.  This mode may not be suitable in
some scenarios where, e.g., an operator may want to
maintain the new DF even if the former DF recovers.
Such a mode is called the 'non-revertive' mode.

The non-revertive mode can be configured by
setting 'revertive' leaf to 'false'.""" ;
    rdfs:domain l2esSegItem:df-election ;
    rdfs:range xsd:boolean ;
    prov:wasDerivedFrom "l2vpn-es:ethernet-segments?container/l2vpn-es:ethernet-segment?list/l2vpn-es:df-election?container/l2vpn-es:revertive?leaf" .

ex:revision a owl:DatatypeProperty ;
    rdfs:label "revision" ;
    rdfs:comment """The vendor-specific revision string of the software
module when not implicitly defined as part of the name of
the software module.""",
        """The vendor-specific revision string of the software
patch when not implicitly defined as part of the name or
revision of the software module.""" ;
    rdfs:domain nwiComp:software-rev,
        nwiCompSwRev:patch,
        nwiNE:software-rev,
        nwiSwRev:patch ;
    rdfs:range xsd:string ;
    prov:wasDerivedFrom "nwi:software-rev?list/nwi:patch?list/nwi:revision?leaf",
        "nwi:software-rev?list/nwi:revision?leaf" .

ex:role a owl:ObjectProperty ;
    rdfs:label "role" ;
    rdfs:comment "Role of the VPN node in the VPN." ;
    rdfs:domain l2nmNodes:vpn-node ;
    rdfs:range l2nmId:role ;
    prov:wasDerivedFrom "l2vpn-ntw:l2vpn-ntw?container/l2vpn-ntw:vpn-services?container/l2vpn-ntw:vpn-service?list/l2vpn-ntw:vpn-nodes?container/l2vpn-ntw:vpn-node?list/l2vpn-ntw:role?leaf" .

ex:rolePriority a owl:DatatypeProperty ;
    rdfs:label "role priority" ;
    rdfs:comment "Numeric priority for cable role used in upstream-ascending traversal filter. Matches CABLE_RANK_MAP: internal=0, drop=1, access=2, branch=3, aggregation=4, distribution=5, trunk=6." ;
    rdfs:range xsd:integer .

ex:router-id a owl:DatatypeProperty ;
    rdfs:label "router-id" ;
    rdfs:comment """A 32-bit number in the dotted-quad format
that is used to uniquely identify a node
within a service provider network.""",
        """A 32-bit number in the dotted-quad format that is
used to uniquely identify a node within an
Autonomous System (AS).""" ;
    rdfs:domain l2nmNodes:vpn-node,
        l2nmNdSig:ldp-or-l2tp ;
    rdfs:range xsd:string ;
    prov:wasDerivedFrom "l2vpn-ntw:l2vpn-ntw?container/l2vpn-ntw:vpn-services?container/l2vpn-ntw:vpn-service?list/l2vpn-ntw:vpn-nodes?container/l2vpn-ntw:vpn-node?list/l2vpn-ntw:router-id?leaf",
        "l2vpn-ntw:l2vpn-ntw?container/l2vpn-ntw:vpn-services?container/l2vpn-ntw:vpn-service?list/l2vpn-ntw:vpn-nodes?container/l2vpn-ntw:vpn-node?list/l2vpn-ntw:signaling-option?container/l2vpn-ntw:ldp-or-l2tp?container/l2vpn-ntw:router-id?leaf" .

ex:row-number a owl:DatatypeProperty ;
    rdfs:label "row-number" ;
    rdfs:comment """Identifies the row within the equipment room where
the rack is located.""" ;
    rdfs:domain niLocRack:rack-location ;
    rdfs:isDefinedBy modu:ietf-ni-location ;
    rdfs:range xsd:unsignedInt ;
    prov:wasAttributedTo modu:ietf-ni-location ;
    prov:wasDerivedFrom "nwi:network-inventory?container/nil:locations?container/nil:racks?container/nil:rack?list/nil:rack-location?container/nil:row-number?leaf" .

ex:s-tag a owl:DatatypeProperty ;
    rdfs:label "s-tag" ;
    rdfs:comment "S-TAG." ;
    rdfs:domain l2nmNdLdp:qinq ;
    rdfs:range xsd:string ;
    prov:wasDerivedFrom "l2vpn-ntw:l2vpn-ntw?container/l2vpn-ntw:vpn-services?container/l2vpn-ntw:vpn-service?list/l2vpn-ntw:vpn-nodes?container/l2vpn-ntw:vpn-node?list/l2vpn-ntw:signaling-option?container/l2vpn-ntw:ldp-or-l2tp?container/l2vpn-ntw:qinq?container/l2vpn-ntw:s-tag?leaf" .

ex:saii a owl:DatatypeProperty ;
    rdfs:label "saii" ;
    rdfs:comment """Source Attachment Individual Identifier
(SAII).""" ;
    rdfs:domain l2nmNdSig:ldp-or-l2tp ;
    rdfs:range xsd:unsignedInt ;
    prov:wasDerivedFrom "l2vpn-ntw:l2vpn-ntw?container/l2vpn-ntw:vpn-services?container/l2vpn-ntw:vpn-service?list/l2vpn-ntw:vpn-nodes?container/l2vpn-ntw:vpn-node?list/l2vpn-ntw:signaling-option?container/l2vpn-ntw:ldp-or-l2tp?container/l2vpn-ntw:saii?leaf" .

ex:serial-num a owl:DatatypeProperty ;
    rdfs:label "serial-num" ;
    ex:isStateData true ;
    rdfs:comment """The vendor-specific serial number string for the
component.  The preferred value is the serial number
string actually printed on the component itself (if
present).""" ;
    rdfs:domain hw:component ;
    rdfs:range xsd:string ;
    prov:wasDerivedFrom "hw:hardware?container/hw:component?list/hw:serial-num?leaf" .

ex:serial-number a owl:DatatypeProperty ;
    rdfs:label "serial-number" ;
    rdfs:comment """The vendor-specific serial number of the component instance.

It is expected that vendors assign unique serial numbers to
different component instances within the scope of the
'part-number'.""" ;
    rdfs:domain nwiComps:component ;
    rdfs:range xsd:string ;
    prov:wasDerivedFrom "nwi:serial-number?leaf" .

ex:service-interface-type a owl:ObjectProperty ;
    rdfs:label "service-interface-type" ;
    rdfs:comment "EVPN service interface type." ;
    rdfs:domain l2nmNode:signaling-option ;
    rdfs:range l2nmId:evpn-service-interface-type ;
    prov:wasDerivedFrom "l2vpn-ntw:l2vpn-ntw?container/l2vpn-ntw:vpn-services?container/l2vpn-ntw:vpn-service?list/l2vpn-ntw:vpn-nodes?container/l2vpn-ntw:vpn-node?list/l2vpn-ntw:signaling-option?container/l2vpn-ntw:service-interface-type?leaf" .

ex:session-type a owl:DatatypeProperty ;
    rdfs:label "session-type" ;
    rdfs:comment """Session type.  By default, the session type
is 'on-demand'.  The non-existence of this
leaf means that no measurements are to be
reported.""",
        "Specifies the session type." ;
    rdfs:domain l2nmOam:y-1731,
        l2svcOam:y-1731 ;
    rdfs:range rdfs:Literal ;
    prov:wasDerivedFrom "l2vpn-ntw:l2vpn-ntw?container/l2vpn-ntw:vpn-services?container/l2vpn-ntw:vpn-service?list/l2vpn-ntw:vpn-nodes?container/l2vpn-ntw:vpn-node?list/l2vpn-ntw:vpn-network-accesses?container/l2vpn-ntw:vpn-network-access?list/l2vpn-ntw:ethernet-service-oam?container/l2vpn-ntw:y-1731?list/l2vpn-ntw:session-type?leaf",
        "l2vpn-svc:l2vpn-svc?container/l2vpn-svc:sites?container/l2vpn-svc:site?list/l2vpn-svc:site-network-accesses?container/l2vpn-svc:site-network-access?list/l2vpn-svc:connection?container/l2vpn-svc:oam?container/l2vpn-svc:y-1731?list/l2vpn-svc:session-type?leaf" .

ex:signaling-type a owl:ObjectProperty ;
    rdfs:label "signaling-type" ;
    ex:xpathPath "../../../../signaling-type" ;
    rdfs:comment "CsC.  By default, the signaling type is 'bgp'.",
        "VPN signaling type." ;
    rdfs:domain l2nmVpns:vpn-service,
        l2nmNode:signaling-option,
        l2svcSiteSvc:carrierscarrier,
        l2svcTpSvc:carrierscarrier ;
    rdfs:range l2nmId:vpn-signaling-type,
        l2svcId:carrierscarrier-type,
        l2nmVpns:vpn-service ;
    prov:wasDerivedFrom "l2vpn-ntw:l2vpn-ntw?container/l2vpn-ntw:vpn-services?container/l2vpn-ntw:vpn-service?list/l2vpn-ntw:signaling-type?leaf",
        "l2vpn-ntw:l2vpn-ntw?container/l2vpn-ntw:vpn-services?container/l2vpn-ntw:vpn-service?list/l2vpn-ntw:vpn-nodes?container/l2vpn-ntw:vpn-node?list/l2vpn-ntw:signaling-option?container/l2vpn-ntw:signaling-type?leaf",
        "l2vpn-svc:l2vpn-svc?container/l2vpn-svc:sites?container/l2vpn-svc:site?list/l2vpn-svc:service?container/l2vpn-svc:carrierscarrier?container/l2vpn-svc:signaling-type?leaf",
        "l2vpn-svc:l2vpn-svc?container/l2vpn-svc:sites?container/l2vpn-svc:site?list/l2vpn-svc:site-network-accesses?container/l2vpn-svc:site-network-access?list/l2vpn-svc:service?container/l2vpn-svc:carrierscarrier?container/l2vpn-svc:signaling-type?leaf" .

ex:single-active a owl:DatatypeProperty ;
    rdfs:label "single-active" ;
    rdfs:comment "Single-active mode." ;
    rdfs:domain l2svcTp:availability ;
    rdfs:range xsd:boolean ;
    prov:wasDerivedFrom "l2vpn-svc:l2vpn-svc?container/l2vpn-svc:sites?container/l2vpn-svc:site?list/l2vpn-svc:site-network-accesses?container/l2vpn-svc:site-network-access?list/l2vpn-svc:availability?container/l2vpn-svc:single-active?leaf" .

ex:site-id a owl:DatatypeProperty ;
    rdfs:label "site-id" ;
    rdfs:comment "Identifier of the site." ;
    rdfs:domain l2svcSites:site ;
    rdfs:range xsd:string ;
    prov:wasDerivedFrom "l2vpn-svc:l2vpn-svc?container/l2vpn-svc:sites?container/l2vpn-svc:site?list/l2vpn-svc:site-id?leaf" .

ex:site-role a owl:ObjectProperty ;
    rdfs:label "site-role" ;
    rdfs:comment "Role of the site in the L2VPN.",
        """Role of the site in the L2VPN.  When referencing
a vpn-id, the site-role setting must be added to
express the role of the site in the target VPN
service topology.""" ;
    rdfs:domain l2svcTp:vpn-attachment,
        entr:vpn ;
    rdfs:range l2svcId:site-role ;
    prov:wasDerivedFrom "l2vpn-svc:l2vpn-svc?container/l2vpn-svc:sites?container/l2vpn-svc:site?list/l2vpn-svc:site-network-accesses?container/l2vpn-svc:site-network-access?list/l2vpn-svc:vpn-attachment?container/l2vpn-svc:site-role?leaf",
        "l2vpn-svc:l2vpn-svc?container/l2vpn-svc:sites?container/l2vpn-svc:site?list/l2vpn-svc:vpn-policies?container/l2vpn-svc:vpn-policy?list/l2vpn-svc:entries?list/l2vpn-svc:vpn?list/l2vpn-svc:site-role?leaf" .

ex:site-vpn-flavor a owl:ObjectProperty ;
    rdfs:label "site-vpn-flavor" ;
    rdfs:comment """Defines the way that the VPN multiplexing is
done, e.g., whether the site belongs to
a single VPN site or a multi-VPN site.  By
default, the site belongs to a single VPN.""" ;
    rdfs:domain l2svcSites:site ;
    rdfs:range l2svcId:site-vpn-flavor ;
    prov:wasDerivedFrom "l2vpn-svc:l2vpn-svc?container/l2vpn-svc:sites?container/l2vpn-svc:site?list/l2vpn-svc:site-vpn-flavor?leaf" .

ex:software-rev a owl:DatatypeProperty ;
    rdfs:label "software-rev" ;
    ex:isStateData true ;
    rdfs:comment """The vendor-specific software revision string for the
component.""" ;
    rdfs:domain hw:component ;
    rdfs:range xsd:string ;
    prov:wasDerivedFrom "hw:hardware?container/hw:component?list/hw:software-rev?leaf" .

ex:source-component-id a owl:ObjectProperty ;
    rdfs:label "source-component-id" ;
    ex:isStateData true ;
    ex:xpathPath "/hw:hardware/hw:component/hw:name" ;
    rdfs:comment """Reference to the component name in the ietf-hardware
model. This leaf creates a direct semantic link between the
power attributes and the physical component they describe.
""" ;
    rdfs:domain paeEnergy:power-entry ;
    rdfs:range hw:component ;
    prov:wasDerivedFrom "eo:energy-objects?container/eo:power-entry?list/eo:source-component-id?leaf" .

ex:source-node a owl:ObjectProperty ;
    rdfs:label "source-node" ;
    ex:xpathPath "../../../nw:node/nw:node-id" ;
    rdfs:comment "Source node identifier.  Must be in the same topology." ;
    rdfs:domain netLink:source ;
    rdfs:isDefinedBy modu:ietf-network-topology ;
    rdfs:range net:node ;
    prov:wasAttributedTo modu:ietf-network-topology ;
    prov:wasDerivedFrom "nt:link?list/nt:source?container/nt:source-node?leaf" .

ex:source-tp a owl:ObjectProperty ;
    rdfs:label "source-tp" ;
    ex:xpathPath "../../../nw:node[nw:node-id=current()/../source-node]/termination-point/tp-id" ;
    rdfs:comment """This termination point is located within the source node
and terminates the link.""" ;
    rdfs:domain netLink:source ;
    rdfs:isDefinedBy modu:ietf-network-topology ;
    rdfs:range nw-node:termination-point ;
    prov:wasAttributedTo modu:ietf-network-topology ;
    prov:wasDerivedFrom "nt:link?list/nt:source?container/nt:source-tp?leaf" .

ex:speed a owl:DatatypeProperty ;
    rdfs:label "speed" ;
    ex:unit "mbps" ;
    rdfs:comment """LACP speed.  By default, the LACP speed is 10
Mbps.""",
        """LACP speed.  This low default value
is inherited from the L2SM.""",
        "Port speed." ;
    rdfs:domain l2nmTpLag:lacp,
        membLiLi:member-link,
        lagIn:lacp,
        membLi3:member-link,
        l2svcTpConn:untagged-interface ;
    rdfs:range xsd:unsignedInt ;
    prov:wasDerivedFrom "l2vpn-ntw:l2vpn-ntw?container/l2vpn-ntw:vpn-services?container/l2vpn-ntw:vpn-service?list/l2vpn-ntw:vpn-nodes?container/l2vpn-ntw:vpn-node?list/l2vpn-ntw:vpn-network-accesses?container/l2vpn-ntw:vpn-network-access?list/l2vpn-ntw:connection?container/l2vpn-ntw:lag-interface?container/l2vpn-ntw:lacp?container/l2vpn-ntw:member-link-list?container/l2vpn-ntw:member-link?list/l2vpn-ntw:speed?leaf",
        "l2vpn-ntw:l2vpn-ntw?container/l2vpn-ntw:vpn-services?container/l2vpn-ntw:vpn-service?list/l2vpn-ntw:vpn-nodes?container/l2vpn-ntw:vpn-node?list/l2vpn-ntw:vpn-network-accesses?container/l2vpn-ntw:vpn-network-access?list/l2vpn-ntw:connection?container/l2vpn-ntw:lag-interface?container/l2vpn-ntw:lacp?container/l2vpn-ntw:speed?leaf",
        "l2vpn-svc:l2vpn-svc?container/l2vpn-svc:sites?container/l2vpn-svc:site?list/l2vpn-svc:site-network-accesses?container/l2vpn-svc:site-network-access?list/l2vpn-svc:connection?container/l2vpn-svc:lag-interfaces?container/l2vpn-svc:lag-interface?list/l2vpn-svc:lacp?container/l2vpn-svc:member-links?container/l2vpn-svc:member-link?list/l2vpn-svc:speed?leaf",
        "l2vpn-svc:l2vpn-svc?container/l2vpn-svc:sites?container/l2vpn-svc:site?list/l2vpn-svc:site-network-accesses?container/l2vpn-svc:site-network-access?list/l2vpn-svc:connection?container/l2vpn-svc:lag-interfaces?container/l2vpn-svc:lag-interface?list/l2vpn-svc:lacp?container/l2vpn-svc:speed?leaf",
        "l2vpn-svc:l2vpn-svc?container/l2vpn-svc:sites?container/l2vpn-svc:site?list/l2vpn-svc:site-network-accesses?container/l2vpn-svc:site-network-access?list/l2vpn-svc:connection?container/l2vpn-svc:untagged-interface?container/l2vpn-svc:speed?leaf" .

ex:split-horizon-filtering a owl:DatatypeProperty ;
    rdfs:label "split-horizon-filtering" ;
    rdfs:comment """Controls split-horizon filtering.  It is enabled
when set to 'true'.

In order to achieve split-horizon filtering, every
Broadcast, Unknown Unicast, or Multicast (BUM)
packet originating from a non-DF PE is encapsulated
with an MPLS label that identifies the origin ES.""" ;
    rdfs:domain l2esSeg:ethernet-segment ;
    rdfs:range xsd:boolean ;
