    prov:wasAttributedTo modu:ietf-l2-topology-state ;
    prov:wasDerivedFrom "l2t:l2-link-attributes?container/l2t:auto-nego?leaf" .

ex:auto-remote-vsi a owl:DatatypeProperty ;
    rdfs:label "auto-remote-vsi" ;
