ex:auto-rt-enable a owl:DatatypeProperty ;
    rdfs:label "auto-rt-enable" ;
    rdfs:comment """Enables/disabled RT auto-derivation based on
the ASN and Ethernet Tag ID.""" ;
    rdfs:domain l2nmNode:bgp-auto-discovery ;
    rdfs:range xsd:boolean ;
    prov:wasDerivedFrom "l2vpn-ntw:l2vpn-ntw?container/l2vpn-ntw:vpn-services?container/l2vpn-ntw:vpn-service?list/l2vpn-ntw:vpn-nodes?container/l2vpn-ntw:vpn-node?list/l2vpn-ntw:bgp-auto-discovery?container/l2vpn-ntw:auto-rt-enable?leaf" .

ex:backbone-src-mac a owl:DatatypeProperty ;
    rdfs:label "backbone-src-mac" ;
    rdfs:comment """Includes Provider Backbone MAC (B-MAC)
address.""",
        """The PEs connected to the same CE must share the
same Provider Backbone (B-MAC) address in
All-Active mode.""" ;
    rdfs:domain l2esSegItem:pbb,
        l2nmNdEvpn:pbb ;
    rdfs:range xsd:string ;
    prov:wasDerivedFrom "l2vpn-es:ethernet-segments?container/l2vpn-es:ethernet-segment?list/l2vpn-es:pbb?container/l2vpn-es:backbone-src-mac?leaf",
        "l2vpn-ntw:l2vpn-ntw?container/l2vpn-ntw:vpn-services?container/l2vpn-ntw:vpn-service?list/l2vpn-ntw:vpn-nodes?container/l2vpn-ntw:vpn-node?list/l2vpn-ntw:signaling-option?container/l2vpn-ntw:evpn-policies?container/l2vpn-ntw:pbb?container/l2vpn-ntw:backbone-src-mac?leaf" .

ex:bearer-reference a owl:DatatypeProperty ;
    rdfs:label "bearer-reference" ;
    rdfs:comment "An internal reference for the SP.",
        """This is an internal reference for the service
provider to identify the bearer associated
with this VPN.""" ;
