ietfEtSe:all-active a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "all-active" ;
    rdfs:comment "Indicates All-Active redundancy mode for a given ES." ;
    rdfs:subClassOf yangId:es-redundancy-mode ;
    prov:wasDerivedFrom "l2vpn-es:all-active?identity" .

ietfEtSe:default-7432 a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "default-7432" ;
    rdfs:comment """The default DF election method.

The default procedure for DF election at the granularity of
<ES,VLAN> for VLAN-based service or <ES, VLAN bundle> for
VLAN-(aware) bundle service is referred to as
'service carving'.""" ;
    rdfs:subClassOf yangId:df-election-methods ;
    prov:wasDerivedFrom "l2vpn-es:default-7432?identity" .

ietfEtSe:esi-type-0-operator a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "esi-type-0-operator" ;
    rdfs:comment """This type indicates an arbitrary 9-octet ESI value,
which is managed and configured by the operator.""" ;
    rdfs:subClassOf yangId:esi-type ;
    prov:wasDerivedFrom "l2vpn-es:esi-type-0-operator?identity" .

ietfEtSe:esi-type-1-lacp a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "esi-type-1-lacp" ;
    rdfs:comment """When the IEEE 802.1AX Link Aggregation Control Protocol (LACP)
is used between the Provider Edge (PE) and Customer Edge (CE)
devices, this ESI type indicates an auto-generated ESI value
determined from LACP.""" ;
    rdfs:subClassOf yangId:esi-type ;
    prov:wasDerivedFrom "l2vpn-es:esi-type-1-lacp?identity" .

ietfEtSe:esi-type-2-bridge a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "esi-type-2-bridge" ;
    rdfs:comment """The ESI value is auto-generated and determined based
on the Layer 2 bridge protocol.""" ;
    rdfs:subClassOf yangId:esi-type ;
    prov:wasDerivedFrom "l2vpn-es:esi-type-2-bridge?identity" .

ietfEtSe:esi-type-3-mac a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "esi-type-3-mac" ;
    rdfs:comment """This type indicates a MAC-based ESI value that can be
auto-generated or configured by the operator.""" ;
    rdfs:subClassOf yangId:esi-type ;
    prov:wasDerivedFrom "l2vpn-es:esi-type-3-mac?identity" .

ietfEtSe:esi-type-4-router-id a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "esi-type-4-router-id" ;
    rdfs:comment """This type indicates a Router ID ESI value that can be
auto-generated or configured by the operator.""" ;
    rdfs:subClassOf yangId:esi-type ;
    prov:wasDerivedFrom "l2vpn-es:esi-type-4-router-id?identity" .

ietfEtSe:esi-type-5-asn a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "esi-type-5-asn" ;
    rdfs:comment """This type indicates an Autonomous System (AS)-based ESI value
that can be auto-generated or configured by the operator.""" ;
    rdfs:subClassOf yangId:esi-type ;
    prov:wasDerivedFrom "l2vpn-es:esi-type-5-asn?identity" .

