ex:index a owl:DatatypeProperty ;
    rdfs:label "index" ;
    rdfs:comment """An index number used to identify the concatenation
order of the child cables.""",
        "LAG interface index." ;
    rdfs:domain lagIn2:lag-interface,
        cab:child-cable ;
    rdfs:range xsd:string,
        xsd:unsignedByte ;
    prov:wasDerivedFrom "l2vpn-svc:l2vpn-svc?container/l2vpn-svc:sites?container/l2vpn-svc:site?list/l2vpn-svc:site-network-accesses?container/l2vpn-svc:site-network-access?list/l2vpn-svc:connection?container/l2vpn-svc:lag-interfaces?container/l2vpn-svc:lag-interface?list/l2vpn-svc:index?leaf",
        "nwi-passive:child-cable?list/nwi-passive:index?leaf" .

ex:ingress-replication a owl:DatatypeProperty ;
    rdfs:label "ingress-replication" ;
    rdfs:comment """Controls whether ingress replication is
enabled ('true') or disabled
('false').""" ;
