ex:bfd-profile-identifier a owl:DatatypeProperty ;
    rdfs:label "bfd-profile-identifier" ;
    rdfs:comment """Identification of the SP BFD profile to be used.
Local to each administration.""" ;
    rdfs:domain l2svcVpnProfs:valid-provider-identifiers ;
