ex:type a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "type" ;
    rdfs:comment "BUM type.",
        """Bandwidth type.  By default, the bandwidth type
is set to 'bw-per-cos'.""",
        """Describes the type of connection, e.g.,
point-to-point or multipoint.""",
        "Management type of the connection.",
        """Performance-monitoring types.  By default, the
performance-monitoring type is set to 'delay'.
The non-existence of this leaf means that no
measurements are to be reported.""",
        """Tagged interface type.  By default,
the type of the tagged interface is
'priority-tagged'.""",
        """The type of network inventory location, e.g.
equipment room, building, or site.

This allows operators to flexibly define custom location
types (e.g., 'pole', 'roof', 'floor') based on their
specific network scenarios without requiring model
extensions. String-based types enable dynamic adaptation
to heterogeneous organizational naming conventions.""",
        "Type of VPN policy filter.",
        """Type of requested bearer: Ethernet, ATM, Frame
Relay, IP Layer 2 transport, Frame Relay Data
Link Connection Identifier (DLCI), SONET/SDH,
PPP.""" ;
    rdfs:domain l2svcBum:bum-rate-per-type,
        l2svcSite:management,
        l2svcTps:site-network-access,
        bear:requested-type,
        l2svcTpBum:bum-rate-per-type,
        l2svcOam:y-1731,
        l2svcTpConn:tagged-interface,
        l2svcSvcBw:bandwidth,
        filt:filter,
        nwiLocs:location ;
    rdfs:range l2svcId:bum-type,
        l2svcId:bw-type,
        l2svcId:management,
        l2svcId:pm-type,
        l2svcId:site-network-access-type,
        l2svcId:tagged-inf-type,
        l2svcId:vpn-policy-filter-type,
        xsd:string ;
    prov:wasDerivedFrom "l2vpn-svc:broadcast-unknown-unicast-multicast?container/l2vpn-svc:bum-rate-per-type?list/l2vpn-svc:type?leaf",
        "l2vpn-svc:l2vpn-svc?container/l2vpn-svc:sites?container/l2vpn-svc:site?list/l2vpn-svc:management?container/l2vpn-svc:type?leaf",
        "l2vpn-svc:l2vpn-svc?container/l2vpn-svc:sites?container/l2vpn-svc:site?list/l2vpn-svc:site-network-accesses?container/l2vpn-svc:site-network-access?list/l2vpn-svc:bearer?container/l2vpn-svc:requested-type?container/l2vpn-svc:type?leaf",
        "l2vpn-svc:l2vpn-svc?container/l2vpn-svc:sites?container/l2vpn-svc:site?list/l2vpn-svc:site-network-accesses?container/l2vpn-svc:site-network-access?list/l2vpn-svc:connection?container/l2vpn-svc:oam?container/l2vpn-svc:y-1731?list/l2vpn-svc:type?leaf",
        "l2vpn-svc:l2vpn-svc?container/l2vpn-svc:sites?container/l2vpn-svc:site?list/l2vpn-svc:site-network-accesses?container/l2vpn-svc:site-network-access?list/l2vpn-svc:connection?container/l2vpn-svc:tagged-interface?container/l2vpn-svc:type?leaf",
        "l2vpn-svc:l2vpn-svc?container/l2vpn-svc:sites?container/l2vpn-svc:site?list/l2vpn-svc:site-network-accesses?container/l2vpn-svc:site-network-access?list/l2vpn-svc:service?container/l2vpn-svc:svc-bandwidth?container/l2vpn-svc:bandwidth?list/l2vpn-svc:type?leaf",
