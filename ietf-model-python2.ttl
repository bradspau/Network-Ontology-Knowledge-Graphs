ex:hasUpstreamDevice a owl:ObjectProperty ;
    rdfs:label "has upstream device" ;
    rdfs:comment "Materialised shortcut: device at Z-end of a cable -> device at A-end (upstream). Annotated via RDF-star with ex:viaCable and ex:cableRole. Enables: ?device ex:hasUpstreamDevice+ ?odf ." .

ietfEtSe:df-election-methods a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "df-election-methods" ;
    rdfs:comment "Base Identity Designated Forwarder (DF) election method." ;
    prov:wasDerivedFrom "l2vpn-es:df-election-methods?identity" .

ietfEtSe:es-redundancy-mode a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "es-redundancy-mode" ;
