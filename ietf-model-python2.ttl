net:link a owl:Class ;
    rdfs:label "link" ;
    rdfs:comment """A network link connects a local (source) node and
a remote (destination) node via a set of the respective
node's termination points.  It is possible to have several
links between the same source and destination nodes.
Likewise, a link could potentially be re-homed between
termination points.  Therefore, in order to ensure that we
would always know to distinguish between links, every link
is identified by a dedicated link identifier.  Note that a
link models a point-to-point link, not a multipoint link.""" ;
    rdfs:isDefinedBy modu:ietf-network-topology ;
    prov:wasAttributedTo modu:ietf-network-topology ;
    prov:wasDerivedFrom "nt:link?list" .

nw-node:supporting-node a owl:Class ;
    rdfs:label "supporting-node" ;
    rdfs:comment """Represents another node that is in an underlay network
and that supports this node.  Used to represent layering
structure.""" ;
    owl:hasKey ( netSuppNode:network-ref netSuppNode:node-ref ) ;
    prov:wasDerivedFrom "nw:networks?container/nw:network?list/nw:node?list/nw:supporting-node?list" .

nw-node:termination-point a owl:Class ;
    rdfs:label "termination-point" ;
    rdfs:comment """A termination point can terminate a link.
Depending on the type of topology, a termination point
could, for example, refer to a port or an interface.""" ;
    rdfs:isDefinedBy modu:ietf-network-topology ;
