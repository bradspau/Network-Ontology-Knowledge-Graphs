    skos:definition "none" ;
    lex:canonicalExample "" ;
    lex:entityClass lex:IdentityKind ;
    prov:wasDerivedFrom <http://example.org/ontology/identity/tapi-topology/FORWARDING_RULE> .

lex:tapi-topology-forwarding-rule-cannot-forward-across-group
    a lex:ReferenceEntry ;
    skos:prefLabel "FORWARDING_RULE_CANNOT_FORWARD_ACROSS_GROUP" ;
    skos:definition "NEPs referenced by the NodeRuleGroup (or indirectly by the InterRuleGroup between NodeRuleGroups) MUST NOT have Connections created between them.\nFor an InterRuleGroup points in a NodeRuleGroup at one end of the InterRuleGroup MUST NOT be connected to points in an NodeRuleGroup at another end of the InterRuleGroup." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:IdentityKind ;
    prov:wasDerivedFrom <http://example.org/ontology/identity/tapi-topology/FORWARDING_RULE_CANNOT_FORWARD_ACROSS_GROUP> .

lex:tapi-topology-forwarding-rule-inter-connection-contention
    a lex:ReferenceEntry ;
    skos:prefLabel "FORWARDING_RULE_INTER_CONNECTION_CONTENTION" ;
    skos:definition "Connections to NEPs in the Rule Group contend for resources based upon a constraint of some signal property.\nFor example, each Connection to a NEP in the Group must use a different value of the signal property from all other Connections to NEPs in the Rule Group.\nFor example, each Connection to a NEP in the Group must use a same value of the signal property as all other Connections to NEPs in the Rule Group. In this case the first Connection created in the Rule Group sets the value and the Group constraint is freed when the last Connection is deleted." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:IdentityKind ;
    prov:wasDerivedFrom <http://example.org/ontology/identity/tapi-topology/FORWARDING_RULE_INTER_CONNECTION_CONTENTION> .

lex:tapi-topology-forwarding-rule-may-forward-across-group
    a lex:ReferenceEntry ;
    skos:prefLabel "FORWARDING_RULE_MAY_FORWARD_ACROSS_GROUP" ;
    skos:definition "NEPs referenced by the NodeRuleGroup (or indirectly by the InterRuleGroup between NodeRuleGroups) may have Connections created between them unless some other rule overrides this.\nFor an InterRuleGroup, points in a NodeRuleGroup at one end of the InterRuleGroup may be connected to points in a NodeRuleGroup at another end of the InterRuleGroup." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:IdentityKind ;
    prov:wasDerivedFrom <http://example.org/ontology/identity/tapi-topology/FORWARDING_RULE_MAY_FORWARD_ACROSS_GROUP> .

lex:tapi-topology-forwarding-rule-must-forward-across-group
    a lex:ReferenceEntry ;
    skos:prefLabel "FORWARDING_RULE_MUST_FORWARD_ACROSS_GROUP" ;
    skos:definition "NEPs referenced by the NodeRuleGroup (or indirectly by the InterRuleGroup between NodeRuleGroups) MUST have Connections created between them unless some other rule overrides this.\nFor an InterRuleGroup, points in a NodeRuleGroup at one end of the InterRuleGroup MUST be connected to points in a NodeRuleGroup at another end of the InterRuleGroup." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:IdentityKind ;
    prov:wasDerivedFrom <http://example.org/ontology/identity/tapi-topology/FORWARDING_RULE_MUST_FORWARD_ACROSS_GROUP> .

