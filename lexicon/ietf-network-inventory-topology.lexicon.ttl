lex:ietf-network-inventory-topology-port-breakout
    a lex:ReferenceEntry ;
    skos:prefLabel "port-breakout" ;
    skos:definition "Breakout capability of the physical port represented by\nthis TP. One TP maps to one physical port; channels are\nlisted here. This container is present only when the\nunderlying hardware supports partitioning the port into\nmultiple independent channels (e.g., 400G to 4x100G)." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:StructuralKind ;
    prov:wasDerivedFrom <http://example.org/ontology/ietf-network-inventory-topology/ietf-network-state/networks/network/node/termination-point/inventory-mapping-attributes/port-breakout> .

lex:ietf-network-inventory-topology-tp-inventory-mapping-attributes
    a lex:ReferenceEntry ;
    skos:prefLabel "tp-inventory-mapping-attributes" ;
    skos:definition "Attributes for mapping a topology termination point (TP)\nto a physical port in the network inventory." ;
    skos:scopeNote "Grouping definition: tp-inventory-mapping-attributes" ;
    lex:canonicalExample "" ;
