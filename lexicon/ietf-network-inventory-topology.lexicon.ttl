lex:ietf-network-inventory-topology-breakout-channel
    a lex:ReferenceEntry ;
    skos:prefLabel "breakout-channel" ;
    skos:definition "List of breakout channels available on this port.\nEach entry represents an independent lane or sub-port\nthat can be used for channelized interfaces." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:StructuralKind ;
    prov:wasDerivedFrom <http://example.org/ontology/ietf-network-inventory-topology/ietf-network-state/networks/network/node/termination-point/inventory-mapping-attributes/port-breakout/breakout-channel> .

lex:ietf-network-inventory-topology-link-inventory-mapping-attributes
    a lex:ReferenceEntry ;
    skos:prefLabel "link-inventory-mapping-attributes" ;
    skos:definition "Attributes for classifying link media type.\nDetailed inventory reference is intentionally omitted from\nthis model; implementations should use the appropriate\nspecialized inventory modules based on the indicated\nlink-type." ;
    skos:scopeNote "Grouping definition: link-inventory-mapping-attributes" ;
    lex:canonicalExample "" ;
    lex:entityClass lex:GroupingKind ;
    prov:wasDerivedFrom <http://example.org/ontology/grouping/ietf-network-inventory-topology/link-inventory-mapping-attributes> .

lex:ietf-network-inventory-topology-node-inventory-mapping-attributes
    a lex:ReferenceEntry ;
    skos:prefLabel "node-inventory-mapping-attributes" ;
    skos:definition "Attributes for mapping a topology node to a Network Element\n(NE) in the physical inventory." ;
    skos:scopeNote "Grouping definition: node-inventory-mapping-attributes" ;
    lex:canonicalExample "" ;
    lex:entityClass lex:GroupingKind ;
