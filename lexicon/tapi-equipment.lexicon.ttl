lex:tapi-equipment-equipment-category-circuit-pack
    a lex:ReferenceEntry ;
    skos:prefLabel "EQUIPMENT_CATEGORY_CIRCUIT_PACK" ;
    # source: http://example.org/ontology/identity/tapi-equipment/EQUIPMENT_CATEGORY_CIRCUIT_PACK
    skos:definition "An assembly with connectors compatible with those in a holder.\nThe assembly is designed to be mounted in a holder (SLOT) of a SUBRACK.\nMay also support holders (SLOTs) for SMALL_FORMFACTOR_PLUGGABLEs." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:IdentityKind ;
    prov:wasDerivedFrom <http://example.org/ontology/identity/tapi-equipment/EQUIPMENT_CATEGORY_CIRCUIT_PACK> .

lex:tapi-equipment-equipment-category-rack
    a lex:ReferenceEntry ;
    skos:prefLabel "EQUIPMENT_CATEGORY_RACK" ;
    # source: http://example.org/ontology/identity/tapi-equipment/EQUIPMENT_CATEGORY_RACK
    skos:definition "A mechanical assembly with cabling and predefined mounting points for particular SUBRACK types.\nThe assembly is designed to be mounted on the floor in a row with other RACKs." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:IdentityKind ;
    prov:wasDerivedFrom <http://example.org/ontology/identity/tapi-equipment/EQUIPMENT_CATEGORY_RACK> .

