lex:tapi-equipment-actual-non-field-replaceable-module
    a lex:ReferenceEntry ;
    skos:prefLabel "actual-non-field-replaceable-module" ;
    # source: http://example.org/ontology/grouping/tapi-equipment/actual-non-field-replaceable-module
    skos:definition "A structure that represents an actual equipment that cannot be replaced in the field.\nIs simply a subordinate part of an ActualEquipment (FRU).\nDoes not have any exposed holders (any associated holders are assumed to belong to the containing FRU).\nDoes not have any connectors (any associated connectors are assumed to belong to the containing FRU).\n" ;
    # source: http://example.org/ontology/grouping/tapi-equipment/actual-non-field-replaceable-module
    skos:scopeNote "Grouping definition: actual-non-field-replaceable-module" ;
    lex:canonicalExample "" ;
    lex:entityClass lex:GroupingKind ;
    prov:wasDerivedFrom <http://example.org/ontology/grouping/tapi-equipment/actual-non-field-replaceable-module> .

