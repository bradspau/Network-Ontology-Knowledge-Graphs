lex:tapi-equipment-physical-span
    a lex:ReferenceEntry ;
    skos:prefLabel "physical-span" ;
    # source: http://example.org/ontology/grouping/tapi-equipment/physical-span
    skos:definition "An adjacency between AccessPorts.\nThe adjacency is supported by a group of strands between pins of the AccessPorts.\nThis is a physical abstraction." ;
    # source: http://example.org/ontology/grouping/tapi-equipment/physical-span
    skos:scopeNote "Grouping definition: physical-span" ;
    lex:canonicalExample "" ;
    lex:entityClass lex:GroupingKind ;
    prov:wasDerivedFrom <http://example.org/ontology/grouping/tapi-equipment/physical-span> .

