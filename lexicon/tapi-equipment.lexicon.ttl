lex:tapi-equipment-abstract-strand
    a lex:ReferenceEntry ;
    skos:prefLabel "abstract-strand" ;
    # source: http://example.org/ontology/grouping/tapi-equipment/abstract-strand
    skos:definition "Grouping definition: abstract-strand" ;
    # source: http://example.org/ontology/grouping/tapi-equipment/abstract-strand
    skos:scopeNote "This object represents an abstraction of one or more strands in series that provides sufficient detail to enable appropriate engineering.\nA strand represents a continuous long, thin piece of a medium such as glass fiber or copper wire.\nIn this model a Strand:\n- a strand has two ends\n- a splice can only be between 2 strands.\n- the end of a strand may have a splice, a connector or be hidden\n- only one end can be hidden in an equipment\n- where a cable has more than two end each strand only goes between two of the ends\nThis model does NOT account for multiple copper strands being spliced." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:GroupingKind ;
    prov:wasDerivedFrom <http://example.org/ontology/grouping/tapi-equipment/abstract-strand> .

