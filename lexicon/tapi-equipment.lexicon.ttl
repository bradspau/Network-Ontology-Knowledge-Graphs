    prov:wasDerivedFrom <http://example.org/ontology/grouping/tapi-equipment/access-port-ref> .

lex:tapi-equipment-access-port-supports-nep
    a lex:ReferenceEntry ;
    skos:prefLabel "access-port-supports-nep" ;
    # source: http://example.org/ontology/grouping/tapi-equipment/access-port-supports-nep
    skos:definition "Grouping definition: access-port-supports-nep" ;
    # source: http://example.org/ontology/grouping/tapi-equipment/access-port-supports-nep
    skos:scopeNote "The AccessPort supporting this NEP. More NEPs can be supported by the same AccessPort.\nThis augment allows NEP to refer to its AccessPort despite TapiTopology model does not import TapiEquipment model." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:GroupingKind ;
    prov:wasDerivedFrom <http://example.org/ontology/grouping/tapi-equipment/access-port-supports-nep> .

