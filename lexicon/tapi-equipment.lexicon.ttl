lex:tapi-equipment-physical-route
    a lex:ReferenceEntry ;
    skos:prefLabel "physical-route" ;
    # source: http://example.org/ontology/grouping/tapi-equipment/physical-route
    skos:definition "Grouping definition: physical-route" ;
    # source: http://example.org/ontology/grouping/tapi-equipment/physical-route
    skos:scopeNote "The physical route of a connection is modeled as an ordered sequence of physical route element instances.\nThe physical route is a description dedicated to the connection." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:GroupingKind ;
    prov:wasDerivedFrom <http://example.org/ontology/grouping/tapi-equipment/physical-route> .

lex:tapi-equipment-physical-route-element
    a lex:ReferenceEntry ;
    skos:prefLabel "physical-route-element" ;
    # source: http://example.org/ontology/grouping/tapi-equipment/physical-route-element
    skos:definition "A PhysicalRouteElement describes equipment, connectors on those equipments and pins of those connectors that are involved in the physical route of the connection.\nThe description may be in terms of access port or connector pin in route (at least one of access port or connector pin in route must be provided) or both.\nWhere access port is provided alone, this may be because all pins in the connectors of the access port are used, because the connector pin detail id not known the and to its subset of connectorPins which are involved in the physical route.\nAn access port may include connectorPins of more Equipments, e.g., in case of bidirectional access port shared by two 'unidirectional'; Equipments.\nConnector pin details may be provided alone without an access port where there are no access ports modelled." ;
    # source: http://example.org/ontology/grouping/tapi-equipment/physical-route-element
    skos:scopeNote "Grouping definition: physical-route-element" ;
    lex:canonicalExample "" ;
    lex:entityClass lex:GroupingKind ;
    prov:wasDerivedFrom <http://example.org/ontology/grouping/tapi-equipment/physical-route-element> .

lex:tapi-equipment-physical-route-list
    a lex:ReferenceEntry ;
    skos:prefLabel "physical-route-list" ;
    # source: http://example.org/ontology/grouping/tapi-equipment/physical-route-list
    skos:definition "Grouping definition: physical-route-list" ;
    # source: http://example.org/ontology/grouping/tapi-equipment/physical-route-list
    skos:scopeNote "The list of the PhysicalRoutes of a Connection." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:GroupingKind ;
    prov:wasDerivedFrom <http://example.org/ontology/grouping/tapi-equipment/physical-route-list> .

