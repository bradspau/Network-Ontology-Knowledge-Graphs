lex:tapi-equipment-holder
    a lex:ReferenceEntry ;
    skos:prefLabel "holder" ;
    # source: http://example.org/ontology/grouping/tapi-equipment/holder
    skos:definition "Grouping definition: holder" ;
    # source: http://example.org/ontology/grouping/tapi-equipment/holder
    skos:scopeNote "Represents a space in an equipment in which another equipment can be fitted in the field.\nIt must have at least one of actual holder or expected holder (and may have both)." ;
