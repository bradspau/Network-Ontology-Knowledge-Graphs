    prov:wasDerivedFrom <http://example.org/ontology/grouping/tapi-equipment/abstract-strand-ref> .

lex:tapi-equipment-access-port
    a lex:ReferenceEntry ;
    skos:prefLabel "access-port" ;
    # source: http://example.org/ontology/grouping/tapi-equipment/access-port
    skos:definition "A group of pins that together support a signal group where any one pin removed from the group will prevent all signals of the signal group from flowing successfully.\nIn some cases the AccessPort may simply reference a single connector (e.g., where the pin-connector association is simple such that the AccessPort references all pins of one connector)." ;
    # source: http://example.org/ontology/grouping/tapi-equipment/access-port
    skos:scopeNote "Grouping definition: access-port" ;
    lex:canonicalExample "" ;
    lex:entityClass lex:GroupingKind ;
    prov:wasDerivedFrom <http://example.org/ontology/grouping/tapi-equipment/access-port> .

