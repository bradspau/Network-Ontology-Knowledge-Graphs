    skos:definition "The reverse of the NORMAL_FLOW.\nThe light flows to the strand that references the strand joint with 'to strand joint'." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:IdentityKind ;
    prov:wasDerivedFrom <http://example.org/ontology/identity/tapi-equipment/FLOW_DIRECTION_CONTRA_FLOW> .

lex:tapi-equipment-flow-direction-normal-flow
    a lex:ReferenceEntry ;
    skos:prefLabel "FLOW_DIRECTION_NORMAL_FLOW" ;
    # source: http://example.org/ontology/identity/tapi-equipment/FLOW_DIRECTION_NORMAL_FLOW
    skos:definition "Applies to the normal flow of light through the strand joint as expressed via the 'to strand joint' statement of a strand." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:IdentityKind ;
    prov:wasDerivedFrom <http://example.org/ontology/identity/tapi-equipment/FLOW_DIRECTION_NORMAL_FLOW> .

