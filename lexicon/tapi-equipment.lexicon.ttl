    skos:definition "Grouping definition: physical-span-ref" ;
    lex:canonicalExample "" ;
    lex:entityClass lex:GroupingKind ;
    prov:wasDerivedFrom <http://example.org/ontology/grouping/tapi-equipment/physical-span-ref> .

lex:tapi-equipment-pin-and-role
    a lex:ReferenceEntry ;
    skos:prefLabel "pin-and-role" ;
    # source: http://example.org/ontology/grouping/tapi-equipment/pin-and-role
    skos:definition "Grouping definition: pin-and-role" ;
    # source: http://example.org/ontology/grouping/tapi-equipment/pin-and-role
    skos:scopeNote "Provides an opportunity, for a pin, to give the location of the pin and the role of the pin." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:GroupingKind ;
    prov:wasDerivedFrom <http://example.org/ontology/grouping/tapi-equipment/pin-and-role> .

lex:tapi-equipment-strand-joint
    a lex:ReferenceEntry ;
    skos:prefLabel "strand-joint" ;
    # source: http://example.org/ontology/grouping/tapi-equipment/strand-joint
    skos:definition "Grouping definition: strand-joint" ;
    # source: http://example.org/ontology/grouping/tapi-equipment/strand-joint
    skos:scopeNote "Represents a flow opportunity through a joint.\nCan represent flow opportunity through:\n- a connector\n- a splice\n- etc.\nAllows augmentation with impairments and other properties of the joint.\nCan be used:\n- as a single instance alone to represent properties that apply equally to each direction of flow\n- in combinations of multiple instances to represent impairments that are different for normal flow, reverse flow and reflections.\n" ;
    lex:canonicalExample "" ;
    lex:entityClass lex:GroupingKind ;
    prov:wasDerivedFrom <http://example.org/ontology/grouping/tapi-equipment/strand-joint> .

lex:tapi-equipment-strand-joint-ref
    a lex:ReferenceEntry ;
    skos:prefLabel "strand-joint-ref" ;
    # source: http://example.org/ontology/grouping/tapi-equipment/strand-joint-ref
    skos:definition "Grouping definition: strand-joint-ref" ;
    lex:canonicalExample "" ;
    lex:entityClass lex:GroupingKind ;
    prov:wasDerivedFrom <http://example.org/ontology/grouping/tapi-equipment/strand-joint-ref> .

lex:tapi-equipment-supporting-physical-span
    a lex:ReferenceEntry ;
    skos:prefLabel "supporting-physical-span" ;
    # source: http://example.org/ontology/grouping/tapi-equipment/supporting-physical-span
    skos:definition "Grouping definition: supporting-physical-span" ;
    # source: http://example.org/ontology/grouping/tapi-equipment/supporting-physical-span
    skos:scopeNote "The PhysicalSpan supporting this Link. More Links can be supported by the same PhysicalSpan.\nThis augment allows Link to refer to its PhysicalSpans despite TapiTopology model does not import TapiEquipment model." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:GroupingKind ;
    prov:wasDerivedFrom <http://example.org/ontology/grouping/tapi-equipment/supporting-physical-span> .
