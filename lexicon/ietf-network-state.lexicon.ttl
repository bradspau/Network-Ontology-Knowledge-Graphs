lex:ietf-network-state-node
    a lex:ReferenceEntry ;
    skos:prefLabel "node" ;
    skos:definition "Augments termination points that terminate links.\nTermination points can ultimately be mapped to interfaces." ;
    skos:scopeNote "Augments the network topology node with inventory mapping\nattributes. This enables correlation between the logical node\nand its physical network element." ;
    skos:scopeNote "Configuration parameters for L2 at the node\nlevel." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:StructuralKind ;
    prov:wasDerivedFrom <http://example.org/ontology/ietf-network-state/networks/network/node> .

lex:ietf-network-state-termination-point
    a lex:ReferenceEntry ;
    skos:prefLabel "termination-point" ;
    skos:definition "A termination point can terminate a link.\nDepending on the type of topology, a termination point\ncould, for example, refer to a port or an interface." ;
    skos:scopeNote "Augments L2 topology termination point information." ;
    skos:scopeNote "Augments the TP with inventory mapping attributes for\nphysical port correlation and breakout capability reporting." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:StructuralKind ;
    prov:wasDerivedFrom <http://example.org/ontology/ietf-network-state/networks/network/node/termination-point> .
