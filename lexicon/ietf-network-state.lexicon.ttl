lex:ietf-network-state-link
    a lex:ReferenceEntry ;
    skos:prefLabel "link" ;
    # source: http://example.org/ontology/ietf-network-state/networks/network/link
    skos:definition "A network link connects a local (source) node and\na remote (destination) node via a set of the respective\nnode's termination points.  It is possible to have several\nlinks between the same source and destination nodes.\nLikewise, a link could potentially be re-homed between\ntermination points.  Therefore, in order to ensure that we\nwould always know to distinguish between links, every link\nis identified by a dedicated link identifier.  Note that a\nlink models a point-to-point link, not a multipoint link." ;
    # source: http://example.org/ontology/ietf-network-state/networks/network/link
    skos:scopeNote "Augments L2 topology link information." ;
    # source: http://example.org/ontology/ietf-network-state/networks/network/link
    skos:scopeNote "Augments the network topology link with inventory-related\nattributes." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:StructuralKind ;
    prov:wasDerivedFrom <http://example.org/ontology/ietf-network-state/networks/network/link> .

