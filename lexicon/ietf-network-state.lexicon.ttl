lex:ietf-network-state-network-types
    a lex:ReferenceEntry ;
    skos:prefLabel "network-types" ;
    skos:definition "Introduces a new network type for L2 topology." ;
    skos:scopeNote "Introduces new network type for L2 topology." ;
    lex:canonicalExample "" ;
