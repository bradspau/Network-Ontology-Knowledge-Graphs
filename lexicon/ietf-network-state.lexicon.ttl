lex:ietf-network-state-inventory-mapping-attributes
    a lex:ReferenceEntry ;
    skos:prefLabel "inventory-mapping-attributes" ;
    # source: http://example.org/ontology/ietf-network-state/networks/network/node/termination-point/inventory-mapping-attributes
    skos:scopeNote "Container for inventory mapping attributes of a TP." ;
    # source: http://example.org/ontology/ietf-network-state/networks/network/node/inventory-mapping-attributes
    skos:scopeNote "Container for inventory mapping attributes of a node." ;
    # source: http://example.org/ontology/ietf-network-state/networks/network/link/inventory-mapping-attributes
    skos:scopeNote "Container for inventory-related attributes of a link.\n\nThis container provides lightweight media classification.\nThe link-type indicates which specialized inventory model\ncontains detailed resource information:\n\n- Wired media (fiber, copper): passive network inventory\n- Wireless media (microwave, Wi-Fi): wireless-specific\n  inventory\n\n  Detailed inventory references may be added in future\n  modules." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:StructuralKind ;
    prov:wasDerivedFrom <http://example.org/ontology/ietf-network-state/networks/network/link/inventory-mapping-attributes> ,
                        <http://example.org/ontology/ietf-network-state/networks/network/node/inventory-mapping-attributes> ,
                        <http://example.org/ontology/ietf-network-state/networks/network/node/termination-point/inventory-mapping-attributes> .

