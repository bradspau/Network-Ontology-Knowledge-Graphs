lex:ietf-network-state-node
    a lex:ReferenceEntry ;
    skos:prefLabel "node" ;
    # source: http://example.org/ontology/ietf-network-state/networks/network/node
    skos:definition "Augments termination points that terminate links.\nTermination points can ultimately be mapped to interfaces." ;
    # source: http://example.org/ontology/ietf-network-state/networks/network/node
    skos:scopeNote "Augments the network topology node with inventory mapping\nattributes. This enables correlation between the logical node\nand its physical network element." ;
    # source: http://example.org/ontology/ietf-network-state/networks/network/node
    skos:scopeNote "Configuration parameters for L2 at the node\nlevel." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:StructuralKind ;
    prov:wasDerivedFrom <http://example.org/ontology/ietf-network-state/networks/network/node> .

