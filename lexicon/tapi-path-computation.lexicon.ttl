lex:tapi-path-computation-topology-constraint
    a lex:ReferenceEntry ;
    skos:prefLabel "topology-constraint" ;
    # source: http://example.org/ontology/grouping/tapi-path-computation/topology-constraint
    skos:definition "Grouping definition: topology-constraint" ;
    # source: http://example.org/ontology/grouping/tapi-path-computation/topology-constraint
    skos:scopeNote "The TopologyConstraint class allows to specify topology entities in order to impose specific constraints (as denoted by the attribute name) on ConnectivityService/PathComputationService realization.\nThe topology entities are specified by their instance UUID rather than using references/path (to allow for mapping to Yang 1.0).\nThis loose typing and reference necessitates that implementations validate not only the presence of the instance, but also that it is of the correct type as implied by the attribute name.\nIf this validation fails, then the implementation is expected to return an error.\n" ;
    lex:canonicalExample "" ;
    lex:entityClass lex:GroupingKind ;
    prov:wasDerivedFrom <http://example.org/ontology/grouping/tapi-path-computation/topology-constraint> .

lex:tapi-path-computation-value-or-priority
    a lex:ReferenceEntry ;
    skos:prefLabel "value-or-priority" ;
    # source: http://example.org/ontology/grouping/tapi-path-computation/value-or-priority
    skos:definition "Grouping definition: value-or-priority" ;
    # source: http://example.org/ontology/grouping/tapi-path-computation/value-or-priority
    skos:scopeNote "Quantitative target: when a value is specified it is intended as mandatory for fulfilment. If value is specified, priority is not considered.\nQualitative target: when priority is specified. Zero means 'unspecified', 1 is highest priority, then 2 has lower priority than 1, 3 has lower priority than 2, etc." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:GroupingKind ;
    prov:wasDerivedFrom <http://example.org/ontology/grouping/tapi-path-computation/value-or-priority> .
