    skos:prefLabel "path-computation-service" ;
    # source: http://example.org/ontology/grouping/tapi-path-computation/path-computation-service
    skos:definition "A PathComputationService represents an 'intent-like' request for connectivity between two or more PathServiceEndPoint (PSEP) instances. The PathComputationService is a container for connectivity request details and is distinct from the Path(s) that realize the request." ;
