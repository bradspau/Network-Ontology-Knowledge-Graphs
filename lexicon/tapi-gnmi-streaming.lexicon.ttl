lex:tapi-gnmi-streaming-qualified-measured-value
    a lex:ReferenceEntry ;
    skos:prefLabel "qualified-measured-value" ;
    skos:definition "Grouping definition: qualified-measured-value" ;
    skos:scopeNote "This structure allows for various value qualifications:\n- Where the value is valid and is for the complete period, then only the value will be provided (valueQualifier will not be present).\n- Where there are issues with the value, then the valueQualifier will be provided and there may be no value depending upon the valueQualifier.\n" ;
    lex:canonicalExample "" ;
    lex:entityClass lex:GroupingKind ;
    prov:wasDerivedFrom <http://example.org/ontology/grouping/tapi-gnmi-streaming/qualified-measured-value> .

