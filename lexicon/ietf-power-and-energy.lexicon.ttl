lex:ietf-power-and-energy-power-state
    a lex:ReferenceEntry ;
    skos:prefLabel "power-state" ;
    skos:definition "Base identity for all possible power states. This identity\nserves as the root for a hierarchy of power states, allowing\nfor extensibility while maintaining alignment with the IANA\nPower State Set Registry." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:IdentityKind ;
    prov:wasDerivedFrom <http://example.org/ontology/identity/ietf-power-and-energy/power-state> .

lex:ietf-power-and-energy-unit-multiplier
    a lex:ReferenceEntry ;
    skos:prefLabel "unit-multiplier" ;
    skos:definition "Base identity for unit multipliers as defined in IEC 61850-7-3\nAnnex A. These represent exponents of 10 for scaling units\nassociated with the integer units used to measure the power or\nenergy." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:IdentityKind ;
    prov:wasDerivedFrom <http://example.org/ontology/identity/ietf-power-and-energy/unit-multiplier> .
