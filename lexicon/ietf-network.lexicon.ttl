lex:ietf-network-network
    a lex:ReferenceEntry ;
    skos:prefLabel "network" ;
    skos:definition "Add links to the network data model." ;
    skos:scopeNote "Describes a network.\nA network typically contains an inventory of nodes,\ntopological information (augmented through the\nnetwork-topology data model), and layering information." ;
