    a lex:ReferenceEntry ;
    skos:prefLabel "local-link-connectivity" ;
    skos:definition "The termination capabilities between the TTP and the LTP.\nThis capability information can be used to compute\nthe tunnel path.\nThe Interface Adjustment Capability Descriptors (IACDs)\n(defined in RFC 6001) on each LTP can be derived from\nthis list." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:StructuralKind ;
    prov:wasDerivedFrom <http://example.org/ontology/ietf-network/networks/network/node/te/tunnel-termination-point/local-link-connectivities/local-link-connectivity> .

