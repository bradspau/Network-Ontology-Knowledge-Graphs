lex:ietf-network-backup-path
    a lex:ReferenceEntry ;
    skos:prefLabel "backup-path" ;
    # source: http://example.org/ontology/ietf-network/networks/network/link/te/te-link-attributes/underlay/backup-path
    skos:definition "A list of backup service paths on the underlay topology that\nprotect the underlay primary path.  If the primary path is\nnot protected, the list contains zero elements.  If the\nprimary path is protected, the list contains one or more\nelements." ;
