lex:ietf-network-supporting-network
    a lex:ReferenceEntry ;
    skos:prefLabel "supporting-network" ;
    skos:definition "An underlay network, used to represent layered network\ntopologies." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:StructuralKind ;
    prov:wasDerivedFrom <http://example.org/ontology/ietf-network/networks/network/supporting-network> .

lex:ietf-network-supporting-node
    a lex:ReferenceEntry ;
    skos:prefLabel "supporting-node" ;
    skos:definition "Represents another node that is in an underlay network\nand that supports this node.  Used to represent layering\nstructure." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:StructuralKind ;
    prov:wasDerivedFrom <http://example.org/ontology/ietf-network/networks/network/node/supporting-node> .

lex:ietf-network-supporting-termination-point
    a lex:ReferenceEntry ;
    skos:prefLabel "supporting-termination-point" ;
    skos:definition "This list identifies any termination points on which a\ngiven termination point depends or onto which it maps.\nThose termination points will themselves be contained\nin a supporting node.  This dependency information can be\ninferred from the dependencies between links.  Therefore,\nthis item is not separately configurable.  Hence, no\ncorresponding constraint needs to be articulated.\nThe corresponding information is simply provided by the\nimplementing system." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:StructuralKind ;
    prov:wasDerivedFrom <http://example.org/ontology/ietf-network/networks/network/node/termination-point/supporting-termination-point> .

lex:ietf-network-termination-point
    a lex:ReferenceEntry ;
    skos:prefLabel "termination-point" ;
    skos:definition "A termination point can terminate a link.\nDepending on the type of topology, a termination point\ncould, for example, refer to a port or an interface." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:StructuralKind ;
    prov:wasDerivedFrom <http://example.org/ontology/ietf-network/networks/network/node/termination-point> .

