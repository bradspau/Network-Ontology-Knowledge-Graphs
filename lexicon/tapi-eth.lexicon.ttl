lex:tapi-eth-eth-pm-parameter-name-average-frame-delay
    a lex:ReferenceEntry ;
    skos:prefLabel "ETH_PM_PARAMETER_NAME_AVERAGE_FRAME_DELAY" ;
    lex:canonicalExample "" ;
    lex:entityClass lex:IdentityKind ;
    lex:needsCuration true ;
