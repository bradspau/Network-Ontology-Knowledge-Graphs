lex:tapi-eth-eth-on-demand-measurement-job-control-sink
    a lex:ReferenceEntry ;
    skos:prefLabel "eth-on-demand-measurement-job-control-sink" ;
    # source: http://example.org/ontology/grouping/tapi-eth/eth-on-demand-measurement-job-control-sink
    skos:definition "Grouping definition: eth-on-demand-measurement-job-control-sink" ;
    # source: http://example.org/ontology/grouping/tapi-eth/eth-on-demand-measurement-job-control-sink
    skos:scopeNote "This object class represents an on-demand measurement job controller sink for 1-way measurements. It is created as a result of an establishOnDemandDualEndedMeasurementJobSink() operation. It is deleted either automatically after the measurement job has completed (stop time reached) and the performance data AVC notification has been sent, or by an explicit abortOnDemandMeasurementJob() operation when the measurement job is running." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:GroupingKind ;
    prov:wasDerivedFrom <http://example.org/ontology/grouping/tapi-eth/eth-on-demand-measurement-job-control-sink> .

lex:tapi-eth-eth-on-demand-measurement-job-control-source
    a lex:ReferenceEntry ;
    skos:prefLabel "eth-on-demand-measurement-job-control-source" ;
    # source: http://example.org/ontology/grouping/tapi-eth/eth-on-demand-measurement-job-control-source
    skos:definition "Basic attributes: destinationAddress, priority\nMeasurement configuration related attributes: oamPduGenerationType, startTime, stopTime, messagePeriod, repetitionPeriod, measurementInterval\nOptional attributes: dataTlvLength, testIdentifier\nThis object class represents an on-demand measurement job controller source for 1-way measurements. It is created as a result of an establishOnDemandDualEndedMeasurementJobSource() operation. It is deleted either automatically after the measurement job has completed (stop time reached), or by an explicit abortOnDemandMeasurementJob() operation while the measurement job is running." ;
    # source: http://example.org/ontology/grouping/tapi-eth/eth-on-demand-measurement-job-control-source
    skos:scopeNote "Grouping definition: eth-on-demand-measurement-job-control-source" ;
    lex:canonicalExample "" ;
    lex:entityClass lex:GroupingKind ;
    prov:wasDerivedFrom <http://example.org/ontology/grouping/tapi-eth/eth-on-demand-measurement-job-control-source> .

