lex:tapi-eth-eth-mep-common
    a lex:ReferenceEntry ;
    skos:prefLabel "eth-mep-common" ;
    # source: http://example.org/ontology/grouping/tapi-eth/eth-mep-common
    skos:definition "Basic attributes: adminState, clientMel, megIdentifier, mepMac\nContinuity Check Process related attributes: ccPeriod, ccPriority, isCcEnabled\nLock Process related attributes: lckPeriod, lckPriority\nThis object class models the MEP functions that are common to MEP Sink and MEP Source." ;
    # source: http://example.org/ontology/grouping/tapi-eth/eth-mep-common
    skos:scopeNote "Grouping definition: eth-mep-common" ;
    lex:canonicalExample "" ;
    lex:entityClass lex:GroupingKind ;
    prov:wasDerivedFrom <http://example.org/ontology/grouping/tapi-eth/eth-mep-common> .

lex:tapi-eth-eth-mep-sink
    a lex:ReferenceEntry ;
    skos:prefLabel "eth-mep-sink" ;
    # source: http://example.org/ontology/grouping/tapi-eth/eth-mep-sink
    skos:definition "1DM related attribute: 1DmPriority\nAIS Process related attributes: aisPeriod, aisPriority\nBandwidth notification Process related attribute: bandwidthReport\nBasic attribute: peerMepRefList\nCSF Process related attributes: isCsfRdiFdiEnabled, isCsfReported\nDefect correlation Process related attribute: currentProblemList\nThis object class models the MEP sink function. Instance of this object class can be created and contained by ETH CTP or TTP objects.\nIt also provides the management of the dual-ended maintenance job, such as test.\nThis object contains the configuration parameters for detecting 'degraded signal' (DEG)." ;
    # source: http://example.org/ontology/grouping/tapi-eth/eth-mep-sink
    skos:scopeNote "Grouping definition: eth-mep-sink" ;
    lex:canonicalExample "" ;
    lex:entityClass lex:GroupingKind ;
    prov:wasDerivedFrom <http://example.org/ontology/grouping/tapi-eth/eth-mep-sink> .

lex:tapi-eth-eth-mep-source
    a lex:ReferenceEntry ;
    skos:prefLabel "eth-mep-source" ;
    # source: http://example.org/ontology/grouping/tapi-eth/eth-mep-source
    skos:definition "APS Process related attribute: apsPriority\nBasic attribute: mepIdentifier\nCSF Process related attributes: csfConfig, csfPeriod, csfPriority\nLink trace related operation: linkTrace\nLoopback related operations: loopbackDiscover, loopbackSeries, loopbackTest, loopbackTestTerminate\nOn demand measurement job control related operation: establishOnDemandDualEndedMeasurementJobSource\nProactive measurement job control related operation: establishProActiveDualEndedMeasurementJobSource\nTest related operations: testInitiatorStart, testInitiatorTerminate\nThis object class models the MEP source function. Instance of this object class can be created and contained by ETH CTP or TTP objects.\nIt also provides the management of single-ended maintenance jobs, such as loopback test, loopback discover, loopback series, link trace, and dual-ended maintenance job, such as test." ;
    # source: http://example.org/ontology/grouping/tapi-eth/eth-mep-source
    skos:scopeNote "Grouping definition: eth-mep-source" ;
    lex:canonicalExample "" ;
    lex:entityClass lex:GroupingKind ;
    prov:wasDerivedFrom <http://example.org/ontology/grouping/tapi-eth/eth-mep-source> .

