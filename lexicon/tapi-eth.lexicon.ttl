lex:tapi-eth-eth-cfm-link-trace-result-data
    a lex:ReferenceEntry ;
    skos:prefLabel "eth-cfm-link-trace-result-data" ;
    # source: http://example.org/ontology/grouping/tapi-eth/eth-cfm-link-trace-result-data
    skos:definition "Grouping definition: eth-cfm-link-trace-result-data" ;
    # source: http://example.org/ontology/grouping/tapi-eth/eth-cfm-link-trace-result-data
    skos:scopeNote "IEEE P802.1Qcx/D0.3:\nMEF 38:\nAn index to distinguish among multiple LTRs with the same LTR  transaction-id field value.\nAssigned sequentially from 1, in the order that the Linktrace Initiator received the LTRs.\n" ;
    lex:canonicalExample "" ;
    lex:entityClass lex:GroupingKind ;
    prov:wasDerivedFrom <http://example.org/ontology/grouping/tapi-eth/eth-cfm-link-trace-result-data> .

lex:tapi-eth-eth-cfm-maintenance-association
    a lex:ReferenceEntry ;
    skos:prefLabel "eth-cfm-maintenance-association" ;
    # source: http://example.org/ontology/grouping/tapi-eth/eth-cfm-maintenance-association
    skos:definition "Grouping definition: eth-cfm-maintenance-association" ;
    # source: http://example.org/ontology/grouping/tapi-eth/eth-cfm-maintenance-association
    skos:scopeNote "IEEE CFM parameters applicable to the composing class.\nIEEE P802.1Qcx/D0.3:\nProvides configuration and operational data for the Maintenance Associations.\nA Maintenance Association is a set of MEPs, each configured with the same MAID and MD level, established to verify the integrity of a single service instance.\nA Maintenance Association can be thought of as a full mesh of Maintenance Entities among a set of MEPs so configured." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:GroupingKind ;
    prov:wasDerivedFrom <http://example.org/ontology/grouping/tapi-eth/eth-cfm-maintenance-association> .

lex:tapi-eth-eth-cfm-maintenance-domain
    a lex:ReferenceEntry ;
    skos:prefLabel "eth-cfm-maintenance-domain" ;
    # source: http://example.org/ontology/grouping/tapi-eth/eth-cfm-maintenance-domain
    skos:definition "Grouping definition: eth-cfm-maintenance-domain" ;
    # source: http://example.org/ontology/grouping/tapi-eth/eth-cfm-maintenance-domain
    skos:scopeNote "IEEE CFM parameters applicable to the composing class.\nIEEE P802.1Qcx/D0.3:\nMEF 38:\nA Maintenance Domain is the network or the part of the network for which faults in connectivity can be managed.\nA Maintenance Domain object is required in order to create an MA with a Maintenance Association Identifier (MAID) that includes that Maintenance Domains Name.\nFrom this Maintenance Domain managed object, all Maintenance Association managed objects associated with that Maintenance Domain managed object can be accessed, and thus controlled." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:GroupingKind ;
    prov:wasDerivedFrom <http://example.org/ontology/grouping/tapi-eth/eth-cfm-maintenance-domain> .

