lex:tapi-eth-eth-link-trace-job
    a lex:ReferenceEntry ;
    skos:prefLabel "eth-link-trace-job" ;
    # source: http://example.org/ontology/grouping/tapi-eth/eth-link-trace-job
    skos:definition "Grouping definition: eth-link-trace-job" ;
    # source: http://example.org/ontology/grouping/tapi-eth/eth-link-trace-job
    skos:scopeNote "This class represents the Link Trace (LT) process for fault localization or for discovering the intermediate MIPs along the link from the MEP Source to a target MEP or MIP. An LTM frame will be sent from the MEP source to the target MEP/MIP.\nThe termination occurs at specified stop time (schedule attribute of OamJob)." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:GroupingKind ;
    prov:wasDerivedFrom <http://example.org/ontology/grouping/tapi-eth/eth-link-trace-job> .

lex:tapi-eth-eth-link-trace-result-data
    a lex:ReferenceEntry ;
    skos:prefLabel "eth-link-trace-result-data" ;
    # source: http://example.org/ontology/grouping/tapi-eth/eth-link-trace-result-data
    skos:definition "Grouping definition: eth-link-trace-result-data" ;
    lex:canonicalExample "" ;
    lex:entityClass lex:GroupingKind ;
    prov:wasDerivedFrom <http://example.org/ontology/grouping/tapi-eth/eth-link-trace-result-data> .

lex:tapi-eth-eth-loopback-job
    a lex:ReferenceEntry ;
    skos:prefLabel "eth-loopback-job" ;
    # source: http://example.org/ontology/grouping/tapi-eth/eth-loopback-job
    skos:definition "Grouping definition: eth-loopback-job" ;
    # source: http://example.org/ontology/grouping/tapi-eth/eth-loopback-job
    skos:scopeNote "This class represents the Loopback (LB) process (send a series of LB messages carrying a test pattern to a particular MEP). The termination occurs at specified stop time (schedule attribute of OamJob).\nThis class models also the 'loopback discover' process, when destinationAddress is multicast.\nWhen number is greater than 1, then the process is to perform a Loopback (LB) Series process (send a series of N LB messages to a particular MEP/MIP. " ;
    lex:canonicalExample "" ;
    lex:entityClass lex:GroupingKind ;
    prov:wasDerivedFrom <http://example.org/ontology/grouping/tapi-eth/eth-loopback-job> .

lex:tapi-eth-eth-loopback-result-data
    a lex:ReferenceEntry ;
    skos:prefLabel "eth-loopback-result-data" ;
    # source: http://example.org/ontology/grouping/tapi-eth/eth-loopback-result-data
    skos:definition "Grouping definition: eth-loopback-result-data" ;
    lex:canonicalExample "" ;
    lex:entityClass lex:GroupingKind ;
    prov:wasDerivedFrom <http://example.org/ontology/grouping/tapi-eth/eth-loopback-result-data> .

lex:tapi-eth-eth-measurement-job-control-common
    a lex:ReferenceEntry ;
    skos:prefLabel "eth-measurement-job-control-common" ;
    # source: http://example.org/ontology/grouping/tapi-eth/eth-measurement-job-control-common
    skos:definition "Grouping definition: eth-measurement-job-control-common" ;
    # source: http://example.org/ontology/grouping/tapi-eth/eth-measurement-job-control-common
    skos:scopeNote "Time length over which each Availability Frame Loss Ratio value is calculated. This parameter allows to generalize SES and UAS.\nMEF 35.1:\n[R78]/[CR58] [O8] A SOAM PM Implementation MUST support a configurable parameter for the length of time over which each Availability flr value is calculated, with a range of 1s – 300s.  This parameter is equivalent to delta-t as specified by MEF 10.3.\n[R79]/[CR59] [O8] The length of time over which each Availability flr value is calculated (delta-t) MUST be an integer multiple of the interval between each SLM/1SL frame transmission.\n[D31]/[CD16] [O8] The default length of time over which each Availability flr value is calculated SHOULD be 1s." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:GroupingKind ;
    prov:wasDerivedFrom <http://example.org/ontology/grouping/tapi-eth/eth-measurement-job-control-common> .

