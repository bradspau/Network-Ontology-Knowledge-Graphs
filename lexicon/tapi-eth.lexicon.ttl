lex:tapi-eth-eth-pm-parameter-name-average-frame-delay-variation
    a lex:ReferenceEntry ;
    skos:prefLabel "ETH_PM_PARAMETER_NAME_AVERAGE_FRAME_DELAY_VARIATION" ;
    # source: http://example.org/ontology/identity/tapi-eth/ETH_PM_PARAMETER_NAME_AVERAGE_FRAME_DELAY_VARIATION
    skos:definition "This attribute contains the average frame delay variation measured in units of ns (nano second, 1x10e-9 seconds).\nY.1563:\nThe 2-point frame delay variation (vk) for an Ethernet frame k between SRC and DST is the difference between the absolute Ethernet frame transfer delay (xk) of frame k and a defined reference Ethernet frame transfer delay, d1,2, between those same MPs:  vk = xk – d1,2." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:IdentityKind ;
    prov:wasDerivedFrom <http://example.org/ontology/identity/tapi-eth/ETH_PM_PARAMETER_NAME_AVERAGE_FRAME_DELAY_VARIATION> .

lex:tapi-eth-eth-pm-parameter-name-average-frame-loss-ratio
    a lex:ReferenceEntry ;
    skos:prefLabel "ETH_PM_PARAMETER_NAME_AVERAGE_FRAME_LOSS_RATIO" ;
    lex:canonicalExample "" ;
    lex:entityClass lex:IdentityKind ;
    lex:needsCuration true ;
    prov:wasDerivedFrom <http://example.org/ontology/identity/tapi-eth/ETH_PM_PARAMETER_NAME_AVERAGE_FRAME_LOSS_RATIO> .

lex:tapi-eth-eth-pm-parameter-name-average-inter-frame-delay-variation
    a lex:ReferenceEntry ;
    skos:prefLabel "ETH_PM_PARAMETER_NAME_AVERAGE_INTER_FRAME_DELAY_VARIATION" ;
    # source: http://example.org/ontology/identity/tapi-eth/ETH_PM_PARAMETER_NAME_AVERAGE_INTER_FRAME_DELAY_VARIATION
    skos:definition "This attribute contains the average frame delay variation measured in units of ns (nano second, 1x10e-9 seconds).\nG.8013/Y.1731:\nFrame delay variation is a measure of the variations in the frame delay between a pair of service frames" ;
