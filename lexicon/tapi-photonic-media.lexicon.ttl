lex:tapi-photonic-media-grid-type-cwdm
    a lex:ReferenceEntry ;
    skos:prefLabel "GRID_TYPE_CWDM" ;
    skos:definition "Fixed frequency grid as specified in ITU-T G.694.2" ;
    lex:canonicalExample "" ;
    lex:entityClass lex:IdentityKind ;
    prov:wasDerivedFrom <http://example.org/ontology/identity/tapi-photonic-media/GRID_TYPE_CWDM> .

lex:tapi-photonic-media-grid-type-dwdm
    a lex:ReferenceEntry ;
    skos:prefLabel "GRID_TYPE_DWDM" ;
    skos:definition "Fixed frequency grid in C & L bands as specified in ITU-T G.694.1\n" ;
    lex:canonicalExample "" ;
    lex:entityClass lex:IdentityKind ;
    prov:wasDerivedFrom <http://example.org/ontology/identity/tapi-photonic-media/GRID_TYPE_DWDM> .

lex:tapi-photonic-media-grid-type-flex
    a lex:ReferenceEntry ;
    skos:prefLabel "GRID_TYPE_FLEX" ;
    skos:definition "Flexible frequency grid as specified in ITU-T G.694.1. In this case,\n- the allowed frequency slots have a nominal central frequency (in THz) defined by:\n193.1 + n × 0.00625 where n is a positive or negative integer including 0 and 0.00625 is the nominal central frequency granularity in THz\n- and a slot width defined by:\n12.5 × m where m is a positive integer and 12.5 is the slot width granularity in GHz.\nAny combination of frequency slots is allowed as long as no two frequency slots overlap." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:IdentityKind ;
    prov:wasDerivedFrom <http://example.org/ontology/identity/tapi-photonic-media/GRID_TYPE_FLEX> .

