    prov:wasDerivedFrom <http://example.org/ontology/identity/tapi-photonic-media/FEC_TYPE> .

lex:tapi-photonic-media-fec-type-c-fec
    a lex:ReferenceEntry ;
    skos:prefLabel "FEC_TYPE_C_FEC" ;
    skos:definition "Concatenated FEC (C-FEC) that combines an outer Staircase Forward Error Correction (SC-FEC) code and an inner double-extended SD-FEC (128,119) Hamming code.\nMore details are provided in clause 15/G.709.3 where it is called DSH instead of concatenated FEC.\nAnnex A of ITU-T G.709.2 v1.1 (09/2020):OTU4 long-reach interface;\nAnnex D of ITU-T G.709.3 v2.1 (11/2022): Flexible OTN long-reach interfaces;\nClause 15 of ITU-T G.709.3 v2.1 (11/2022): Flexible OTN long-reach interfaces." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:IdentityKind ;
    prov:wasDerivedFrom <http://example.org/ontology/identity/tapi-photonic-media/FEC_TYPE_C_FEC> .

lex:tapi-photonic-media-fec-type-g-fec
    a lex:ReferenceEntry ;
    skos:prefLabel "FEC_TYPE_G_FEC" ;
    skos:definition "Generic Forward Error Correction (G-FEC) - Reed Solomon (255,239) coding schema.\nITU-T G.975 v2.0 (10/2000): Forward error correction for submarine systems." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:IdentityKind ;
    prov:wasDerivedFrom <http://example.org/ontology/identity/tapi-photonic-media/FEC_TYPE_G_FEC> .

lex:tapi-photonic-media-fec-type-golay
    a lex:ReferenceEntry ;
    skos:prefLabel "FEC_TYPE_GOLAY" ;
    skos:definition "Golay error correction." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:IdentityKind ;
    prov:wasDerivedFrom <http://example.org/ontology/identity/tapi-photonic-media/FEC_TYPE_GOLAY> .

lex:tapi-photonic-media-fec-type-hamming-code
    a lex:ReferenceEntry ;
    skos:prefLabel "FEC_TYPE_HAMMING_CODE" ;
    skos:definition "Hamming Code error correction." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:IdentityKind ;
    prov:wasDerivedFrom <http://example.org/ontology/identity/tapi-photonic-media/FEC_TYPE_HAMMING_CODE> .

lex:tapi-photonic-media-fec-type-no-fec
    a lex:ReferenceEntry ;
    skos:prefLabel "FEC_TYPE_NO_FEC" ;
    skos:definition "FEC feature not supported." ;
    lex:canonicalExample "" ;
