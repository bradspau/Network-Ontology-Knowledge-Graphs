lex:tapi-photonic-media-fec-type-o-fec
    a lex:ReferenceEntry ;
    skos:prefLabel "FEC_TYPE_O_FEC" ;
    skos:definition "Open Forward Error Correction (O-FEC) which reuses the Bose, Chaudhuri and Hocquenghem (BCH) FEC.\nClause 16.4.4 of ITU-T G.709.3 v2.1 (11/2022): Flexible OTN long-reach interfaces." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:IdentityKind ;
    prov:wasDerivedFrom <http://example.org/ontology/identity/tapi-photonic-media/FEC_TYPE_O_FEC> .

lex:tapi-photonic-media-fec-type-sc-fec
    a lex:ReferenceEntry ;
    skos:prefLabel "FEC_TYPE_SC_FEC" ;
    skos:definition "Staircase Forward Error Correction (SC-FEC).\nAnnex A of ITU-T G.709.2 v1.1 (09/2020): OTU4 long-reach interface." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:IdentityKind ;
    prov:wasDerivedFrom <http://example.org/ontology/identity/tapi-photonic-media/FEC_TYPE_SC_FEC> .

lex:tapi-photonic-media-fec-type-super-fec
    a lex:ReferenceEntry ;
    skos:prefLabel "FEC_TYPE_SUPER_FEC" ;
    skos:definition "Super Forward Error Correction (S-FEC). Also called Enhanced FEC (E-FEC).\nITU-T G.975.1 v1.2 (07/2013): Forward error correction for high bit-rate DWDM submarine systems." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:IdentityKind ;
    prov:wasDerivedFrom <http://example.org/ontology/identity/tapi-photonic-media/FEC_TYPE_SUPER_FEC> .

