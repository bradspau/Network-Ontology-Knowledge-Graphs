    prov:wasDerivedFrom <http://example.org/ontology/identity/tapi-streaming/RECORD_TYPE_INFORMATION> .

lex:tapi-streaming-record-type-tombstone
    a lex:ReferenceEntry ;
    skos:prefLabel "RECORD_TYPE_TOMBSTONE" ;
    skos:definition "Used in a Compacted log to remove old records and truncate deletion history.\nIs only a LogRecordHeader with no LogRecordBody." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:IdentityKind ;
    prov:wasDerivedFrom <http://example.org/ontology/identity/tapi-streaming/RECORD_TYPE_TOMBSTONE> .

