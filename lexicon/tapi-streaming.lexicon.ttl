    skos:scopeNote "The ConnectionEndPoint (CEP) instances of the Connection." ;
    # source: http://example.org/ontology/tapi-streaming/stream-record/log-record/log-record-body/connectivity-service-end-point/connection-end-point
    skos:scopeNote "The associated ConnectionEndPoint (CEP) instances." ;
    # source: http://example.org/ontology/tapi-streaming/stream-record/subscribe-response/notification/update/val/proto-bytes/measurement-details/connection-end-point
    skos:scopeNote "The path to the CEP that represents the resources against which the measures were made (where the path includes topology-uuid etc.).\nCONDITION: Mandatory where abstract resource ref is not being used and a CEP is being measured." ;
