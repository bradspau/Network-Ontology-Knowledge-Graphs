lex:tapi-streaming-connection-end-point
    a lex:ReferenceEntry ;
    skos:prefLabel "connection-end-point" ;
    # source: http://example.org/ontology/tapi-streaming/stream-record/log-record/log-record-body/current-data/connection-end-point
    skos:scopeNote "The CEP to which the measurements refer to.\nAt least and exclusively one of CurrentDataOfCep, CurrentDataOfMep, CurrentDataOfMip must be referred by the CurrentData instance. " ;
    # source: http://example.org/ontology/tapi-streaming/stream-record/log-record/log-record-body/oam-job-service/oam-service-point/connection-end-point
    skos:scopeNote "The ConnectionEndPoint (CEP) instance monitored by the OamServicePoint (OSP).\nIf not specified (and neither CSEP is specified), the OamServicePoint (OSP) is intended for SIP monitoring." ;
    # source: http://example.org/ontology/tapi-streaming/stream-record/log-record/log-record-body/connection/route/connection-end-point
    skos:scopeNote "The ConnectionEndPoint (CEP) instances composing the Route." ;
    # source: http://example.org/ontology/tapi-streaming/stream-record/log-record/log-record-body/oam-job/connection-end-point
    skos:scopeNote "The ConnectionEndPoint (CEP) instances involved in the OamJob." ;
