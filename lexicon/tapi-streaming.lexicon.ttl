lex:tapi-streaming-compacted-log-details
    a lex:ReferenceEntry ;
    skos:prefLabel "compacted-log-details" ;
    # source: http://example.org/ontology/grouping/tapi-streaming/compacted-log-details
    skos:definition "Details relevant for a CompactedLog.\nThe essential Compacted Log strategy is to remove historic records about a particular thing such that only the latest record about each thing exists in the log.\nThe essential strategy is refined by the parameters of this structure." ;
    # source: http://example.org/ontology/grouping/tapi-streaming/compacted-log-details
    skos:scopeNote "Grouping definition: compacted-log-details" ;
    lex:canonicalExample "" ;
    lex:entityClass lex:GroupingKind ;
    prov:wasDerivedFrom <http://example.org/ontology/grouping/tapi-streaming/compacted-log-details> .

lex:tapi-streaming-condition-detector
    a lex:ReferenceEntry ;
    skos:prefLabel "condition-detector" ;
    # source: http://example.org/ontology/grouping/tapi-streaming/condition-detector
    skos:definition "ConditionDetector represents any monitoring component that assesses properties of something and determines from those properties what conditions are associated with the thing.\nFor example, a thing might be 'too hot' or might be 'unreliable'.\nThe monitor may a multi-state output.\nThe ConditionDetector lifecycle depends upon the lifecycle of the thing it is monitoring (this is a general OAM model consideration).\nThe entityKey in the AppendLogRecordHeader for a ConditionDetector record is the nativeDetector Id which may be derived from other ids (most robustly, nativeOwningEntityName (to which the detector is associated) + natveConditionName)." ;
    # source: http://example.org/ontology/grouping/tapi-streaming/condition-detector
    skos:scopeNote "Grouping definition: condition-detector" ;
    lex:canonicalExample "" ;
    lex:entityClass lex:GroupingKind ;
    prov:wasDerivedFrom <http://example.org/ontology/grouping/tapi-streaming/condition-detector> ,
                        <http://example.org/ontology/tapi-streaming/stream-record/log-record/log-record-body/condition-detector> .

