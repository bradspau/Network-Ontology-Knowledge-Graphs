lex:tapi-streaming-mep-meg
    a lex:ReferenceEntry ;
    skos:prefLabel "mep" ;
    skos:definition "The maintenance entity group consists of one or more maintenance entities. There are the following cases:\n1. A maintenance entity may have 0 MEPs (case of transit domains where at least 1 MIP is present).\n2. A maintenance entity may have 1 MEP (case of edge domains, where the peer MEP is ouside the managed domain).\n3. A maintenance entity may have 2 MEPs." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:StructuralKind ;
    prov:wasDerivedFrom <http://example.org/ontology/tapi-streaming/stream-record/log-record/log-record-body/meg/mep> .

