    lex:canonicalExample "" ;
    lex:entityClass lex:StructuralKind ;
    prov:wasDerivedFrom <http://example.org/ontology/tapi-streaming/stream-record/log-record/log-record-body/physical-route/physical-route-element/connector-pin-in-route> .

