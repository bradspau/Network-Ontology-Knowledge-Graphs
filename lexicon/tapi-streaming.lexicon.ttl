    prov:wasDerivedFrom <http://example.org/ontology/tapi-streaming/stream-record/log-record/log-record-body/access-port/connector-pin> .

lex:tapi-streaming-connector-pin-access-port
    a lex:ReferenceEntry ;
    skos:prefLabel "connector-pin" ;
    skos:definition "The list of Pins that support the AccessPort." ;
    lex:canonicalExample "" ;
