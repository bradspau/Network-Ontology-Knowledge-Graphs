lex:tapi-streaming-alarm-detector-state
    a lex:ReferenceEntry ;
    skos:prefLabel "ALARM_DETECTOR_STATE" ;
    skos:definition "none" ;
    lex:canonicalExample "" ;
    lex:entityClass lex:IdentityKind ;
    prov:wasDerivedFrom <http://example.org/ontology/identity/tapi-streaming/ALARM_DETECTOR_STATE> .

lex:tapi-streaming-alarm-detector-state-active
    a lex:ReferenceEntry ;
    skos:prefLabel "ALARM_DETECTOR_STATE_ACTIVE" ;
    skos:definition "The detector is indicating the operation of the monitored entity is not within acceptable bounds with respect to the specific condition measured.\nIf INTERMITTENT is supported there may be a requirement for persisted unacceptable operation after a problem occurs before ACTIVE is declared. An alternative may be to declare INTERMITTENT.\nWhere INTERMITTENT is supported, ACTIVE indicates the stable presence of a problem." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:IdentityKind ;
    prov:wasDerivedFrom <http://example.org/ontology/identity/tapi-streaming/ALARM_DETECTOR_STATE_ACTIVE> .

lex:tapi-streaming-alarm-detector-state-clear
    a lex:ReferenceEntry ;
    skos:prefLabel "ALARM_DETECTOR_STATE_CLEAR" ;
    skos:definition "The detector is indicating the operation of the monitored entity is within acceptable bounds with respect to the specific condition measured.\nThere may be a requirement for persisted acceptable operation after a problem before clear is declared etc.\nFor a Compacted Log solution a CLEAR alarm will be considered as a DELETE ChangeType in the RecordBody.\nHence a CLEAR will also cause a Tombstone record in a Compacted Log solution." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:IdentityKind ;
    prov:wasDerivedFrom <http://example.org/ontology/identity/tapi-streaming/ALARM_DETECTOR_STATE_CLEAR> .

lex:tapi-streaming-alarm-detector-state-intermittent
    a lex:ReferenceEntry ;
    skos:prefLabel "ALARM_DETECTOR_STATE_INTERMITTENT" ;
    skos:definition "The detector is indicating the operation of the monitored entity is intermittently not within acceptable bounds with respect to the specific condition measured.\nINTERMITTENT support is optional. Where it is supported there may be a requirement for persisted unacceptable operation after a problem occurs before ACTIVE or INTERMITTENT is declared." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:IdentityKind ;
    prov:wasDerivedFrom <http://example.org/ontology/identity/tapi-streaming/ALARM_DETECTOR_STATE_INTERMITTENT> .

