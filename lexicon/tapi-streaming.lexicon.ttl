lex:tapi-streaming-record-type-create
    a lex:ReferenceEntry ;
    skos:prefLabel "RECORD_TYPE_CREATE" ;
    skos:definition "The record is of the whole entity where it is known to have not existed before or not known to have existed before (it may have existed but the record has been lost and hence it appears to be new)." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:IdentityKind ;
    prov:wasDerivedFrom <http://example.org/ontology/identity/tapi-streaming/RECORD_TYPE_CREATE> .

lex:tapi-streaming-record-type-create-update
    a lex:ReferenceEntry ;
    skos:prefLabel "RECORD_TYPE_CREATE_UPDATE" ;
    skos:definition "The record includes a create or update.\nWhere there is an update in a non-compacted log the information with be sparse (e.g., a single attribute) and about an entity that is already known." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:IdentityKind ;
    prov:wasDerivedFrom <http://example.org/ontology/identity/tapi-streaming/RECORD_TYPE_CREATE_UPDATE> .

lex:tapi-streaming-record-type-delete
    a lex:ReferenceEntry ;
    skos:prefLabel "RECORD_TYPE_DELETE" ;
    skos:definition "The record is about a delete.\nThe record may have a LogRecordHeader and a LogRecordBody but no augmented content.\nThe entityKey should be sufficient to identify the entity to be deleted.\nUnder certain circumstances there may be class content in the LogRecordBody." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:IdentityKind ;
    prov:wasDerivedFrom <http://example.org/ontology/identity/tapi-streaming/RECORD_TYPE_DELETE> .

