    lex:canonicalExample "" ;
    lex:entityClass lex:IdentityKind ;
    prov:wasDerivedFrom <http://example.org/ontology/identity/tapi-streaming/CONDITION_DETECTOR_TYPE_EVENT_DETECTOR> .

