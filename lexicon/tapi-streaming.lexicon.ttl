lex:tapi-streaming-validation-mechanism
    a lex:ReferenceEntry ;
    skos:prefLabel "validation-mechanism" ;
    skos:definition "Provides details of the specific validation mechanism(s) used to confirm the presence of an intended topological entity.\nValidation mechanism examples include a specific discovery protocol, a test carried out a commissioning, information from the plan. There is no formal format for the string. Considering each example,\nthe string could be 'discovery protocol', 'commissioning test' or 'plan data'." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:StructuralKind ;
    prov:wasDerivedFrom <http://example.org/ontology/tapi-streaming/stream-record/log-record/log-record-body/link/validation-mechanism> .

