    skos:prefLabel "alarm-condition-detector-detail" ;
    skos:definition "A record of the state of a detector where that detector has two underling states that are of asymmetric importance." ;
    skos:scopeNote "Grouping definition: alarm-condition-detector-detail" ;
    lex:canonicalExample "" ;
    lex:entityClass lex:GroupingKind ;
    prov:wasDerivedFrom <http://example.org/ontology/grouping/tapi-streaming/alarm-condition-detector-detail> .

lex:tapi-streaming-alarm-condition-detector-detail-condition-detector
