lex:tapi-streaming-period
    a lex:ReferenceEntry ;
    skos:prefLabel "period" ;
    # source: http://example.org/ontology/tapi-streaming/stream-record/log-record/log-record-body/cep-pm-data/history-data/pm-data-pac/granularity-period/period
    skos:definition "The specific interval of time. Each TimePeriod occurrence specifies a duration in years, months, days, hours, minutes etc.\nThe 1..5 occurrences complies with Q.821.\nITU-T Q.821 (02/2000):\nTimeInterval ::= SEQUENCE {\nday [0] INTEGER (0..31) DEFAULT 0,\nhour [1] INTEGER (0..23) DEFAULT 0,\nminute [2] INTEGER (0..59) DEFAULT 0,\nsecond [3] INTEGER (0..59) DEFAULT 0,\nmsec [4] INTEGER (0..999) DEFAULT 0 }\nExamples:\nA duration of 1 hour, 15 minutes and 30 seconds should be coded as 3 occurrences of TimePeriod:\n- HOURS; 1\n- MINUTES; 15\n- SECONDS; 30\nA duration of 1550 milliseconds as two occurrences of TimePeriod:\n- SECONDS; 1\n- MILLISECONDS: 550" ;
    lex:canonicalExample "" ;
    lex:entityClass lex:StructuralKind ;
    prov:wasDerivedFrom <http://example.org/ontology/tapi-streaming/stream-record/log-record/log-record-body/cep-pm-data/history-data/pm-data-pac/granularity-period/period> ,
                        <http://example.org/ontology/tapi-streaming/stream-record/log-record/log-record-body/current-data/elapsed-time/period> ,
                        <http://example.org/ontology/tapi-streaming/stream-record/log-record/log-record-body/current-data/history-data/pm-data-pac/granularity-period/period> ,
                        <http://example.org/ontology/tapi-streaming/stream-record/log-record/log-record-body/current-data/pm-data-pac/granularity-period/period> ,
                        <http://example.org/ontology/tapi-streaming/stream-record/log-record/log-record-body/history-data/pm-data-pac/granularity-period/period> ,
                        <http://example.org/ontology/tapi-streaming/stream-record/log-record/log-record-body/mep-pm-data/history-data/pm-data-pac/granularity-period/period> ,
                        <http://example.org/ontology/tapi-streaming/stream-record/log-record/log-record-body/mip-pm-data/history-data/pm-data-pac/granularity-period/period> ,
                        <http://example.org/ontology/tapi-streaming/stream-record/log-record/log-record-body/oam-job/current-data/elapsed-time/period> ,
                        <http://example.org/ontology/tapi-streaming/stream-record/log-record/log-record-body/oam-job/current-data/history-data/pm-data-pac/granularity-period/period> ,
                        <http://example.org/ontology/tapi-streaming/stream-record/log-record/log-record-body/oam-job/current-data/pm-data-pac/granularity-period/period> .

