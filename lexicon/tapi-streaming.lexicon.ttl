lex:tapi-streaming-proto-bytes
    a lex:ReferenceEntry ;
    skos:prefLabel "proto-bytes" ;
    skos:definition "This is substituted for 'bytes proto_bytes = 13;' in message typed value.\n(see https://github.com/openconfig/gnmi/blob/master/proto/gnmi/gnmi.proto)\nCONDITION: Mandatory where stream details is being used." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:StructuralKind ;
    prov:wasDerivedFrom <http://example.org/ontology/tapi-streaming/stream-record/subscribe-response/notification/update/val/proto-bytes> .

lex:tapi-streaming-qualified-measured-value
    a lex:ReferenceEntry ;
    skos:prefLabel "qualified-measured-value" ;
    skos:definition "The value result of the measurement.\nIn a single measurement case, this field is mandatory.\nIn a list of measurements, it is assumed that in most cases each measurement will be different and hence it is most likely to be provided in every member of the qualifierMeasurement list in MeasurementDetails.\nIn the case where there are multiple qualified measurements identified against one point the qualifiedMeasuredValuSet field should be used.\nCONDITION: Mandatory as identified in the description above." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:StructuralKind ;
    prov:wasDerivedFrom <http://example.org/ontology/tapi-streaming/stream-record/subscribe-response/notification/update/val/proto-bytes/measurement-details/qualified-measured-value> .

lex:tapi-streaming-qualified-measured-value-qualified-measurement
    a lex:ReferenceEntry ;
    skos:prefLabel "qualified-measured-value" ;
    skos:definition "The value result of the measurement.\nIn a single measurement case, this field is mandatory.\nIn a list of measurements, it is assumed that in most cases each measurement will be different and hence it is most likely to be provided in every member of the qualifierMeasurement list in MeasurementDetails.\nIn the case where there are multiple qualified measurements identified against one point the qualifiedMeasuredValuSet field should be used.\nCONDITION: Mandatory as identified in the description above." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:StructuralKind ;
    prov:wasDerivedFrom <http://example.org/ontology/tapi-streaming/stream-record/subscribe-response/notification/update/val/proto-bytes/measurement-details/qualified-measurement/qualified-measured-value> .

lex:tapi-streaming-qualified-measured-value-set
    a lex:ReferenceEntry ;
    skos:prefLabel "qualified-measured-value-set" ;
    skos:definition "A separate measurment as part of a list of related\nProvides a simple list of values where there are multiple measurement values available in one measurement. In this case, each value must have a qualified value name to distinguish each member of the set.\nAn example could be where mean, max and min are considered as multiple measurement values for the same measurement.\nCONDITION: Mandatory where a list of values is to be provided." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:StructuralKind ;
    prov:wasDerivedFrom <http://example.org/ontology/tapi-streaming/stream-record/subscribe-response/notification/update/val/proto-bytes/measurement-details/qualified-measured-value-set> .

lex:tapi-streaming-qualified-measured-value-set-qualified-measurement
    a lex:ReferenceEntry ;
    skos:prefLabel "qualified-measured-value-set" ;
    skos:definition "A separate measurment as part of a list of related\nProvides a simple list of values where there are multiple measurement values available in one measurement. In this case, each value must have a qualified value name to distinguish each member of the set.\nAn example could be where mean, max and min are considered as multiple measurement values for the same measurement.\nCONDITION: Mandatory where a list of values is to be provided." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:StructuralKind ;
    prov:wasDerivedFrom <http://example.org/ontology/tapi-streaming/stream-record/subscribe-response/notification/update/val/proto-bytes/measurement-details/qualified-measurement/qualified-measured-value-set> .

lex:tapi-streaming-qualified-measurement
    a lex:ReferenceEntry ;
    skos:prefLabel "qualified-measurement" ;
    skos:definition "Used where multiple independent measurements are being reported in one record.\nCONDITION: Mandatory where multiple measures are to be reported." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:StructuralKind ;
    prov:wasDerivedFrom <http://example.org/ontology/tapi-streaming/stream-record/subscribe-response/notification/update/val/proto-bytes/measurement-details/qualified-measurement> .

