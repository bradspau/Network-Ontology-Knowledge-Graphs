lex:tapi-streaming-condition-detector-type-alarm-detector
    a lex:ReferenceEntry ;
    skos:prefLabel "CONDITION_DETECTOR_TYPE_ALARM_DETECTOR" ;
    skos:definition "A type of detector used for reporting problems.\nThe underlying raw detector is two state from the perspective of the monitored condition.\nThe detector is asymmetric in nature.\nOne state indicates that there is a problem and the other state indicates that there is no problem." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:IdentityKind ;
    prov:wasDerivedFrom <http://example.org/ontology/identity/tapi-streaming/CONDITION_DETECTOR_TYPE_ALARM_DETECTOR> .

