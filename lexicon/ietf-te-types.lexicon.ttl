lex:ietf-te-types-action-exercise
    a lex:ReferenceEntry ;
    skos:prefLabel "action-exercise" ;
    skos:definition "An action that starts testing whether or not APS communication\nis operating correctly.  It is of lower priority than any\nother state or command." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:IdentityKind ;
    prov:wasDerivedFrom <http://example.org/ontology/identity/ietf-te-types/action-exercise> .

lex:ietf-te-types-action-forced-switch
    a lex:ReferenceEntry ;
    skos:prefLabel "action-forced-switch" ;
    skos:definition "A switchover action initiated by an operator command to switch\nthe Extra-Traffic signal, the normal traffic signal, or the\nnull signal to the protection transport entity, unless a\nswitchover command of equal or higher priority is in effect." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:IdentityKind ;
    prov:wasDerivedFrom <http://example.org/ontology/identity/ietf-te-types/action-forced-switch> .

lex:ietf-te-types-action-freeze
    a lex:ReferenceEntry ;
    skos:prefLabel "action-freeze" ;
    skos:definition "A temporary configuration action initiated by an operator\ncommand that prevents any switchover action from being taken\nand, as such, freezes the current state." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:IdentityKind ;
    prov:wasDerivedFrom <http://example.org/ontology/identity/ietf-te-types/action-freeze> .

lex:ietf-te-types-action-lockout-of-normal
    a lex:ReferenceEntry ;
    skos:prefLabel "action-lockout-of-normal" ;
    skos:definition "A temporary configuration action initiated by an operator\ncommand to ensure that the normal traffic is not allowed\nto use the protection transport entity." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:IdentityKind ;
    prov:wasDerivedFrom <http://example.org/ontology/identity/ietf-te-types/action-lockout-of-normal> .

lex:ietf-te-types-action-lockout-of-protection
    a lex:ReferenceEntry ;
    skos:prefLabel "action-lockout-of-protection" ;
    skos:definition "A temporary configuration action initiated by an operator\ncommand to ensure that the protection transport entity is\ntemporarily not available to transport a traffic signal\n(either normal or Extra-Traffic)." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:IdentityKind ;
    prov:wasDerivedFrom <http://example.org/ontology/identity/ietf-te-types/action-lockout-of-protection> .

lex:ietf-te-types-action-manual-switch
    a lex:ReferenceEntry ;
    skos:prefLabel "action-manual-switch" ;
    skos:definition "A switchover action initiated by an operator command to switch\nthe Extra-Traffic signal, the normal traffic signal, or\nthe null signal to the protection transport entity, unless\na fault condition exists on other transport entities or a\nswitchover command of equal or higher priority is in effect." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:IdentityKind ;
    prov:wasDerivedFrom <http://example.org/ontology/identity/ietf-te-types/action-manual-switch> .

lex:ietf-te-types-association-type
    a lex:ReferenceEntry ;
    skos:prefLabel "association-type" ;
    skos:definition "Base identity for the tunnel association." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:IdentityKind ;
    prov:wasDerivedFrom <http://example.org/ontology/identity/ietf-te-types/association-type> .

lex:ietf-te-types-association-type-double-sided-bidir
    a lex:ReferenceEntry ;
    skos:prefLabel "association-type-double-sided-bidir" ;
    skos:definition "Association type for double-sided bidirectional LSPs,\nused to associate two LSPs of two tunnels that are\nindependently configured on either endpoint." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:IdentityKind ;
    prov:wasDerivedFrom <http://example.org/ontology/identity/ietf-te-types/association-type-double-sided-bidir> .

lex:ietf-te-types-association-type-recovery
    a lex:ReferenceEntry ;
    skos:prefLabel "association-type-recovery" ;
    skos:definition "Association type for recovery, used to associate LSPs of the\nsame tunnel for recovery." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:IdentityKind ;
    prov:wasDerivedFrom <http://example.org/ontology/identity/ietf-te-types/association-type-recovery> .

lex:ietf-te-types-association-type-resource-sharing
    a lex:ReferenceEntry ;
    skos:prefLabel "association-type-resource-sharing" ;
    skos:definition "Association type for resource sharing, used to enable\nresource sharing during make-before-break." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:IdentityKind ;
    prov:wasDerivedFrom <http://example.org/ontology/identity/ietf-te-types/association-type-resource-sharing> .

lex:ietf-te-types-association-type-single-sided-bidir
    a lex:ReferenceEntry ;
    skos:prefLabel "association-type-single-sided-bidir" ;
    skos:definition "Association type for single-sided bidirectional LSPs,\nused to associate two LSPs of two tunnels, where one\ntunnel is configured on one side/endpoint and the other\ntunnel is dynamically created on the other endpoint." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:IdentityKind ;
    prov:wasDerivedFrom <http://example.org/ontology/identity/ietf-te-types/association-type-single-sided-bidir> .

lex:ietf-te-types-bandwidth-protection-desired
    a lex:ReferenceEntry ;
    skos:prefLabel "bandwidth-protection-desired" ;
    skos:definition "Requests FRR bandwidth protection on LSRs, if present." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:IdentityKind ;
    prov:wasDerivedFrom <http://example.org/ontology/identity/ietf-te-types/bandwidth-protection-desired> .

lex:ietf-te-types-boundary-rerouting-desired
    a lex:ReferenceEntry ;
    skos:prefLabel "boundary-rerouting-desired" ;
    skos:definition "Indicates boundary rerouting behavior for an LSP undergoing\nestablishment.  This MAY also be used to specify\nsegment-based LSP recovery through nested crankback for\nestablished LSPs.  The boundary Area Border Router (ABR) /\nAutonomous System Border Router (ASBR) can decide to forward\nthe PathErr message upstream to either an upstream boundary\nABR/ASBR or the ingress LSR.  Alternatively, it can try to\nselect another egress boundary LSR." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:IdentityKind ;
    prov:wasDerivedFrom <http://example.org/ontology/identity/ietf-te-types/boundary-rerouting-desired> .

lex:ietf-te-types-clear
    a lex:ReferenceEntry ;
