@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix prov: <http://www.w3.org/ns/prov#> .

# Reference lexicon for module: iana-hardware
# Auto-drafted by draft_lexicon.py from yang4owl.py output. Do not hand-edit
# without removing lex:needsCuration once an entry has been reviewed --
# it exists so curated and uncurated entries stay distinguishable.
#
# Entries flagged lex:needsCuration true have an empty or label-restating
# definition and/or a placeholder canonical example -- see
# docs/reference-lexicons.md recommendation #2 before relying on them.

lex:iana-hardware-backplane
    a lex:ReferenceEntry ;
    skos:prefLabel "backplane" ;
    skos:definition "This identity is applicable if the hardware class is some sort\nof device for aggregating and forwarding networking traffic,\nsuch as a shared backplane in a modular ethernet switch.  Note\nthat an implementation may model a backplane as a single\nphysical component, which is actually implemented as multiple\ndiscrete physical components (within a chassis or stack)." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:IdentityKind ;
    prov:wasDerivedFrom <http://example.org/ontology/identity/iana-hardware/backplane> .

lex:iana-hardware-battery
    a lex:ReferenceEntry ;
    skos:prefLabel "battery" ;
    skos:definition "This identity is applicable if the hardware class is some sort\nof battery." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:IdentityKind ;
    prov:wasDerivedFrom <http://example.org/ontology/identity/iana-hardware/battery> .

lex:iana-hardware-chassis
    a lex:ReferenceEntry ;
    skos:prefLabel "chassis" ;
    skos:definition "This identity is applicable if the hardware class is an\noverall container for networking equipment.  Any class of\nphysical component, except a stack, may be contained within a\nchassis; a chassis may only be contained within a stack." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:IdentityKind ;
    prov:wasDerivedFrom <http://example.org/ontology/identity/iana-hardware/chassis> .

lex:iana-hardware-container
    a lex:ReferenceEntry ;
    skos:prefLabel "container" ;
    skos:definition "This identity is applicable if the hardware class is capable\nof containing one or more removable physical entities,\npossibly of different types.  For example, each (empty or\nfull) slot in a chassis will be modeled as a container.  Note\nthat all removable physical components should be modeled\nwithin a container component, such as field-replaceable\nmodules, fans, or power supplies.  Note that all known\ncontainers should be modeled by the agent, including empty\ncontainers." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:IdentityKind ;
    prov:wasDerivedFrom <http://example.org/ontology/identity/iana-hardware/container> .

lex:iana-hardware-cpu
    a lex:ReferenceEntry ;
    skos:prefLabel "cpu" ;
    skos:definition "This identity is applicable if the hardware class is some sort\nof central processing unit." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:IdentityKind ;
    prov:wasDerivedFrom <http://example.org/ontology/identity/iana-hardware/cpu> .

lex:iana-hardware-energy-object
    a lex:ReferenceEntry ;
    skos:prefLabel "energy-object" ;
    skos:definition "This identity is applicable if the hardware class is some sort\nof energy object, i.e., it is a piece of equipment that is\npart of or attached to a communications network that is\nmonitored, it is controlled, or it aids in the management of\nanother device for Energy Management." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:IdentityKind ;
    prov:wasDerivedFrom <http://example.org/ontology/identity/iana-hardware/energy-object> .

lex:iana-hardware-fan
    a lex:ReferenceEntry ;
    skos:prefLabel "fan" ;
    skos:definition "This identity is applicable if the hardware class is a fan or\nother heat-reduction component." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:IdentityKind ;
    prov:wasDerivedFrom <http://example.org/ontology/identity/iana-hardware/fan> .

lex:iana-hardware-hardware-class
    a lex:ReferenceEntry ;
    skos:prefLabel "hardware-class" ;
    skos:definition "This identity is the base for all hardware class\nidentifiers." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:IdentityKind ;
    prov:wasDerivedFrom <http://example.org/ontology/identity/iana-hardware/hardware-class> .

lex:iana-hardware-module
    a lex:ReferenceEntry ;
    skos:prefLabel "module" ;
    skos:definition "This identity is applicable if the hardware class is some sort\nof self-contained sub-system.  If a module component is\nremovable, then it should be modeled within a container\ncomponent; otherwise, it should be modeled directly within\nanother physical component (e.g., a chassis or another\nmodule)." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:IdentityKind ;
    prov:wasDerivedFrom <http://example.org/ontology/identity/iana-hardware/module> .

lex:iana-hardware-port
    a lex:ReferenceEntry ;
    skos:prefLabel "port" ;
    skos:definition "This identity is applicable if the hardware class is some sort\nof networking port capable of receiving and/or transmitting\nnetworking traffic." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:IdentityKind ;
    prov:wasDerivedFrom <http://example.org/ontology/identity/iana-hardware/port> .

lex:iana-hardware-power-supply
    a lex:ReferenceEntry ;
    skos:prefLabel "power-supply" ;
    skos:definition "This identity is applicable if the hardware class is a\npower-supplying component." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:IdentityKind ;
    prov:wasDerivedFrom <http://example.org/ontology/identity/iana-hardware/power-supply> .

lex:iana-hardware-sensor
    a lex:ReferenceEntry ;
    skos:prefLabel "sensor" ;
    skos:definition "This identity is applicable if the hardware class is some sort\nof sensor, such as a temperature sensor within a router\nchassis." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:IdentityKind ;
    prov:wasDerivedFrom <http://example.org/ontology/identity/iana-hardware/sensor> .

lex:iana-hardware-stack
    a lex:ReferenceEntry ;
    skos:prefLabel "stack" ;
    skos:definition "This identity is applicable if the hardware class is some sort\nof super-container (possibly virtual) intended to group\ntogether multiple chassis entities.  A stack may be realized\nby a virtual cable, a real interconnect cable attached to\nmultiple chassis, or multiple interconnect cables.  A stack\nshould not be modeled within any other physical components,\nbut a stack may be contained within another stack.  Only\nchassis components should be contained within a stack." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:IdentityKind ;
    prov:wasDerivedFrom <http://example.org/ontology/identity/iana-hardware/stack> .

lex:iana-hardware-storage-drive
    a lex:ReferenceEntry ;
    skos:prefLabel "storage-drive" ;
    skos:definition "This identity is applicable if the hardware class is some sort\nof component with data storage capability as its main\nfunctionality, e.g., hard disk drive (HDD), solid-state device\n(SSD), solid-state hybrid drive (SSHD), object storage device\n(OSD), or other." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:IdentityKind ;
    prov:wasDerivedFrom <http://example.org/ontology/identity/iana-hardware/storage-drive> .

lex:iana-hardware-unknown
    a lex:ReferenceEntry ;
    skos:prefLabel "unknown" ;
    skos:definition "This identity is applicable if the hardware class is unknown\nto the server." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:IdentityKind ;
    prov:wasDerivedFrom <http://example.org/ontology/identity/iana-hardware/unknown> .
