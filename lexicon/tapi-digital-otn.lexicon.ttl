lex:tapi-digital-otn-deg-thr
    a lex:ReferenceEntry ;
    skos:prefLabel "deg-thr" ;
    # source: http://example.org/ontology/grouping/tapi-digital-otn/deg-thr
    skos:definition "Degraded Threshold, specify either the percentage or the number of Errored Blocks in the defined interval.\n1) degThrValue when type is PERCENTAGE: percentageGranularity is used to indicate the number of decimal points.\nSo if percentageGranularity is ones, a value of 1 in degThrValue would indicate 1%, a value of 10 = 10%, a value of 100 = 100%.\nSo if percentageGranularity is thousandths a value of 1 in degThrValue would indicate 0.001%, a value of 1000 = 1%, a value of 1000000 = 100%.\n2) degThrValue when type is NUMBER_ERROR_BLOCKS: Number of Errored Blocks is captured in an integer value." ;
    # source: http://example.org/ontology/grouping/tapi-digital-otn/deg-thr
    skos:scopeNote "Grouping definition: deg-thr" ;
    lex:canonicalExample "" ;
    lex:entityClass lex:GroupingKind ;
    prov:wasDerivedFrom <http://example.org/ontology/grouping/tapi-digital-otn/deg-thr> .

lex:tapi-digital-otn-deg-thr-type
    a lex:ReferenceEntry ;
    skos:prefLabel "deg-thr-type" ;
    # source: http://example.org/ontology/types/tapi-digital-otn/deg-thr-type
    skos:definition "The value of the threshold can be provisioned in terms of number of errored blocks or in terms of percentage of errored blocks. For percentage-based specification, in order to support provision of less than 1%, the specification consists of two fields. The first field indicates the granularity of percentage. For examples, in 1%, in 0.1%, or in 0.01%, etc. The second field indicates the multiple of the granularity. For number of errored block based, the value is a positive integer." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:EnumeratedKind ;
    prov:wasDerivedFrom <http://example.org/ontology/types/tapi-digital-otn/deg-thr-type> .

