    skos:definition "Grouping definition: otn-oam-mip-service-point" ;
    # source: http://example.org/ontology/grouping/tapi-digital-otn/otn-oam-mip-service-point
    skos:scopeNote "See OtnOamMepService point comment." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:GroupingKind ;
    prov:wasDerivedFrom <http://example.org/ontology/grouping/tapi-digital-otn/otn-oam-mip-service-point> .

