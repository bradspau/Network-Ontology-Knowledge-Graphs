lex:tapi-digital-otn-otn-cn-error-performance-data
    a lex:ReferenceEntry ;
    skos:prefLabel "otn-cn-error-performance-data" ;
    skos:definition "Grouping definition: otn-cn-error-performance-data" ;
    skos:scopeNote "The ODUk contains one instance of ODU PM overhead.\nThe ODUCn contains n instances of the ODU PM overhead, numbered 1 to n (PM #1 to PM #n).\nThe PM #2 to #n fields contain the following subfields:\n- bit interleaved parity (BIP-8)\n- backward error indication (BEI)\nThe ODUk contains one instance of ODU TCM1 to TCM6 overhead.\nThe ODUCn contains n instances of the ODU TCM1 to TCM6 overhead, numbered 1 to n (TCMi #1 to TCMi #n).\nEach TCMi #2 to #n field contains the following subfields (see Figure 15-19):\n- bit interleaved parity 8 (BIP-8);\n- backward error indication and backward incoming alignment error (BEI/BIAE)" ;
    lex:canonicalExample "" ;
    lex:entityClass lex:GroupingKind ;
    prov:wasDerivedFrom <http://example.org/ontology/grouping/tapi-digital-otn/otn-cn-error-performance-data> .

