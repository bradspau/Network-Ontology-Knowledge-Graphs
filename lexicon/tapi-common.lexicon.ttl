    prov:wasDerivedFrom <http://example.org/ontology/identity/tapi-common/ETH_PM_PARAMETER_NAME_AVERAGE_FRAME_LOSS_RATIO> .

lex:tapi-common-eth-pm-parameter-name-average-inter-frame-delay-variation
    a lex:ReferenceEntry ;
    skos:prefLabel "ETH_PM_PARAMETER_NAME_AVERAGE_INTER_FRAME_DELAY_VARIATION" ;
    # source: http://example.org/ontology/identity/tapi-common/ETH_PM_PARAMETER_NAME_AVERAGE_INTER_FRAME_DELAY_VARIATION
    skos:definition "This attribute contains the average frame delay variation measured in units of ns (nano second, 1x10e-9 seconds).\nG.8013/Y.1731:\nFrame delay variation is a measure of the variations in the frame delay between a pair of service frames" ;
    lex:canonicalExample "" ;
    lex:entityClass lex:IdentityKind ;
    prov:wasDerivedFrom <http://example.org/ontology/identity/tapi-common/ETH_PM_PARAMETER_NAME_AVERAGE_INTER_FRAME_DELAY_VARIATION> .

