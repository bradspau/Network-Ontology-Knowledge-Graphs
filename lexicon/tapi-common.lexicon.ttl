lex:tapi-common-alr-plm
    a lex:ReferenceEntry ;
    skos:prefLabel "ALR_PLM" ;
    # source: http://example.org/ontology/identity/tapi-common/ALR_PLM
    skos:definition "Payload mismatch supervision.\nG.806: The payload label mismatch defect (dPLM) shall be detected if the 'accepted TSL' code does not match the 'expected TSL' code. If the 'accepted TSL' is 'equipped non-specific', the mismatch is not detected (TSL: Trail Signal Label).\nPayload type supervision checks that compatible adaptation functions are used at the source and the sink.\nThis is normally done by adding a signal type identifier at the source adaptation function and comparing it with the expected identifier at the sink.\nIf they do not match, a payload mismatch is detected.\nG.798 - dPLM at the ODUP layer: dPLM shall be declared if the accepted payload type (AcPT) is not equal to the expected payload type(s) as defined by the specific adaptation function." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:IdentityKind ;
    prov:wasDerivedFrom <http://example.org/ontology/identity/tapi-common/ALR_PLM> .

