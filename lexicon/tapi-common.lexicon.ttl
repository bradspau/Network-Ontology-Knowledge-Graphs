lex:tapi-common-owned-node-edge-point
    a lex:ReferenceEntry ;
    skos:prefLabel "owned-node-edge-point" ;
    # source: http://example.org/ontology/tapi-common/context/topology-context/topology/node/owned-node-edge-point
    skos:scopeNote "Augments the base NEP with MC specific information." ;
    # source: http://example.org/ontology/tapi-common/context/notification-context/event-notification/node/owned-node-edge-point
    skos:scopeNote "The NEPs belonging to / owned by this Node.\nBy convention, only the Node instances at the lowest partitioning level 'own' the NEPs.\nIn other words, each and every NEP instance is owned by a Node at the lowest partitioning level." ;
    # source: http://example.org/ontology/tapi-common/context/topology-context/topology/node/owned-node-edge-point
    skos:scopeNote "This augment allows NEP to refer to its AccessPorts despite TapiTopology model does not import TapiEquipment model." ;
    # source: http://example.org/ontology/tapi-common/context/topology-context/topology/node/owned-node-edge-point
    skos:scopeNote "This augment allows NEP to refer to its CEPs despite TapiTopology model does not import TapiConnectivity model." ;
    # source: http://example.org/ontology/tapi-common/context/topology-context/topology/node/owned-node-edge-point
    skos:scopeNote "This augment allows NEP to refer to its MEPs/MIPs despite TapiOam model does not import TapiTopology model." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:StructuralKind ;
    prov:wasDerivedFrom <http://example.org/ontology/tapi-common/context/notification-context/event-notification/node/owned-node-edge-point> ,
