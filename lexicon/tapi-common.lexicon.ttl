lex:tapi-common-queue-config-list
    a lex:ReferenceEntry ;
    skos:prefLabel "queue-config-list" ;
    # source: http://example.org/ontology/tapi-common/context/connectivity-context/connectivity-service/end-point/eth-connectivity-service-end-point-spec/eth-ctp-common-pac/traffic-shaping-pac/queue-config-list
    skos:definition "This attribute configures the Queue depth and Dropping threshold parameters of the Queue process. The Queue depth sets the maximum size of the queue in bytes. An incoming ETH_CI traffic unit is dropped if there is insufficient space in the queue to hold the whole unit. The Dropping threshold sets the threshold of the queue. If the queue is filled beyond this threshold, incoming ETH_CI traffic units accompanied by the ETH_CI_DE signal set are dropped." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:StructuralKind ;
    prov:wasDerivedFrom <http://example.org/ontology/tapi-common/context/connectivity-context/connectivity-service/end-point/eth-connectivity-service-end-point-spec/eth-ctp-common-pac/traffic-shaping-pac/queue-config-list> ,
