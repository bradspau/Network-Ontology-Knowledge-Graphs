lex:tapi-common-abstract-strand
    a lex:ReferenceEntry ;
    skos:prefLabel "abstract-strand" ;
    # source: http://example.org/ontology/tapi-common/context/notification-context/event-notification/physical-span/abstract-strand
    skos:definition "Both the serial segments that form an end-end strand and the parallel end-end strands.\nCONDITION: Mandatory where abstract strands are to be stated." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:StructuralKind ;
    prov:wasDerivedFrom <http://example.org/ontology/tapi-common/context/notification-context/event-notification/abstract-strand> ,
                        <http://example.org/ontology/tapi-common/context/notification-context/event-notification/physical-span/abstract-strand> ,
                        <http://example.org/ontology/tapi-common/context/physical-context/physical-span/abstract-strand> .

lex:tapi-common-accepted-payload-type
    a lex:ReferenceEntry ;
    skos:prefLabel "accepted-payload-type" ;
    # source: http://example.org/ontology/tapi-common/context/topology-context/topology/node/owned-node-edge-point/cep-list/connection-end-point/odu-connection-end-point-spec/odu-term-and-adapter/accepted-payload-type
    skos:definition "This attribute is applicable when the ODU CTP object instance represents a lower order ODU CTP Sink at the client layer of the ODUP/ODU[i]j or ODUP/ODUj-21 adaptation function.\nThis attribute is a 2-digit Hex code that indicates the new accepted payload type.\nValid values are defined in Table 15-9 of ITU-T Recommendation G.709 with one additional value UNINTERPRETABLE." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:StructuralKind ;
    prov:wasDerivedFrom <http://example.org/ontology/tapi-common/context/topology-context/topology/node/owned-node-edge-point/cep-list/connection-end-point/odu-connection-end-point-spec/odu-term-and-adapter/accepted-payload-type> .

lex:tapi-common-access-port
    a lex:ReferenceEntry ;
    skos:prefLabel "access-port" ;
    # source: http://example.org/ontology/tapi-common/context/notification-context/event-notification/device/access-port
    skos:scopeNote "Access ports of the device.\nCONDITION: Mandatory where access ports are present." ;
