lex:tapi-common-min-input-power
    a lex:ReferenceEntry ;
    skos:prefLabel "min-input-power" ;
    # source: http://example.org/ontology/tapi-common/context/connectivity-context/connectivity-service/end-point/layer-protocol-constraint/mcg-connectivity-service-end-point-spec/mc-bandwidth-config-pac/power-management-config-pac/min-input-power
    skos:definition "Add/drop ROADM port: This parameter shall be used to specify the minimum power to be delivered to the local transceiver i.e., after the signal has crossed the amplification/attenuation of the optical line system.\nThis specifies constraints related to power that the OLS should guarantee.\nTransceiver: the transceiver min launch (TX) power.\nThis specifies constraints related to power that the transceiver should guarantee.\nThis parameter conveys the attached transceiver min launch (TX) power (expected from the transceiver).\nThis specifies constraints related to power tolerance at the input." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:StructuralKind ;
    prov:wasDerivedFrom <http://example.org/ontology/tapi-common/context/connectivity-context/connectivity-service/end-point/layer-protocol-constraint/mcg-connectivity-service-end-point-spec/mc-bandwidth-config-pac/power-management-config-pac/min-input-power> ,
                        <http://example.org/ontology/tapi-common/context/connectivity-context/connectivity-service/end-point/layer-protocol-constraint/mcg-connectivity-service-end-point-spec/mc-flexi-grid-config-pac/power-management-config-pac/min-input-power> ,
                        <http://example.org/ontology/tapi-common/context/connectivity-context/connectivity-service/end-point/layer-protocol-constraint/mcg-connectivity-service-end-point-spec/mc-spectrum-config-pac/power-management-config-pac/min-input-power> ,
                        <http://example.org/ontology/tapi-common/context/connectivity-context/connectivity-service/end-point/layer-protocol-constraint/otsi-mcg-connectivity-service-end-point-spec/otsi-mc-bandwidth-config-pac/power-management-config-pac/min-input-power> ,
                        <http://example.org/ontology/tapi-common/context/connectivity-context/connectivity-service/end-point/layer-protocol-constraint/otsi-mcg-connectivity-service-end-point-spec/otsi-mc-flexi-grid-config-pac/power-management-config-pac/min-input-power> ,
                        <http://example.org/ontology/tapi-common/context/connectivity-context/connectivity-service/end-point/layer-protocol-constraint/otsi-mcg-connectivity-service-end-point-spec/otsi-mc-frequency-config-pac/power-management-config-pac/min-input-power> ,
                        <http://example.org/ontology/tapi-common/context/connectivity-context/connectivity-service/end-point/layer-protocol-constraint/otsi-mcg-connectivity-service-end-point-spec/otsi-mc-spectrum-config-pac/power-management-config-pac/min-input-power> ,
