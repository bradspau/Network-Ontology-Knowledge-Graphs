lex:tapi-common-cond-config-list
    a lex:ReferenceEntry ;
    skos:prefLabel "cond-config-list" ;
    skos:definition "This attribute indicates for the conditioner process the conditioning parameters:\n- Queue ID: Indicates the Queue ID\n- Committed Information Rate (CIR): number of bits per second\n- Committed Burst Size (CBS): number of bytes\n- Excess Information Rate (EIR): number of bits per second\n- Excess Burst Size (EBS): number of bytes\n- Coupling flag (CF): 0 or 1\n- Color mode (CM): color-blind and color-aware." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:StructuralKind ;
    prov:wasDerivedFrom <http://example.org/ontology/tapi-common/context/connectivity-context/connectivity-service/end-point/eth-connectivity-service-end-point-spec/eth-ctp-common-pac/traffic-conditioning-pac/cond-config-list> .

lex:tapi-common-cond-config-list-traffic-conditioning-pac
    a lex:ReferenceEntry ;
    skos:prefLabel "cond-config-list" ;
    skos:definition "This attribute indicates for the conditioner process the conditioning parameters:\n- Queue ID: Indicates the Queue ID\n- Committed Information Rate (CIR): number of bits per second\n- Committed Burst Size (CBS): number of bytes\n- Excess Information Rate (EIR): number of bits per second\n- Excess Burst Size (EBS): number of bytes\n- Coupling flag (CF): 0 or 1\n- Color mode (CM): color-blind and color-aware." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:StructuralKind ;
    prov:wasDerivedFrom <http://example.org/ontology/tapi-common/context/topology-context/topology/node/owned-node-edge-point/cep-list/connection-end-point/eth-connection-end-point-spec/eth-ctp/eth-ctp-common-pac/traffic-conditioning-pac/cond-config-list> .

