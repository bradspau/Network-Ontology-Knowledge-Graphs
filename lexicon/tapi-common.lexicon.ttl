lex:tapi-common-connector-pin
    a lex:ReferenceEntry ;
    skos:prefLabel "connector-pin" ;
    # source: http://example.org/ontology/tapi-common/context/notification-context/event-notification/abstract-strand/connector-pin
    skos:scopeNote "A strand can end on two or more Pins (usually 2 pins, but a strand may be spliced to split a signal).\nThis model supports only 2 ended strands and hence splices must be represented explicitly.\nA abstract strand may be spliced at both ends and hence have no direct relationship to pins or may be connected to pins at one or both ends.\nIn the essential model these Pins would be on connectors that plug in to connectors on Equipments.\nThe AbstractStrand is extended to the pins of the AccessPort which are the Pins on the Connectors of the Equipment.\nIn some cases it may not be relevant to represent the pin detail and hence the reference is to a connector alone.\nCONDITION: Mandatory where at least one connector pin detail is to be represented." ;
    # source: http://example.org/ontology/tapi-common/context/notification-context/event-notification/access-port/connector-pin
    skos:scopeNote "The list of Pins that support the AccessPort." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:StructuralKind ;
    prov:wasDerivedFrom <http://example.org/ontology/tapi-common/context/notification-context/event-notification/abstract-strand/connector-pin> ,
                        <http://example.org/ontology/tapi-common/context/notification-context/event-notification/access-port/connector-pin> ,
                        <http://example.org/ontology/tapi-common/context/notification-context/event-notification/device/access-port/connector-pin> ,
                        <http://example.org/ontology/tapi-common/context/notification-context/event-notification/physical-span/abstract-strand/connector-pin> ,
                        <http://example.org/ontology/tapi-common/context/physical-context/device/access-port/connector-pin> ,
                        <http://example.org/ontology/tapi-common/context/physical-context/physical-span/abstract-strand/connector-pin> .

lex:tapi-common-connector-pin-in-route
    a lex:ReferenceEntry ;
    skos:prefLabel "connector-pin-in-route" ;
    # source: http://example.org/ontology/tapi-common/context/connectivity-context/connection/physical-route-list/physical-route/physical-route-element/connector-pin-in-route
    skos:definition "The connectors and pins defining this point in the route where the access port alone is not sufficient or the access port is not provided.\nCONDITION: Mandatory where AccessPort is not used to define PhysicalRoute or where AccessPort requires clarification as it includes more connectorPins than are used in the route." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:StructuralKind ;
    prov:wasDerivedFrom <http://example.org/ontology/tapi-common/context/connectivity-context/connection/physical-route-list/physical-route/physical-route-element/connector-pin-in-route> ,
