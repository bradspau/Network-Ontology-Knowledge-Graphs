lex:tapi-common-expected-non-field-replaceable-module
    a lex:ReferenceEntry ;
    skos:prefLabel "expected-non-field-replaceable-module" ;
    skos:definition "Details of modules attached to the expected equipment where those modules are essentially part of the equipment and are not replaceable in the field.\nNote that there may be modules reported by the actual equipment that are not declared in the expectation detail.\nNote that mismatch may not account for this detail.\nCONDITION: Mandatory where expected equipment has known non-field-replaceble modules." ;
