                        <http://example.org/ontology/tapi-common/context/oam-context/meg/mip/otn-mip-spec/odu-mip/otn-oam-common/deg-thr> ,
                        <http://example.org/ontology/tapi-common/context/oam-context/meg/mip/otn-mip-spec/odu-tcm-mip/otn-oam-common/deg-thr> ,
                        <http://example.org/ontology/tapi-common/context/oam-context/oam-service/oam-service-point/otn-oam-mep-service-point/odu-mep/otn-oam-common/deg-thr> ,
                        <http://example.org/ontology/tapi-common/context/oam-context/oam-service/oam-service-point/otn-oam-mep-service-point/odu-tcm-mep/otn-oam-common/deg-thr> ,
