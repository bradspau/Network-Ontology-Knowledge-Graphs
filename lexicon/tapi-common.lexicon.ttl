                        <http://example.org/ontology/tapi-common/context/connectivity-context/connectivity-service/resilience-constraint/resiliency-route-constraint/topology-constraint/connection-and-partition-constraint/include-connection-and-partition/connection> ,
                        <http://example.org/ontology/tapi-common/context/connectivity-context/connectivity-service/resilience-constraint/resiliency-route-constraint/topology-constraint/connection-and-route-constraint/exclude-connection-and-route/connection> ,
                        <http://example.org/ontology/tapi-common/context/connectivity-context/connectivity-service/resilience-constraint/resiliency-route-constraint/topology-constraint/connection-and-route-constraint/include-connection-and-route/connection> ,
                        <http://example.org/ontology/tapi-common/context/connectivity-context/connectivity-service/topology-constraint/connection-and-partition-constraint/exclude-connection-and-partition/connection> ,
