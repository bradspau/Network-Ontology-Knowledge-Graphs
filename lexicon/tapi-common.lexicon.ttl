    skos:definition "IEEE P802.1Qcx/D0.3:\nMEF 38:\nThe Maintenance Association name and name format choice." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:StructuralKind ;
    prov:wasDerivedFrom <http://example.org/ontology/tapi-common/context/oam-context/meg/eth-meg-spec/eth-cfm-maintenance-association/maintenance-association-name> ,
                        <http://example.org/ontology/tapi-common/context/oam-context/oam-service/eth-oam-service/eth-cfm-maintenance-association/maintenance-association-name> .

lex:tapi-common-mapped-service-interface-point
    a lex:ReferenceEntry ;
    skos:prefLabel "mapped-service-interface-point" ;
    # source: http://example.org/ontology/tapi-common/context/notification-context/event-notification/node-edge-point/mapped-service-interface-point
    skos:definition "A NodeEdgePoint (NEP) may be associated to a ServiceInterfacePoint (SIP), i.e. when the NEP is the resource oriented view of a SIP.\nNEP mapped to more than one SIP (slicing/virtualizing) or a SIP mapped to more than one NEP (load balancing/resilience) should be considered experimental." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:StructuralKind ;
    prov:wasDerivedFrom <http://example.org/ontology/tapi-common/context/notification-context/event-notification/node-edge-point/mapped-service-interface-point> ,
