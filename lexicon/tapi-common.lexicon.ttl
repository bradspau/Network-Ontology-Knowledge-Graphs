lex:tapi-common-payload-structure
    a lex:ReferenceEntry ;
    skos:prefLabel "payload-structure" ;
    # source: http://example.org/ontology/grouping/tapi-common/payload-structure
    skos:definition "Grouping definition: payload-structure" ;
    # source: http://example.org/ontology/grouping/tapi-common/payload-structure
    skos:scopeNote "The supported multiplexing sequences, e.g.\n- ODU0; ODU1; ODU2; ODU4 : 80\n- ODU0; ODU1; ODU2; ODU3; ODU4 : 64\n- ODUflex; ODU2; ODU3; ODU4 : 64 [64/ts] : 10G\n- ODUflex; ODU2; ODU4: 80 [80/ts] : 10G\n- ODU1; ODU2; ODU3; ODUCn : 40 [mult. for n]\n- ODU2; ODU4; ODUCn: 10 [mult. for n]\n- ODU2; ODU3: ODU4; ODUCn: 8 [mult. for n]\n- ODU3; ODU4; ODUCn: 2 [mult. for n]\n- OTSiMC; MC; OMS; OTS : 80 : 50G\n- ODUCn; OTSiMC : 2 : 200G\n- ODUCn; OTSiMC : 1 : 400G\nIn each sequence, the first entry indicates the upper most client (non-terminated) CEP, the rest of entries indicate the server terminated CEPs (forming the mux path)." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:GroupingKind ;
    prov:wasDerivedFrom <http://example.org/ontology/grouping/tapi-common/payload-structure> .

lex:tapi-common-peer-fwd-connectivity-service-end-point
    a lex:ReferenceEntry ;
    skos:prefLabel "peer-fwd-connectivity-service-end-point" ;
