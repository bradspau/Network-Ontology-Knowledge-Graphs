lex:tapi-common-aggregated-node-edge-point
    a lex:ReferenceEntry ;
    skos:prefLabel "aggregated-node-edge-point" ;
    # source: http://example.org/ontology/tapi-common/context/notification-context/event-notification/node-edge-point/aggregated-node-edge-point
    skos:scopeNote "A NodeEdgePoint (NEP) instance may aggregate one or more other NEP instances for e.g. pooling purposes, when a set of NEP instances are equivalent for usage." ;
