lex:tapi-common-connection-exclusion
    a lex:ReferenceEntry ;
    skos:prefLabel "connection-exclusion" ;
    # source: http://example.org/ontology/tapi-common/context/connectivity-context/connectivity-service/connectivity-constraint/connection-exclusion
    skos:definition "The list of Connection instances which shall not be used to implement the ConnectivityService." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:StructuralKind ;
    prov:wasDerivedFrom <http://example.org/ontology/tapi-common/context/connectivity-context/connectivity-service/connectivity-constraint/connection-exclusion> ,
                        <http://example.org/ontology/tapi-common/context/notification-context/event-notification/connectivity-service/connectivity-constraint/connection-exclusion> .

lex:tapi-common-connection-inclusion
    a lex:ReferenceEntry ;
    skos:prefLabel "connection-inclusion" ;
    # source: http://example.org/ontology/tapi-common/context/connectivity-context/connectivity-service/connectivity-constraint/connection-inclusion
    skos:definition "A ConnectivityService may use one or more existing Connections.\nA common traditional strategy is to set up 'stranded' connectivity in the core of the network as 'express channels' (this is essentially a serial compound link, but can be treated as simple connections).\nA Connection inclusion capability allows for adoption of discovered Connections, i.e. will allow discovered Connections with no stated intent to be associated with an intent via the ConnectivityService.\nA ConnectivityService is requested with a Connection inclusion constraint that identifies a Connection (or chain of Connections) that is bounded by CEPs that each belong to a NEP that references a SIP that is referenced by a CSEP of the ConnectivityService such that all CSEPs are satisfied by CEPs of the existing Connection." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:StructuralKind ;
    prov:wasDerivedFrom <http://example.org/ontology/tapi-common/context/connectivity-context/connectivity-service/connectivity-constraint/connection-inclusion> ,
                        <http://example.org/ontology/tapi-common/context/notification-context/event-notification/connectivity-service/connectivity-constraint/connection-inclusion> .

