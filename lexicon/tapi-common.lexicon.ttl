lex:tapi-common-deg-thr
    a lex:ReferenceEntry ;
    skos:prefLabel "deg-thr" ;
    # source: http://example.org/ontology/tapi-common/context/oam-context/meg/mep/otn-mep-spec/odu-mep/otn-oam-common/deg-thr
    skos:definition "This attribute indicates the threshold level for declaring a performance monitoring (PM) Second to be bad. The value of the threshold can be provisioned in terms of number of errored blocks or in terms of percentage of errored blocks. For percentage-based specification, in order to support provision of less than 1%, the specification consists of two fields. The first field indicates the granularity of percentage. For examples, in 1%, in 0.1%, or in 0.01%, etc. The second field indicates the multiple of the granularity. For number of errored block based, the value is a positive integer." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:StructuralKind ;
    prov:wasDerivedFrom <http://example.org/ontology/tapi-common/context/oam-context/meg/mep/otn-mep-spec/odu-mep/otn-oam-common/deg-thr> ,
                        <http://example.org/ontology/tapi-common/context/oam-context/meg/mep/otn-mep-spec/odu-tcm-mep/otn-oam-common/deg-thr> ,
