lex:tapi-common-service-interface-point-tapi-common
    a lex:ReferenceEntry ;
    skos:prefLabel "service-interface-point" ;
    skos:definition "A Service Interface Point represents the network-interface-facing aspects of the edge-port functions that access the forwarding capabilities provided by the Node. Hence it provides a limited, simplified view of interest to external clients (e.g. shared addressing, capacity, resource availability, etc.), that enable the clients to request connectivity without the need to understand the provider network internals." ;
    skos:scopeNote "Grouping definition: service-interface-point" ;
    lex:canonicalExample "" ;
    lex:entityClass lex:GroupingKind ;
    prov:wasDerivedFrom <http://example.org/ontology/grouping/tapi-common/service-interface-point> .

