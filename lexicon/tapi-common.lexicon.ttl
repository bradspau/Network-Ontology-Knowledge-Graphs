lex:tapi-common-connection
    a lex:ReferenceEntry ;
    skos:prefLabel "connection" ;
    # source: http://example.org/ontology/tapi-common/context/connectivity-context/connectivity-service/connection
    skos:scopeNote "The Connection instance(s) tracking the state of the allocated resources for the support of the ConnectivityService." ;
    # source: http://example.org/ontology/tapi-common/context/connectivity-context/connection
    skos:scopeNote "The included Connection instances." ;
    # source: http://example.org/ontology/tapi-common/context/connectivity-context/connection
    skos:scopeNote "This augment allows Connection to describe its physical route(s) by listing all involved AccessPorts, despite TapiConnectivity model does not import TapiEquipment model." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:StructuralKind ;
    prov:wasDerivedFrom <http://example.org/ontology/tapi-common/context/connectivity-context/connection> ,
                        <http://example.org/ontology/tapi-common/context/connectivity-context/connectivity-service/connection> ,
