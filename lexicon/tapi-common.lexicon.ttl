lex:tapi-common-mep
    a lex:ReferenceEntry ;
    skos:prefLabel "mep" ;
    # source: http://example.org/ontology/tapi-common/context/notification-context/event-notification/current-data/mep
    skos:scopeNote "The MEP to which the measurements refer to.\nAt least and exclusively one of CurrentDataOfCep, CurrentDataOfMep, CurrentDataOfMip must be referred by the CurrentData instance. " ;
    # source: http://example.org/ontology/tapi-common/context/connectivity-context/connectivity-service/connectivity-oam-job-service/oam-job-service/oam-service-point/mep
    skos:scopeNote "The associated Mep instance, mutually exclusive wrt Mip instance." ;
    # source: http://example.org/ontology/tapi-common/context/topology-context/topology/node/owned-node-edge-point/cep-list/connection-end-point/mep-mip-list/mep
    skos:scopeNote "The list of associated Mep instances." ;
    # source: http://example.org/ontology/tapi-common/context/notification-context/event-notification/meg/mep
    skos:scopeNote "The maintenance entity group consists of one or more maintenance entities. There are the following cases:\n1. A maintenance entity may have 0 MEPs (case of transit domains where at least 1 MIP is present).\n2. A maintenance entity may have 1 MEP (case of edge domains, where the peer MEP is ouside the managed domain).\n3. A maintenance entity may have 2 MEPs." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:StructuralKind ;
