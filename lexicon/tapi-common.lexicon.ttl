lex:tapi-common-frequency-constraint
    a lex:ReferenceEntry ;
    skos:prefLabel "frequency-constraint" ;
    # source: http://example.org/ontology/tapi-common/context/service-interface-point/photonic-media-service-interface-point-spec/spectrum-capability-pac/available-spectrum/frequency-constraint
    skos:definition "The combination of adjustment granularity and grid type informs about either ITU-T fixed or flexible grid capability.\nE.g. if grid type = DWDM then the adjustment granularity informs about the fixed slot width.\nE.g. if grid type = FLEX then the adjustment granularity informs about the minimum slot width (two times the adjustment granularity value)." ;
