    prov:wasDerivedFrom <http://example.org/ontology/identity/tapi-common/ETH_ALARM_CONDITION_NAME> .

lex:tapi-common-eth-alarm-condition-name-ais
    a lex:ReferenceEntry ;
    skos:prefLabel "ETH_ALARM_CONDITION_NAME_AIS" ;
    # source: http://example.org/ontology/identity/tapi-common/ETH_ALARM_CONDITION_NAME_AIS
    skos:definition "G.8021: Reception of an AIS frame." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:IdentityKind ;
    prov:wasDerivedFrom <http://example.org/ontology/identity/tapi-common/ETH_ALARM_CONDITION_NAME_AIS> .

lex:tapi-common-eth-alarm-condition-name-csf
    a lex:ReferenceEntry ;
    skos:prefLabel "ETH_ALARM_CONDITION_NAME_CSF" ;
    # source: http://example.org/ontology/identity/tapi-common/ETH_ALARM_CONDITION_NAME_CSF
    skos:definition "G.8021 - ETH layer: Reception of a CSF frame that indicates a client loss of signal (dCSF-LOS) or a client forward defect indication (dCSF-FDI) or a client reverse defect indication (dCSF-RDI).\nThe CSF (CSF-LOS, CSF-FDI, and CSF-RDI) defect is calculated at the ETH layer. It monitors the presence of a CSF maintenance signal.\nG.8021 - GFP: dCSF is Client-specific GFP-F and GFP-T (resp. Frame and Transparent) sink processes.\ndCSF-RDI: GFP client signal fail-remote defect indication is raised when a GFP client management frame with the RDI UPI (as defined in Table 6-4 of [ITU-T G.7041]) is received.\ndCSF-RDI is cleared when no such GFP client management frame is received in N x 1000 ms (a value of 3 is suggested for N), a valid GFP client data frame is received, or a GFP client management frame with the DCI UPI is received.\ndCSF-FDI: GFP client signal fail-forward defect indication is raised when a GFP client management frame with the FDI UPI (as defined in Table 6-4 of [ITU-T G.7041]) is received.\ndCSF-FDI is cleared when no such GFP client management frame is received in N x 1000 ms (a value of 3 is suggested for N), a valid GFP client data frame is received, or a GFP client management frame with the DCI UPI is received.\ndCSF-LOS: GFP client signal fail-loss of signal is raised when a GFP client management frame with the LOS UPI (as defined in Table 6-4 of [ITU-T G.7041]) is received.\ndCSF-LOS is cleared when no such GFP client management frame is received in N x 1000 ms (a value of 3 is suggested for N), a valid GFP client data frame is received, or a GFP client management frame with the DCI UPI is received." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:IdentityKind ;
    prov:wasDerivedFrom <http://example.org/ontology/identity/tapi-common/ETH_ALARM_CONDITION_NAME_CSF> .

lex:tapi-common-eth-alarm-condition-name-degraded
    a lex:ReferenceEntry ;
    skos:prefLabel "ETH_ALARM_CONDITION_NAME_DEGRADED" ;
    # source: http://example.org/ontology/identity/tapi-common/ETH_ALARM_CONDITION_NAME_DEGRADED
    skos:definition "G.8021: The defect is detected if there are MI_LM_DEGM (lmDegm of EthMepSink) consecutive bad seconds and cleared if there are MI_LM_M (lmM of EthMepSink) consecutive good seconds.\nIn order to declare a bad second the number of transmitted frames must exceed a threshold (MI_LM_TFMIN, lmTfMin of EthMepSink).\nFurthermore, if the frame loss ratio (lost frames/transmitted frames) is greater than MI_LM_DEGTHR (lmDegThr of EthMepSink), a bad second is declared.\nThis defect is only defined for point-to-point ETH connections. It monitors the connectivity of an ETH trail.\n" ;
    lex:canonicalExample "" ;
    lex:entityClass lex:IdentityKind ;
    prov:wasDerivedFrom <http://example.org/ontology/identity/tapi-common/ETH_ALARM_CONDITION_NAME_DEGRADED> .

lex:tapi-common-eth-alarm-condition-name-exm
    a lex:ReferenceEntry ;
    skos:prefLabel "ETH_ALARM_CONDITION_NAME_EXM" ;
    # source: http://example.org/ontology/identity/tapi-common/ETH_ALARM_CONDITION_NAME_EXM
    skos:definition "G.806 - Common GFP sink processes: GFP extension header mismatch (dEXM) is raised when the accepted EXI (AcEXI) is different from the expected EXI.\ndEXM is cleared when AcEXI matches the expected EXI or GFP_SF is active." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:IdentityKind ;
    prov:wasDerivedFrom <http://example.org/ontology/identity/tapi-common/ETH_ALARM_CONDITION_NAME_EXM> .

lex:tapi-common-eth-alarm-condition-name-lfd
    a lex:ReferenceEntry ;
    skos:prefLabel "ETH_ALARM_CONDITION_NAME_LFD" ;
    # source: http://example.org/ontology/identity/tapi-common/ETH_ALARM_CONDITION_NAME_LFD
    skos:definition "G.806 - Server layer-specific GFP sink processes: GFP loss of frame delineation (dLFD) is raised when the frame delineation process (clause 6.3.1 of [ITU-T G.7041]) is not in the 'SYNC' state.\ndLFD is cleared when the frame delineation process is in the 'SYNC' state." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:IdentityKind ;
    prov:wasDerivedFrom <http://example.org/ontology/identity/tapi-common/ETH_ALARM_CONDITION_NAME_LFD> .

lex:tapi-common-eth-alarm-condition-name-locked
    a lex:ReferenceEntry ;
    skos:prefLabel "ETH_ALARM_CONDITION_NAME_LOCKED" ;
    # source: http://example.org/ontology/identity/tapi-common/ETH_ALARM_CONDITION_NAME_LOCKED
    skos:definition "G.8021: Reception of a LCK frame." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:IdentityKind ;
    prov:wasDerivedFrom <http://example.org/ontology/identity/tapi-common/ETH_ALARM_CONDITION_NAME_LOCKED> .

lex:tapi-common-eth-alarm-condition-name-loss-of-continuity
    a lex:ReferenceEntry ;
    skos:prefLabel "ETH_ALARM_CONDITION_NAME_LOSS_OF_CONTINUITY" ;
    # source: http://example.org/ontology/identity/tapi-common/ETH_ALARM_CONDITION_NAME_LOSS_OF_CONTINUITY
    skos:definition "G.8021: The loss of continuity defect is calculated at the ETH layer. It monitors the presence of continuity in ETH trails." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:IdentityKind ;
    prov:wasDerivedFrom <http://example.org/ontology/identity/tapi-common/ETH_ALARM_CONDITION_NAME_LOSS_OF_CONTINUITY> .

lex:tapi-common-eth-alarm-condition-name-mismerge-unexpected-meg
    a lex:ReferenceEntry ;
    skos:prefLabel "ETH_ALARM_CONDITION_NAME_MISMERGE_UNEXPECTED_MEG" ;
    # source: http://example.org/ontology/identity/tapi-common/ETH_ALARM_CONDITION_NAME_MISMERGE_UNEXPECTED_MEG
    skos:definition "G.8021: Reception of a CCM frame with an invalid MEG value, but with a valid MEL value.\nMonitoring of the connectivity in a maintenance entity group.\n" ;
    lex:canonicalExample "" ;
    lex:entityClass lex:IdentityKind ;
    prov:wasDerivedFrom <http://example.org/ontology/identity/tapi-common/ETH_ALARM_CONDITION_NAME_MISMERGE_UNEXPECTED_MEG> .

lex:tapi-common-eth-alarm-condition-name-partial-link-loss
    a lex:ReferenceEntry ;
    skos:prefLabel "ETH_ALARM_CONDITION_NAME_PARTIAL_LINK_LOSS" ;
    # source: http://example.org/ontology/identity/tapi-common/ETH_ALARM_CONDITION_NAME_PARTIAL_LINK_LOSS
    skos:definition "G.8021: LAG - fault cause shall be raised if the number of active ports is less than the provisioned threshold." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:IdentityKind ;
    prov:wasDerivedFrom <http://example.org/ontology/identity/tapi-common/ETH_ALARM_CONDITION_NAME_PARTIAL_LINK_LOSS> .

lex:tapi-common-eth-alarm-condition-name-plm
    a lex:ReferenceEntry ;
    skos:prefLabel "ETH_ALARM_CONDITION_NAME_PLM" ;
    # source: http://example.org/ontology/identity/tapi-common/ETH_ALARM_CONDITION_NAME_PLM
    skos:definition "G.806: The payload label mismatch defect (dPLM) shall be detected if the 'accepted TSL' code does not match the 'expected TSL' code. If the 'accepted TSL' is 'equipped non-specific', the mismatch is not detected (TSL: Trail Signal Label).\nPayload type supervision checks that compatible adaptation functions are used at the source and the sink.\nThis is normally done by adding a signal type identifier at the source adaptation function and comparing it with the expected identifier at the sink.\nIf they do not match, a payload mismatch is detected." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:IdentityKind ;
    prov:wasDerivedFrom <http://example.org/ontology/identity/tapi-common/ETH_ALARM_CONDITION_NAME_PLM> .

lex:tapi-common-eth-alarm-condition-name-rdi
    a lex:ReferenceEntry ;
    skos:prefLabel "ETH_ALARM_CONDITION_NAME_RDI" ;
    # source: http://example.org/ontology/identity/tapi-common/ETH_ALARM_CONDITION_NAME_RDI
    skos:definition "G.8021: Remote defect indicator defect, reception by an MEP (indexed by 'i', this index not included in the 'cause' cRDI) of a CCM frame with valid MEL, MEG, MEP and periodicity values and the RDI flag set to x; where x=0 (remote defect clear) and x=1 (remote defect set)." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:IdentityKind ;
    prov:wasDerivedFrom <http://example.org/ontology/identity/tapi-common/ETH_ALARM_CONDITION_NAME_RDI> .

lex:tapi-common-eth-alarm-condition-name-total-link-loss
    a lex:ReferenceEntry ;
    skos:prefLabel "ETH_ALARM_CONDITION_NAME_TOTAL_LINK_LOSS" ;
    # source: http://example.org/ontology/identity/tapi-common/ETH_ALARM_CONDITION_NAME_TOTAL_LINK_LOSS
    skos:definition "G.8021: LAG - fault cause will be raised if no ports are active for an aggregator." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:IdentityKind ;
    prov:wasDerivedFrom <http://example.org/ontology/identity/tapi-common/ETH_ALARM_CONDITION_NAME_TOTAL_LINK_LOSS> .

lex:tapi-common-eth-alarm-condition-name-unexpected-mel
    a lex:ReferenceEntry ;
    skos:prefLabel "ETH_ALARM_CONDITION_NAME_UNEXPECTED_MEL" ;
    # source: http://example.org/ontology/identity/tapi-common/ETH_ALARM_CONDITION_NAME_UNEXPECTED_MEL
    skos:definition "G.8021: Reception of a CCM frame with an invalid MEL value.\nMonitoring of the connectivity in a maintenance entity group." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:IdentityKind ;
    prov:wasDerivedFrom <http://example.org/ontology/identity/tapi-common/ETH_ALARM_CONDITION_NAME_UNEXPECTED_MEL> .

lex:tapi-common-eth-alarm-condition-name-unexpected-mep
    a lex:ReferenceEntry ;
    skos:prefLabel "ETH_ALARM_CONDITION_NAME_UNEXPECTED_MEP" ;
    # source: http://example.org/ontology/identity/tapi-common/ETH_ALARM_CONDITION_NAME_UNEXPECTED_MEP
    skos:definition "G.8021: Reception of a CCM frame with an invalid MEP value, but with valid MEL and MEG values.\nMonitoring of the connectivity in a maintenance entity group.\n" ;
    lex:canonicalExample "" ;
    lex:entityClass lex:IdentityKind ;
    prov:wasDerivedFrom <http://example.org/ontology/identity/tapi-common/ETH_ALARM_CONDITION_NAME_UNEXPECTED_MEP> .

lex:tapi-common-eth-alarm-condition-name-unexpected-periodicity
    a lex:ReferenceEntry ;
    skos:prefLabel "ETH_ALARM_CONDITION_NAME_UNEXPECTED_PERIODICITY" ;
    # source: http://example.org/ontology/identity/tapi-common/ETH_ALARM_CONDITION_NAME_UNEXPECTED_PERIODICITY
    skos:definition "G.8021: Reception of a CCM frame with an invalid periodicity value, but with valid MEL, MEG and MEP values.\nIt detects the configuration of different periodicities at different MEPs belonging to the same MEG.\n" ;
    lex:canonicalExample "" ;
    lex:entityClass lex:IdentityKind ;
    prov:wasDerivedFrom <http://example.org/ontology/identity/tapi-common/ETH_ALARM_CONDITION_NAME_UNEXPECTED_PERIODICITY> .

lex:tapi-common-eth-alarm-condition-name-unexpected-priority
    a lex:ReferenceEntry ;
    skos:prefLabel "ETH_ALARM_CONDITION_NAME_UNEXPECTED_PRIORITY" ;
    # source: http://example.org/ontology/identity/tapi-common/ETH_ALARM_CONDITION_NAME_UNEXPECTED_PRIORITY
    skos:definition "G.8021: Reception of a CCM frame with an invalid priority value, but with valid MEL, MEG, MEP and periodicity values.\nIt detects the configuration of different priorities for CCM at different MEPs belonging to the same MEG.\n" ;
    lex:canonicalExample "" ;
    lex:entityClass lex:IdentityKind ;
    prov:wasDerivedFrom <http://example.org/ontology/identity/tapi-common/ETH_ALARM_CONDITION_NAME_UNEXPECTED_PRIORITY> .

lex:tapi-common-eth-alarm-condition-name-upm
    a lex:ReferenceEntry ;
    skos:prefLabel "ETH_ALARM_CONDITION_NAME_UPM" ;
    # source: http://example.org/ontology/identity/tapi-common/ETH_ALARM_CONDITION_NAME_UPM
    skos:definition "G.806 - Client-specific GFP-F (Frame) and GFP-T (Transparent) sink processes: GFP user payload mismatch (dUPM) is raised when the accepted UPI (AcUPI) is different from the expected UPI.\ndUPM is cleared when AcUPI matches the expected UPI or GFP_SF is active." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:IdentityKind ;
    prov:wasDerivedFrom <http://example.org/ontology/identity/tapi-common/ETH_ALARM_CONDITION_NAME_UPM> .

