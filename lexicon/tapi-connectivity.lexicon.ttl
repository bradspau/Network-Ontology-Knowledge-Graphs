lex:tapi-connectivity-fault-condition-determination-inherent
    a lex:ReferenceEntry ;
    skos:prefLabel "FAULT_CONDITION_DETERMINATION_INHERENT" ;
    # source: http://example.org/ontology/identity/tapi-connectivity/FAULT_CONDITION_DETERMINATION_INHERENT
    skos:definition "Inherent monitored (/I): The fault condition status of each link connection is derived from the status of the underlying server layer trail." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:IdentityKind ;
    prov:wasDerivedFrom <http://example.org/ontology/identity/tapi-connectivity/FAULT_CONDITION_DETERMINATION_INHERENT> .

lex:tapi-connectivity-fault-condition-determination-non-intrusive
    a lex:ReferenceEntry ;
    skos:prefLabel "FAULT_CONDITION_DETERMINATION_NON_INTRUSIVE" ;
    # source: http://example.org/ontology/identity/tapi-connectivity/FAULT_CONDITION_DETERMINATION_NON_INTRUSIVE
    skos:definition "Non-intrusive monitored (/N): Each serial compound link connection is extended with a non-intrusive monitoring termination sink function to derive the fault condition status from the traffic signal that is present." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:IdentityKind ;
    prov:wasDerivedFrom <http://example.org/ontology/identity/tapi-connectivity/FAULT_CONDITION_DETERMINATION_NON_INTRUSIVE> .

lex:tapi-connectivity-fault-condition-determination-sublayer
    a lex:ReferenceEntry ;
    skos:prefLabel "FAULT_CONDITION_DETERMINATION_SUBLAYER" ;
    # source: http://example.org/ontology/identity/tapi-connectivity/FAULT_CONDITION_DETERMINATION_SUBLAYER
    skos:definition "Sublayer monitored (/S): Each serial compound link connection is extended with tandem connection monitoring or segment termination/adaptation functions to derive the fault condition status independent of the traffic signal present." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:IdentityKind ;
    prov:wasDerivedFrom <http://example.org/ontology/identity/tapi-connectivity/FAULT_CONDITION_DETERMINATION_SUBLAYER> .

