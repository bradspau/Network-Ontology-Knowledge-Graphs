lex:tapi-connectivity-connection
    a lex:ReferenceEntry ;
    skos:prefLabel "connection" ;
    # source: http://example.org/ontology/grouping/tapi-connectivity/connection
    skos:definition "A Connection represents an enabled (provisioned) potential for forwarding (of transport characteristic information including all circuit/packet forms) between two or more ConnectionEndPoint instances.\nThe bounding Node of a Connection may be explicit or be conceptually implicit.\nThe Connection is a container for provisioned connectivity that tracks the state of the allocated resources and is distinct from the ConnectivityService.\nAt the lowest level of recursion, a Connection may represent a cross-connection in a switch matrix (i.e., a fabric) in an equipment." ;
    # source: http://example.org/ontology/grouping/tapi-connectivity/connection
    skos:scopeNote "Grouping definition: connection" ;
    lex:canonicalExample "" ;
    lex:entityClass lex:GroupingKind ;
    prov:wasDerivedFrom <http://example.org/ontology/grouping/tapi-connectivity/connection> .

