    # source: http://example.org/ontology/identity/tapi-connectivity/FAULT_CONDITION_DETERMINATION_TEST
    skos:definition "Test monitored (/T): Each serial compound link connection's fault condition status is derived from an additional monitored serial compound link connection transported via the same serial compound link." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:IdentityKind ;
    prov:wasDerivedFrom <http://example.org/ontology/identity/tapi-connectivity/FAULT_CONDITION_DETERMINATION_TEST> .

