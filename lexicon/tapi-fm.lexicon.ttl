    lex:canonicalExample "" ;
    lex:entityClass lex:IdentityKind ;
    prov:wasDerivedFrom <http://example.org/ontology/identity/tapi-fm/PERCEIVED_TCA_SEVERITY> .

lex:tapi-fm-perceived-tca-severity-clear
    a lex:ReferenceEntry ;
    skos:prefLabel "PERCEIVED_TCA_SEVERITY_CLEAR" ;
    skos:definition "Included only for some possible backward compatibility purpose. It should not be used to assign a severity to a failure.\nITU-T G.7710: The severities 'cleared' and 'indeterminate' defined by [ITU-T X.733] are not included in Table 2, as it is assumed that these are not to be used to assign a failure." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:IdentityKind ;
    prov:wasDerivedFrom <http://example.org/ontology/identity/tapi-fm/PERCEIVED_TCA_SEVERITY_CLEAR> .

lex:tapi-fm-perceived-tca-severity-warning
    a lex:ReferenceEntry ;
    skos:prefLabel "PERCEIVED_TCA_SEVERITY_WARNING" ;
    skos:definition "ITU-T G.7710/X.733/M.3100: Indication for a potential or impending service-affecting fault. Further diagnosis should be made." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:IdentityKind ;
    prov:wasDerivedFrom <http://example.org/ontology/identity/tapi-fm/PERCEIVED_TCA_SEVERITY_WARNING> .

