lex:tapi-fm-perceived-severity-type
    a lex:ReferenceEntry ;
    skos:prefLabel "perceived-severity-type" ;
    skos:definition "The types of perceived severity.\nITU-T G.7710: Failures may have been categorized to indicate the severity or urgency of the fault." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:EnumeratedKind ;
    prov:wasDerivedFrom <http://example.org/ontology/types/tapi-fm/perceived-severity-type> .

lex:tapi-fm-perceived-tca-severity
    a lex:ReferenceEntry ;
    skos:prefLabel "PERCEIVED_TCA_SEVERITY" ;
