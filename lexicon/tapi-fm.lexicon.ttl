lex:tapi-fm-simple-detector-state
    a lex:ReferenceEntry ;
    skos:prefLabel "SIMPLE_DETECTOR_STATE" ;
    skos:definition "none" ;
    lex:canonicalExample "" ;
    lex:entityClass lex:IdentityKind ;
    prov:wasDerivedFrom <http://example.org/ontology/identity/tapi-fm/SIMPLE_DETECTOR_STATE> .

lex:tapi-fm-simple-detector-state-active
    a lex:ReferenceEntry ;
    skos:prefLabel "SIMPLE_DETECTOR_STATE_ACTIVE" ;
    skos:definition "The detector is indicating the operation of the monitored entity is not within acceptable bounds with respect to the specific condition measured.\nIf INTERMITTENT is supported there may be a requirement for persisted unacceptable operation after a problem occurs before ACTIVE is declared. An alternative may be to declare INTERMITTENT.\nWhere INTERMITTENT is supported, ACTIVE indicates the stable presence of a problem." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:IdentityKind ;
    prov:wasDerivedFrom <http://example.org/ontology/identity/tapi-fm/SIMPLE_DETECTOR_STATE_ACTIVE> .

lex:tapi-fm-simple-detector-state-active-no-explicit-clear
    a lex:ReferenceEntry ;
    skos:prefLabel "SIMPLE_DETECTOR_STATE_ACTIVE_NO_EXPLICIT_CLEAR" ;
    skos:definition "Same as Active, but an explicit transition to Clear is not foreseen.\nThis e.g. applies to PM metrics which can only increase (counters), hence the 'clear' criteria is conventionally the end of a measurement period." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:IdentityKind ;
    prov:wasDerivedFrom <http://example.org/ontology/identity/tapi-fm/SIMPLE_DETECTOR_STATE_ACTIVE_NO_EXPLICIT_CLEAR> .

lex:tapi-fm-simple-detector-state-clear
    a lex:ReferenceEntry ;
    skos:prefLabel "SIMPLE_DETECTOR_STATE_CLEAR" ;
    skos:definition "The detector is indicating the operation of the monitored entity is within acceptable bounds with respect to the specific condition measured." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:IdentityKind ;
    prov:wasDerivedFrom <http://example.org/ontology/identity/tapi-fm/SIMPLE_DETECTOR_STATE_CLEAR> .

lex:tapi-fm-simple-detector-state-fleeting
    a lex:ReferenceEntry ;
    skos:prefLabel "SIMPLE_DETECTOR_STATE_FLEETING" ;
    skos:definition "Event has a very short life (Active-Clear), hence is notified/streamed after its occurrence." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:IdentityKind ;
    prov:wasDerivedFrom <http://example.org/ontology/identity/tapi-fm/SIMPLE_DETECTOR_STATE_FLEETING> .

lex:tapi-fm-simple-detector-state-intermittent
    a lex:ReferenceEntry ;
    skos:prefLabel "SIMPLE_DETECTOR_STATE_INTERMITTENT" ;
    skos:definition "The detector is indicating the operation of the monitored entity is intermittently not within acceptable bounds with respect to the specific condition measured.\nINTERMITTENT support is optional. Where it is supported there may be a requirement for persisted unacceptable operation after a problem occurs before ACTIVE or INTERMITTENT is declared." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:IdentityKind ;
    prov:wasDerivedFrom <http://example.org/ontology/identity/tapi-fm/SIMPLE_DETECTOR_STATE_INTERMITTENT> .

