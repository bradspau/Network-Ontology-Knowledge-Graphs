lex:tapi-oam-mip
    a lex:ReferenceEntry ;
    skos:prefLabel "mip" ;
    skos:definition "Grouping definition: mip" ;
    skos:scopeNote "The Maintenance entity group Intermediate Point.\nITU-T G.8001: maintenance entity group intermediate point compound function: A compound transport processing function that accepts the characteristic information of the layer network at its input,\nreacts to OAM information related to on-demand monitoring of a maintenance entity group and presents the characteristic information without the OAM to which it reacted at its output." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:GroupingKind ;
    prov:wasDerivedFrom <http://example.org/ontology/grouping/tapi-oam/mip> .

