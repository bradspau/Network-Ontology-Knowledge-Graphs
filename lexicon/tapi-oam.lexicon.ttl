lex:tapi-oam-pm-data
    a lex:ReferenceEntry ;
    skos:prefLabel "pm-data" ;
    skos:definition "Grouping definition: pm-data" ;
    skos:scopeNote "The PM threshold information associated to an OamProfile instance.\nIt defines a set of PM metrics, their threshold values, the granularity period or measurement interval time for these PM metrics, the stateful or stateless types of related threshold crossing alert (TCA) reporting." ;
