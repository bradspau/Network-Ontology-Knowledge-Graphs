    lex:entityClass lex:GroupingKind ;
    prov:wasDerivedFrom <http://example.org/ontology/grouping/tapi-oam/history-data-ref> .

lex:tapi-oam-meg
    a lex:ReferenceEntry ;
    skos:prefLabel "meg" ;
    skos:definition "Grouping definition: meg" ;
    skos:scopeNote "The Maintenance Entity Group.\nITU-T G.8001: A group defined, for the purpose of fragment or connection monitoring, between a set of flow or connection points within a fragment/connection.\nThis set of flow or connection points may be located at the boundary of one administrative domain or a protection domain, or at the boundaries of two adjacent administrative domains.\nThe maintenance entity group consists of one or more maintenance entities (the entity between two of the flow/connection points in a maintenance entity group)." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:GroupingKind ;
    prov:wasDerivedFrom <http://example.org/ontology/grouping/tapi-oam/meg> .

lex:tapi-oam-meg-ref
    a lex:ReferenceEntry ;
    skos:prefLabel "meg-ref" ;
    skos:definition "Grouping definition: meg-ref" ;
    skos:scopeNote "none" ;
    lex:canonicalExample "" ;
    lex:entityClass lex:GroupingKind ;
    prov:wasDerivedFrom <http://example.org/ontology/grouping/tapi-oam/meg-ref> .

lex:tapi-oam-mep
    a lex:ReferenceEntry ;
    skos:prefLabel "mep" ;
    skos:definition "Grouping definition: mep" ;
    skos:scopeNote "The Maintenance Entity group end Point.\nITU-T G.8001: maintenance entity group end point compound sink function: A compound transport processing function that accepts the characteristic information of the layer network at its input,\nextracts and processes the OAM information related to the monitoring of the maintenance entity group, filters the OAM information from within to the maintenance entity group,\nadapts the information and presents it as the characteristic information of the layer or a client layer at its output, potentially as a (client) layer maintenance signal (e.g., AIS).\nITU-T G.8001: maintenance entity group end point compound source function: A compound transport processing function that accepts the characteristic information of the layer or a client layer network at its input,\nadapts that information, filters it for OAM information interfering with its own OAM information, adds OAM information to allow the maintenance entity group to be monitored and presents the resulting information at its output." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:GroupingKind ;
    prov:wasDerivedFrom <http://example.org/ontology/grouping/tapi-oam/mep> .

lex:tapi-oam-mep-mip-list
    a lex:ReferenceEntry ;
    skos:prefLabel "mep-mip-list" ;
    skos:definition "Grouping definition: mep-mip-list" ;
    skos:scopeNote "This augment allows CEP and NEP to refer to their MEPs/MIPs despite TapiOam model does not import resp. TapiConnectivity and TapiTopology models." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:GroupingKind ;
    prov:wasDerivedFrom <http://example.org/ontology/grouping/tapi-oam/mep-mip-list> .

