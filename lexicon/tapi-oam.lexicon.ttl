lex:tapi-oam-current-data
    a lex:ReferenceEntry ;
    skos:prefLabel "current-data" ;
    skos:definition "Grouping definition: current-data" ;
    skos:scopeNote "The CurrentData class. The PM metrics/types can be specified in technology specific augmentations of this class.\nITU-T Q.822: This object contains the measurements for the resource being monitored for a specified time interval (measurement interval time / granularity period)." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:GroupingKind ;
    prov:wasDerivedFrom <http://example.org/ontology/grouping/tapi-oam/current-data> .

