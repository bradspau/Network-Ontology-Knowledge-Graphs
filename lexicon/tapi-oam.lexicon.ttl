    prov:wasDerivedFrom <http://example.org/ontology/grouping/tapi-oam/current-data-ref> .

lex:tapi-oam-history-data
    a lex:ReferenceEntry ;
    skos:prefLabel "history-data" ;
    skos:definition "Grouping definition: history-data" ;
    skos:scopeNote "The HistoryData class. The PM metrics/types can be specified in technology specific augmentations of this class.\nITU-T Q.822: This object will contain a copy of the performance management and other selected attributes that are present in the CurrentData object at the end of the current interval (measurement interval time / granularity period).\nA new instance of this object class is created at the end of each interval." ;
    lex:canonicalExample "" ;
    lex:entityClass lex:GroupingKind ;
    prov:wasDerivedFrom <http://example.org/ontology/grouping/tapi-oam/history-data> .

