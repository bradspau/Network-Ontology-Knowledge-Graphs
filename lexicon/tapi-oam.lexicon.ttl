lex:tapi-oam-oam-service
    a lex:ReferenceEntry ;
    skos:prefLabel "oam-service" ;
    skos:definition "An OamService represents an 'intent-like' request for OAM functions between two or more OamServicePoint (OSP) instances. The OamService is a container for OAM request details and is distinct from the Meg that realize the request." ;
    skos:scopeNote "Grouping definition: oam-service" ;
    lex:canonicalExample "" ;
    lex:entityClass lex:GroupingKind ;
    prov:wasDerivedFrom <http://example.org/ontology/grouping/tapi-oam/oam-service> .

